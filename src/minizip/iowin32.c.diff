+/* Shorten the file to `size`, leaving the position where the caller had it:
+   SetEndOfFile cuts at the current one, so it has to be moved and put back. */
+int ZCALLBACK win32_truncate64_file_func(voidpf opaque, voidpf stream,
+                                         ZPOS64_T size) {
+  HANDLE hFile = NULL;
+  LARGE_INTEGER cur, want;
+
+  (void) opaque;
+  if (stream != NULL)
+    hFile = ((WIN32FILE_IOWIN *) stream)->hf;
+  if (hFile == NULL)
+    return -1;
+  cur.QuadPart = 0;
+  want.QuadPart = (LONGLONG) size;
+  if (!MySetFilePointerEx(hFile, cur, &cur, FILE_CURRENT) ||
+      !MySetFilePointerEx(hFile, want, NULL, FILE_BEGIN) ||
+      !SetEndOfFile(hFile) ||
+      !MySetFilePointerEx(hFile, cur, NULL, FILE_BEGIN)) {
+    ((WIN32FILE_IOWIN *) stream)->error = (int) GetLastError();
+    return -1;
+  }
+  return 0;
+}

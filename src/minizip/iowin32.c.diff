+/* The handle carries no user-space buffer, so this is the OS write cache. */
+int ZCALLBACK win32_flush_file_func(voidpf opaque, voidpf stream) {
+  HANDLE hFile = NULL;
+
+  (void) opaque;
+  if (stream != NULL)
+    hFile = ((WIN32FILE_IOWIN *) stream)->hf;
+  if (hFile == NULL)
+    return -1;
+  if (!FlushFileBuffers(hFile)) {
+    ((WIN32FILE_IOWIN *) stream)->error = (int) GetLastError();
+    return -1;
+  }
+  return 0;
+}

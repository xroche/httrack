prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libhttrack
Description: HTTrack Website Copier engine
URL: @PACKAGE_URL@
Version: @PACKAGE_VERSION@
# Flat, as the installed headers and the libtest examples include each other;
# LFS decides the layout of the struct stat httrack-library.h typedefs.
Cflags: -I${includedir}/httrack @V6_FLAG@ @LFS_FLAG@
# Carries its own leading space, and is empty for a system libdir (#978).
Libs: -L${libdir} -lhttrack@PKGCONFIG_RPATH_LDFLAG@
Libs.private: @LIBS@ @THREADS_LIBS@ @BROTLI_LIBS@ @ZSTD_LIBS@ @OPENSSL_LIBS@ @DL_LIBS@ @SOCKET_LIBS@ @ICONV_LIBS@

/* ------------------------------------------------------------ */
/* File: Public build-switch header (generated by configure)     */
/* ------------------------------------------------------------ */

/** @file htsfeatures.h
 *  The subset of config.h the installed headers need. HTS_INET6 and
 *  HTS_USEOPENSSL fix SOCaddr/htsblk layout: a consumer that guesses them wrong
 *  desyncs from the library it links against. */

#ifndef HTTRACK_FEATURES_DEFH
#define HTTRACK_FEATURES_DEFH

/* Picks the in6_addr/sockaddr_in6 arm of SOCaddr (htsnet.h). */
#undef HTS_INET6

/* Adds the ssl fields to htsblk, past its embedded SOCaddr (htsopt.h). */
#undef HTS_USEOPENSSL

/* Content codings the build can decode (htsglobal.h). */
#undef HTS_USEBROTLI
#undef HTS_USEZSTD

/* Large-file support: widens INTsys to 64 bits (htsglobal.h). */
#undef HTS_LFS

/* Set when the platform declares in_addr_t, which htsnet.h then leaves alone. */
#undef HTS_DO_NOT_REDEFINE_in_addr_t

/* Replacements for the socket types a platform may not declare; htsnet.h uses
   in_port_t in the SOCaddr accessors. */
#undef in_port_t
#undef sa_family_t

/* setuid() available; its absence defines HTS_DO_NOT_USE_UID (htsglobal.h). */
#undef SETUID

/* dlopen() available; drives HTS_DLOPEN (htsglobal.h). */
#undef DLLIB

/* strnlen() available; picks htssafe.h's own implementation when absent. */
#undef HAVE_STRNLEN

/* Compiler honours visibility attributes; marks HTSEXT_API and
   EXTERNAL_FUNCTION default-visible on a non-GNU compiler. */
#undef HAVE_VISIBILITY

#endif

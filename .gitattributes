# Resource scripts are Windows tooling input and must stay CRLF: the engine has no
# encoding guard, so an autocrlf checkout could otherwise flatten them silently.
*.rc text eol=crlf

# The test scripts run under Git Bash on the Windows CI; a CRLF checkout makes
# bash die on $'\r' on every line of them.
*.test text eol=lf
*.sh text eol=lf

# The count pin is parsed field by field; a CRLF checkout makes every line malformed.
tests/*.counts text eol=lf

# The index templates are CRLF too, and nothing checks them either: pinned so a
# text-mode rewrite cannot flatten one silently.
templates/*.html text eol=crlf

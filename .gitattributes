# Only rc.exe reads these and it takes LF, so nothing here earns a CRLF pin.
*.rc text eol=lf

# The test scripts run under Git Bash on the Windows CI; a CRLF checkout makes
# bash die on $'\r' on every line of them.
*.test text eol=lf
*.sh text eol=lf

# The count pin is parsed field by field; a CRLF checkout makes every line malformed.
tests/*.counts text eol=lf

# The engine pastes these into the generated index verbatim; LF so a Windows
# checkout cannot put CRs there and so the compiled-in copies match on POSIX.
templates/*.html text eol=lf

# Tab-separated data: the generator rejects a stray CR by design.
*.tsv text eol=lf

# Shipped as documentation, where a CR draws rpmlint and a packager's dos2unix.
httrack-doc.html text eol=lf
src/proxy/AUTHORS text eol=lf
src/proxy/changelog.txt text eol=lf

# WinHTTrack and other out-of-tree readers expect the catalogs CRLF, so git
# must convert neither end. -text, not eol=crlf: the latter would renormalize
# every blob to LF on the next add.
lang.def -text
lang/*.txt -text

# Byte-exact fuzz vectors, whatever their line endings look like.
fuzz/corpus/** -text

# Tokens of URL-to-save-name building (htsname.c).
scheme_http="http://"
scheme_https="https://"
scheme_ftp="ftp://"
scheme_file="file://"
creds="user:pass@"
ipv6="[IPv6:::1]:8080"
port=":443"
slash="/"
dotdot="../"
dotslash="./"
dslash="//"
query="?a=1&id=x"
query2="?PHPSESSID=abcdef0123456789"
fragment="#top"
ext_html=".html"
ext_php=".php"
ext_cgi=".cgi"
space="%20"
plus="+"
tilde="~"
utf8="h\xc3\xa9llo"
backslash="\\"
dot_host="www.example.com."
trailing="example.com/"
domain="example.com"
path_page="/page.php"
path_index="/index.html"

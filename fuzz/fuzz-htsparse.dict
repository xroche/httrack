tag_style="<style"
tag_link="<link rel="
tag_meta="<meta"
tag_base="<base href="
tag_frame="<frame src="
tag_iframe="<iframe src="
tag_form="<form action="
tag_input="<input type="
tag_object="<object data="
tag_embed="<embed src="
tag_applet="<applet code="
tag_area="<area href="
tag_usemap="usemap="#m"
tag_svg="<svg"
tag_math="<math"
tag_tables="<table"
tag_td="<td colspan="
attr_srcset="srcset="
attr_background="background="
attr_xlink="xlink:href="
attr_style="style="
attr_data="data="
cond_comment="<!--[if IE]>"
cdata="<![CDATA["
comment="<!--"
dtd="<!DOCTYPE HTML"
pi="<?xml"

# HTTP response header shapes (htslib.c header parsing).
s_200="HTTP/1.1 200 OK"
s_302="HTTP/1.0 302 Moved"
h_ct="Content-Type:"
h_len="Content-Length:"
h_loc="Location:"
h_cookie="Set-Cookie:"
h_disposition="Content-Disposition:"
h_refresh="Refresh:"
h_link="Link:"
h_range="Content-Range:"
h_encoding="Transfer-Encoding: chunked"
cookie_attr="; Path=/"
cookie_attr2="; Secure"
cookie_attr3="; HttpOnly"
cookie_attr4="; Max-Age=0"
cookie_attr5="; Domain=.example.com"
cookie_attr6="; Expires=Wed, 21 Oct 2026 07:28:00 GMT"
charset_param="; charset=utf-8"
filename_param="; filename=\"f.zip\""
crlf="\x0d\x0a"

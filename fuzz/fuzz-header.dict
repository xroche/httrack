charset_param="; charset=utf-8"
filename_param="; filename=\"f.zip\""
crlf="\x0d\x0a"
h_connection="Connection:"
h_keepalive="Keep-Alive:"
h_te="TE:"
h_trailer="Trailer:"
h_trailers="trailers"
h_retry="Retry-After:"

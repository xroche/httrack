# URL shapes for the splitter and decoders.
scheme_http="http://"
scheme_https="https://"
scheme_ftp="ftp://"
scheme_file="file://"
userinfo="user:pass@"
ipv6="[2001:db8::1]"
port=":8080"
path_abs="/a/b.html"
path_rel="../up.html"
dotdot="../"
dot="./"
dslash="//"
query="?a=1&b=2"
fragment="#top"
pct_ok="%20"
pct_bad="%zz"
pct_hex="%2F"
plus="+"
backslash="\x5c"
xn="xn--caf-dma"
utf8="caf\xc3\xa9"
dot_host="example.com."

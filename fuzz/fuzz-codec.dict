# Magic numbers and framing of the Content-Encoding codings.
gzip_magic="\x1f\x8b\x08"
gzip_flags="\x1f\x8b\x08\x08\x00\x00\x00\x00\x00\x03"
zlib_default="\x78\x9c"
zlib_none="\x78\x01"
zlib_best="\x78\xda"
zlib_dict="\x78\xbb"
deflate_stored="\x01\x00\x00\xff\xff"
deflate_fixed="\x03\x00"
deflate_final_stored="\x01"
zstd_magic="\x28\xb5\x2f\xfd"
zstd_skippable="\x50\x2a\x4d\x18"
zstd_last_block="\x01\x00\x00"
br_empty="\x3b"
br_empty2="\x06"
# first byte of every input: low 2 bits pick the codec, bits 2-4 pick the cap
sel_deflate="\x00"
sel_br="\x01"
sel_zstd="\x02"
sel_unsupported="\x03"
sel_cap1="\x04"
sel_cap100="\x08"

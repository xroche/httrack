# Tokens of the robots.txt grammar (htsrobots.c).
k_ua="User-agent:"
k_dis="Disallow:"
k_allow="Allow:"
k_delay="Crawl-delay:"
k_map="Sitemap:"
star="*"
anchor="$"
slash="/"
path="/private/"
path2="/a*b"
path3="/*.pdf$"
agent_httrack="HTTrack"
agent_star="User-agent: *"
ws=" "
colon=":"
nl="\x0a"
comment="# comment"
url="http://fuzz.example/s.xml"
delay="5"

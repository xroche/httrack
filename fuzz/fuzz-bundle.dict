# Tokens of the HTTrack login-bundle format (htsbundle.c).
hdr="# HTTrack bundle 1"
hdr13="# HTTrack bundle 1.3"
bom="\xEF\xBB\xBF"
k_url="url "
k_ua="ua "
k_header="header "
k_scope="scope "
k_cookies="cookies"
scheme_https="https://"
scheme_http="http://"
authz="Authorization: Bearer "
hdr_xa="X-A: 1"
dom1=".alpha.test"
dom2="example.com"
dom3="127.0.0.1"
b_true="TRUE"
b_false="FALSE"
jar_line="\x09TRUE\x09/\x09FALSE\x090\x09"
pair="sid="
docookie="a=1; b=2"
comment="# a note"
unknown="unknown-key"
naked="nakedkey"
cookie_hdr="Cookies:"
dotdot=".."
enc="%2f"
dos="CON"
crlf="\x0d\x0a"

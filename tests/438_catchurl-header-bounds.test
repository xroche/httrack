#!/bin/bash
#
# The capture proxy must bind loopback, because the request it captures carries
# the browser's cookies. Its header block is unbounded input, and one over 32 KB
# aborted the process. #1561 stops one producer of an over-long path, so the
# wizard and basic-auth consumers of one are bounded here as well.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

selftest_queue "catchurl self-test OK (33 headers plus 11 bytes kept, 12 refused)" catchurl
selftest_queue "catchurl bind self-test OK (127.0.0.1, captured http://example.com/)" catchurl-bind
selftest_queue "catchurl over-long header self-test OK (9000 bytes refused: one request header line was over 8191 bytes)" catchurl-overlong
selftest_queue "urlbounds self-test OK (wizard 2025/2026, auth 2032/2033)" urlbounds
selftest_run_queued

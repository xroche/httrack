#!/bin/bash
#
# The capture proxy must bind loopback. Its header block is unbounded input, so
# a block over 32 KB must not abort it. The wizard and basic-auth consumers of
# an over-long path are bounded too, beyond the producer #1561 fixed.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

selftest_queue "catchurl self-test OK (33 headers plus 11 bytes kept, 12 refused)" catchurl
selftest_queue "catchurl bind self-test OK (127.0.0.1, both entry points)" catchurl-bind
selftest_queue "catchurl over-long header self-test OK (9000 bytes refused: one request header line was over 8191 bytes)" catchurl-overlong
selftest_queue "urlbounds self-test OK (wizard 2025/2026, auth 2025/2026)" urlbounds
selftest_run_queued

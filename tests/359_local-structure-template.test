#!/bin/bash
#
# --structure must accept a template as well as a numeric preset (#1380).

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

tmpbase=${TMPDIR:-/tmp}
# Slash-stripped: the engine normalizes a "//" away, failing every layout below.
tmp=$(mktemp -d "${tmpbase%/}/httrack_structure.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${tmp}"

# The engine maps what Windows forbids to '_' and the wsl2 shim turns /mnt/d/
# into D:/, so use the path it saw. Strip the leading slash last for nativepath.
localname() { # localname ABSOLUTE-PATH
    local n
    n=$(nativepath "$1" | tr ':~' '__')
    printf '%s' "${n#/}"
}

echo '<html><body>hello</body></html>' >"${tmp}/page.html"

run() { # run ARG...
    rm -rf "${tmp}/out"
    mkdir -p "${tmp}/out"
    RC=0
    httrack "file://${tmp}/page.html" -O "${tmp}/out" --quiet -n "$@" \
        >"${tmp}/out/.log" 2>&1 || RC=$?
}

# List what the crawl saved, minus engine files. A value lost to the URL list
# then shows up as a junk file next to the wanted one.
mirrored() {
    (cd "${tmp}/out" && find . -type f ! -path './hts-cache/*' ! -name '.log' \
        ! -name 'hts-log.txt' ! -name '*.gif' ! -name '*.lock' -print |
        grep -v '^\./index\.html$' | sort)
}

# Only the layout on disk tells whether -N applied: hts-cache/doit.log is the
# invocation rebuilt from argv, so it says the alias expanded and nothing more.
layout() { # layout RELATIVE-PATH ARG...
    local want=$1
    shift
    run "$@"
    assert_eq 0 "${RC}" "$* exited"
    assert_eq "./${want}" "$(mirrored)" "$* mirrored"
}

refused() { # refused WANTED-MESSAGE ARG...
    local want=$1
    shift
    run "$@"
    { test "${RC}" -ne 0 && test "${RC}" -ne 134; } || fail "$* not refused (exit ${RC})"
    grep -q "${want}" "${tmp}/out/.log" ||
        fail "$* refused without saying why: $(<"${tmp}/out/.log")"
}

# Test the presets in every spelling. 100 and 5 pin the whole value, because a
# truncated one gives the default layout.
default_layout="file/$(localname "${tmp}")/page.html"
layout web/page.html -N1
layout web/page.html --structure 1
layout web/page.html --structure=1
layout web/html/page.html -N5
layout web/html/page.html --structure=5
layout "$(localname "${tmp}")/page.html" --structure=100
layout "${default_layout}" --structure=0

# A detached -N 1 is preset 1, but a template "1" would collapse the mirror.
layout web/page.html -N 1

# A preset trailed by short options is refused, so 1L0 must not apply -L0.
# refused() also catches 1%c8 taken as a template, which exits 0.
refused 'does not take the value' --structure=1L0
refused 'does not take the value' --structure 1L0
refused 'does not take the value' --structure=1c8
refused 'does not take the value' --structure=1%c8
refused 'does not take the value' --structure=8I0

# param maps off to 0, and on to the bare short form, which for -N would read
# the next word as a template: both name the default preset here (#1434).
layout "${default_layout}" --structure=off
layout "${default_layout}" --structure=on
layout "${default_layout}" --structure on

# A template reaches the engine in every spelling. No preset makes "tpl/".
layout tpl/page.html -N tpl/%n.%t
layout tpl/page.html --structure tpl/%n.%t
layout tpl/page.html --structure=tpl/%n.%t
layout tpl/page.html --user-structure tpl/%n.%t

# A template may open with a digit, so the leading digits cannot decide alone.
layout 2col/page.html --structure 2col/%n.%t
layout 2col/page.html --structure=2col/%n.%t
layout 2col/page.html -N 2col/%n.%t

# The engine bounds a glued digit run. Past INT_MAX, sscanf("%d") crashes
# url_savename on LP64 and flattens the mirror on ILP32, which INT_MAX pins.
layout "${default_layout}" -N4294967295
layout "${default_layout}" -N99999999999999999999
layout "${default_layout}" -N2147483648
layout "${default_layout}" -N2147483647

# The alias table does see the long form, where such a run is neither a preset
# nor a template. -N <word> keeps taking its value verbatim.
refused 'does not take the value' --structure=4294967295
layout 4294967295 -N 4294967295

# A %-free value maps every URL onto one local name, so it is refused as a typo.
for word in OFF flat none default yes -1; do
    refused 'does not take the value' "--structure=${word}"
done
refused 'does not take the value' --structure none
# Control: an option whose class checks its value rejects the same word. --cache
# cannot be that control, because "param" glues any value into a cluster.
refused 'does not take the value' --index=OFF
# --user-structure is how to ask for such a name on purpose.
layout flat --user-structure flat
# 9 digits still glue, 10 do not. A nonsense preset names files from a hash of
# the URL, so only the file the template form would have written is stable.
run --structure=999999999
assert_eq 0 "${RC}" '--structure=999999999 exited'
test ! -e "${tmp}/out/999999999" ||
    fail '--structure=999999999 became a template: the digit bound is off by one'

# An empty value is -N "", which the engine reads as "back to the default".
layout "${default_layout}" --structure=
layout "${default_layout}" --user-structure ''

#!/bin/bash
#

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# The engine looks for hts-abort.lock at most every 250 ms rather than on every
# loop turn, and a clock stepping back does not stop it looking.

dir=$(mktemp -d)
cleanup_push rm -rf "$dir"

assert_selftest 'lockpoll self-test: OK' lockpoll "$dir"

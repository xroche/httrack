#!/bin/bash
#
# The linker ANDs the GNU property note across every input, so one object built
# without branch protection clears it for the whole image. Assert it in the
# artifact, the way 331 does for _FORTIFY_SOURCE.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# Unset means no automake run (the Windows job runs the scripts directly), so
# there is nothing configured to inspect.
[ -n "${abs_top_builddir:-}" ] || skip "abs_top_builddir unset, no automake environment"

readelf=${READELF:-readelf}
command -v "$readelf" >/dev/null 2>&1 || skip "no readelf ($readelf)"
# CC carries flags on some legs ("gcc -m32", "ccache gcc"), so split it.
read -r -a cc_argv <<<"${CC:-cc}"
command -v "${cc_argv[0]}" >/dev/null 2>&1 || skip "no C compiler (${cc_argv[0]})"

# The library holds the engine; a static build has none, so take the binary then.
subject=''
for f in "${HTTRACK_SHLIB:-}" "${HTTRACK_BIN:-}"; do
    if [ -n "$f" ] && [ -f "$f" ]; then
        subject=$f
        break
    fi
done
[ -n "$subject" ] || skip "no built binary to inspect"

# Catches Mach-O and every other non-ELF target at once: readelf declines them.
"$readelf" -hW "$subject" >/dev/null 2>&1 || skip "$(basename "$subject") is not an ELF object"
case $("$readelf" -hW "$subject" | awk -F: '/Machine:/ { print $2 }') in
*AArch64*) ;;
*) skip "not an aarch64 build, where -mbranch-protection=standard does nothing" ;;
esac

tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"

want='BTI PAC'

# Case-insensitive: llvm-readelf spells the line in lower case.
features() { # features FILE
    "$readelf" -nW "$1" 2>/dev/null |
        awk 'tolower($0) ~ /aarch64 feature:/ {
            sub(/^.*[Ff]eature:[ ]*/, "")
            gsub(/,/, "\n")
            gsub(/ /, "")
            print
        }' | sort -u || true
}

# Captured, not piped: grep -q would SIGPIPE the producer under pipefail.
has() { # has FILE FEATURE
    grep -qx "$2" <<<"$(features "$1")"
}

# Which of $want FILE does not advertise, space-separated, empty when none.
missing() { # missing FILE
    local w out=''
    for w in $want; do
        has "$1" "$w" || out="$out $w"
    done
    printf '%s' "${out# }"
}

# Non-leaf, so the flag has a call to sign as well as a landing pad to mark.
cat >"$tmp/probe.c" <<'PROBE'
static int callee(int x) { return x + 1; }
int main(void) { return callee(0); }
PROBE

# -Werror, so this accepts exactly what configure's own probe accepted.
build() { # build OUT FLAGS...
    local out=$1
    shift
    "${cc_argv[@]}" -Werror "$@" -o "$out" "$tmp/probe.c" >/dev/null 2>&1
}

# Three controls, because the assertion below is vacuous without all of them.
build "$tmp/asked.o" -c -mbranch-protection=standard ||
    skip "${CC:-cc} does not accept -mbranch-protection=standard"
gap=$(missing "$tmp/asked.o")
if [ -n "$gap" ]; then
    # A note present but unreadable is a broken probe, not a missing mitigation.
    sections=$("$readelf" -SW "$tmp/asked.o" 2>/dev/null || true)
    if grep -q 'note\.gnu\.property' <<<"$sections"; then
        fail "$readelf prints a property note this test cannot parse"
    fi
    skip "${CC:-cc} marks no $gap for -mbranch-protection=standard"
fi

# =none rather than the flag left out: some toolchains default it on.
build "$tmp/plain.o" -c -mbranch-protection=none ||
    skip "${CC:-cc} does not accept -mbranch-protection=none"
[ "$(missing "$tmp/plain.o")" = "$want" ] ||
    skip "the unprotected control already carries part of $want"

build "$tmp/asked.elf" -mbranch-protection=standard ||
    skip "cannot link a probe here"
gap=$(missing "$tmp/asked.elf")
[ -z "$gap" ] || skip "a link drops $gap here, so no build could keep it"

echo "$(basename "$subject"): AArch64 features: $(features "$subject" | tr '\n' ' ')"

gap=$(missing "$subject")
[ -z "$gap" ] || fail "$subject carries no $gap, so -mbranch-protection=standard did not reach it"

exit 0

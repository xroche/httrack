#!/bin/bash
#
# Assert pac-ret in the artifact, not the GNU property note: the linker ANDs
# that note across every input, and Ubuntu's aarch64 crt objects carry none, so
# it is absent there however the engine was built. The signing instructions are
# what survive, and they are what actually protects a return address.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# Unset means no automake run (the Windows job runs the scripts directly), so
# there is nothing configured to inspect.
[ -n "${abs_top_builddir:-}" ] || skip "abs_top_builddir unset, no automake environment"

readelf=${READELF:-readelf}
objdump=${OBJDUMP:-objdump}
command -v "$readelf" >/dev/null 2>&1 || skip "no readelf ($readelf)"
command -v "$objdump" >/dev/null 2>&1 || skip "no objdump ($objdump)"
# CC carries flags on some legs ("gcc -m32", "ccache gcc"), so split it.
read -r -a cc_argv <<<"${CC:-cc}"
command -v "${cc_argv[0]}" >/dev/null 2>&1 || skip "no C compiler (${cc_argv[0]})"

# The library holds the engine; a static build has none, so take the binary then.
subject=''
for f in "${HTTRACK_SHLIB:-}" "${HTTRACK_BIN:-}"; do
    if [ -n "$f" ] && [ -f "$f" ]; then
        subject=$f
        break
    fi
done
[ -n "$subject" ] || skip "no built binary to inspect"

# Catches Mach-O and every other non-ELF target at once: readelf declines them.
"$readelf" -hW "$subject" >/dev/null 2>&1 || skip "$(basename "$subject") is not an ELF object"
case $("$readelf" -hW "$subject" | awk -F: '/Machine:/ { print $2 }') in
*AArch64*) ;;
*) skip "not an aarch64 build, where -mbranch-protection=standard does nothing" ;;
esac

tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"

# grep -c exits 1 on no match, which would end the whole run under errexit.
signed() { # signed FILE -- how many functions sign their return address
    "$objdump" -d "$1" 2>/dev/null | grep -c paciasp || true
}

# Non-leaf and not inlinable, so pac-ret has a return address to sign: a leaf
# gets no paciasp however the flag is spelled.
cat >"$tmp/probe.c" <<'PROBE'
int callee(int x);
int caller(int x) { return callee(x) + 1; }
PROBE

# -Werror, so this accepts exactly what configure's own probe accepted.
build() { # build OUT FLAGS...
    local out=$1
    shift
    "${cc_argv[@]}" -Werror "$@" -c -o "$out" "$tmp/probe.c" >/dev/null 2>&1
}

# Two controls, because the assertion below is vacuous without both.
build "$tmp/asked.o" -mbranch-protection=standard ||
    skip "${CC:-cc} does not accept -mbranch-protection=standard"
[ "$(signed "$tmp/asked.o")" -gt 0 ] ||
    skip "$objdump shows no paciasp for -mbranch-protection=standard here"

# =none rather than the flag left out: some toolchains default it on.
build "$tmp/plain.o" -mbranch-protection=none ||
    skip "${CC:-cc} does not accept -mbranch-protection=none"
[ "$(signed "$tmp/plain.o")" -eq 0 ] ||
    skip "the unprotected control signs too, so paciasp cannot discriminate"

# The note says whether the loader also enforces BTI, which the crt objects
# decide rather than we do, so report it and assert only what we control.
echo "$(basename "$subject"): $(signed "$subject") signed function(s), property note:" \
    "$("$readelf" -nW "$subject" 2>/dev/null | sed -n 's/.*[Ff]eature: *//p' | head -1)"

[ "$(signed "$subject")" -gt 0 ] ||
    fail "$subject signs no return address, so -mbranch-protection=standard did not reach it"

exit 0

#!/bin/bash
#
# hts_buf sizes (-#test=buf), and HTS_BUF / HTS_BUF_MIN refusing at compile
# time a pointer or an array smaller than the minimum.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

assert_selftest "buf: OK" buf

err=$(httrack -O /dev/null "-#test=buf" tail-overrun 2>&1 >/dev/null) && fail "a tail with no byte left did not abort"
grep -q "off < b.size" <<<"$err" || fail "a tail with no byte left failed another way: $err"

top=$(cd "$top_srcdir" && pwd)
# htsfeatures.h is generated, so a hand run outside make check has none.
[ -n "${abs_top_builddir:-}" ] || skip "abs_top_builddir unset, no automake environment"
read -r -a cc <<<"${CC:-cc}"
command -v "${cc[0]}" >/dev/null 2>&1 || skip "no C compiler"
cc+=(-I"$abs_top_builddir" -I"$top/src")
tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"

cat >"$tmp/probe.c" <<'PROBE'
#include "htsbuf.h"
struct s {
  char f[48];
};
int main(void) {
  char a[64];
  struct s st;
  char *ptr = a;
  char *const cptr = a;
  hts_buf b = HTS_BUF(a);
  (void) ptr;
  (void) cptr;
  (void) st;
#ifdef NEG
  b = NEG;
#endif
  return b.size == 64 && HTS_BUF_MIN(a, 64).size == 64 &&
                 HTS_BUF(st.f).size == 48 && HTS_BUF_MIN(st.f, 1).size == 48
             ? 0
             : 1;
}
PROBE

"${cc[@]}" -o "$tmp/probe" "$tmp/probe.c" 2>"$tmp/pos.err" || fail_dump "an array does not compile" "$tmp/pos.err"
"$tmp/probe" || fail "HTS_BUF gave the wrong size"

# Only the guards' char[-1] says "negative", so any other compile error fails.
for neg in 'HTS_BUF(ptr)' 'HTS_BUF(cptr)' 'HTS_BUF_MIN(ptr, 1)' 'HTS_BUF_MIN(a, 65)' \
    'HTS_BUF_MIN(st.f, 49)'; do
    if "${cc[@]}" -fsyntax-only "-DNEG=$neg" "$tmp/probe.c" 2>"$tmp/neg.err"; then
        fail "$neg compiles"
    fi
    grep -q 'negative' "$tmp/neg.err" || fail_dump "$neg fails for another reason" "$tmp/neg.err"
done
echo "OK: hts_buf sizes hold, and a pointer or a short array does not compile"

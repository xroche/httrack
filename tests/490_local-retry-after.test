#!/bin/bash
#
# Which status codes earn a retry, and whether the Retry-After delay is obeyed
# and capped (#1738). Graded on the requests the server actually received, so a
# retry that never leaves the engine cannot pass.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

python=$(find_python) || skip "python3 missing"

server=$(nativepath "$top_srcdir/tests/retry-after-server.py")
tmpdir=$(mktemp -d)
serverpid=
log=$tmpdir/crawl.log
fail_dump_var log

cleanup() {
    stop_server "$serverpid"
    rm -rf "$tmpdir"
}
cleanup_push cleanup

"$python" "$server" >"$tmpdir/srv.out" 2>"$tmpdir/srv.err" &
serverpid=$!
port=$(discover_server_port "$tmpdir/srv.out" "$serverpid") || exit 1

retries=2
crawl() { # crawl NAME [extra httrack args...]
    local name=$1 rc=0
    shift
    mkdir -p "$tmpdir/$name"
    run_with_timeout 120 httrack "http://127.0.0.1:$port/index.html" \
        -O "$tmpdir/$name" -c1 --robots=0 --retries="$retries" -%v0 -q "$@" \
        >>"$log" 2>&1 || rc=$?
    test "$rc" -ne 124 || fail "$name: crawl hit the deadline"
    test "$rc" -le 128 || fail "$name: crawl ended abnormally ($rc)"
}

hits() { # hits PATH -- requests the server logged for it
    local n
    n=$(command grep -c "^HIT /$1\$" "$tmpdir/srv.out" || true)
    echo "$n"
}

assert_hits() { # assert_hits CASE EXPECTED WHY
    local got
    got=$(hits "$1.html")
    test "$got" -eq "$2" ||
        fail_dump "$1: $got request(s), expected $2 ($3)" "$tmpdir/srv.out"
}

# --max-retry-after=1 keeps the run short; the wait itself is timed below.
t0=$(date +%s)
crawl retried --max-retry-after=1
retried_seconds=$(($(date +%s) - t0))

# retried: 1 try + $retries. 429 whether or not the server named a delay,
# and 503 only when it did.
want=$((retries + 1))
assert_hits rate "$want" "429 must be retried"
assert_hits rate-nodelay "$want" "429 with no Retry-After must still be retried"
assert_hits busy "$want" "503 with Retry-After must be retried"
assert_hits datefmt "$want" "Retry-After as an HTTP-date must be retried"
assert_hits boom "$want" "500 must still be retried"
# not retried: a 503 naming no delay is as likely a host that is down for good
assert_hits down 1 "503 with no Retry-After must not be retried"
assert_hits ok 1 "a 200 is fetched once"

# The cap decides the wait, not the server. /huge asks for 100000s; the crawl
# above finished at all, which it could not have done without the clip.
grep -qF "Server asked to retry after 100000s, waiting 1s" \
    "$tmpdir/retried/hts-log.txt" ||
    fail_dump "no clip logged for the 100000s Retry-After" \
        "$tmpdir/retried/hts-log.txt"

# rate, busy and huge each wait 1s on both of their $retries, and -c1 keeps
# those waits from overlapping. datefmt rounds to 0 or 1 and is left out, so
# this stays a floor whatever the box does.
floor=$((3 * 2 * 1))
echo "capped crawl: ${retried_seconds}s (floor ${floor}s)"
test "$retried_seconds" -ge "$floor" ||
    fail "the crawl obeyed no Retry-After: ${retried_seconds}s, expected ${floor}s or more"

# And the wait is the cap's to waive: --max-retry-after=0 makes the same
# requests without any of it.
requests() { command grep -c '^HIT ' "$tmpdir/srv.out" || true; }
capped_requests=$(requests)
t0=$(date +%s)
crawl nowait --max-retry-after=0
nowait_seconds=$(($(date +%s) - t0))
nowait_requests=$(($(requests) - capped_requests))

echo "no-wait crawl: ${nowait_seconds}s, ${nowait_requests} requests"
# The cap moves the timing, never the retry count.
test "$nowait_requests" -eq "$capped_requests" ||
    fail_dump "--max-retry-after=0 made $nowait_requests requests, $capped_requests with the wait" \
        "$tmpdir/srv.out"
test "$nowait_seconds" -lt "$floor" ||
    skip "the no-wait crawl took ${nowait_seconds}s: this box is too slow to show the wait"

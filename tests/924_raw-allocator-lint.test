#!/bin/bash
#
# Engine sources must allocate through the htssafe.h wrappers, not raw libc.
# punycode.c is vendored, and the libc stubs in htslib.c carry a
# `libc on purpose` tag.
# Reads the tracked source, so it is named outside the Windows CI globs.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top="${abs_top_srcdir:-}"
test -n "$top" || fail "not run under make check"

raw() { # raw FILE -> the untagged lines calling a raw libc allocator
    LC_ALL=C grep -nE '(^|[^[:alnum:]_.>])(malloc|calloc|realloc|free|strdup)[[:space:]]*\(' "$1" |
        LC_ALL=C grep -v '/\* libc on purpose \*/' || true
}

# Control: the scan must fire on a raw call and stay quiet on a wrapped one.
work=$(mktemp -d "${TMPDIR:-/tmp}/charsetalloc.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "$work"
printf 'void f(void) {\n  free(p);\n}\n' >"$work/dirty.c"
test -n "$(raw "$work/dirty.c")" || fail "the scan cannot see a raw free"
printf 'void f(void) {\n  freet(p);\n  q = strdupt(s);\n}\n' >"$work/clean.c"
test -z "$(raw "$work/clean.c")" || fail "the scan flags a wrapped call"

printf 'void f(void) {\n  t->free(p);\n  t.free(p);\n}\n' >"$work/member.c"
test -z "$(raw "$work/member.c")" || fail "the scan flags a member call"

# A tagged call is allowed, an untagged one in the same file is not.
printf 'void f(void) {\n  free(p); /* libc on purpose */\n  free(q);\n}\n' >"$work/tag.c"
test "$(raw "$work/tag.c" | wc -l)" = 1 || fail "the libc tag hides an untagged call"

checked=0
for src in "$top"/src/*.c "$top"/src/proxy/*.c "$top"/src/proxy/*.h; do
    test -r "$src" || skip "sources not shipped"
    case "$src" in
    */punycode.c) continue ;;
    esac
    found=$(raw "$src")
    test -z "$found" || fail "raw allocator calls in $src: $found"
    checked=$((checked + 1))
done
# Floor: a mangled glob must not pass by scanning nothing.
test "$checked" -ge 85 || fail "only $checked files scanned"
echo "no raw allocator call in $checked engine and proxy files"

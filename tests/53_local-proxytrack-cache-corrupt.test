#!/bin/bash
# A corrupt proxytrack .ndx must not overflow the fixed cache-read buffers. The
# sanitizer CI build turns any regression here into a hard stack/heap overflow.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

dir=$(mktemp -d)
cleanup_push rm -rf "$dir"

# cache_brstr must clamp a field longer than firstline[256] to its size.
{
    printf '4000\n'
    head -c 4000 /dev/zero | tr '\0' 'A'
} >"$dir/foo.ndx"
: >"$dir/foo.dat" # cache_brstr runs only when the sibling .dat opens

proxytrack --convert "$dir/out.arc" "$dir/foo.ndx" >/dev/null 2>&1 || fail "proxytrack crashed/errored on a corrupt cache index"

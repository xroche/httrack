#!/bin/bash
#
# code64() against the RFC 4648 vectors, with and without its CRLF breaks.
set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

times() { printf "$2%.0s" $(seq 1 "$1"); }

selftest_queue "" base64 ""
selftest_queue "Zg==" base64 f
selftest_queue "Zm8=" base64 fo
selftest_queue "Zm9v" base64 foo
selftest_queue "Zm9vYg==" base64 foob
selftest_queue "Zm9vYmE=" base64 fooba
selftest_queue "Zm9vYmFy" base64 foobar
selftest_queue "AA==" base64 hex:00
selftest_queue "+/8=" base64 hex:fbff
selftest_queue "////" base64 hex:ffffff
# RFC 2045: a CRLF after every 76 characters (57 input bytes), none before
selftest_queue "$(times 18 YWJj)" base64 abc 18 1
selftest_queue "$(times 19 YWJj)\\r\\n" base64 abc 19 1
selftest_queue "$(times 19 YWJj)\\r\\nYWJj" base64 abc 20 1
selftest_queue "$(times 19 YWJj)\\r\\n$(times 19 YWJj)\\r\\n" base64 abc 38 1
selftest_queue "$(times 21 YWJj)" base64 abc 21 0
selftest_queue "$(times 19 YWFh)\\r\\nYQ==" base64 a 58 1
# an output of exactly the encoding plus its NUL is enough
selftest_queue "Zg==" base64 f 1 0 5
selftest_queue "$(times 19 YWJj)\\r\\n" base64 abc 19 1 79

selftest_run_queued

# one byte short must abort before writing
short() {
    local err
    err=$(httrack -O /dev/null "-#test=base64" "$@" 2>&1) || true
    case "$err" in
    *"< out.size failed"*) ;;
    *) fail "base64 $*: expected the code64 size abort, got: $err" ;;
    esac
}
short f 1 0 4
short abc 19 1 78

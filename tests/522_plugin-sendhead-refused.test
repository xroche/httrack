#!/bin/bash
#
# htsdefines.h promises a sendhead hook returning anything but 1 fails the
# transfer. http_sendhead() closed the socket and sent the request down it
# anyway, so the user got a generic transport error, and over HTTPS SSL_write()
# got a freed handle.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

: "${top_srcdir:=..}"

[ -n "${SENDHEADREFUSE_LIB:-}" ] || skip "SENDHEADREFUSE_LIB unset, no automake environment"
[ -r "${SENDHEADREFUSE_LIB}" ] || skip "nothing built at ${SENDHEADREFUSE_LIB}"

# One seed and no robots fetch, so the refused request is the only error. The
# hook's own reason must survive with STATUSCODE_CONNERROR (-4) beside it; the
# pre-loop relabels an unfinished slot "Unexpected socket error" and loses both.
bash "$top_srcdir/tests/local-crawl.sh" --errors 1 \
    --stdout-found 'sendheadrefuse: refusing' \
    --log-found '"Header refused by external wrapper" \(-4\)' \
    --log-not-found 'Unexpected socket error' \
    httrack 'BASEURL/simple/basic.html' --wrapper "${SENDHEADREFUSE_LIB}"

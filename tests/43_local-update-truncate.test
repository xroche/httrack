#!/bin/bash
#
# -M hard-abort must not destroy already-complete files (#77 follow-up).
# Pass 1 mirrors bigtrunc fully. In pass 2 under --update -M, fast.bin overruns
# the cap and its abort tears down slow.bin's stalled re-fetch. Both files must
# survive: slow.bin's previous copy is restored, and fast.bin is not
# overwritten with an empty body.

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" \
    --rerun-args '--update -M400000' \
    --log-found 'More than 400000 bytes have been transferred.. giving up' \
    --log-not-found 'could not restore' \
    --found bigtrunc/slow.bin \
    --file-min-bytes bigtrunc/slow.bin 655360 \
    --file-min-bytes bigtrunc/fast.bin 655360 \
    httrack 'BASEURL/bigtrunc/index.html' -c2

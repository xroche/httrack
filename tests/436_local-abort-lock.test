#!/bin/bash
# Windows has no cross-process SIGTERM, so a running engine takes a stop request
# as a file: hts-abort.lock in the output directory, beside the hts-stop.lock
# that asks for a pause. It acts on one only when the request is newer than the
# run's own hts-in_progress.lock and it could also delete it.
set -eu

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

# The C side has HTS_ABORT_LOCKNAME for these two.
ABORTLOCK=hts-abort.lock
PROGRESSLOCK=hts-in_progress.lock

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_abortlock.XXXXXX") || exit 1
crawlpid=
cleanup() {
    if test -n "$crawlpid"; then kill -9 "$crawlpid" 2>/dev/null || true; fi
    rm -rf "$tmpdir"
}
cleanup_push cleanup

stop_crawl() {
    if test -n "$crawlpid"; then
        kill -9 "$crawlpid" 2>/dev/null || true
        wait "$crawlpid" 2>/dev/null || true
        crawlpid=
    fi
}

require_httrack

assert_lockrule_selftest abortlock

local_server_start --env LOCAL_SERVER_VERBOSE=1
common=(--quiet --disable-security-limits --robots=0 --timeout=30 --retries=0 -c1)
# The crawl log only ever says "Mirror not completed (see log file)", so the
# engine log it names is dumped beside it (#1680).
fail_dump_var crawllog enginelog
arm_paths() { # arm_paths NAME: leaves the paths in $out, $crawllog, $enginelog
    out="${tmpdir}/$1"
    crawllog="${tmpdir}/log-$1"
    # shellcheck disable=SC2034 # read by fail_dump_var above, by name
    enginelog="${out}/hts-log.txt"
}

# The engine creates the page file when its transfer starts. The progress lock
# appears earlier, while nothing is transferring yet.
trickle_started() { # trickle_started DIR
    test -n "$(find "$1" -path '*/trickle/p*.bin' 2>/dev/null)"
}

# /trickle/ hands out eight .bin pages, two bytes a second for a minute each, so
# the single socket is busy and only the reading inside that wait can see this.
printf '[a running engine takes the request] ..\t'
arm_paths running
httrack -O "$out" "${common[@]}" "${BASEURL}/trickle/index.html" \
    >"$crawllog" 2>&1 &
crawlpid=$!
wait_until_still_running "test -e '${out}/${PROGRESSLOCK}'" "the crawl never got going" "$crawlpid"
# The engine dates that lock a second back, so a request written the instant it
# appears is newer than it whatever resolution the filesystem keeps.
: >"${tmpdir}/probe"
test "$(mtime "${tmpdir}/probe")" -gt "$(mtime "${out}/${PROGRESSLOCK}")" ||
    fail "the engine did not date ${PROGRESSLOCK} back, so a request written the moment it appears can tie it"
wait_until_still_running "trickle_started '$out'" "the crawl opened no trickle page" \
    "$crawlpid"
write_lock_request "$out" "$ABORTLOCK" "$crawlpid"
wait_until_still_running "test ! -e '${out}/${ABORTLOCK}'" \
    "30s on, a running engine had not read the request" "$crawlpid"
stop_crawl
echo "OK"

# An abort keeps hts-cache/ref and the interactive stop erases it. Both log the
# same line, so only the directory tells them apart.
printf '[an abort keeps the cut transfers] ..\t'
arm_paths keep
httrack -O "$out" "${common[@]}" --max-rate=200000 \
    "${BASEURL}/bigfiles/index.html" >"$crawllog" 2>&1 &
crawlpid=$!
wait_until_still_running "test -e '${out}/${PROGRESSLOCK}'" "the crawl never got going" "$crawlpid"
# The abort has to find a transfer already running, or there is no resume data
# for it to keep.
sleep 1
write_lock_request "$out" "$ABORTLOCK" "$crawlpid"
wait_until_still_running "test ! -e '${out}/${ABORTLOCK}'" \
    "30s on, a running engine had not read the request" "$crawlpid"
# The erase happens at shutdown, and unwinding the cut transfer takes a while.
wait_until "! kill -0 '$crawlpid' 2>/dev/null" "the engine never shut down" 900
wait "$crawlpid" 2>/dev/null || true
crawlpid=
test -n "$(find "${out}/hts-cache/ref" -name '*.ref' 2>/dev/null)" ||
    fail "the abort erased hts-cache/ref, so the cut transfers cannot resume"
echo "OK"

# Each 640 KB file takes over 3s at 200 KB/s on one socket, and the abort is
# written about 1s in, so p0 is cut and p1 at most begun. An engine that waits
# for every link's type downloads them all first.
printf '[an abort stops before the next links] ..	'
bigdir=$(find "$out" -type d -name bigfiles)
test -n "$bigdir" || fail "the abort left no bigfiles directory"
complete=0
for f in "$bigdir"/* "$bigdir"/.[!.]*; do
    test -e "$f" || continue
    case ${f##*/} in
    index.html) ;;
    p0.bin | p1.bin)
        test "$(wc -c <"$f")" -lt 655360 || complete=$((complete + 1))
        ;;
    *) fail "the abort let the crawl go on: ${f##*/} is in the mirror" ;;
    esac
done
test "$complete" -le 1 || fail "the abort let ${complete} files finish"
leftover=$(find "$out" -name '*.tmp' -o -name '*.delayed')
test -z "$leftover" || fail "the abort left temporary files: ${leftover}"
echo "OK"

# The links the abort left online are what --continue fetches.
printf '[a --continue after the abort finishes the mirror] ..	'
local_crawl --log "$crawllog" -O "$out" "${common[@]}" --continue \
    "${BASEURL}/bigfiles/index.html" || fail "the --continue crawl failed"
for i in 0 1 2 3 4 5 6 7; do
    test -f "${bigdir}/p${i}.bin" || fail "the --continue did not fetch p${i}.bin"
    test "$(wc -c <"${bigdir}/p${i}.bin")" -eq 655360 ||
        fail "the --continue left p${i}.bin at $(wc -c <"${bigdir}/p${i}.bin") bytes"
done
page=$(<"${bigdir}/index.html")
for i in 0 1 2 3 4 5 6 7; do
    case $page in
    *"href=\"p${i}.bin\""*) ;;
    *) fail_dump "the page does not link the local p${i}.bin" "${bigdir}/index.html" ;;
    esac
done
case $page in
*"${BASEURL}/bigfiles/p"*) fail_dump "the page still links the server" "${bigdir}/index.html" ;;
esac
echo "OK"

# Each /slowhead/ reply takes 1s, so an engine that polls only between links
# probes all eight. A request sent before p0's probe is taken by another path.
printf '[an abort stops the -%%N0 type probe] ..\t'
arm_paths probe
httrack -O "$out" "${common[@]}" -%N0 "${BASEURL}/slowhead/index.html" \
    >"$crawllog" 2>&1 &
crawlpid=$!
wait_until_still_running \
    "test \"\$(count_matching_lines 'HEAD /slowhead/p0' \"\$SRV_LOG\")\" -ge 1" \
    "the crawl never probed p0.bin" "$crawlpid"
# The clock starts after the write, because drvfs retries can take 3s (#1639).
write_lock_request "$out" "$ABORTLOCK" "$crawlpid"
started=$SECONDS
rc=0
wait_bounded "$crawlpid" 60 || rc=$?
crawlpid=
test "$rc" -ne 124 || fail "the crawl was still probing 60s after the request"
elapsed=$((SECONDS - started))
test "$elapsed" -lt 4 || fail "the abort took ${elapsed}s to stop the type probe"
probed=$(count_matching_lines 'HEAD /slowhead/p' "$SRV_LOG")
test "$probed" -le 2 || fail "the crawl probed ${probed} links after the abort"
echo "OK (${elapsed}s)"

# The pause wait watches for it too, or a paused engine is unreachable.
printf '[a paused engine takes the request] ..\t'
arm_paths paused
httrack -O "$out" "${common[@]}" --max-rate=200000 \
    "${BASEURL}/bigfiles/index.html" >"$crawllog" 2>&1 &
crawlpid=$!
wait_until_still_running "test -e '${out}/${PROGRESSLOCK}'" "the crawl never got going" "$crawlpid"
write_lock_request "$out" hts-stop.lock "$crawlpid"
wait_until_still_running "test -e '${out}/hts-paused.lock'" "the engine never paused" "$crawlpid"
# A frozen mirror writes nothing, and the wait re-reads once a second, so three
# seconds cover an iteration that saw the file and a resumed 200KB/s transfer.
frozen=$(du -sk "$out")
touch -t 200001010000 "${out}/${ABORTLOCK}"
sleep 3
test "$(du -sk "$out")" = "$frozen" ||
    fail "a request left by an earlier run lifted the pause"
test -e "${out}/${ABORTLOCK}" ||
    fail "the pause wait deleted a request that was never aimed at it"
write_lock_request "$out" "$ABORTLOCK" "$crawlpid"
wait_until_still_running "test ! -e '${out}/${ABORTLOCK}'" \
    "30s on, a paused engine had not read the request" "$crawlpid"
stop_crawl
echo "OK"

# The lock is written aside and moved onto its real name, so it is dated back
# before anything can read it. A directory in the way makes that move fail, and
# the engine has to say so rather than run on with no lock at all.
printf '[a lock the engine cannot create is named] ..\t'
arm_paths blocked
mkdir -p "${out}/${PROGRESSLOCK}"
local_crawl --log "$crawllog" -O "$out" "${common[@]}" \
    "${BASEURL}/simple/basic.html" || fail "the mirror failed outright"
grep -q 'could not create hts-in_progress.lock' "$enginelog" ||
    fail_dump "the engine did not report the lock it could not create" "$enginelog"
test ! -e "${out}/hts-in_progress.tmp" ||
    fail "the engine left the lock it staged behind"
echo "OK"

# A request older than the mirror that finds it was aimed at an earlier run.
# Dated back, because the engine backdates its own progress lock by a second. A
# file written just before the mirror starts lands inside that second.
printf '[a request left behind does not stop the next mirror] ..\t'
arm_paths stale
mkdir -p "$out"
touch -t 200001010000 "${out}/${ABORTLOCK}"
local_crawl --log "$crawllog" -O "$out" "${common[@]}" \
    "${BASEURL}/simple/basic.html" || fail "the mirror failed outright"
test -n "$(find "$out" -name 'basic.html' 2>/dev/null)" ||
    fail "the mirror saved nothing, so the request it inherited stopped it"
test -e "${out}/${ABORTLOCK}" ||
    fail "the mirror deleted a request that was never aimed at it"
echo "OK"

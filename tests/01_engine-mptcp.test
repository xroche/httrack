#!/bin/bash
#

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

require_httrack
# Gated on the feature alone, since macOS connects a multipath socket but cannot
# see a fallback. Only this test reaches connectx(). 'run' is ignored.
have_feature mptcp || skip "no Multipath TCP on this system"
assert_selftest "mptcp: OK" mptcp run

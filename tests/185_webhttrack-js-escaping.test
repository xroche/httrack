#!/bin/bash
#
# A tooltip reaches the browser as a JS literal inside an HTML attribute, so a
# translation holding ' " \ & or < must survive both decoders intact.

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
distdir=${top_srcdir:-$(cd "${testdir}/.." && pwd)}
distdir=$(cd "${distdir}" && pwd)
# shellcheck source=tests/testlib.sh
. "${testdir}/testlib.sh"

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

command -v htsserver >/dev/null || fail "no htsserver in PATH"
python=$(find_python) || {
    echo "python3 not found; skipping" >&2
    exit 77
}

printf '[each template puts js: in handlers and html: in text] ..\t'
"${python}" - "${distdir}" <<'PY' || fail "the templates mix the two escaping modes (see above)"
import glob, os, re, sys

# A handler value is JS, everything else is HTML text: the two never swap.
handler = re.compile(r'\bon[A-Za-z]+="([^"]*)"')
subst = re.compile(r"\$\{([^}]*)\}")
# Directives expand to markup the template itself wrote, not to a value.
directive = re.compile(r"/\*|^(do|test|ztest|checked|list|liststr|listid|fexist"
                       r"|file-exists|arg|unquoted):")
# Shipped translations and build-time constants; everything else is runtime data.
constant = re.compile(r"^(LANG_|LANGUAGE_|HTTRACK_|HTS_PLATFORM)")

files = sorted(glob.glob(os.path.join(sys.argv[1], "html", "server", "*.html")))
if len(files) < 20:
    sys.exit("only %d server templates found" % len(files))

bad, in_handler, in_text, in_body = [], {}, 0, 0
for path in files:
    name = os.path.basename(path)
    text = open(path, encoding="latin-1").read()
    spans = [m.span(1) for m in handler.finditer(text)]
    # An attribute value is a third position: only js: escapes the double quote
    # that ends one, so those are left out rather than checked against html:.
    def in_tag(pos):
        return text.rfind("<", 0, pos) > text.rfind(">", 0, pos)
    # ${do:output-mode:X} escapes every bare value until the next end-if clears
    # it, which is how a <pre> or <textarea> keeps its newlines (src/htsserver.c).
    mode = 0
    for m in subst.finditer(text):
        key = m.group(1)
        if key.startswith("do:output-mode:"):
            mode = key[len("do:output-mode:"):] != ""
        elif key.startswith("do:end-if"):
            mode = 0
        if directive.match(key):
            continue
        if any(a <= m.start() and m.end() <= b for a, b in spans):
            in_handler[name] = in_handler.get(name, 0) + 1
            # Only js: escapes the quotes and backslashes a JS literal ends on;
            # ${LANG_x} and ${html:LANG_x} both reach the JS parser as HTML text.
            if not key.startswith("js:"):
                bad.append("%s: handler interpolates ${%s}" % (name, key))
        elif key.startswith("js:"):
            bad.append("%s: HTML text interpolates ${%s}" % (name, key))
        elif key.startswith("html:"):
            in_text += 1
        elif in_tag(m.start()):
            pass
        elif not constant.match(key) and not mode:
            bad.append("%s: element body interpolates ${%s} unescaped" % (name, key))
        else:
            in_body += 1
if bad:
    sys.exit("\n".join(bad))
# No leg may go vacuous; step2.html is named because it is the one the
# ${html:html:} spelling hid in.
if (sum(in_handler.values()) < 300 or in_text < 100 or in_body < 350
        or in_handler.get("step2.html", 0) < 8):
    sys.exit("scanned too little: %d handler (%d in step2.html), %d text, %d body"
             % (sum(in_handler.values()), in_handler.get("step2.html", 0), in_text,
                in_body))
PY
echo OK

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_jsesc.XXXXXX") || fail "no tmpdir"
srvlog=$(mktemp)
srv=
srvpid=
cleanup() {
    # htsserver keeps SIGTERM ignored across its exec, so only -9 reaps it.
    test -z "${srvpid}" || kill -9 "${srvpid}" 2>/dev/null || true
    test -z "${srv}" || kill -9 "${srv}" 2>/dev/null || true
    wait "${srv}" 2>/dev/null || true # absorb bash's async "Killed" notice
    rm -rf "${work}" "${srvlog}"
}
trap 'set +e; cleanup' EXIT
trap cleanup HUP INT QUIT PIPE TERM

# A private data root, so LANGUAGE_2 can carry the hostile strings. distcheck's
# srcdir is read-only and cp keeps that mode.
root="${work}/root"
mkdir -p "${root}"
cp -R "${distdir}/html" "${distdir}/lang" "${distdir}/lang.def" "${root}/"
chmod -R u+w "${root}"
# CRLF line pairs, English key then translation; \\ \n \t are read back as one
# backslash, a newline and a tab, and \203 is a raw shift-jis lead byte.
# Anything left undefined falls back to English.
printf '%s\r\n' \
    LANGUAGE_NAME 'Francais-864' \
    LANGUAGE_FILE 'Francais' \
    LANGUAGE_ISO 'fr' \
    LANGUAGE_CHARSET 'iso-8859-1' \
    'Click to get help!' "Cliquez pour avoir de l'aide!" \
    'Click to confirm' 'Guillemet " et </script> ici' \
    'Cancel changes' 'Antislash \\ et & ici' \
    'Follow external links' 'Deux\nlignes\tici' \
    'Test all links in pages' "$(printf 'Lead \203\\\\ fin')" \
    >"${root}/lang/Francais.txt"

printf '[a French tooltip survives the two decoders] ..\t'
sport=$("${python}" -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()')
(
    trap '' TERM TTOU
    # An isolated HOME keeps a stray ~/.httrack.ini out of the served settings.
    export HOME="${work}"
    exec htsserver "${root}/" --port "${sport}" >"${srvlog}" 2>&1
) &
srv=$!
for _ in $(seq 1 40); do
    url=$(sed -n 's/^URL=//p' "${srvlog}") && test -n "${url}" && break
    kill -0 "${srv}" 2>/dev/null || break
    sleep 0.25
done
test -n "${url:-}" || fail "htsserver did not start: $(cat "${srvlog}")"
srvpid=$(sed -n 's/^PID=//p' "${srvlog}") # absent on Windows

"${python}" - "${url}" <<'PY' || fail "tooltips are not JS-escaped (see above)"
import re, sys, urllib.request

url = sys.argv[1].rstrip("/")
form = urllib.request.urlopen(url + "/server/index.html", timeout=20).read()
m = re.search(rb'name="sid" value="([0-9a-f]+)"', form)
if not m:
    sys.exit("no session id in server/index.html")
sid = m.group(1).decode()


def render(page):
    # lang=2 selects LANGUAGE_2 and renders in one shot.
    req = urllib.request.Request(url + "/server/" + page,
                                 data=("sid=%s&lang=2" % sid).encode("latin-1"),
                                 method="POST")
    resp = urllib.request.urlopen(req, timeout=20)
    if resp.status != 200:
        sys.exit("%s answered %d" % (page, resp.status))
    body = resp.read().decode("latin-1")
    if 'lang="fr"' not in body:
        sys.exit("%s did not switch to LANGUAGE_2:\n%s" % (page, body[:2000]))
    return body


def handler(js):
    return "onMouseOver=\"info('%s'); return true\"" % js


help_tip = handler(r"Cliquez pour avoir de l\x27aide!")
pages = [
    ("option1.html", [
        # an apostrophe closes the JS literal
        help_tip,
        # a quote closes the attribute, < opens </script>, and a surviving &
        # would let the attribute decode rebuild either one
        handler(r"Guillemet \x22 et \x3c/script\x3e ici"),
        # a lone backslash would eat the next character as an escape
        handler(r"Antislash \x5c et \x26 ici"),
        # a raw newline or tab is not legal inside a JS literal
        handler(r"Deux\x0alignes\x09ici"),
        # shift-jis, BIG5 and GBK trail bytes cover 0x5c, so a \\ pair after an
        # orphan lead byte decodes to one glyph plus a stray backslash that
        # escapes the closing quote; \x5c leaves the decoder nothing to pair
        handler("Lead \x83" + r"\x5c fin"),
        # the title attribute is HTML text and stays on the html: mode
        "title='Cliquez pour avoir de l&#39;aide!'",
        "title='Guillemet \" et &lt;/script&gt; ici'",
        r"title='Antislash \ et &amp; ici'",
    ]),
    # ${html:html:LANG_x} used to render empty here rather than double-escape
    ("step2.html", [help_tip]),
]

for page, wants in pages:
    body = render(page)
    for want in wants:
        if want not in body:
            sys.exit("%s does not emit %r" % (page, want))
    # no static handler carries one, so any & or < came out of a translation
    for h in re.findall(r'onMouseOver="([^"]*)"', body):
        if "&" in h or "<" in h:
            sys.exit("%s leaves an HTML-special byte in %r" % (page, h))
        # every escape is a \xNN group: a bare \ is one a DBCS decode can eat
        if re.search(r"\\(?!x[0-9a-f]{2})", h):
            sys.exit("%s emits a non-hex escape in %r" % (page, h))
PY
echo OK

#!/bin/bash
# A socket number from FD_SETSIZE up must not be offered to select().

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

skip_on_windows "a Winsock fd_set has no descriptor ceiling"

out=$(httrack -O /dev/null '-#test=selectable' 2>&1) ||
    fail "-#test=selectable failed: $out"
assert_eq "selectable OK" "$out" "the self-test verdict"
ok "FD_SETSIZE - 1 is selectable and FD_SETSIZE is not"

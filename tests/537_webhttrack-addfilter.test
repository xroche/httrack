#!/bin/bash
#
# A scan rule added to a running crawl through WebHTTrack's add-filter drops
# the queued links it refuses, and keeps the others (#128).

set -euo pipefail

# shellcheck source=tests/webhttracklib.sh
. "${0%"${0##*/}"}./webhttracklib.sh"

htsserver_require

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_addfilter.XXXXXX") || fail "no tmpdir"
csrv=
cleanup_push htsserver_cleanup_dir "${work}"
cleanup_push htsserver_reap_vars csrv

export HOME="${work}" # no ~/.httrack.ini of the developer's in the store

# short.bin trickles for six seconds and holds the only socket (-c1), while the
# pages after it wait fetched and unsaved.
mkdir -p "${work}/docroot/junk" "${work}/docroot/keep"
{
    printf '<html><body><a href="/trickle/short.bin">slow</a>\n'
    for i in 1 2 3 4 5; do
        printf '<a href="junk/j%d.html">j</a>\n' "${i}"
        printf '<html><body>junk</body></html>\n' >"${work}/docroot/junk/j${i}.html"
    done
    printf '<a href="keep/k1.html">k</a></body></html>\n'
} >"${work}/docroot/index.html"
printf '<html><body>keep</body></html>\n' >"${work}/docroot/keep/k1.html"

clog="${work}/content.log"
LOCAL_SERVER_VERBOSE=1 "${HTS_PYTHON}" "${testdir}/local-server.py" --root "${work}/docroot" \
    >"${clog}" 2>&1 &
csrv=$!
cport=$(discover_server_port "${clog}" "${csrv}") || fail "no content server"

htsserver_start
sid=$(htsserver_sid)
test "${#sid}" -eq 32 || fail "no session id in the panel (got '${sid}')"

out="${work}/crawl"
site="${out}/127.0.0.1_${cport}"
log="${out}/hts-log.txt"
htsserver_client --path /step4.html --field "sid=${sid}" --field "path=${work}" \
    --field projname=crawl --field winprofile=x --field command_do=start \
    --field "command=httrack --robots=0 -c1 -%A bin=application/octet-stream http://127.0.0.1:${cport}/index.html +* -O ${out}" \
    >/dev/null

# Declaring .bin up front keeps the parser from fetching short.bin to type it,
# so it is requested only once index.html is parsed and every link queued.
start=$SECONDS
while ! grep -q "GET /trickle/short.bin HTTP" "${clog}"; do
    htsserver_alive || fail "htsserver died: $(tail -n 20 "${log}" 2>/dev/null)"
    test "$((SECONDS - start))" -lt 60 || fail "the slow file was never requested"
    poll_wait 0.2
done

htsserver_client --path /step4.html --field "sid=${sid}" \
    --field "command=add-filter=-*/junk/*" >/dev/null

start=$SECONDS
while ! grep -q "queued link(s) dropped" "${log}"; do
    test "$((SECONDS - start))" -lt 30 ||
        fail_dump "the rule was never applied" "${log}" "${clog}"
    poll_wait 0.2
done
# keep/k1.html matches no rule, so exactly the 5 junk links go.
grep -q "1 scan rule(s) added by user, 5 queued link(s) dropped" "${log}" ||
    fail_dump "the queued junk links were not all dropped" "${log}"

start=$SECONDS
while ! grep -q "HTTrack Website Copier/" "${log}"; do
    test "$((SECONDS - start))" -lt 60 || fail "the crawl did not end"
    poll_wait 0.2
done
assert_file "${site}/keep/k1.html" "a link the rule does not match was dropped"
test ! -e "${site}/junk" || fail "a dropped link was saved: $(ls "${site}/junk")"

echo "PASS"

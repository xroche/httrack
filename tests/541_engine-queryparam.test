#!/bin/bash
#
# The shared query iterator and the %[param] lookup read keys exactly.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# In %[param], a second '?' does not start a field, and a name holding '=' or '&'
# never matches, because no key can hold either.
selftest_queue_lines "queryparam: OK" queryparam

# Every field is read, empty ones too, and the key ends at the first '='. A '|'
# marks the end of the key.
selftest_queue "[a]" querynext a
selftest_queue "[a][]" querynext "a&"
selftest_queue "[][]" querynext "&"
selftest_queue "[a][b|c][][d|e=f]" querynext "a&b=c&&d=e=f"
selftest_queue "[|v]" querynext "=v"
selftest_queue "[k|]" querynext "k="
selftest_queue "[x|1?id=5]" querynext "x=1?id=5"
selftest_queue "[%41|%26][+]" querynext "%41=%26&+"

selftest_run_queued

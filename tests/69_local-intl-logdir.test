#!/bin/bash
#
# A single non-ASCII -O sets path_html and path_log to "café" (#630). The logs
# and hts-cache must land there, not in an ANSI-mangled twin, because on Windows
# path_log holds UTF-8 bytes that raw file calls read as the codepage. The
# --log-found and --cache-under-logroot checks fail on a write to the twin.
# POSIX has no twin, so the bug shows only on the Windows leg.

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --outdir-intl 'café' --errors 0 --files 5 \
    --found 'simple/basic.html' \
    --log-found 'mirror complete in' \
    --cache-under-logroot \
    httrack 'BASEURL/simple/basic.html'

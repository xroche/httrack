#!/bin/bash
#
# A non-ASCII -O must get the logs and hts-cache, not a mangled twin (#630).
# POSIX has no twin, so only the Windows leg can fail.

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --outdir-intl 'café' --errors 0 --files 5 \
    --found 'simple/basic.html' \
    --log-found 'mirror complete in' \
    --cache-under-logroot \
    httrack 'BASEURL/simple/basic.html'

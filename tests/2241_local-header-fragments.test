#!/bin/bash
#
# The header reader must stop at the blank line, even when bytes arrive one per
# write, and must refuse a header block larger than its 8 KB buffer.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmpdir=$(mktemp -d)
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

out=$(httrack -O /dev/null '-#test=xfread-lines' 2>&1) ||
    fail "-#test=xfread-lines failed: $out"
assert_eq "xfread-lines self-test OK" "$out" "the self-test's own verdict"

# Equals FRAG_BODY in local-server.py.
{
    printf '\r\n\r\nstart\r\nline\n\nlone\rCR\r\n'
    python3 -c 'import sys; sys.stdout.buffer.write(bytes(range(256)))'
    printf '\r\n\r\n'
} >"$tmpdir/expected"

# check SCHEME [local_server_start args]
check() {
    local scheme=$1 dir shape mode link
    shift
    local_server_start "$@" --log "$tmpdir/$scheme-srv.out"
    local_crawl --log "$tmpdir/$scheme.out" \
        "$scheme://127.0.0.1:$SRV_PORT/frag/index.html" -O "$tmpdir/$scheme" \
        -r2 -c4 --robots=0 --retries=0 --quiet || true
    dir="$tmpdir/$scheme/127.0.0.1_$SRV_PORT/frag"
    for shape in crlf lf chunked; do
        for mode in whole bytes split; do
            test -f "$dir/$shape-$mode.bin" ||
                fail_dump "$scheme $shape-$mode.bin not saved" "$tmpdir/$scheme.out"
            cmp "$tmpdir/expected" "$dir/$shape-$mode.bin" ||
                fail "$scheme $shape-$mode.bin differs from the served body"
        done
    done
    # over 8 KB of headers: refused by the reader, not lost some other way
    link=127.0.0.1:$SRV_PORT/frag
    test "$scheme" = http || link="$scheme://$link"
    for mode in whole bytes split; do
        test ! -e "$dir/huge-$mode.bin" || fail "$scheme huge-$mode.bin saved"
        grep -qF "\"Interrupted transfer\" (-4) at link $link/huge-$mode.bin" \
            "$tmpdir/$scheme/hts-log.txt" ||
            fail_dump "$scheme huge-$mode.bin not refused as too long" "$tmpdir/$scheme/hts-log.txt"
    done
}

check http
if test "${HTTPS_SUPPORT:-}" == "no"; then
    echo "no https support compiled, skipping the https half"
else
    check https --tls
fi

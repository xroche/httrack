#!/bin/bash
# hts-stop.lock is how a script pauses a running engine. It follows the same
# staleness rule as hts-abort.lock: the engine pauses only for a request stamped
# later than the run's own hts-in_progress.lock that it could also delete, so a
# copy an earlier mirror left behind no longer pauses the next one.
set -eu

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

# The C side has HTS_PAUSE_LOCKNAME for the first of these.
STOPLOCK=hts-stop.lock
PAUSEDLOCK=hts-paused.lock
PROGRESSLOCK=hts-in_progress.lock

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_stoplock.XXXXXX") || exit 1
crawlpid=
cleanup() {
    if test -n "$crawlpid"; then kill -9 "$crawlpid" 2>/dev/null || true; fi
    # The rule self-test leaves a directory it made read-only on purpose.
    chmod -R u+w "$tmpdir" 2>/dev/null || true
    rm -rf "$tmpdir"
}
cleanup_push cleanup

# mktemp gives 0700, which the unprivileged euid the rule self-test borrows on a
# root runner cannot walk through.
chmod 0755 "$tmpdir"

wait_until() { # wait_until <shell condition> <message> [tenths, default 300]
    for _ in $(seq 1 "${3:-300}"); do
        if eval "$1"; then return 0; fi
        sleep 0.1
    done
    fail "$2"
}

stop_crawl() {
    if test -n "$crawlpid"; then
        kill -9 "$crawlpid" 2>/dev/null || true
        wait "$crawlpid" 2>/dev/null || true
        crawlpid=
    fi
}

# The request has to land in a later whole second than the progress lock, which
# is what the engine compares it against.
next_second() { sleep 1; }

require_httrack

printf '[the rule itself] ..\t'
st_out=$(httrack -O "${tmpdir}/st" "-#test=stoplock" \
    "$(nativepath "${tmpdir}/rule")" 2>&1) ||
    fail "the rule self-test exited non-zero: ${st_out}"
case "$st_out" in
*"stoplock self-test: OK"*) ;;
*) fail "the rule self-test did not report OK: ${st_out}" ;;
esac
# Nothing portable makes a delete fail, so that arm names what covered it here
# rather than skipping in silence.
coverage=$(printf '%s\n' "$st_out" | command grep 'undeletable request: ') ||
    fail "the rule self-test said nothing about an undeletable request"
echo "OK (${coverage#*: })"

local_server_start
common=(--quiet --disable-security-limits --robots=0 --timeout=30 --retries=0 -c1)

# The behaviour this test is here for: before the staleness rule the engine took
# any hts-stop.lock it found, so a copy left in a reused output directory paused
# the next mirror on its first poll and nothing lifted it.
printf '[a request left behind does not pause the next mirror] ..\t'
out="${tmpdir}/stale"
mkdir -p "$out"
: >"${out}/${STOPLOCK}"
touch -t 200001010000 "${out}/${STOPLOCK}"
httrack -O "$out" "${common[@]}" "${BASEURL}/simple/basic.html" \
    >"${tmpdir}/log-stale" 2>&1 &
crawlpid=$!
wait_until "! kill -0 '$crawlpid' 2>/dev/null" \
    "60s on, the mirror had not finished: the request it inherited paused it" 600
wait "$crawlpid" 2>/dev/null || fail "the mirror failed outright"
crawlpid=
test ! -e "${out}/${PAUSEDLOCK}" ||
    fail "a request left by an earlier run paused the mirror"
test -e "${out}/${STOPLOCK}" ||
    fail "the mirror deleted a request that was never aimed at it"
test -n "$(find "$out" -name 'basic.html' 2>/dev/null)" ||
    fail "the mirror saved nothing"
echo "OK"

# The control for the arm above: the same file, stamped after this run started,
# still pauses. Rate-capped /bigfiles/ keeps the engine polling long enough.
printf '[a request aimed at this run pauses it] ..\t'
out="${tmpdir}/fresh"
httrack -O "$out" "${common[@]}" --max-rate=200000 \
    "${BASEURL}/bigfiles/index.html" >"${tmpdir}/log-fresh" 2>&1 &
crawlpid=$!
wait_until "test -e '${out}/${PROGRESSLOCK}'" "the crawl never got going"
next_second
: >"${out}/${STOPLOCK}"
wait_until "test -e '${out}/${PAUSEDLOCK}'" \
    "30s on, a running engine had not paused"
test ! -e "${out}/${STOPLOCK}" ||
    fail "the engine paused without taking the request that asked for it"
stop_crawl
echo "OK"

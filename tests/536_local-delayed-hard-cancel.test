#!/bin/bash
#
# A hard stop during a type wait must drop the cancelled slot (#1854). p0's
# headers overrun -M5000's grace, so the link stays online, never p0.bin.html.

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" \
    --log-found 'mirror cancelled, type unknown, link left online: .*/dhard/p0\.bin' \
    --log-not-found 'probably looping' \
    --file-matches dhard/index.html 'href="http://[^"]*/dhard/p0\.bin"' \
    --file-not-matches dhard/index.html 'p0\.bin\.html' \
    httrack 'BASEURL/dhard/index.html' -M5000 -c1 -Z

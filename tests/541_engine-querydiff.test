#!/bin/bash
#
# The shared query iterator matches the parsers it replaced, except in %[param].

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# Exact counts, so a shrinking corpus or a growing allowlist shows. The allowed
# %[param] changes: a second '?' no longer starts a field, and a name holding
# '=' or '&' never matches, because no key can hold either.
selftest_queue_lines "querydiff: 274752 cases, 0 failures, allowed: 662 second '?', 16 name with '=' or '&'
querydiff: OK" querydiff

# Every field is read, empty ones too, and the key ends at the first '='.
selftest_queue "[a]" querynext a
selftest_queue "[a][]" querynext "a&"
selftest_queue "[][]" querynext "&"
selftest_queue "[a][b=c][][d=e=f]" querynext "a&b=c&&d=e=f"
selftest_queue "[=v]" querynext "=v"
selftest_queue "[k=]" querynext "k="
selftest_queue "[x=1?id=5]" querynext "x=1?id=5"
selftest_queue "[%41=%26][+]" querynext "%41=%26&+"

selftest_run_queued

#!/bin/bash
# Issue #769: -o1 with .txt assumed image/gif was the one input reaching the
# removed --errpage placeholder block, which over-read in robots_parse.

set -eu

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --found 'sitemapdir/orphan1.html' \
    --log-found 'listed by 127\.0\.0\.1:[0-9]+/sitemap\.xml' \
    httrack 'BASEURL/sitemapdir/start.html' --sitemap -r2 -o1 \
    --assume 'txt=image/gif' -F 'errorrobots-agent'

#!/bin/bash
#
# The WebHTTrack footer year is expanded on each request (#1165), so it cannot
# drift from the calendar the way the 23 hardcoded copies did.

set -euo pipefail

# shellcheck source=tests/webhttracklib.sh
. "$(dirname "$0")/webhttracklib.sh"

htsserver_require
distdir=${HTS_DISTDIR}

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_year.XXXXXX") || fail "no tmpdir"
cleanup() {
    htsserver_cleanup
    rm -rf "${work}"
}
cleanup_push cleanup

printf '[every server footer takes its year from the clock] ..\t'

# Converting one page and leaving 22 stamped renders correctly on the page the
# request below reads, so sweep the tree rather than trust that one reply.
stamped=$({ grep -l '&copy; 1998-[0-9]' "${distdir}"/html/server/*.html || true; })
test -z "${stamped}" || fail "footers still carry a stamped year: ${stamped}"
footers=$({ grep -l 'id="footer"' "${distdir}"/html/server/*.html || true; } | wc -l)
# shellcheck disable=SC2016 # the literal ${...} is what we look for
tokens=$({ grep -lF '1998-${date:year}' "${distdir}"/html/server/*.html || true; } | wc -l)
test "${footers}" -gt 20 || fail "only ${footers} server pages carry a footer"
test "${tokens}" -eq "${footers}" || fail "${footers} footers, ${tokens} take the token"

# A private root, so the probe below can sit beside the shipped pages.
root="${work}/root"
mkdir -p "${root}"
cp -R "${distdir}/html" "${distdir}/lang" "${distdir}/lang.def" "${root}/"
chmod -R u+w "${root}"

# Bracketed, so an empty year is distinguishable from a dropped line. The field
# name is matched whole: an unknown one and a longer one both expand to nothing.
# shellcheck disable=SC2016 # the literal ${...} is what the server expands
printf '%s\n' 'year=[${date:year}] unknown=[${date:month}] longer=[${date:yearly}]' \
    >"${root}/html/server/probe-1165.html"

# An hour before New Year UTC, read from 14 hours east of it: the pinned year is
# 2019 through gmtime and 2020 through localtime, so this says which one runs.
pinned=2019
epoch=$("${HTS_PYTHON}" -c \
    "import datetime;print(int(datetime.datetime(${pinned},12,31,23,tzinfo=datetime.timezone.utc).timestamp()))")
export TZ=XXX-14

# Pinned first: a year hardcoded in C would pass every clock check below.
export SOURCE_DATE_EPOCH="${epoch}"
htsserver_start --root "${root}" --home "${work}"
reply=$(htsserver_get /server/probe-1165.html)
grep -q '^HTTP/1.[01] 200' <<<"${reply}" || fail "probe page: ${reply}"
grep -q "year=\[${pinned}\]" <<<"${reply}" ||
    fail "SOURCE_DATE_EPOCH=${epoch} did not reach the expansion as UTC: ${reply}"
grep -q 'unknown=\[\] longer=\[\]' <<<"${reply}" ||
    fail "a field that is not year expands to something: ${reply}"

# ... and a shipped page has to carry the token rather than a stamped year.
reply=$(htsserver_get /server/index.html)
grep -q '^HTTP/1.[01] 200' <<<"${reply}" || fail "index.html: ${reply}"
grep -q "&copy; 1998-${pinned} Xavier Roche &amp; other contributors" <<<"${reply}" ||
    fail "the index.html footer does not follow the clock: ${reply}"
# shellcheck disable=SC2016 # ditto: the raw token must not survive
case ${reply} in
*'${date:'*) fail "index.html serves the raw token: ${reply}" ;;
esac
htsserver_stop
unset TZ

# No override, then two the parser cannot use: all three take the real clock,
# because a footer reading 1998-1970 is worse than an ignored override.
for override in '' abc 99999999999999999999; do
    if test -n "${override}"; then
        export SOURCE_DATE_EPOCH="${override}"
    else
        unset SOURCE_DATE_EPOCH
    fi
    now=$(date +%Y)
    htsserver_start --root "${root}" --home "${work}"
    reply=$(htsserver_get /server/probe-1165.html)
    # Re-read: a New Year crossing mid-request is not a failure.
    after=$(date +%Y)
    grep -qE "year=\[(${now}|${after})\]" <<<"${reply}" ||
        fail "SOURCE_DATE_EPOCH='${override}' gives neither ${now} nor ${after}: ${reply}"
    htsserver_stop
done

# A leaked server wedges the parallel harness behind a green log.
htsserver_assert_reaped

echo OK

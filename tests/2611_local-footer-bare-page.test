#!/bin/bash
#
# An HTML page with </html> but no <head>, <body> or <meta> gets the -%F footer
# once, at its very end and without the charset meta. Other pages are as before.

set -e
# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_2611.XXXXXX") || exit 1
cleanup() {
    rm -rf "$tmpdir"
}
trap 'set +e; cleanup' EXIT

root="$tmpdir/docroot"
mkdir -p "$root/footer"
local_server_start --root "$root"
require_httrack

# NAME BODY: a page, and a link to it from the crawl's index (.html unless
# NAME has a suffix)
pages=()
page() {
    local file=$1
    test "${file%.*}" != "$file" || file=$file.html
    printf '%b' "$2" >"$root/footer/$file"
    pages+=("$file")
}
page bare '<html>hello</html>\n'
page notags 'just text\n'
page frag '<p>para</p>\n'
page normal '<!DOCTYPE html>\n<html><head><title>t</title></head><body>x</body></html>\n'
page upper '<HTML><HEAD><TITLE>t</TITLE></HEAD><BODY>x</BODY></HTML>\n'
page hidden '<html><!-- <head> --><script>var s="<head></html>";</script>x</html>\n'
page xhtml '<?xml version="1.0"?>\n<!DOCTYPE html>\n<html xmlns="http://www.w3.org/1999/xhtml"><head><title>t</title></head><body>x</body></html>\n'
page doctype '<!DOCTYPE html>\n<html>x</html>\n'
page twice '<html>a</html>\n<html>b</html>\n'
page crlf '<html>a\r\n</html>\r\n'
page stray '</html>\n<!DOCTYPE html>\n<html><head></head><body>x</body></html>\n'
page late '<html>a</html>\n<html><head><title>t</title></head><body>x</body></html>\n'
page textarea '<html><textarea></html></textarea>x</html>\n'
page frameset '<html><frameset><frame name="a"></frameset></html>\n'
page feed.atom '<feed><content type="html"><html>x</html></content></feed>\n'
page feed.rss '<rss></html></rss>\n'
page pic.svg '<svg><foreignObject><html>x</html></foreignObject></svg>\n'
for p in "${pages[@]}"; do
    printf '<a href="%s">%s</a>\n' "$p" "$p"
done >"$root/footer/index.html"

crawl() { # crawl LABEL [httrack args...], leaving the mirrored pages in $mir
    mir="$tmpdir/$1/127.0.0.1_$SRV_PORT/footer"
    local label=$1
    shift
    local_crawl --log "$tmpdir/log-$label" -O "$tmpdir/$label" --quiet \
        --robots=0 --timeout=30 --retries=0 "$@" "$BASEURL/footer/index.html" ||
        fail "$label crawl failed"
}

expect() { # expect FILE BODY: the mirrored FILE (.html unless named) is BODY
    local file=$1
    test "${file%.*}" != "$file" || file=$file.html
    printf '%b' "$2" >"$tmpdir/want"
    cmp -s "$tmpdir/want" "$mir/$file" ||
        fail "$1: got $(od -An -c "$mir/$file"), want $(od -An -c "$tmpdir/want")"
}
same() { # same FILE: the mirrored FILE is the served one
    cmp -s "$root/footer/$1" "$mir/$1" || fail "$1 was changed: $(od -An -c "$mir/$1")"
}

charset='<!-- Added by HTTrack --><meta http-equiv="content-type" content="text/html;charset=utf-8" /><!-- /Added by HTTrack -->\n'

crawl tmpl -%F '<!-- F {path} -->'
f() { printf '\\n<!-- F /footer/%s.html -->\\n' "$1"; }
expect bare "<html>hello</html>\n$(f bare)"
expect notags 'just text\n'
expect frag '<p>para</p>\n'
expect normal "<!DOCTYPE html>\n<html>$(f normal)$charset<head><title>t</title></head><body>x</body>$(f normal)</html>\n"
expect upper "<HTML>$(f upper)$charset<HEAD><TITLE>t</TITLE></HEAD><BODY>x</BODY>$(f upper)</HTML>\n"
expect hidden "<html><!-- <head> --><script>var s=\"<head></html>\";</script>x</html>\n$(f hidden)"
expect xhtml "<?xml version=\"1.0\"?>\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\">$(f xhtml)$charset<head><title>t</title></head><body>x</body>$(f xhtml)</html>\n"
expect doctype "<!DOCTYPE html>\n<html>x</html>\n$(f doctype)"
expect twice "<html>a</html>\n<html>b</html>\n$(f twice)"
expect crlf '<html>a\r\n</html>\r\n\r\n<!-- F /footer/crlf.html -->\r\n'
# A <head> after a stray </html> still takes the footer and the charset meta.
expect stray "</html>\n<!DOCTYPE html>\n<html>$(f stray)$charset<head></head><body>x</body>$(f stray)</html>\n"
expect late "<html>a</html>\n<html>$(f late)$charset<head><title>t</title></head><body>x</body>$(f late)</html>\n"
expect textarea "<html><textarea></html></textarea>x</html>\n$(f textarea)"
expect frameset "<html><frameset><frame name=\"a\"></frameset></html>\n$(f frameset)"
same feed.atom
same feed.rss
same pic.svg

# No footer: a bare page is left alone, a normal one keeps its charset meta.
crawl none -%F ''
expect bare '<html>hello</html>\n'
expect normal "<!DOCTYPE html>\n<html>$charset<head><title>t</title></head><body>x</body></html>\n"

# The default footer, once.
crawl default
n=$(count_matching_lines 'Mirrored from' "$mir/bare.html")
test "$n" -eq 1 || fail "default footer on a bare page: $n copies, want 1"

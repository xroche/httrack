#!/bin/bash
#
# Login bundles in a real crawl, graded on what the server received: each site
# gets its own UA, Authorization and cookies, while a CDN and another user's
# site under a public suffix get the global -F and -%X. --update finds the
# bundles again, and the newer of the bundle and the jar wins.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

python=$(find_python) || skip "python3 missing"

bin=$(httrack_path)
server=$(nativepath "$top_srcdir/tests/bundle-server.py")
tmpdir=$(mktemp -d)
serverpid=
log=$tmpdir/crawl.log
fail_dump_var log

cleanup() {
    stop_server "$serverpid"
    rm -rf "$tmpdir"
}
cleanup_push cleanup

"$python" "$server" >"$tmpdir/srv.out" 2>"$tmpdir/srv.err" &
serverpid=$!
port=$(discover_server_port "$tmpdir/srv.out" "$serverpid") || exit 1

tab=$(printf '\t')
jar() { # jar DOMAIN NAME VALUE -- one Netscape jar line
    printf '%s' ".$1${tab}TRUE${tab}/${tab}FALSE${tab}0${tab}$2${tab}$3"
}
mkdir "$tmpdir/logins" "$tmpdir/one" "$tmpdir/two"
alpha=$tmpdir/logins/alpha.test.hts
printf '%s\n' '# HTTrack bundle 1' 'ua AlphaUA/1.0' \
    'header Authorization: Bearer alpha-token' cookies \
    "$(jar alpha.test SID alpha-captured)" "$(jar alpha.test PREF alpha-pref)" \
    >"$alpha"
printf '%s\n' '# HTTrack bundle 1' 'ua BetaUA/2.0' \
    'header Authorization: Bearer beta-token' cookies \
    "$(jar beta.test SID beta-captured)" >"$tmpdir/logins/beta.test.hts"
printf '%s\n' '# HTTrack bundle 1' 'ua GhUA/3.0' \
    'header Authorization: Bearer gh-token' >"$tmpdir/logins/gh.hts"
cp "$alpha" "$tmpdir/alpha.orig"
jarfile=$tmpdir/one/cookies.txt
jar alpha.test SID alpha-refreshed >"$jarfile"

crawl() { # crawl CWD [httrack args...]
    local cwd=$1 rc=0
    shift
    (cd "$cwd" && run_with_timeout 120 "$bin" -P "127.0.0.1:$port" \
        -F GlobalUA/9 -%X 'X-Global: 1' '+*cdn.gamma.test/*' \
        '+*github.io/*' -c1 --robots=0 -%v0 -q "$@") >>"$log" 2>&1 || rc=$?
    test "$rc" -ne 124 || fail "crawl hit the deadline"
    return "$rc"
}
hits() { wc -l <"$tmpdir/srv.out"; }
hit() { # hit WHAT FROM LINE -- the server logged LINE after line FROM
    tail -n "+$(($2 + 1))" "$tmpdir/srv.out" >"$tmpdir/new.out"
    command grep -qxF "HIT $3" "$tmpdir/new.out" ||
        fail_dump "$1: no request [HIT $3]" "$tmpdir/new.out"
}
dated() { # dated BUNDLE-TIME JAR-TIME -- times as touch -t takes them
    touch -t "$1" "$alpha"
    touch -t "$2" "$jarfile"
}

# The jar is newer than the bundle, so its SID wins. --bundle-dir is relative.
dated 202601011000.00 202601021000.00
crawl "$tmpdir" -O one --bundle-dir logins \
    'http://www.alpha.test/#httrack-bundle=alpha.test' \
    'http://www.beta.test/#httrack-bundle=beta.test' \
    'http://alpha.test/plain.html' 'http://github.io/#httrack-bundle=gh' ||
    fail "the bundle crawl failed"
a='ua=AlphaUA/1.0 auth=Bearer alpha-token cookie=PREF=alpha-pref; SID'
hit "start page" 0 "www.alpha.test/ $a=alpha-refreshed x=-"
hit "crawled link" 0 "www.alpha.test/page.html $a=alpha-refreshed x=-"
hit "plain URL on the bundle's site" 0 "alpha.test/plain.html $a=alpha-refreshed x=-"
hit "second bundle" 0 "www.beta.test/ ua=BetaUA/2.0 auth=Bearer beta-token cookie=SID=beta-captured x=-"
for gif in a.gif b.gif; do
    hit "CDN" 0 "cdn.gamma.test/$gif ua=GlobalUA/9 auth=- cookie=- x=1"
done
hit "suffix host" 0 "github.io/ ua=GhUA/3.0 auth=Bearer gh-token cookie=- x=-"
hit "another user under the suffix" 0 \
    "attacker.github.io/x.html ua=GlobalUA/9 auth=- cookie=- x=1"
n=$(hits)
test "$n" -eq 9 || fail_dump "$n lines, expected PORT and 8 requests" "$tmpdir/srv.out"
cmp -s "$tmpdir/alpha.orig" "$alpha" || fail "the crawl wrote to the bundle"
doit=$tmpdir/one/hts-cache/doit.log
test -f "$doit" || fail "no $doit"
command grep -qF -- '--bundle-dir logins' "$doit" &&
    fail_dump "doit.log kept a relative --bundle-dir" "$doit"
# The suffix is cut before any URL reaches a file name, a log or the index.
# hts-log.txt echoes the command line in parentheses, as doit.log keeps it.
no_suffix() { # no_suffix PROJECT
    local names f
    names=$(cd "$1" && find . -name '*httrack-bundle*')
    test -z "$names" || fail "a file name holds the bundle suffix: $names"
    for f in index.html hts-log.txt hts-cache/new.txt; do
        test -f "$1/$f" || fail "no $1/$f"
        if command grep -v '^(' "$1/$f" | command grep -F '#httrack-bundle'; then
            fail_dump "$f holds the bundle suffix" "$1/$f"
        fi
    done
}
no_suffix "$tmpdir/one"
command grep -qF 'http://www.alpha.test/ ' "$tmpdir/one/hts-log.txt" ||
    fail_dump "hts-log.txt does not name the start URL" "$tmpdir/one/hts-log.txt"

refresh() { # the server refreshed SID, as the saved jar holds it
    sed "s/${tab}SID${tab}.*/${tab}SID${tab}alpha-server/" "$jarfile" >"$tmpdir/jar.new"
    cat "$tmpdir/jar.new" >"$jarfile"
    command grep -qF "SID${tab}alpha-server" "$jarfile" ||
        fail_dump "the jar holds no SID to refresh" "$jarfile"
}
# --update from another folder reads doit.log, so it finds the bundles again.
# The jar the crawl saved is newer: a cookie the server refreshed wins.
update() { # update WANT-SID
    local from
    from=$(hits)
    crawl / -O "$(nativepath "$tmpdir/one")" --update || fail "--update failed"
    hit "--update with SID=$1" "$from" "www.alpha.test/ $a=$1 x=-"
}
refresh
dated 202601011000.00 202601021000.00
update alpha-server
# a new capture is newer than the jar, so the fresh login wins
dated 202601031000.00 202601021000.00
update alpha-captured
# and so it does on a tie, where a coarse clock cannot order the two
refresh
dated 202601041000.00 202601041000.00
update alpha-captured

# A -%L list names a bundle too, and it resolves in the project folder.
cp "$tmpdir/logins/beta.test.hts" "$tmpdir/two/"
printf '%s\n' 'http://www.beta.test/#httrack-bundle=beta.test' >"$tmpdir/list.txt"
before=$(hits)
crawl "$tmpdir" -O two -%L "$(nativepath "$tmpdir/list.txt")" ||
    fail "the -%L crawl failed"
test "$(($(hits) - before))" -eq 2 ||
    fail_dump "-%L crawl: $(($(hits) - before)) requests, expected 2" "$tmpdir/srv.out"
hit "-%L" "$before" "www.beta.test/ ua=BetaUA/2.0 auth=Bearer beta-token cookie=SID=beta-captured x=-"
no_suffix "$tmpdir/two"

# A bundle that cannot be read stops the run before any request, with a message
# that names it and never shows a refused header's value. A CR would end a
# header early and start another on the wire.
printf '%s\n' '# HTTrack bundle 1' 'header Proxy-Authorization: planted-secret' \
    >"$tmpdir/two/secret.hts"
printf '# HTTrack bundle 1\nua U\rX-Injected: 1\nheader X-A: 1\rCookie: forged=1\n' \
    >"$tmpdir/two/cr.hts"
printf '%s\n' '# HTTrack bundle 1' cookies "$(jar beta.test SID "v$(printf '\033')x")" \
    >"$tmpdir/two/esc.hts"
printf '%s\n' '# HTTrack bundle 1' cookies \
    "$(jar beta.test SID "$(repeat_chars 8100 v)")" >"$tmpdir/two/long.hts"
printf '%s\n' 'http://www.beta.test/#httrack-bundle=../beta.test' >"$tmpdir/bad.txt"
badlist=$(nativepath "$tmpdir/bad.txt")
stops=0
stop() { # stop MESSAGE [httrack args...] -- MESSAGE is a whole line of output
    local want=$1 rc=0
    shift
    : >"$log"
    crawl "$tmpdir" -O two "$@" || rc=$?
    test "$rc" -ne 0 || fail "the run did not stop: $*"
    command grep -qxF "$want" "$log" || fail_dump "no message [$want]" "$log"
    stops=$((stops + 1))
}
before=$(hits)
stop 'Login bundle: two/nosuch.hts: cannot read the login bundle: No such file or directory' \
    'http://www.alpha.test/#httrack-bundle=nosuch'
stop "\"$badlist\", line 1: invalid login bundle name: use letters, digits, '.', '_' and '-'" \
    -%L "$badlist"
stop 'Login bundle: two/secret.hts, line 2: refused header: a proxy header is not for the site' \
    'http://www.alpha.test/#httrack-bundle=secret'
stop 'Login bundle: two/cr.hts, line 2: holds a control byte' \
    'http://www.alpha.test/#httrack-bundle=cr'
for b0 in -b1 -b0; do
    stop 'Login bundle: two/esc.hts, line 3: a cookie line holds a control byte' \
        "$b0" 'http://www.beta.test/#httrack-bundle=esc'
done
stop 'Login bundle: two/long.hts, line 3: a cookie line is too long' \
    'http://www.beta.test/#httrack-bundle=long'
test "$stops" -eq 7 || fail "$stops stops ran, expected 7"
test "$(hits)" -eq "$before" || fail_dump "a refused bundle still crawled" "$tmpdir/srv.out"
for f in "$log" "$tmpdir/two/hts-log.txt"; do
    test -f "$f" || fail "no $f"
    command grep -qF planted-secret "$f" && fail_dump "$f shows the secret" "$f"
done

# The identity is per request host: it drops on a redirect away from the
# bundle's site and returns on one back. A userinfo that spells the site's name
# gets none of it.
before=$(hits)
crawl "$tmpdir" -O three --bundle-dir logins '+*evil.test/*' \
    '+*sub.alpha.test/*' 'http://www.alpha.test/out#httrack-bundle=alpha.test' \
    'http://www.alpha.test@evil.test/' || fail "the redirect crawl failed"
a='ua=AlphaUA/1.0 auth=Bearer alpha-token cookie=PREF=alpha-pref; SID=alpha-captured x=-'
g='ua=GlobalUA/9 auth=- cookie=- x=1'
hit "redirect start" "$before" "www.alpha.test/out $a"
hit "redirect out" "$before" "evil.test/back $g"
hit "redirect back" "$before" "sub.alpha.test/home $a"
# the userinfo is the user's own Basic login, sent as given
hit "userinfo" "$before" \
    "evil.test/ ua=GlobalUA/9 auth=Basic d3d3LmFscGhhLnRlc3Q= cookie=- x=1"
test "$(($(hits) - before))" -eq 4 ||
    fail_dump "redirect crawl: $(($(hits) - before)) requests, expected 4" "$tmpdir/srv.out"

# A pasted login for an international host serves its Unicode and its ASCII
# address alike, because the engine requests the host in its ASCII form.
mkdir "$tmpdir/idn"
idn() { # idn LABEL PASTE-URL CRAWL-URL HOST -- paste a login, crawl, check
    local paste=$tmpdir/idn/$1.txt b
    printf "curl '%s' -b 'C=%s'" "$2" "$1" >"$paste"
    "$bin" -O /dev/null -#test=paste "$(nativepath "$tmpdir/idn")" \
        "$(nativepath "$paste")" >"$tmpdir/idn/$1.out" ||
        fail_dump "$1: the paste failed" "$tmpdir/idn/$1.out"
    b=$(sed -n 's/^name=\([^ ]*\) .*/\1/p' "$tmpdir/idn/$1.out")
    before=$(hits)
    crawl "$tmpdir" -O idn --bundle-dir idn "$3#httrack-bundle=$b" ||
        fail "$1: the crawl failed"
    hit "$1" "$before" "$4/ ua=GlobalUA/9 auth=- cookie=C=$1 x=1"
}
idn ascii http://www.ascii.test/ http://www.ascii.test/ www.ascii.test
idn uni http://www.bücher.test/ http://www.bücher.test/ www.xn--bcher-kva.test
idn puny http://www.bücher.test/ http://www.xn--bcher-kva.test/ \
    www.xn--bcher-kva.test
idn puny2uni http://www.xn--bcher-kva.test/ http://www.bücher.test/ \
    www.xn--bcher-kva.test

#!/bin/bash
#
# check-comments.py flags banned comment phrasing, and --base limits it to added lines.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

srcdir="${abs_top_srcdir:?not run under make check}"
lint="${srcdir}/tools/check-comments.py"
python=$(find_python) || skip "python3 not found"
test -r "${lint}" || fail "missing ${lint}"
command -v git >/dev/null 2>&1 || skip "no git"

work=$(mktemp -d "${TMPDIR:-/tmp}/cmtlint.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${work}"

cat >"${work}/dirty.c" <<'C'
/* Measured, not assumed: the SDK lacks it. */
int a; // this guard is load-bearing
/* A long block whose second line
   holds the phrase by construction. */
const char *u = "http://x"; // the whole point
C
cat >"${work}/dirty.py" <<'PY'
x = 1  # Worth noting, maybe
PY
cat >"${work}/more.c" <<'C'
/* Proved, not guessed. */
/* a // b
   Load-bearing */
C
# Every listed phrase, capitalised as a comment opener would be.
"${python}" -c 'import runpy, sys
for p in runpy.run_path(sys.argv[1])["BANNED"]:
    print("/* " + p.capitalize() + " here. */")' "${lint}" >"${work}/all.c"
nbanned=$(wc -l <"${work}/all.c")
test "${nbanned}" -ge 12 || fail "BANNED shrank to ${nbanned}"
out=$("${python}" "${lint}" "${work}/all.c") && fail "all.c passed"
test "$(wc -l <<<"${out}")" -eq "${nbanned}" || fail "not every phrase fired: ${out}"
printf '# %s\n' 'Captured, not piped: grep -q exits early.' >"${work}/dirty.sh"
cat >"${work}/clean.c" <<'C'
/* The SDK lacks AF_MULTIPATH, so name it. */
const char *u = "http://load-bearing.example/";
const char *s = "// in practice", *o = "/*", c = '"';
const char *m = "by construction";
/* The point isn't here. Fine, not broken: yes. */
/* neither, not quite: lowercase */
C
printf '%s\n' "DOC = '''" '# the whole point' "'''" >"${work}/clean.py"
cat >"${work}/clean.css" <<'CSS'
a { background: url(//example.com/load-bearing.png); }
CSS

out=$("${python}" "${lint}" "${work}/dirty.c" "${work}/dirty.sh" "${work}/dirty.py" \
    "${work}/more.c") &&
    fail "dirty files passed"
for want in 'dirty.c:1: slogan' "dirty.c:2: 'load-bearing'" "dirty.c:4: 'by construction'" \
    "dirty.c:5: 'the whole point'" 'dirty.sh:1: slogan' "dirty.py:1: 'worth noting'" \
    'more.c:1: slogan' "more.c:3: 'load-bearing'"; do
    grep -qF "${want}" <<<"${out}" || fail "missed ${want}: ${out}"
done
out=$("${python}" "${lint}" "${work}/clean.c" "${work}/clean.py" "${work}/clean.css") ||
    fail "clean file flagged: ${out}"

# --base reports what the change adds, and not what was already there.
repo="${work}/repo"
mkdir "${repo}"
cd "${repo}"
git init -q
git config user.email t@example.com
git config user.name t
printf '%s\n' '/* Old, not new: kept as it was.' '   first line */' 'int x;' >f.c
git add f.c
git commit -qm base
printf '%s\n' '/* Old, not new: kept as it was.' '   first line' \
    '   and an added line, load-bearing. */' 'int x;' '// the whole point' >f.c
printf '%s\n' '/* in practice */' >'sp é.c'
git add 'sp é.c'
out=$("${python}" "${lint}" --base HEAD) && fail "added phrases passed"
grep -qF "sp é.c:1: 'in practice'" <<<"${out}" || fail "missed a quoted path: ${out}"
grep -qF "f.c:3: 'load-bearing'" <<<"${out}" || fail "missed a continuation line: ${out}"
grep -qF "f.c:5: 'the whole point'" <<<"${out}" || fail "missed a // comment: ${out}"
grep -qF 'f.c:1:' <<<"${out}" && fail "reported an unchanged line: ${out}"
mkdir sub
out2=$(cd sub && "${python}" "${lint}" --base HEAD) && fail "a run from a subdirectory passed"
test "${out2}" = "${out}" || fail "a subdirectory run differs: ${out2}"
git checkout -q f.c
git rm -qf 'sp é.c'
out=$("${python}" "${lint}" --base HEAD) || fail "an empty change failed: ${out}"

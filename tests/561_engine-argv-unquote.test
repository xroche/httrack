#!/bin/bash
#
# argv reaches the engine final: a quote on the command line is data, except
# around a whole argument or a number, where it is refused. -O, doit.log and
# the WebHTTrack command line each decode their own quotes. doit.log line 1
# shows the argv the engine kept.

set -euo pipefail
# shellcheck source=tests/webhttracklib.sh
. "${0%"${0##*/}"}./webhttracklib.sh"

bin=$(httrack_path)

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_argvquote.XXXXXX") || exit 1
cleanup_push htsserver_cleanup_dir "$tmp"
url="file://$tmp/none.html"

# run DIR [ARGS...]: mirror from DIR, through a proxy that avoids DNS
run() {
    local dir=$1 rc=0
    shift
    mkdir -p "$dir"
    (cd "$dir" && "$bin" "$url" -q -r1 -R0 -P 127.0.0.1:1 "$@" >"$dir.out" 2>&1) || rc=$?
    test "$rc" -eq 0 || fail "httrack $* exited $rc: $(<"$dir.out")"
}
doit() {
    local line
    assert_file "$1/hts-cache/doit.log"
    IFS= read -r line <"$1/hts-cache/doit.log"
    # Windows writes doit.log with CR LF.
    printf '%s\n' "${line%$'\r'}"
}
has() { # has WANT LINE LABEL: WANT is whole words of LINE
    [[ " $2 " == *" $1 "* ]] || fail "$3: want '$1' in: $2"
}

refused() { # refused DIR MESSAGE [ARGS...]: the run fails, saying MESSAGE
    local dir=$1 want=$2 rc=0
    shift 2
    mkdir -p "$dir"
    (cd "$dir" && "$bin" "$url" -q -r1 -R0 -P 127.0.0.1:1 "$@" >"$dir.out" 2>&1) || rc=$?
    test "$rc" -ne 0 || fail "httrack $* was accepted"
    grep -qF -- "$want" "$dir.out" || fail "httrack $*: want '$want' in: $(<"$dir.out")"
}

# an option value and a filter keep their quotes, with -O too; a free-text value
# may hold one anywhere
run "$tmp/a" '+*"q"*' '-*"n"*' -F '"ua"' -%X 'X-A: "v"'
line=$(doit "$tmp/a")
has '"+*\"q\"*" "-*\"n\"*" -F "\"ua\"" -%X "X-A: \"v\""' "$line" "argv"
for f in '+*"q"*' '-*"n"*'; do
    grep -qF "filter $f holds a quote" "$tmp/a.out" || fail "no warning for $f: $(<"$tmp/a.out")"
done
run "$tmp/b" '"+*q*' -F '"a b"' -O "$tmp/b/out"
has '"\"+*q*" -F "\"a b\""' "$(doit "$tmp/b/out")" "argv with -O"
# a quote that does not wrap the whole URL is data
run "$tmp/c" '"z'
has '"\"z"' "$(doit "$tmp/c")" "unbalanced quote"

# a quote around a whole argument is a leftover, so it is refused
refused "$tmp/r1" 'Argument refused: "http://x.invalid/" is quoted, remove the quotes' \
    '"http://x.invalid/"'
refused "$tmp/r2" 'Argument refused: "+*.gif" is quoted, remove the quotes' '"+*.gif"'
# a number never parsed with quotes, and the refusal now says why
refused "$tmp/r3" 'Option --retries: "5" is quoted, remove the quotes' --retries '"5"'
refused "$tmp/r4" 'Option -R: "5" is quoted, remove the quotes' '-R"5"'
refused "$tmp/r5" 'MIN<=MAX<=86400): "1" is quoted, remove the quotes' --pause '"1"'
refused "$tmp/r6" 'positive size: "5" is quoted, remove the quotes' --single-file-max-size '"5"'
refused "$tmp/r7" 'needs a size: "2" is quoted, remove the quotes' --warc-max-size '"2"'

# a quoted line of a URL list is refused, and the others are kept
printf '"http://a.invalid/"\nhttp://b.invalid/\n' >"$tmp/list.txt"
run "$tmp/l" -%L "$tmp/list.txt"
grep -qF 'line 1: "http://a.invalid/" is quoted, remove the quotes, ignored' "$tmp/l/hts-log.txt" ||
    fail "no refusal of the quoted list line: $(<"$tmp/l/hts-log.txt")"
grep -qF '1 links added' "$tmp/l/hts-log.txt" ||
    fail "the other list line was lost: $(<"$tmp/l/hts-log.txt")"

# -O decodes its own quotes, where one groups a comma, and doit.log keeps them
run "$tmp/o" -O "\"$tmp/o/a,b\""
test -d "$tmp/o/a,b" || fail "-O split a quoted comma: $(ls "$tmp/o")"
want="-O \"\\\"$tmp/o/a,b\\\"\""
has "$want" "$(doit "$tmp/o/a,b")" "-O with a comma"

# -O1 takes one path, where a quote is data (Windows forbids one in a name)
if ! target_is_windows; then
    run "$tmp/o1" -O1 "$tmp/o1/a\"b,c"
    assert_file "$tmp/o1/a\"b,c/hts-log.txt"
fi

# doit.log reads back what it wrote, across two resumes
for i in 1 2; do
    (cd "$tmp/a" && "$bin" --continue -q >/dev/null 2>&1) || fail "--continue $i failed"
    has '"+*\"q\"*" "-*\"n\"*" -F "\"ua\"" -%X "X-A: \"v\""' "$(doit "$tmp/a")" "--continue $i"
    (cd "$tmp/o/a,b" && "$bin" --continue -q >/dev/null 2>&1) || fail "-O --continue $i failed"
    has "$want" "$(doit "$tmp/o/a,b")" "-O --continue $i"
done
test ! -e "$tmp/o/a" || fail "--continue split the -O value"

# a doit.log line the 3.50.5 engine wrote reads back the same
run "$tmp/m"
old='file://@D@/none.html -q -r1 -P 127.0.0.1:1 -O "\"@D@/m/o,x\"" -F "\"ua\"" -%X "X-A: \"v\"" "\"+*q*" -%F "\\\"ft"'
printf '%s\n' "${old//@D@/$tmp}" >"$tmp/m/hts-cache/doit.log"
(cd "$tmp/m" && "$bin" --continue -q >"$tmp/m.out" 2>&1) || fail "--continue on an old doit.log: $(<"$tmp/m.out")"
want=${old//@D@/$tmp}
has "${want#* -q }" "$(doit "$tmp/m")" "old doit.log"

# WebHTTrack: the step 4 command line, decoded as the browser posts it
if target_is_windows; then
    echo "PASS (no htsserver on Windows)"
    exit 0
fi
htsserver_require
export HOME="$tmp" # no ~/.httrack.ini of the developer's in the store
htsserver_start
proj="my proj,x"
htsserver_python - "${HTS_URL}" "$tmp" "$proj" "$url" <<'PY' || fail "see above"
import html
import sys

from webtestlib import Session, textarea

s, work, proj, url = Session(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
s.post("step2.html", [("path", work), ("projname", proj)])
s.post("step3.html", [("urls", url)])
s.post("option6.html", [("user", 'Probe "x" 1.0')])
page = s.get("step4.html")
s.post("step4.html", [("command", html.unescape(textarea(page, "command"))),
                      ("winprofile", html.unescape(textarea(page, "winprofile"))),
                      ("command_do", "start"), ("path", work), ("projname", proj)])
PY
out="$tmp/$proj"
start=$SECONDS
while ! grep -q "HTTrack Website Copier/" "$out/hts-log.txt" 2>/dev/null; do
    htsserver_alive || fail "htsserver died: $(<"${HTS_LOG}")"
    test "$((SECONDS - start))" -lt 60 || fail "the WebHTTrack mirror did not end"
    poll_wait 0.2
done
line=$(doit "$out")
has '-F "Probe \"x\" 1.0"' "$line" "WebHTTrack user agent"
has "-O1 \"$out\"" "$line" "WebHTTrack path"
test ! -e "$tmp/my proj" || fail "WebHTTrack split the path at its comma"
echo PASS

#!/bin/bash
#
# A fallback's working address is tried first by the next connect, and a
# negative-cache hit reports a real reason.

set -euo pipefail

# a failing self-test exits non-zero, and its FAIL lines are the diagnosis
out=$(httrack -#test=dnsaddr run) || true

test "$out" = "dns-addr-selftest: OK" || {
    echo "expected 'dns-addr-selftest: OK', got: $out" >&2
    exit 1
}

# A slot that ends while it resolves lets go of the job.
out=$(httrack -#test=dnsdrop)
test "$out" = "dnsdrop: OK" || {
    echo "expected 'dnsdrop: OK', got: $out" >&2
    exit 1
}

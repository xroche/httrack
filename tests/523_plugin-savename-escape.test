#!/bin/bash
#
# url_savename() collapsed "../" and then handed the name to the savename hook,
# which rewrites it where it is, so whatever the hook wrote reached the open()
# unchecked. Measured before the fix: "../../X" put a file one directory above
# the mirror root, and with no -O, where the root a name joins to is empty, an
# absolute name was used verbatim.

set -e
# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

[ "${EXAMPLE_LIBS:-yes}" = yes ] || skip "--disable-example-libs builds no plugin"
[ -n "${FILENAME2_LIB:-}" ] || skip "FILENAME2_LIB unset, no automake environment"

lib=
for suffix in so dylib; do
    if [ -r "${FILENAME2_LIB}.${suffix}" ]; then
        lib="${FILENAME2_LIB}.${suffix}"
        break
    fi
done
[ -n "$lib" ] || skip "nothing built at ${FILENAME2_LIB}.so"

require_httrack
# Resolved now: the no-O case below runs from inside its own mirror directory.
httrack_bin=$(httrack_path)

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_savesc.XXXXXX") || exit 1
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

site="$tmpdir/site"
mkdir -p "$site/sub"
cat >"$site/index.html" <<'HTML'
<html><body><a href="sub/page.html">p</a></body></html>
HTML
printf '<html><body>SUBPAGE</body></html>\n' >"$site/sub/page.html"

local_server_start --root "$site"

host="127.0.0.1_${SRV_PORT}" # the directory the engine names a mirror after

common=(--quiet --robots=0 --timeout=30 --retries=0 -r2)

# Every file under $1 that the mirror root $1/mirror does not hold.
outside_files() { # outside_files JAIL
    find "$1" -mindepth 1 -type f -not -path "$1/mirror/*" | LC_ALL=C sort
}

# Control for that scan: an empty result below has to mean the engine wrote
# nothing there, not that the scan cannot see a file.
seen="$tmpdir/seen"
mkdir -p "$seen/mirror"
: >"$seen/planted"
test "$(outside_files "$seen")" = "$seen/planted" ||
    fail "the outside-the-mirror scan missed a planted file, so a clean result proves nothing"

# The page the hook renames, under the name the engine itself built for it.
assert_kept() { # assert_kept JAIL WHAT
    local saved="$1/mirror/$host/sub/page.html"
    test -f "$saved" || fail "$2: nothing saved at $saved"
    grep -q SUBPAGE <"$saved" || fail "$2: $saved is not the page we served"
}

# ---------------------------------------------------------------------------
# A ".." component walks out of the mirror root the name is joined to.
# ---------------------------------------------------------------------------
esc="$tmpdir/esc"
mkdir -p "$esc/mirror"
rc=0
local_crawl --log "$tmpdir/esc.log" -O "$esc/mirror" "${common[@]}" \
    --wrapper "${lib},sub,../../ESCAPED" \
    "http://127.0.0.1:${SRV_PORT}/index.html" || rc=$?
test "$rc" -eq 0 || fail_dump "httrack exited $rc" "$tmpdir/esc.log"

stray=$(outside_files "$esc")
test -z "$stray" || fail "a savename hook writing \"../../\" left the mirror: $stray"
assert_kept "$esc" 'the "../" name was refused'

# ---------------------------------------------------------------------------
# An absolute name, which only escapes with no -O. The hook replaces the host
# directory too, so the whole name is absolute rather than rooted under it.
# ---------------------------------------------------------------------------
abs="$tmpdir/abs"
mkdir -p "$abs/mirror"
rc=0
(
    cd "$abs/mirror" &&
        run_with_timeout "$(crawl_deadline)" "$httrack_bin" \
            "http://127.0.0.1:${SRV_PORT}/index.html" \
            "--max-time=$CRAWL_MAX_TIME" "${common[@]}" \
            --wrapper "${lib},${host}/sub,${abs}/ABSOLUTE"
) >"$tmpdir/abs.log" 2>&1 || rc=$?
test "$rc" -ne 124 || fail "crawl watchdog fired on the absolute-name case"
test "$rc" -eq 0 || fail_dump "httrack exited $rc" "$tmpdir/abs.log"

test ! -e "$abs/ABSOLUTE" ||
    fail "a savename hook writing an absolute path left the mirror: $(outside_files "$abs")"
assert_kept "$abs" 'the absolute name was refused'

# ---------------------------------------------------------------------------
# Control: an ordinary rename still reaches the filesystem, so the two checks
# above cannot pass by breaking every savename hook.
# ---------------------------------------------------------------------------
ok="$tmpdir/ok"
mkdir -p "$ok/mirror"
rc=0
local_crawl --log "$tmpdir/ok.log" -O "$ok/mirror" "${common[@]}" \
    --wrapper "${lib},sub,renamed" \
    "http://127.0.0.1:${SRV_PORT}/index.html" || rc=$?
test "$rc" -eq 0 || fail_dump "httrack exited $rc" "$tmpdir/ok.log"

renamed="$ok/mirror/$host/renamed/page.html"
test -f "$renamed" || fail "an ordinary savename hook no longer renames: nothing at $renamed"
grep -q SUBPAGE <"$renamed" || fail "$renamed is not the page we served"
stray=$(outside_files "$ok")
test -z "$stray" || fail "an ordinary rename wrote outside the mirror: $stray"

ok "a savename hook cannot leave the mirror, and an ordinary rename still works"

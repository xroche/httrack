#!/bin/bash
#
# The shipped example wrappers took their arguments and the engine's link and
# save buffers with strcpy/strcat into fixed fields. They now refuse what does
# not fit; the fields themselves are what the sizes below come from.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

: "${top_srcdir:=..}"

top="${abs_top_srcdir:?not run under make check}"

resolve() { # resolve BASE -> the built module, suffix included
    local base=$1 suffix
    for suffix in so dylib; do
        if [ -r "${base}.${suffix}" ]; then
            printf '%s\n' "${base}.${suffix}"
            return 0
        fi
    done
    return 1
}

# No strcat() may come back to these files: each one's destination is a fixed
# field the caller never passes a size for.
work=$(mktemp -d "${TMPDIR:-/tmp}/libbounds.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "$work"

find "$top/libtest" -name 'callbacks-example-*.c' -print |
    LC_ALL=C sort >"$work/files"
test "$(lines_of "$work/files")" -eq 10 ||
    fail "expected 10 example wrappers, found $(lines_of "$work/files")"

xargs grep -nHE '(^|[^_[:alnum:]])strcat[[:space:]]*\(' <"$work/files" \
    >"$work/found" || true
printf '  strcat(temp, link);\n' >"$work/dirty.c"
grep -qE '(^|[^_[:alnum:]])strcat[[:space:]]*\(' "$work/dirty.c" ||
    fail "the scan cannot see a strcat, so a clean result proves nothing"
test ! -s "$work/found" ||
    fail_dump "an example wrapper appends into a fixed field again; bound it with snprintf" "$work/found"

[ "${EXAMPLE_LIBS:-yes}" = yes ] || skip "--disable-example-libs builds no plugin"
[ -n "${FILENAME2_LIB:-}" ] || skip "FILENAME2_LIB unset, no automake environment"

f2=$(resolve "${FILENAME2_LIB}") || skip "nothing built at ${FILENAME2_LIB}.so"
cf=$(resolve "${CONTENTFILTER_LIB}") || skip "nothing built at ${CONTENTFILTER_LIB}.so"

# 256 is the width of filename2's string1 and string2. One over is what used to
# be copied in unchecked. Nothing longer is worth trying: htscoremain.c caps
# every argv element below HTS_CDLMAXSIZE (1024) at src/htscoremain.c:463.
long256=$(printf 'a%.0s' $(seq 256))

# A URL is needed or httrack prints its usage before loading anything. The plug
# fails first, so nothing is ever fetched from it.
refuses() { # refuses WHAT WRAPPER-ARG
    local what=$1 warg=$2 out rc=0
    out=$(httrack -O "$work/mirror" --wrapper "$warg" \
        'http://127.0.0.1:1/never' 2>&1) || rc=$?
    grep -q 'callback error' <<<"$out" ||
        fail "$what: the wrapper accepted it (rc=$rc), output: $out"
    grep -q 'unable to plug the module' <<<"$out" ||
        fail "$what: the refusal did not stop the option, output: $out"
}

# An empty string1 matched at every position without advancing, so the rewrite
# loop appended string2 forever.
refuses "empty search string" "${f2},,replacement"
refuses "over-long search string" "${f2},${long256},b"
refuses "over-long replacement" "${f2},a,${long256}"

# contentfilter splits the list into a 128-entry pointer array and used to keep
# writing past the end of it. 200 one-character keywords fit in one argv element.
keywords=$(printf 'k,%.0s' $(seq 199))k
accepted=$(httrack -O "$work/cf" --wrapper "${cf},${keywords}" \
    'http://127.0.0.1:1/never' 2>&1 |
    grep -c 'will crawl pages with' || true)
test "$accepted" -gt 0 ||
    fail "contentfilter took no keyword at all, so this proves nothing"
test "$accepted" -le 127 ||
    fail "contentfilter accepted $accepted keywords into a 128-entry array"

# The feature still works: "simple" in the save path becomes "plain".
bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --found 'plain/basic.html' \
    httrack 'BASEURL/simple/basic.html' --wrapper "${f2},simple,plain"

echo "example wrappers refuse over-long arguments, and the rename still works"

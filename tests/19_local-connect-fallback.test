#!/bin/bash
#
# A host that resolves to several addresses must fall back to the next one when
# a connect fails, instead of giving up on the first (dead IPv6 on a dual-stack
# host, ...). HTTRACK_DEBUG_RESOLVE pins "deadhost" to a refused address first
# (127.0.0.2, nothing listening) then the live server (127.0.0.1): the crawl
# only succeeds if httrack retries the second address. A second case pins every
# address to a refused one, so the slot must exhaust the list and error out
# (rather than hang or loop).

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

if test "${V6_SUPPORT:-}" == "no"; then
    echo "no IPv6 support (resolver list/override is IPv6-only), skipping"
    exit 77
fi
# The fixture needs a second loopback IP (dead 127.0.0.2 + live 127.0.0.1) for
# the fallback to have a target; GNU/Hurd has only 127.0.0.1, so skip there.
case "$HTS_OS" in
GNU | GNU/*)
    echo "GNU/Hurd: single loopback IP, connect-fallback fixture unbuildable, skipping"
    exit 77
    ;;
esac

tmpdir=$(mktemp -d)

cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

# bind the live server to 127.0.0.1 only, so 127.0.0.2 refuses the connect
local_server_start --log "$tmpdir/srv.out" --bind 127.0.0.1

out="$tmpdir/crawl"
# macOS has only 127.0.0.1, so the dead 127.0.0.x connects block to the timeout
# instead of refusing instantly (as on Linux); a small --timeout + --retries=0
# bound the stall without changing what the fallback exercises.
HTTRACK_DEBUG_RESOLVE="deadhost:127.0.0.2,127.0.0.1" \
    local_crawl --log "$tmpdir/log" "http://deadhost:${SRV_PORT}/simple/basic.html" -O "$out" -c1 --robots=0 --timeout=5 --retries=0 --quiet -Z

log="$out/hts-log.txt"

# the dead address was tried, then the next one (proves the fallback ran)
if ! grep -q "trying next address" "$log"; then
    echo "FAIL: no connect fallback happened"
    cat "$log"
    exit 1
fi

# 0 errors and the file was actually fetched (over the live address)
errs=$(count_log_errors "$log")
test "$errs" == "0" || {
    echo "FAIL: $errs error(s) reported"
    grep -iE "Error:" "$log"
    exit 1
}
test -f "$out/deadhost_${SRV_PORT}/simple/basic.html" || {
    echo "FAIL: basic.html not downloaded via fallback"
    find "$out" -type f
    exit 1
}

# every address dead: the slot exhausts the list, then errors out (the harness
# timeout would catch a hang/loop)
out2="$tmpdir/crawl2"
HTTRACK_DEBUG_RESOLVE="alldead:127.0.0.2,127.0.0.3" \
    local_crawl --log "$tmpdir/log2" "http://alldead:${SRV_PORT}/simple/basic.html" -O "$out2" -c1 --robots=0 --timeout=5 --retries=0 --quiet -Z
log2="$out2/hts-log.txt"

grep -q "trying next address" "$log2" ||
    fail_dump "exhaustion path never tried the fallback address" "$log2"
grep -iqE "^[0-9:]*[[:space:]]Error:" "$log2" ||
    fail_dump "all addresses failing did not report an error" "$log2"
test ! -f "$out2/alldead_${SRV_PORT}/simple/basic.html" || fail "file downloaded despite every address failing"

echo "OK: connect fallback succeeds, and exhausting all addresses errors out"

# Both cases above answer the connect with a refusal, which the engine sees as a
# ready socket carrying an error. A dead IPv6 on a dual-stack host instead drops
# the SYN, and that path is the one #1942 broke: it waits for the deadline. Only
# Linux lets us build it, because a listener whose accept queue is full drops
# every later SYN there, where macOS and the BSDs complete or refuse it.
case "$HTS_OS" in
Linux)
    drop_py="$tmpdir/drop.py"
    cat >"$drop_py" <<'PYEOF'
import socket, sys, time

# Hold 127.0.0.2:PORT with a full accept queue and never accept, so every
# later SYN is dropped and a connect to it hangs instead of being refused.
port = int(sys.argv[1])
srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.2", port))
srv.listen(1)
held = []
for _ in range(6):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setblocking(False)
    s.connect_ex(("127.0.0.2", port))
    held.append(s)
print("ready", flush=True)
while True:
    time.sleep(3600)
PYEOF
    "${SRV_PYTHON}" "$drop_py" "$SRV_PORT" >"$tmpdir/drop.out" 2>&1 &
    drop_pid=$!
    drop_stop() {
        kill "$drop_pid" 2>/dev/null
        wait "$drop_pid" 2>/dev/null
    }
    cleanup_push drop_stop
    # The fixture is useless if the address answers, so prove it does not.
    for _ in $(seq 1 50); do
        test -s "$tmpdir/drop.out" && break
        sleep 0.1
    done
    grep -q ready "$tmpdir/drop.out" ||
        fail_dump "the dropping fixture never came up" "$tmpdir/drop.out"
    # The connect must TIME OUT, not merely fail: with
    # net.ipv4.tcp_abort_on_overflow=1 a full queue sends a RST instead, and a
    # refusal is the path the two cases above already cover. Reading "it failed"
    # as "it dropped" would silently test nothing new.
    probe_rc=0
    timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.2/${SRV_PORT}" 2>/dev/null ||
        probe_rc=$?
    if test "$probe_rc" -ne 124; then
        echo "127.0.0.2:${SRV_PORT} did not drop the connect (rc=${probe_rc}); skipping that case"
    else
        out3="$tmpdir/crawl3"
        HTTRACK_DEBUG_RESOLVE="drophost:127.0.0.2,127.0.0.1" \
            local_crawl --log "$tmpdir/log3" "http://drophost:${SRV_PORT}/simple/basic.html" -O "$out3" -c1 --robots=0 --timeout=4 --retries=0 --quiet -Z
        log3="$out3/hts-log.txt"
        grep -q "trying next address" "$log3" ||
            fail_dump "a dropped SYN never reached the next address" "$log3"
        test -f "$out3/drophost_${SRV_PORT}/simple/basic.html" ||
            fail_dump "basic.html not downloaded past a dropped SYN" "$log3"
        echo "OK: a dropped SYN falls back before the slot's timeout"
    fi
    ;;
*)
    echo "a dropped SYN needs a full accept queue, which only Linux gives; skipping that case"
    ;;
esac

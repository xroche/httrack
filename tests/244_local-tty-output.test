#!/bin/bash
#
# Requires -%v1/-%v2 to write plain lines when stdout is redirected, and to still
# paint escapes when stdout is a real terminal (the pty controls at the end).

set -eu

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

python=$(find_python) || skip "python3 not found"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_ttyout.XXXXXX") || exit 1
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

local_server_start
url="http://127.0.0.1:${SRV_PORT}/simple/basic.html"

# Stdin is the pty too, and never written to, so it never reads as a keypress.
ttyrun=$(nativepath "${testdir}/ttyrun.py")

# crawl <label> <httrack args...>, stdout to a pipe; CRLF from the Windows CRT
# is normalized away so only a CR the display wrote is left. --quiet would gate
# the spinner on its own, so the caller decides.
crawl() {
    local label=$1
    shift
    run_with_timeout 120 httrack -O "${tmpdir}/m_${label}" --robots=0 \
        --timeout=30 --retries=1 -c1 "$@" "$url" >"${tmpdir}/raw_${label}" 2>&1 || true
    sed $'s/\r$//' "${tmpdir}/raw_${label}" >"${tmpdir}/out_${label}"
}

# crawl_tty <label> <httrack args...>, same but stdout is a terminal
crawl_tty() {
    local label=$1
    shift
    run_with_timeout 120 "$python" "$ttyrun" "${tmpdir}/out_${label}" -- \
        httrack -O "${tmpdir}/m_${label}" --robots=0 --timeout=30 --retries=1 \
        -c1 "$@" "$url" >/dev/null 2>&1 || true
}

# count <label> <ERE>
count() {
    LC_ALL=C count_matching_lines "$2" "${tmpdir}/out_$1"
}

# expect <description> <actual> <op> <bound> <label>
expect() {
    printf '[%s] ..\t' "$1"
    if test "$2" -"$3" "$4"; then
        echo "OK"
    else
        echo "FAIL: got $2"
        LC_ALL=C head -c 400 "${tmpdir}/out_$5" | cat -v >&2
        exit 1
    fi
}

esc=$'\033'
cr=$'\r'

# Every crawl asserts it ran: `|| true` above would otherwise let a httrack that
# died at startup pass every absence check below.
ran() {
    expect "$1 ran" "$(count "$2" '^Mirror launched')" ge 1 "$2"
}

crawl v1 --quiet -%v1
ran "-%v1" v1
expect "-%v1 into a pipe writes no escape" "$(count v1 "$esc")" eq 0 v1
expect "-%v1 into a pipe writes no CR" "$(count v1 "$cr")" eq 0 v1
# Teeth: the completion lines must actually be there, each ending its own line.
expect "-%v1 keeps one line per file" "$(count v1 ' - OK$')" ge 2 v1

crawl v2 --quiet -%v2
ran "-%v2" v2
expect "-%v2 into a pipe writes no escape" "$(count v2 "$esc")" eq 0 v2
expect "-%v2 into a pipe writes no CR" "$(count v2 "$cr")" eq 0 v2

# The spinner is the default display. POSIX forces quiet off a tty and silences
# it there anyway, so only Windows, which never probed the terminal, reaches the
# gate this asserts.
crawl v0 -%v0
ran "-%v0" v0
expect "the spinner writes no CR into a pipe" "$(count v0 "$cr")" eq 0 v0

if target_is_windows; then
    echo "[terminal controls] ..	skipped (no pty)"
    exit 0
fi

# Controls: suppressing the escapes off a terminal must not have suppressed the
# display on one.
crawl_tty ttyv2 -%v2
expect "-%v2 still paints the panel on a terminal" "$(count ttyv2 "$esc")" ge 20 ttyv2

crawl_tty ttyv0 -%v0
expect "the spinner still turns on a terminal" "$(count ttyv0 "$cr")" ge 1 ttyv0

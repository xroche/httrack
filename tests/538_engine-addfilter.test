#!/bin/bash
#
# hts_addfilter() and hts_setfilters() queue signed scan rules within the length
# cap, in call order, and refuse the rest (#128).

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

out=$(httrack -O /dev/null -#test=addfilter)

for want in "minus: queued=1 kept=1" "plus: queued=1 kept=1" \
    "unsigned: queued=0 kept=0" "minus only: queued=0 kept=0" \
    "plus only: queued=0 kept=0" "newline: queued=0 kept=0" \
    "empty: queued=0 kept=0" "at the cap: queued=1 kept=1" \
    "past the cap: queued=0 kept=0" "two rules: ordered=1" \
    "set with a bad rule: refused=1" "set supersedes earlier adds: ok=1" \
    "empty set: ok=1" \
    "addfilter self-test OK"; do
    grep -qxF "$want" <<<"$out" || fail "missing '$want' in: $out"
done

out=$(httrack -O /dev/null -#test=filterremove)
for want in "remove none: ok=1" "remove one: ok=1" "remove all: ok=1" \
    "filterremove self-test OK"; do
    grep -qxF "$want" <<<"$out" || fail "missing '$want' in: $out"
done

out=$(httrack -O /dev/null -#test=filterlayout)
grep -qxF "layout after set and add: ok=1" <<<"$out" || fail "layout: $out"

out=$(httrack -O /dev/null -#test=filterkeep)
for want in "unrelated rule keeps both: ok=1" "junk rule drops only junk: ok=1"; do
    grep -qxF "$want" <<<"$out" || fail "missing '$want' in: $out"
done

echo "PASS"

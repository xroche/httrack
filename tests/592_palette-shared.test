#!/bin/bash
#
# The docs and the WebHTTrack UI share html/palette.css. Each must resolve every
# token it reads, and each install tree must carry its own copy of the palette.
# The UI must load user.css last, and keep what themes rely on: a class per page
# and colours read from variables.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

srcdir="${abs_top_srcdir:?not run under make check}"
html="${srcdir}/html"

# Prints the custom properties a stylesheet defines, one per line.
defined() { grep -oE -- '--[A-Za-z0-9_-]+[[:space:]]*:' "$@" | tr -d ' \t:' | sort -u; }

palette=$(defined "${html}/palette.css")
# The palette has 11 distinct tokens.
test "$(grep -c . <<<"${palette}")" -ge 11 || fail "palette.css defines too few tokens: ${palette}"

work=$(mktemp -d "${TMPDIR:-/tmp}/palette.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${work}"

checked=0
for css in "${html}/doc.css" "${html}/server/style.css"; do
    grep -q '@import url(\(\.\./\)\?palette.css);' "${css}" || fail "${css} does not import palette.css"
    known=$(printf '%s\n' "${palette}" "$(defined "${css}" || true)")
    while IFS= read -r used; do
        test -n "${used}" || continue
        grep -qxF -- "${used}" <<<"${known}" || fail "${css##*/} reads ${used}, which nothing defines"
        checked=$((checked + 1))
    done <<<"$(grep -oE 'var\(--[A-Za-z0-9_-]+' "${css}" | sed 's/^var(//' | sort -u)"
done
test "${checked}" -ge 22 || fail "only ${checked} var() references found"

# Themes may read the shared palette and the UI hooks defined by style.css.
# Check every shipped theme so a typo in var(--...) cannot land unnoticed.
ui=$(defined "${html}/server/style.css")
for css in "${html}"/server/themes/*/theme.css; do
    test -f "${css}" || continue
    known=$(printf '%s\n' "${palette}" "${ui}" "$(defined "${css}" || true)")
    while IFS= read -r used; do
        test -n "${used}" || continue
        grep -qxF -- "${used}" <<<"${known}" || fail "${css#"${html}"/} reads ${used}, which nothing defines"
    done <<<"$(grep -oE 'var\(--[A-Za-z0-9_-]+' "${css}" | sed 's/^var(//' | sort -u)"
done

# A theme overrides style.css, and the user stylesheet overrides both.
pages=0
for page in "${html}"/server/*.html; do
    grep -q 'href="style.css"' "${page}" || continue
    order=$(grep -oE 'href="(style|/server/theme|user)\.css"' "${page}" | tr '\n' ' ')
    test "${order}" = 'href="style.css" href="/server/theme.css" href="user.css" ' ||
        fail "${page##*/} loads ${order:-nothing}, not style.css, theme.css, then user.css"
    # Themes target a page by this class.
    name=${page##*/}
    grep -qE "<body class=\"([^\"]* )?page-${name%.html}[\" ]" "${page}" ||
        fail "${name} has no page-${name%.html} body class"
    pages=$((pages + 1))
done
test "${pages}" -ge 21 || fail "only ${pages} UI pages load style.css"

# Prints each colour declaration that reads no variable, or a variable with a
# literal fallback. The values none, 0, transparent and inherit set no colour.
fixed_colours() {
    tr '\n' ' ' <"$1" |
        awk '{ gsub(/\/\*([^*]|\*+[^*\/])*\*+\//, ""); gsub(/[{};]/, "\n"); print }' |
        awk '{ sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); t = tolower($0) }
            t ~ /^([a-z-]*color|background(-image)?|border(-[a-z]+)*|outline|(box|text)-shadow|fill|stroke)[[:space:]]*:/ &&
            (t !~ /var\(/ || t ~ /var\(--[^,)]*,/) && t !~ /:[[:space:]]*(none|0|transparent|inherit)$/'
}
# A colour written as a literal is one no theme can change.
probe="${work}/probe.css"
cat >"${probe}" <<'EOF2'
:root { --x: #000; color-scheme: dark; }
#a { COLOR: Black; border: 1px solid var(--x); background: none; outline: 0; box-shadow: transparent; color: inherit; /* fill: red; */ caret-color: var(--x, red) }
EOF2
test "$(fixed_colours "${probe}" | tr '\n' '|')" = "COLOR: Black|caret-color: var(--x, red)|" ||
    fail "fixed_colours misreads the probe: $(fixed_colours "${probe}")"
fixed=$(fixed_colours "${html}/server/style.css")
test -z "${fixed}" || fail "style.css sets colours a theme cannot change: ${fixed}"

# Debian ships the docs and the UI in different packages, so both need a copy.
stage_install_target install "${work}/inst" "${work}/log" html ||
    fail "make -C html install failed"
for css in doc.css server/style.css; do
    installed=$(find "${work}/inst" -path "*/${css}" -type f)
    test -n "${installed}" || fail "${css} not installed"
    ref=$(sed -n 's/^@import url(\(.*\));$/\1/p' "${installed}")
    test -f "$(dirname "${installed}")/${ref}" ||
        fail "installed ${css} imports ${ref}, which is not beside it"
done

# Debian moves files by these lists and never checks for a file left behind.
files="${srcdir}/debian/webhttrack-common.files"
if test -d "${srcdir}/debian"; then
    grep -qx 'usr/share/httrack/html/palette.css' "${files}" ||
        fail "${files} does not ship the UI's palette.css"
fi

echo "palette: ${checked} var() references resolve, ${pages} UI pages load user.css last"

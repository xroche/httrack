#!/bin/bash
#
# Only a winprofile.ini declaring Charset=UTF-8 skips the ANSI conversion of
# its category; an absent or unknown value stays legacy.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

dir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_profilecharset.XXXXXX")
cleanup_push rm -rf "$dir"

assert_selftest "profilecharset self-test OK" profilecharset "$dir"

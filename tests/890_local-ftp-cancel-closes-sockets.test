#!/bin/bash
#
# A per-link cancel must close the FTP control and data sockets, whether it
# lands mid-body or while the client waits for the RETR reply.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

if ! target_is_linux; then
    skip "cancel-sockets: LD_PRELOAD and /proc are Linux-only here"
fi
if [ ! -r "${CLOSETRACK_LA:-}" ]; then
    fail "cancel-sockets: ${CLOSETRACK_LA:-\$CLOSETRACK_LA} was not built"
fi
if grep -q "^dlname=''" "$CLOSETRACK_LA"; then
    skip "cancel-sockets: static-only build, nothing to preload"
fi
test -r "${FTPCANCEL_LIB:-}" || fail "cancel-sockets: the cancel shim was not built"

require_httrack

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_ftpsock.XXXXXX")
crawlpid=
cleanup_push rm -rf "$tmpdir"

root="${tmpdir}/root"
out="${tmpdir}/crawl"
cmds="${tmpdir}/cmds"
trigger="${tmpdir}/trigger"
mkdir -p "$root" "$out"
for f in anchor body held; do
    awk 'BEGIN { s = sprintf("%0999d", 0); for (i = 0; i < 100; i++) print s }' \
        >"${root}/${f}.bin"
done
# anchor keeps the crawl alive after the two cancels, so its sockets can be read.
printf '/anchor.bin stall\n/body.bin stall\n/held.bin hold\n' >"${tmpdir}/modes"

ftp_server_start --root "$root" --mode-file "$(nativepath "${tmpdir}/modes")" \
    --log "$(nativepath "$cmds")"

kill_crawl() { test -z "$crawlpid" || kill_tree "$crawlpid"; }
cleanup_push kill_crawl

# Under the sanitizer stderr shim (tests/stderrwrap.c) the engine is its child.
engine_pid() {
    local stat line rest
    for stat in /proc/[0-9]*/stat; do
        line=$(cat "$stat" 2>/dev/null) || continue
        # Fields after the parenthesized command name: state, then ppid.
        rest=${line##*) }
        rest=${rest#* }
        test "${rest%% *}" != "$crawlpid" || {
            echo "${line%% *}"
            return
        }
    done
    echo "$crawlpid"
}

sockets() {
    local fd n=0
    for fd in /proc/"$enginepid"/fd/*; do
        case $(readlink "$fd" 2>/dev/null || true) in
        socket:*) n=$((n + 1)) ;;
        esac
    done
    echo "$n"
}

export ASAN_OPTIONS="${ASAN_OPTIONS:+$ASAN_OPTIONS:}verify_asan_link_order=0"
export FTPCANCEL_TRIGGER="$trigger"
export LD_PRELOAD="$FTPCANCEL_LIB"
url="ftp://127.0.0.1:${FTP_PORT}"
httrack "${url}/anchor.bin" "${url}/body.bin" "${url}/held.bin" -O "$out" \
    --quiet --disable-security-limits --robots=0 --timeout=0 --max-time=0 -c4 \
    >"${tmpdir}/log" 2>&1 &
crawlpid=$!
unset LD_PRELOAD

# All three in flight: two bodies on disk, and RETR sent for held.bin.
deadline=$((SECONDS + 60))
body=
until test -n "$body" && test -n "$(find "$out" -name anchor.bin)" &&
    test "$(count_matching_lines '^RETR ' "$cmds")" -eq 3; do
    test "$SECONDS" -lt "$deadline" || fail "the three transfers never started"
    body=$(find "$out" -name body.bin)
    poll_wait 1
done
enginepid=$(engine_pid)
before=$(sockets)
test "$before" -ge 4 || fail "only $before sockets with three transfers in flight"

printf '%s\n%s\n' "$body" "$(dirname "$body")/held.bin" >"${trigger}.tmp"
mv "${trigger}.tmp" "$trigger"

# Each cancelled transfer held a control and a data socket. The engine logs a
# cancel only once it reaches that link, after anchor.bin, so poll the count.
want=$((before - 4))
deadline=$((SECONDS + 30))
until test "$(sockets)" -le "$want"; do
    test "$SECONDS" -lt "$deadline" ||
        fail "$before sockets before the cancels and $(sockets) after, expected $want"
    kill -0 "$crawlpid" 2>/dev/null || fail "the crawl ended before the check"
    poll_wait 1
done
after=$(sockets)
kill_crawl
crawlpid=
test "$after" -eq "$want" || fail "$before sockets before the cancels and $after after, expected $want"
ok "both cancels closed their control and data sockets ($before to $after)"

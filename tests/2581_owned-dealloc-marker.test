#!/bin/bash
#
# On GCC 11+, a mismatched release of an exported owned result must warn, in C
# and in C++, while each documented deallocator stays silent.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top=$(cd "$top_srcdir" && pwd)
# htsfeatures.h is generated, so a hand run outside make check has none.
[ -n "${abs_top_builddir:-}" ] || skip "abs_top_builddir unset, no automake environment"
tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"

cat >"$tmp/probe.c" <<'PROBE'
#include "httrack-library.h"
#if !defined(__GNUC__) || __GNUC__ < 11 || defined(__clang__)
#error not GCC 11 or later
#endif
int probe(char *path);
int probe(char *path) {
  char *const dup = hts_strdup("a");
  void *const mem = hts_malloc(1);
  char *const categ = hts_getcategories(path, 1);
  char *const utf8 = hts_convertStringToUTF8("a", 1, "utf-8");
  const int ok = dup != NULL && mem != NULL && utf8 != NULL;

#if defined(BAD_DUP)
  free(dup);
#elif defined(BAD_MEM)
  free(mem);
#elif defined(BAD_CATEG)
  fclose((FILE *) categ);
#elif defined(BAD_UTF8)
  fclose((FILE *) utf8);
#else
  hts_free(dup);
  hts_free(mem);
  hts_free(categ);
  free(utf8);
#endif
  return ok;
}
PROBE
cp "$tmp/probe.c" "$tmp/probe.cc"

# The control runs first, so another compile error is not taken for the warning.
check() { # check LANG COMPILER-ARGV...
    local lang=$1 src
    shift
    src=$tmp/probe.c
    [ "$lang" = C ] || src=$tmp/probe.cc
    "$@" -c -o "$tmp/probe.o" -Werror=mismatched-dealloc "$src" 2>"$tmp/ctl.err" ||
        fail_dump "$lang: a documented deallocator warns" "$tmp/ctl.err"
    # fclose() is foreign to every allocator here, so it proves the marking.
    for bad in BAD_DUP BAD_MEM BAD_CATEG BAD_UTF8; do
        if "$@" -c -o "$tmp/probe.o" -Werror=mismatched-dealloc -D"$bad" "$src" 2>"$tmp/bad.err"; then
            fail "$lang: the $bad release compiles silently with $1"
        fi
        grep -q 'mismatched-dealloc' "$tmp/bad.err" ||
            fail_dump "$lang: the $bad probe fails for another reason" "$tmp/bad.err"
    done
    echo "OK: $lang ($1) warns on each mismatched release"
}

inc=(-I"$abs_top_builddir" -I"$abs_top_builddir/src" -I"$top/src")
# Configure's CPPFLAGS carries brew's keg-only openssl include path.
if [ -n "${TEST_CPPFLAGS:-}" ]; then
    read -r -a extra <<<"$TEST_CPPFLAGS"
    inc+=("${extra[@]}")
fi
printf '#if !defined(__GNUC__) || __GNUC__ < 11 || defined(__clang__)\n#error\n#endif\n' >"$tmp/gcc11.c"
read -r -a cc <<<"${CC:-cc}"
command -v "${cc[0]}" >/dev/null 2>&1 || skip "no C compiler (${cc[0]})"
"${cc[@]}" -fsyntax-only "$tmp/gcc11.c" 2>/dev/null || skip "${cc[0]} is not GCC 11 or later"
check C "${cc[@]}" "${inc[@]}"

read -r -a cxx <<<"${CXX:-c++}"
if command -v "${cxx[0]}" >/dev/null 2>&1 &&
    "${cxx[@]}" -x c++ -fsyntax-only "$tmp/gcc11.c" 2>/dev/null; then
    check C++ "${cxx[@]}" "${inc[@]}"
else
    echo "note: no GCC 11+ C++ compiler, C++ leg not run" >&2
fi

#!/bin/bash
# -#test=features is what every other test gates on, so a wrong answer there does
# not fail anything: it makes cases vanish into a skip. Pin the reporter against
# the config.h the binary was built from, and against one conversion only a real
# iconv can do.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

require_httrack

[ -n "${abs_top_builddir:-}" ] || skip "abs_top_builddir unset, no automake environment"
builddir="${abs_top_builddir}"
config="${builddir}/config.h"
test -r "${config}" || skip "no config.h in ${builddir}"

report=$(httrack -#test=features) || fail "httrack -#test=features failed"
test -n "${report}" || fail "httrack -#test=features said nothing"

# macro_is CONFIG MACRO VALUE: does config.h define MACRO to VALUE?
macro_is() {
    grep -q "^#define $2 $3\$" "$1"
}

# want_feature NAME: 1 or 0, derived from config.h rather than from the report.
want_feature() {
    case $1 in
    brotli) macro_is "${config}" HTS_USEBROTLI 1 && echo 1 || echo 0 ;;
    zstd) macro_is "${config}" HTS_USEZSTD 1 && echo 1 || echo 0 ;;
    # htsbacktrace.c needs __linux as well as the macro.
    backtrace)
        if target_is_linux && macro_is "${config}" HAVE_BACKTRACE 1; then
            echo 1
        else
            echo 0
        fi
        ;;
    # Absent, or defined to anything but 0, means iconv is compiled in.
    iconv) macro_is "${config}" HTS_USEICONV 0 && echo 0 || echo 1 ;;
    *) fail "unknown feature $1" ;;
    esac
}

known="brotli zstd backtrace iconv"
for f in ${known}; do
    got=$(sed -n "s/^${f} //p" <<<"${report}")
    test -n "${got}" || fail "-#test=features reports nothing for ${f}"
    want=$(want_feature "${f}")
    test "${got}" = "${want}" ||
        fail "-#test=features says ${f} ${got}, config.h says ${want}"
    echo "ok: ${f} reported as ${got}, matching config.h"
done

# A line this test does not know about is a feature nothing here checks, and
# have_feature will gate on it the moment a test asks. Fail rather than drift.
while read -r name value; do
    case " ${known} " in
    *" ${name} "*) ;;
    *) fail "-#test=features reports '${name} ${value}', which no test checks" ;;
    esac
done <<<"${report}"
echo "ok: the report carries no feature this test does not check"

# config.h and the report can agree and both be wrong about the binary, so one
# feature is also checked against behaviour. gb2312 is multi-byte, which no
# 256-entry codepage table holds, so it converts only where iconv is linked.
ni=$(httrack -#test=charset gb2312 hex:c4e3 2>/dev/null) || ni=
if have_feature iconv; then
    # The value, not just its presence: a wrong non-empty answer is still wrong.
    test "${ni}" = "你" ||
        fail "iconv is reported on, but gb2312 0xc4e3 gave '${ni}', expected 你"
    echo "ok: gb2312 converts to 你, which only iconv does"
else
    test -z "${ni}" ||
        fail "iconv is reported off, but gb2312 converted to '${ni}'"
    echo "ok: gb2312 does not convert, as a tables-only build cannot"
fi

# windows-1252 is the spelling HTTP headers use for the cp1252 table, and the
# fallback used to miss it, so it is the case a tables-only build must still do.
got=$(httrack -#test=charset windows-1252 hex:80 2>/dev/null) || got=
test "${got}" = "€" || fail "windows-1252 0x80 gave '${got}', expected the euro sign"
echo "ok: windows-1252 resolves to the cp1252 table"

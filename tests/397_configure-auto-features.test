#!/bin/bash
# Every optional feature defaulted to "auto", so the same source built a
# different binary on each distribution: Gentoo linked both codecs off a recipe
# naming neither, and Void would have shipped both off. --disable-auto-features
# moves those defaults to no and leaves an explicit flag alone.

# TEST_TIMEOUT_AT_LEAST: 900

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

srcdir="${abs_top_srcdir:?not run under make check}"
test -r "${srcdir}/configure" || skip "no configure in ${srcdir}"

# $CC carries its flags on some hosts, so it is an argv, never one word.
read -r -a cc_argv <<<"${CC:-cc}"
command -v "${cc_argv[0]}" >/dev/null 2>&1 || skip "no C compiler (${cc_argv[0]})"

work=$(mktemp -d "${TMPDIR:-/tmp}/autofeat.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${work}"

# automake refuses an out-of-tree configure when srcdir holds a config.status,
# which an in-tree build leaves there; a symlink farm without that one file is
# the same tree to configure.
shadow=${work}/srcdir
mkdir -p "${shadow}"
for entry in "${srcdir}"/*; do
    test "${entry##*/}" = config.status || ln -s "${entry}" "${shadow}/"
done
test -r "${shadow}/configure" || fail "the shadow source tree has no configure"

features="brotli zstd backtrace iconv"

# The "checking whether to ..." text configure prints for a feature.
feature_line() { # feature_line NAME
    case $1 in
    brotli) echo "whether to enable the brotli content coding" ;;
    zstd) echo "whether to enable the zstd content coding" ;;
    backtrace) echo "whether to enable symbolic crash traces" ;;
    iconv) echo "whether to convert charsets with iconv" ;;
    *) fail "unknown feature $1" ;;
    esac
}
# How a packager asks for it explicitly.
feature_flag() { # feature_flag NAME
    case $1 in
    brotli) echo "--with-brotli" ;;
    zstd) echo "--with-zstd" ;;
    backtrace) echo "--enable-backtrace" ;;
    iconv) echo "--with-iconv" ;;
    *) fail "unknown feature $1" ;;
    esac
}
# The macro it sets in config.h.
feature_macro() { # feature_macro NAME
    case $1 in
    brotli) echo "HTS_USEBROTLI" ;;
    zstd) echo "HTS_USEZSTD" ;;
    backtrace) echo "HAVE_BACKTRACE" ;;
    iconv) echo "HTS_USEICONV" ;;
    esac
}
# The link variable src/Makefile substitutes, or "" where it adds none.
feature_libs() { # feature_libs NAME
    case $1 in
    brotli) echo "BROTLI_LIBS" ;;
    zstd) echo "ZSTD_LIBS" ;;
    backtrace) echo "BACKTRACE_LIBS" ;;
    esac
}
# Whether the macro must also reach the installed htsfeatures.h, or "".
feature_public() { # feature_public NAME
    case $1 in
    brotli | zstd) echo yes ;;
    esac
}
# What libhttrack.pc must name when it is on, or "" where it names nothing.
feature_pc() { # feature_pc NAME
    case $1 in
    brotli) echo "brotlidec" ;;
    zstd) echo "zstd" ;;
    esac
}

# verdict DIR NAME: the qualified answer, e.g. "yes (auto)".
verdict() {
    local text
    text=$(feature_line "$2")
    sed -n "s/^checking ${text}\\.\\.\\. //p" "$1/configure.log" | tail -1
}

# No --cache-file: the probes cache as ac_cv_lib_brotlidec_* and friends, so one
# cache shared across runs replays the first run's answer and nothing is probed.
run_configure() { # run_configure DIR ARG...
    local dir=$1 rc=0
    shift
    mkdir -p "${dir}"
    # A keg-only openssl (brew) makes --enable-https a hard error, and TLS is
    # not one of the features this switch moves.
    (cd "${dir}" && bash "${shadow}/configure" --enable-https=auto "$@") \
        >"${dir}/configure.log" 2>&1 || rc=$?
    # autoconf only warns about a flag it does not know, so a run that lost one
    # would otherwise report the status quo as a pass.
    if test "${rc}" -eq 0 && grep -q 'unrecognized options' "${dir}/configure.log"; then
        fail_dump "configure did not recognise every flag it was given" "${dir}/configure.log"
    fi
    return "${rc}"
}

# assert_state DIR NAME on|off: everything DIR's generated files must say about
# NAME in that state. Absolute, because two runs of an equally broken tree agree
# with each other and prove nothing.
assert_state() { # assert_state DIR NAME on|off
    local dir=$1 f=$2 want=$3 macro libs pc line value
    macro=$(feature_macro "${f}")
    libs=$(feature_libs "${f}")
    pc=$(feature_pc "${f}")
    value=$(test "${want}" = on && echo 1 || echo 0)

    # HAVE_BACKTRACE is defined or absent; the rest are defined to 1 or 0.
    if test "${f}" = backtrace; then
        if test "${want}" = on; then
            grep -q '^#define HAVE_BACKTRACE 1$' "${dir}/config.h" ||
                fail_dump "${f}: config.h does not define HAVE_BACKTRACE" "${dir}/config.h"
        else
            ! grep -q '^#define HAVE_BACKTRACE' "${dir}/config.h" ||
                fail_dump "${f}: config.h still defines HAVE_BACKTRACE" "${dir}/config.h"
        fi
    else
        grep -q "^#define ${macro} ${value}\$" "${dir}/config.h" ||
            fail_dump "${f}: config.h does not define ${macro} to ${value}" "${dir}/config.h"
    fi

    # The installed header a consumer of libhttrack compiles against. config.h
    # is not installed and cannot stand in for it.
    if test -n "$(feature_public "${f}")"; then
        grep -q "^#define ${macro} ${value}\$" "${dir}/htsfeatures.h" ||
            fail_dump "${f}: htsfeatures.h does not carry ${macro} ${value}" \
                "${dir}/htsfeatures.h"
    fi

    # A macro left at 1 beside an emptied link line is an unresolved symbol at
    # link time, so the "on" half is asserted as loudly as the "off" half.
    if test -n "${libs}"; then
        line=$(sed -n "s/^${libs} = *//p" "${dir}/src/Makefile")
        if test "${want}" = off; then
            test -z "${line}" || fail "${f}: ${libs} still links '${line}'"
        elif test "${f}" != backtrace; then
            # backtrace() is in libc on glibc, where nothing is linked for it.
            test -n "${line}" || fail "${f}: ${libs} is empty with the feature on"
        fi
    fi

    # The .pc is installed too, and it reaches its dependencies by a path that
    # neither config.h nor src/Makefile passes through.
    if test -n "${pc}"; then
        if test "${want}" = off; then
            ! grep -qE "^(Requires|Libs)\\.private:.*${pc}" "${dir}/src/libhttrack.pc" ||
                fail_dump "${f}: libhttrack.pc still names ${pc}" "${dir}/src/libhttrack.pc"
        else
            grep -qE "^(Requires|Libs)\\.private:.*${pc}" "${dir}/src/libhttrack.pc" ||
                fail_dump "${f}: libhttrack.pc does not name ${pc}" "${dir}/src/libhttrack.pc"
        fi
    fi
}

n=0
planned=10 # steps below; the last one needs the libraries to be installed

# A GNU-libiconv-shaped prefix: a header that renames iconv_open the way the
# real one does away from LIBICONV_PLUG, and a library under a subdirectory the
# bare prefix does not name. Both halves matter, because a probe that declares
# the symbol itself agrees where the compiler would not, and a -L naming the
# prefix rather than the libdir resolves to nothing.
# Prints the prefix, or fails when this host cannot build a shared library.
iconv_fixture() { # iconv_fixture SUBDIR
    local prefix=${work}/iconvdir lib ext=so
    lib=${prefix}/$1
    test "${HTS_OS}" != Darwin || ext=dylib
    mkdir -p "${prefix}/include" "${lib}"
    cat >"${prefix}/include/iconv.h" <<'HDR'
#ifndef HTS_FAKE_ICONV_H
#define HTS_FAKE_ICONV_H
#include <stddef.h>
typedef void *iconv_t;
#define iconv_open libiconv_open
#define iconv libiconv
#define iconv_close libiconv_close
extern iconv_t iconv_open(const char *to, const char *from);
extern size_t iconv(iconv_t cd, char **in, size_t *il, char **out, size_t *ol);
extern int iconv_close(iconv_t cd);
#endif
HDR
    cat >"${work}/fakeiconv.c" <<'SRC'
#include <stddef.h>
typedef void *iconv_t;
iconv_t libiconv_open(const char *to, const char *from) {
    (void) to;
    (void) from;
    return (iconv_t) 0;
}
size_t libiconv(iconv_t cd, char **in, size_t *il, char **out, size_t *ol) {
    (void) cd; (void) in; (void) il; (void) out; (void) ol;
    return 0;
}
int libiconv_close(iconv_t cd) { (void) cd; return 0; }
SRC
    "${cc_argv[@]}" -shared -fPIC -o "${lib}/libiconv.${ext}" "${work}/fakeiconv.c" \
        >/dev/null 2>&1 || return 1
    echo "${prefix}"
}

# Deleting or renaming the switch must not leave any host green, so the flags
# are checked before the first run and before any skip.
help=$(bash "${shadow}/configure" --help) || fail "configure --help failed"
for flag in --disable-auto-features $(for f in ${features}; do feature_flag "${f}"; done); do
    grep -q -e "${flag}" <<<"${help}" || fail "configure --help does not offer ${flag}"
done

# The flags the Debian build passes. --disable-auto-features makes them the whole
# optional set, so a flag dropped here ships a package that decodes less and
# nothing else notices.
# Every dh_auto_configure invocation, one per line, continuations joined. Each
# has to stand on its own: a later one overrides the first, so reading only the
# first lets a shorter list hide behind a complete one.
rules_flags() { # rules_flags FILE
    awk '/dh_auto_configure[ \t]+--/ { want = 1; line = "" }
         want { line = line " " $0 }
         want && !/\\$/ { gsub(/[ \t\\]+/, " ", line); print line; want = 0 }' "$1"
}
# Which features a flag list does not turn on, or "". --with-X=no is autoconf's
# spelling of --without-X, so =DIR asks for the feature and =no asks against it.
rules_missing() { # rules_missing FLAGS
    local flags=$1 f flag out=""
    for f in ${features}; do
        flag=$(feature_flag "${f}")
        case " ${flags} " in
        *" ${flag}=no "*) out="${out} ${f}" ;;
        *" ${flag} "* | *" ${flag}="*) ;;
        *) out="${out} ${f}" ;;
        esac
    done
    echo "${out# }"
}

rules="${srcdir}/debian/rules"
if test -r "${rules}"; then
    n=$((n + 1))
    lines=$(rules_flags "${rules}")
    test -n "${lines}" || fail "no dh_auto_configure invocation in ${rules}"
    while read -r flags; do
        case " ${flags} " in
        *" --disable-auto-features "*) ;;
        *) fail "a dh_auto_configure drops --disable-auto-features: ${flags}" ;;
        esac
        said=$(rules_missing "${flags}")
        test -z "${said}" ||
            fail "debian/rules asks for no ${said}, which --disable-auto-features then drops"
    done <<<"${lines}"

    # A reader that matched nothing would call any file complete, so put each
    # way of losing a feature past it and require the same check to name it.
    said=$(rules_missing "${lines//--with-zstd/}")
    test "${said}" = zstd || fail "a dropped --with-zstd went unreported: ${said:-(silence)}"
    said=$(rules_missing "${lines//--with-zstd/--with-zstd=no}")
    test "${said}" = zstd || fail "--with-zstd=no went unreported: ${said:-(silence)}"
    said=$(rules_missing "${lines//--with-zstd/--with-zstd=/opt/zstd}")
    test -z "${said}" || fail "--with-zstd=DIR reads as a refusal: ${said}"
    {
        cat "${rules}"
        printf '\tdh_auto_configure -- --disable-auto-features --with-brotli\n'
    } >"${work}/rules"
    said=$(rules_flags "${work}/rules" | awk 'END { print NR + 0 }')
    test "${said}" -eq 2 || fail "a second dh_auto_configure was not read: ${said} found"
    # The target line names dh_auto_configure without invoking it.
    printf 'override_dh_auto_configure:\n\ttrue\n' >"${work}/rules-override"
    said=$(rules_flags "${work}/rules-override")
    test -z "${said}" || fail "an override target read as an invocation: ${said}"
    echo "ok: every dh_auto_configure in debian/rules asks for every feature by name"
else
    planned=$((planned - 1))
    echo "no debian/rules under ${srcdir}, so the packaging flag list is not read" >&2
fi

# The cheap, host-independent steps run first: a slow leg that runs out of
# budget later still covers what the switch means.
n=$((n + 1))
# A value the switch does not understand must not read as one of the two it does.
! run_configure "${work}/bogus" --enable-auto-features=maybe ||
    fail_dump "--enable-auto-features=maybe was accepted" "${work}/bogus/configure.log"
grep -q 'bad value for auto-features' "${work}/bogus/configure.log" ||
    fail_dump "configure refused the value without saying which flag" "${work}/bogus/configure.log"
echo "ok: a value that is neither yes nor no is refused"

n=$((n + 1))
# Same for a feature's own tri-state: neither an unknown value nor a bare typo
# may fall through to a default.
! run_configure "${work}/btbogus" --enable-backtrace=bogus ||
    fail_dump "--enable-backtrace=bogus was accepted" "${work}/btbogus/configure.log"
grep -q 'bad value for backtrace' "${work}/btbogus/configure.log" ||
    fail_dump "configure refused the value without saying which flag" "${work}/btbogus/configure.log"
echo "ok: an unknown --enable-backtrace value is refused"

n=$((n + 1))
# The switch must not turn a library the packager named into a silent drop (#1502).
mkdir -p "${work}/empty"
! run_configure "${work}/reject" --disable-auto-features --with-brotli="${work}/empty" ||
    fail_dump "an explicit --with-brotli at an empty prefix was accepted" "${work}/reject/configure.log"
grep -q 'brotli requested at' "${work}/reject/configure.log" ||
    fail_dump "configure failed without naming the prefix it was given" "${work}/reject/configure.log"
echo "ok: an explicit prefix with no library still fails the build"

n=$((n + 1))
# backtrace() is implemented for Linux alone, so --enable-backtrace has to stay a
# notice off it: a recipe passes one flag list for every architecture it builds,
# and hurd and the BSDs must not FTBFS on it. Cross-configuring reaches that arm
# from a Linux runner.
run_configure "${work}/foreign" --host=x86_64-unknown-freebsd14 --enable-backtrace || true
got=$(verdict "${work}/foreign" backtrace)
case ${got} in
"no (not implemented on freebsd"*)
    echo "ok: an explicit --enable-backtrace off Linux is a notice, not an error"
    ;;
"") skip "the cross-configure stopped before reaching the backtrace verdict" ;;
*) fail_dump "a foreign host answered '${got}' rather than declining backtrace" \
    "${work}/foreign/configure.log" ;;
esac

n=$((n + 1))
# A bare --with-iconv is a request, so a host where iconv does not link must
# FTBFS rather than quietly fall back to the codepage tables. The header is
# there and the symbol is not, which is what a renaming libiconv header without
# its library looks like.
mkdir -p "${work}/noiconv"
cat >"${work}/noiconv/iconv.h" <<'HDR'
#ifndef HTS_NOICONV_H
#define HTS_NOICONV_H
#include <stddef.h>
typedef void *iconv_t;
#define iconv_open hts_absent_iconv_open
#define iconv hts_absent_iconv
#define iconv_close hts_absent_iconv_close
extern iconv_t iconv_open(const char *to, const char *from);
extern size_t iconv(iconv_t cd, char **in, size_t *il, char **out, size_t *ol);
extern int iconv_close(iconv_t cd);
#endif
HDR
! run_configure "${work}/ic-bare" --with-iconv "CPPFLAGS=-I${work}/noiconv ${CPPFLAGS:-}" ||
    fail_dump "a bare --with-iconv was accepted where iconv_open does not link" \
        "${work}/ic-bare/configure.log"
grep -q 'iconv requested but no iconv.h with a linkable iconv_open' \
    "${work}/ic-bare/configure.log" ||
    fail_dump "configure failed without saying that iconv was the request" \
        "${work}/ic-bare/configure.log"
echo "ok: a bare --with-iconv fails the build rather than falling back"

n=$((n + 1))
# --with-iconv=DIR is the form a keg-only or ports prefix needs, and the one arm
# of HTS_FIND_LIBDIR the codec test does not reach. The subdirectory is the
# fixture's own, so this means the same thing on a host with no real lib64.
if prefix=$(iconv_fixture lib64); then
    run_configure "${work}/icdir" --disable-auto-features --with-iconv="${prefix}" ||
        fail_dump "--with-iconv at a prefix with a renaming header failed" \
            "${work}/icdir/configure.log"
    got=$(verdict "${work}/icdir" iconv)
    test "${got}" = "yes (requested)" ||
        fail_dump "--with-iconv=DIR answered '${got}'" "${work}/icdir/configure.log"
    line=$(sed -n 's/^ICONV_LIBS = *//p' "${work}/icdir/src/Makefile")
    case " ${line} " in
    *" -L${prefix}/lib64 "*) ;;
    *) fail "ICONV_LIBS did not name the fixture's lib64: '${line}'" ;;
    esac
    case " ${line} " in
    *" -liconv "*) ;;
    *) fail "ICONV_LIBS resolved a renaming header without -liconv: '${line}'" ;;
    esac
    # The bare prefix is what the old codec code emitted, and it holds no library.
    case " ${line} " in
    *" -L${prefix} "*) fail "ICONV_LIBS named the bare prefix: '${line}'" ;;
    esac

    # A prefix carrying the header and no library must say where it looked.
    rm -rf "${prefix:?}/lib64"
    ! run_configure "${work}/icdir-nolib" --with-iconv="${prefix}" ||
        fail_dump "a prefix with no libiconv was accepted" "${work}/icdir-nolib/configure.log"
    grep -q 'no libiconv found in any of' "${work}/icdir-nolib/configure.log" ||
        fail_dump "configure rejected the prefix without naming the directories it tried" \
            "${work}/icdir-nolib/configure.log"
    echo "ok: --with-iconv=DIR resolves the libdir, links the renaming header, and reports a miss"
else
    planned=$((planned - 1))
    n=$((n - 1))
    echo "no shared library from ${cc_argv[0]}, so the iconv prefix case is skipped" >&2
fi

began=${SECONDS}
n=$((n + 1))
run_configure "${work}/off" --disable-auto-features ||
    fail_dump "--disable-auto-features was rejected" "${work}/off/configure.log"
for f in ${features}; do
    got=$(verdict "${work}/off" "${f}")
    case ${got} in
    "no (auto-features off)" | "no (not implemented on "*) ;;
    *) fail_dump "${f}: expected 'no (auto-features off)', got '${got}'" \
        "${work}/off/configure.log" ;;
    esac
    assert_state "${work}/off" "${f}" off
done
echo "ok: the switch turns every feature off, whatever the host has installed"
skip_if_out_of_budget "$((planned - n))" "$((SECONDS - began))"

began=${SECONDS}
n=$((n + 1))
run_configure "${work}/control" ||
    fail_dump "the control configure failed" "${work}/control/configure.log"
# Renaming a "checking whether to" string would silently empty this list and
# leave every feature unchecked, so an unreadable verdict fails rather than
# counting as absent. Only yes versus no is the host's to decide.
on=""
for f in ${features}; do
    got=$(verdict "${work}/control" "${f}")
    case ${got} in
    "yes (auto)") on="${on} ${f}" ;;
    "no (auto)" | "no (not implemented on "*) ;;
    *) fail_dump "${f}: the default run answered '${got}', which is no auto verdict" \
        "${work}/control/configure.log" ;;
    esac
done
echo "ok: every feature answers the default run; auto-enabled here:${on:- none}"
skip_if_out_of_budget "$((planned - n))" "$((SECONDS - began))"

if test -z "${on}"; then
    planned=$((planned - 1))
    echo "nothing is auto-enabled here, so no feature can be asked back on" >&2
else
    n=$((n + 1))
    flags=""
    for f in ${on}; do
        flags="${flags} $(feature_flag "${f}")"
    done
    # shellcheck disable=SC2086 # a deliberately split flag list
    run_configure "${work}/asked" --disable-auto-features ${flags} ||
        fail_dump "the switch rejected the flags beside it" "${work}/asked/configure.log"
    for f in ${on}; do
        got=$(verdict "${work}/asked" "${f}")
        test "${got}" = "yes (requested)" ||
            fail_dump "${f}: expected 'yes (requested)', got '${got}'" "${work}/asked/configure.log"
        assert_state "${work}/asked" "${f}" on
    done
    # And it must land on the default build exactly, or the switch has a side
    # effect on something outside the feature list.
    for gen in config.h htsfeatures.h src/Makefile src/libhttrack.pc; do
        sed "s|${work}/control|@BUILDDIR@|g" "${work}/control/${gen}" >"${work}/gen-control"
        sed "s|${work}/asked|@BUILDDIR@|g" "${work}/asked/${gen}" >"${work}/gen-asked"
        diff -u "${work}/gen-control" "${work}/gen-asked" ||
            fail "asking for each feature back does not reproduce the default ${gen}"
    done
    echo "ok: an explicit flag still wins, and reproduces the default build"
fi

assert_steps_ran "${planned}" "${n}"

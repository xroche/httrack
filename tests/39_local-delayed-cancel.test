#!/bin/bash
#
# Cancelled delayed-type-checks must not orphan .delayed placeholders (#483).
# The first page's headers push the crawl past -M (see the dcancel routes), so
# the stop lands while it waits for its type. -c1 then makes the namer pump
# sockets until that page is written to its placeholder.

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --log-found 'moved placeholder' \
    httrack 'BASEURL/dcancel/index.html' -M400000 -c1 -Z

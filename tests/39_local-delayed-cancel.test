#!/bin/bash
#
# Cancelled delayed-type-checks must not orphan .delayed placeholders (#483).
# The server holds the headers until -E1 fires, and -c1 keeps the only
# connection busy, so the type waiter pumps sockets past the stop. Two tries,
# because the stop can still miss the poll that receives the headers.

set -euo pipefail

: "${top_srcdir:=..}"

for _ in 1 2; do
    bash "$top_srcdir/tests/local-crawl.sh" \
        httrack 'BASEURL/dcancel/index.html' -E1 -c1 -A25000
done

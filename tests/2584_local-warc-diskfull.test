#!/bin/bash
#
# A failed WARC write is logged once, whether it fails mid-crawl or at close.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

require_httrack

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_warcfull.XXXXXX")
cleanup() { rm -rf "$tmpdir"; }
cleanup_push cleanup

skip_on_windows "a native binary does not follow an MSYS symlink to /dev/full"
test -c /dev/full || skip "no /dev/full device"
probe="${tmpdir}/probe"
ln -s /dev/full "$probe" 2>/dev/null || skip "cannot symlink /dev/full"
if printf x >"$probe" 2>/dev/null; then
    skip "a write through /dev/full succeeds here, so it stands in for nothing"
fi
rm -f "$probe"

local_server_start --log "${tmpdir}/server.log"

# Mirror with archive $2 on /dev/full, and leave the WARC error lines in $lost.
# Whether a lost archive fails the exit status is undecided, so accept 0 or 1.
crawl_warc_full() {
    local name="$1" dir="${tmpdir}/$1" link="$2" rc=0

    shift 2
    mkdir -p "$dir"
    ln -s /dev/full "${dir}/${link}"
    local_crawl --log "${tmpdir}/log-${name}" --quiet --robots=0 -O "$dir" \
        "$@" || rc=$?
    log=$(<"${dir}/hts-log.txt")
    test "$rc" -le 1 || fail "the ${name} crawl exited ${rc}: ${log}"
    lost=$(command grep 'WARC: could not' <<<"$log" || true)
    test "$(wc -l <<<"$lost")" -eq 1 -a -n "$lost" ||
        fail "the ${name} arm wanted one WARC error, got: ${lost}"
    test "$(command grep -c 'Error:' <<<"$log")" -eq 1 ||
        fail "the ${name} arm wanted one error in all: ${log}"
}

# About 30KB of random assets: a write fails while the crawl still runs.
big=(-r3 '-*' '+*/big/a/*' '+*/big/p/*' "${BASEURL}/big/index.html")
crawl_warc_full write full.warc.gz --warc-file "${tmpdir}/write/full.warc.gz" \
    --warc-cdx "${big[@]}"
grep -q 'archive stops there' <<<"$lost" ||
    fail "a mid-crawl write failure was not reported: ${lost}"
test ! -e "${tmpdir}/write/full.cdx" || fail "an incomplete archive was indexed"
ok "a mid-crawl write failure is logged once, and indexes nothing"

# The first rotation flushes segment 0 onto the full device.
crawl_warc_full rotate s-00000.warc.gz --warc-file "${tmpdir}/rotate/s" \
    --warc-max-size 600 "${big[@]}"
grep -q 'could not finish writing .*s-00000\.warc\.gz' <<<"$lost" ||
    fail "a failed rotation did not name its segment: ${lost}"
test ! -e "${tmpdir}/rotate/s-00001.warc.gz" ||
    fail "a failed rotation left the next segment behind"
ok "a failed rotation is logged once and opens no segment"

# One small page fits the stdio buffer, so only the close sees the failure.
crawl_warc_full close full.warc.gz --warc-file "${tmpdir}/close/full.warc.gz" \
    "${BASEURL}/mini304/index.html"
grep -q 'could not finish writing .*full\.warc\.gz' <<<"$lost" ||
    fail "a failure at close was not reported: ${lost}"
ok "a failure at close is logged once"

#!/bin/bash
#
# A ^C must end a crawl parked in an FTP connect to a blackholed host, instead
# of leaving it to the kernel's own two-minute connect timeout (#1059).

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

python=$(find_python) || skip "python3 not found"
command -v httrack >/dev/null || {
    echo "could not find httrack" >&2
    exit 1
}
! is_windows || ! echo "MSYS cannot signal a native httrack.exe; skipping" >&2 ||
    exit 77

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_ftpint.XXXXXX")
crawlpid=
cleanup() {
    test -z "$crawlpid" || kill_tree "$crawlpid"
    rm -rf "$tmpdir"
}
cleanup_push cleanup

ok() { echo "OK: $*"; }

# Above a truncated $SECONDS and a loaded runner's scheduling, below the
# shortest kernel connect timeout an unfixed engine would wait out.
bound=15
# What the precondition below has to outlast for the bound to mean anything.
probe=10
blackhole=192.0.2.1

# TEST-NET-1 is routed nowhere, so a connect hangs until something bounds it.
# Where the network answers instead, there is no wait to cut short and an
# unfixed engine passes the timing below.
"$python" - "$blackhole" "$probe" <<'EOF' || exit 77
import socket, sys, time

host, limit = sys.argv[1], int(sys.argv[2])
sock = socket.socket()
sock.settimeout(limit)
start = time.time()
try:
    sock.connect((host, 21))
except socket.timeout:
    sys.exit(0)
except OSError as err:
    print("%s answers in %.1fs (%s)" % (host, time.time() - start, err), file=sys.stderr)
    sys.exit(1)
print("%s accepted the connection" % host, file=sys.stderr)
sys.exit(1)
EOF
ok "a connect to ${blackhole} is still unanswered after ${probe}s"

out="${tmpdir}/crawl"
mkdir -p "$out"
# No bound of any kind, so only the interrupt can end this run.
httrack "ftp://${blackhole}/f.bin" -O "$out" --quiet --disable-security-limits \
    --debug-log --robots=0 --timeout=0 --max-time=0 -c1 >"${tmpdir}/log" 2>&1 &
crawlpid=$!

# Signal the worker once it is inside connect(), observed rather than slept for:
# a ^C landing before it would prove nothing, and would red a correct tree.
log="${out}/hts-log.txt"
deadline=$((SECONDS + 60))
until test -s "$log" && grep -aq "FTP: connecting to ${blackhole}:" "$log"; do
    test "$SECONDS" -lt "$deadline" || fail "the crawl never reached connect()"
    poll_wait 1
done

# Nothing bounds this run, so a crawl that ended by itself never reached the
# wait under test: an engine failing the connect outright would pass below.
sleep 5
kill -0 "$crawlpid" 2>/dev/null ||
    fail "the crawl ended on its own, so ^C is not what stopped it"

start=$SECONDS
kill -INT "$crawlpid"
wait_bounded "$crawlpid" 60 ||
    fail "^C left the crawl running for $((SECONDS - start))s"
elapsed=$((SECONDS - start))
crawlpid=

grep -aq 'Exit requested by shell or user' "$log" ||
    fail "the crawl never saw the interrupt: $(grep -a Error "$log" || true)"
# Anchored on the FTP worker's own wording: the HTTP backend, which is already
# non-blocking, emits the same text with a trailing ": <reason>".
grep -aqE '"Unable to connect to the server" \([^)]*\) at link ftp://' "$log" ||
    fail "the interrupt did not land on a pending FTP connect"
test "$elapsed" -lt "$bound" ||
    fail "^C took ${elapsed}s to end a crawl stuck in connect()"
ok "^C ends a crawl stuck in connect() (${elapsed}s)"

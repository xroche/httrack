#!/bin/bash
#
# ProxyTrack reads a request body to its exact length, refuses a short or
# oversized one, and names the socket error when it cannot bind.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"
# shellcheck source=tests/arclib.sh
. "${0%"${0##*/}"}./arclib.sh"

python=$(find_python) || skip "python3 missing"

dir=$(mktemp -d)
ptpid=
cleanup() {
    stop_server "$ptpid"
    rm -rf "$dir"
}
cleanup_push cleanup

printf 'HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 5\r\n\r\n' >"$dir/hdr"
printf 'hello' >"$dir/body"
{
    arc_filedesc
    arc_record http://example.com/page.html text/html 200 "$dir/hdr" "$dir/body"
} >"$dir/in.arc"

launch_proxytrack() {
    proxytrack "127.0.0.1:$proxyport" "127.0.0.1:$icpport" "$dir/in.arc" >"$ptlog" 2>&1 &
    ptpid=$!
}
start_proxytrack "$dir/pt" launch_proxytrack

"$python" - "$proxyport" <<'PY' || fail_dump "proxytrack read a body wrongly" "$ptlog"
import socket, sys, time

port = int(sys.argv[1])
get = b"GET http://example.com/page.html HTTP/1.1\r\nHost: example.com\r\n\r\n"


def post(n, chunks, shut=False):
    s = socket.create_connection(("127.0.0.1", port), 10)
    s.settimeout(10)
    s.sendall(b"PROPFIND /x HTTP/1.1\r\nHost: example.com\r\n"
              b"Connection: keep-alive\r\nContent-Length: %d\r\n\r\n" % n)
    for c in chunks:
        time.sleep(0.05)  # each chunk is its own segment
        s.sendall(c)
    if shut:
        s.shutdown(socket.SHUT_WR)
    out = b""
    while True:
        try:
            d = s.recv(65536)
        except socket.timeout:
            break
        if not d:
            break
        out += d
        if b"hello" in out:
            break
    s.close()
    return out


def expect(name, out, first, served):
    status = out.split(b"\r\n", 1)[0]
    if first not in status:
        sys.exit("%s: status %r" % (name, status))
    if served != (b"hello" in out):
        sys.exit("%s: the request after the body was %s" % (name, "lost" if served else "served"))


# the GET that follows is answered only when the body was consumed exactly
expect("exact", post(4, [b"abcd" + get]), b" 405 ", True)
expect("split", post(4, [b"a", b"bc", b"d" + get]), b" 405 ", True)
expect("one byte", post(1, [b"z" + get]), b" 405 ", True)
expect("largest", post(32767, [b"A" * 32767 + get]), b" 405 ", True)
expect("short", post(40, [b"abcd"], shut=True), b" 500 Posted Data Read Error", False)
expect("too large", post(32768, [b"A" * 32768 + get], shut=True),
       b" 500 Posted Data Too Large", False)
PY

"$python" - "$(nativepath "$(command -v proxytrack)")" "$(nativepath "$dir/in.arc")" <<'PY' || fail "bind error is not named"
import os, re, socket, subprocess, sys

busy = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
if hasattr(socket, "SO_EXCLUSIVEADDRUSE"):  # else Windows lets proxytrack share it
    busy.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
busy.bind(("127.0.0.1", 0))
busy.listen(1)
udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
udp.bind(("127.0.0.1", 0))
icp = udp.getsockname()[1]
udp.close()
r = subprocess.run([sys.argv[1], "127.0.0.1:%d" % busy.getsockname()[1],
                    "127.0.0.1:%d" % icp, sys.argv[2]],
                   capture_output=True, timeout=60)
err = r.stderr.decode("latin-1")
m = re.search(r"cannot bind tcp port \d+ on 127\.0\.0\.1: (.*) \((\d+)\)", err)
if r.returncode != 1 or m is None:
    sys.exit("rc %d, stderr %r" % (r.returncode, err))
text, code = m.group(1), int(m.group(2))
if code < 10000:
    ok = text == os.strerror(code)
else:  # Winsock codes have no strerror() text
    ok = len(text) >= 20
if not ok:
    sys.exit("message %r for code %d" % (text, code))
PY

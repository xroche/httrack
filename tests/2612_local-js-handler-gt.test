#!/bin/bash
#
# A browser ends a quoted attribute value, event handler or javascript: URL
# only at its closing quote, and an unquoted one at a space or '>', so a '>'
# inside leaves the tag open and the attributes after it are links. Each kNN
# is loaded, each nNN not.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_jshandler.XXXXXX") || exit 1
cleanup_push rm -rf "$tmp"
root=$tmp/root
mkdir -p "$root"

# The source, with a '@' where the rewrite drops the leading '/' of a loaded
# link. 05 is a script string after the write, which only -%P0 leaves alone.
cat >"$tmp/page" <<'EOF'
<html><body>
<a onclick="document.write('<b>x</b>')" href=@k01.html>a</a>
<a onclick="if(a>b)x()" href=@k02.html>b</a>
<img onmouseover='x=">"' src=@k03.gif>
<a onclick="document.write('<img src=\'@k04.gif\'>');x='<img src=/n05.gif>'" href=@k06.html>c</a>
<a onclick=x() href=@k07.html>d</a>
<a onclick=foo() href=@k08.html>e</a>
<a onclick= "if(a>b)x()" href=@k09.html>f</a>
<a onclick="a='>'" href=@k10.html>g</a><img onclick='document.write("<i>")' src=@k11.gif>
<a onclick="x()" href=@k12.html>h</a>
<a onclick="document.write('<img src=@k13.gif>')" href=@k14.html>i</a>
<a onclick=x()>j</a><img src=@k15.gif>
<a href="javascript:x()" title="t"><img src=@k16.gif></a>
<img lowsrc="javascript:if(a>b)x()" src=@k19.gif>
<img lowsrc=javascript:x() src=@k20.gif>
<a title="a>b" href=@k21.html>m</a>
<img alt='a>b' src=@k22.gif>
<a data-x="a>b" href=@k23.html>n</a>
<input type=image value="a>b" src=@k24.gif>
<a title="<b>x</b>" href=@k25.html>o</a>
<foo a="x>y" href=@k26.html>p</foo>
<a title = 'a"b>c' href=@k27.html>q</a>
<a href=@k28.html title=it's>r</a><img title="" src=@k29.gif>
<a title="<!--" href=@k33.html>u</a>
<img alt="<script>" src=@k34.gif>
<a href=@k35.html title=it's>v</a><style>b { background: url(@k36.gif) }</style><a title='w'>w</a>
<a title=a>b href=/n30.html>s</a>
<p>end</p>
</body></html>
EOF
sed 's|@|/|g' "$tmp/page" >"$root/index.html"
sed 's|@||g' "$tmp/page" >"$tmp/expect"

# Pages cut inside a handler or a value: no closing quote, nothing past the end.
printf '<a href=/k17.html>t</a><a onclick="x>y' >"$root/k17.html"
printf '<a href=/k18.html>t</a><a onclick=x' >"$root/k18.html"
printf '<a href=/k31.html>t</a><a title="x>y href=/n32.html>' >"$root/k31.html"
cat >>"$root/index.html" <<'EOF'
<a href=/k17.html>t</a><a href=/k18.html>t</a><a href=/k31.html>t</a>
EOF
printf '<a href=k17.html>t</a><a href=k18.html>t</a><a href=k31.html>t</a>\n' >>"$tmp/expect"

want="k01.html k02.html k03.gif k04.gif k06.html k07.html k08.html k09.html
k10.html k11.gif k12.html k13.gif k14.html k15.gif k16.gif k17.html k18.html
k19.gif k20.gif k21.html k22.gif k23.html k24.gif k25.html k26.html k27.html
k28.html k29.gif k31.html k33.html k34.gif k35.html k36.gif"
for f in $want n05.gif n30.html n32.html; do
    case $f in
    *.gif) printf 'GIF89a' >"$root/$f" ;;
    k17.html | k18.html | k31.html) ;;
    *) printf '<html>t</html>\n' >"$root/$f" ;;
    esac
done

local_server_start --root "$root" --log "$tmp/server.log"

# check MODE [httrack args]: crawl, then assert each link and the page bytes
check() {
    local mode=$1 out site f bad=
    shift
    out=$tmp/out-$mode
    local_crawl --log "$tmp/$mode.log" "$BASEURL/index.html" -O "$out" \
        -r3 -c4 --robots=0 --quiet -%F '' "$@" || true
    site=$out/127.0.0.1_$SRV_PORT
    test -f "$site/index.html" || fail_dump "$mode: no index.html" "$tmp/$mode.log"
    # name every wrong link, so a failure lists each pattern it breaks
    for f in $want; do
        test -f "$site/$f" || bad="$bad $f"
    done
    for f in n05.gif n30.html n32.html; do
        test ! -e "$site/$f" || bad="$bad $f(captured)"
    done
    test -z "$bad" || fail "$mode: wrong:$bad"
    cmp -s "$tmp/expect" "$site/index.html" || {
        diff "$tmp/expect" "$site/index.html" | cut -c1-200 >&2 || true
        fail "$mode: index.html changed beyond its rewritten links"
    }
}

check P0 -%P0
check default

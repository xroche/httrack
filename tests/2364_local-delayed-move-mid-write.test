#!/bin/bash
#
# A .delayed placeholder moved while its body still arrives must keep every
# byte (#483): the later writes append to the moved file. The /dmove/ fixture
# orders it, and "(still writing)" proves the move found the file open.

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" \
    --log-found 'moved placeholder .*p0\.bin\.[0-9]+\.delayed to .* \(still writing\)$' \
    --log-not-found 'Write error on disk' \
    --file-bytes 'dmove/p0.bin.html' 2560 \
    --file-matches 'dmove/p0.bin.html' '^0000000$' \
    --file-matches 'dmove/p0.bin.html' '^0000319$' \
    httrack 'BASEURL/dmove/index.html' -M50000 -c2 '-%N1' -Z

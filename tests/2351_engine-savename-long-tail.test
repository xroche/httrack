#!/bin/bash
#

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# A save name that would overflow save[] is shortened, never aborted (#2246).

a() { printf "%0${1}d" 0 | tr 0 a; }
host=/dev/null/www.example.com
# The exact names assume a 4096-byte PATH_MAX; a smaller cap only proves no abort.
path_max=$(getconf PATH_MAX / 2>/dev/null || true)
exact=false
if ! target_is_windows && [[ $path_max =~ ^[0-9]+$ ]] && ((path_max >= 4096)); then
    exact=true
fi
# name_is WANT FIL CTYPE PAD [ARGS...]: filpad=PAD expands the '*' in FIL
name_is() {
    local want=$1 fil=$2 ctype=$3 pad=$4
    shift 4
    if $exact; then
        selftest_queue "savename: $want" savename "$fil" "$ctype" \
            "filpad=$pad" "$@"
    else
        selftest_queue_head "savename: /dev/null/" savename "$fil" "$ctype" \
            "filpad=$pad" "$@"
    fi
}

# Each appended tail survives: .delayed, .html, index.html, an -N type 99 ext.
name_is "/dev/null/x/x/$(a 231).delayed" '/x/*.php' text/html 2030 \
    'userdef=%p/%p/%n' statuscode=301
name_is "$host/$(a 234).html" '/*' application/x-unknown 2030 delayed=1
for pad in 2030 2035; do
    name_is "$host/$(a 238)/index.html" '/x.*' application/x-unknown "$pad" \
        type=105
done
name_is "/dev/null/web/_r8furq.$(a 231)" '/x.*' application/x-unknown 2035 \
    type=99
# The name gives up a cut extension, never its last byte nor its directory.
name_is "$host/$(a 234).html" '/*' text/html 2030
name_is "$host/$(a 238)/x" '/*/x.php' image/png 2026
name_is "$host/$(a 238)/x.delayed" '/*/x.php' text/html 2026 statuscode=301
name_is "$host/$(a 238)/index.delayed" '/*/x.php' text/html 2030 statuscode=301
# A ".delayed" placeholder lands in the directory of the final name.
for pad in 1015 1018; do
    dir="/dev/null/$(a 239)/ab/$(a 238)/ab"
    name_is "$dir/x" '/*/ab/x' text/html "$pad" 'userdef=%p/%p/%n'
    name_is "$dir/x.delayed" '/*/ab/x' text/html "$pad" 'userdef=%p/%p/%n' \
        statuscode=301
done

selftest_run_queued

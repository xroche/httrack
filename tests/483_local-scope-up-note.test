#!/bin/bash
#
# The default scope refuses every link above the start directory. An entry URL
# in a subdirectory then mirrors to a page with no assets, and nothing says why.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

: "${top_srcdir:=..}"

work=$(mktemp -d)
trap 'set +e; rm -rf "$work"' EXIT

root="$work/root"
mkdir -p "$root/sub"

echo 'console.log("root")' >"$root/root.js"
echo 'console.log("other")' >"$root/other.js"
cat >"$root/sub/index.html" <<'HTML'
<!DOCTYPE html><html><body>
<script src="/root.js"></script>
<script src="/other.js"></script>
<a href="page2.html">p</a>
</body></html>
HTML
# no link above the start directory, so only a filter can refuse anything here
cat >"$root/sub/filtered.html" <<'HTML'
<!DOCTYPE html><html><body>
<script src="blocked.js"></script>
<a href="page2.html">p</a>
</body></html>
HTML
echo '<!DOCTYPE html><html><body>p2</body></html>' >"$root/sub/page2.html"
echo 'console.log("blocked")' >"$root/sub/blocked.js"

note='above the start directory .* not mirrored'
option='[-]B \(--can-go-up-and-down\)'

bash "$top_srcdir/tests/local-crawl.sh" --root "$root" --errors 0 \
    --log-found "2 links $note" --stdout-found "2 links $note" \
    --log-found "$option" --stdout-found "$option" \
    --not-found 'root.js' --not-found 'other.js' \
    httrack BASEURL/sub/ -r3

# -B is what the note tells the user to pass, so it must silence the note.
bash "$top_srcdir/tests/local-crawl.sh" --root "$root" --errors 0 \
    --log-not-found "$note" --stdout-not-found "$note" \
    --found 'root.js' --found 'other.js' \
    httrack BASEURL/sub/ -r3 -B

# An ordinary filter refusal is not a scope refusal.
bash "$top_srcdir/tests/local-crawl.sh" --root "$root" --errors 0 \
    --log-not-found "$note" --stdout-not-found "$note" \
    --not-found 'sub/blocked.js' --found 'sub/page2.html' \
    httrack BASEURL/sub/filtered.html -r3 '-*blocked.js*'

# A filter that takes one of the two up-links leaves one refused, so the count
# is read after the filters, not at the refusal.
bash "$top_srcdir/tests/local-crawl.sh" --root "$root" --errors 0 \
    --log-found "1 link $note" --stdout-found "1 link $note" \
    --found 'root.js' --not-found 'other.js' \
    httrack BASEURL/sub/ -r3 '+*root.js*'

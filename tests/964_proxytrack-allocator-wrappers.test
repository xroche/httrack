#!/bin/bash
#
# ProxyTrack allocates through the htssafe.h wrappers, so a raw libc call
# there is a lint failure.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top="${abs_top_srcdir:?not run under make check}"
test -d "$top/src/proxy" || skip "no source tree (dist tarball)"

work=$(mktemp -d "${TMPDIR:-/tmp}/ptalloc.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "$work"

raw() { # raw FILE... -> lines calling a raw libc allocator
    command grep -nE '(^|[^[:alnum:]_.>])(malloc|calloc|realloc|free|strdup)[[:space:]]*\(' "$@" || true
}

# Control: the scan must see a raw call and ignore a wrapped one.
printf 'void f(void) {\n  free(p);\n  p = strdup(q);\n}\n' >"$work/dirty.c"
test "$(raw "$work/dirty.c" | wc -l)" -eq 2 ||
    fail "the scan cannot see raw calls, so a clean result proves nothing"
printf 'void f(void) {\n  freet(p);\n  p = strdupt(q);\n  p = realloct(p, 1);\n}\n' >"$work/clean.c"
test -z "$(raw "$work/clean.c")" || fail "the scan flags wrapped calls"

found=$(raw "$top"/src/proxy/*.c "$top"/src/proxy/*.h)
test -z "$found" || fail "raw libc allocation in src/proxy:${TESTLIB_NL}$found"

echo "src/proxy allocates through the wrappers"

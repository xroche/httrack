#!/bin/bash
#
# Every ${LANG_*} the webhttrack templates interpolate must exist in lang.def
# and in all lang/*.txt: an unknown key renders as the empty string, so a
# missing translation is invisible in the page instead of loud.

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
distdir=${top_srcdir:-$(cd "${testdir}/.." && pwd)}
distdir=$(cd "${distdir}" && pwd)
# shellcheck source=tests/testlib.sh
. "${testdir}/testlib.sh"

python=$(find_python) || {
    echo "python3 not found; skipping" >&2
    exit 77
}

"${python}" - "${distdir}" <<'PY'
import glob, os, re, sys

srcdir = sys.argv[1]
rc = 0


def pairs(path):
    lines = [l.rstrip("\r") for l in
             open(path, "rb").read().decode("latin-1").split("\n")]
    return dict((lines[i], lines[i + 1]) for i in range(0, len(lines) - 1, 2))


langdef = pairs(os.path.join(srcdir, "lang.def"))
used = set()
for path in sorted(glob.glob(os.path.join(srcdir, "html", "server", "*.html"))):
    page = open(path, "rb").read().decode("latin-1")
    used |= set(re.findall(r"\$\{(?:html:)?(LANG_[A-Za-z0-9_]+)\}", page))
if len(used) < 100:
    sys.exit("FAIL: only %d keys scanned, the template glob is wrong" % len(used))

unknown = sorted(used - set(langdef))
if unknown:
    print("FAIL: not in lang.def: %s" % " ".join(unknown))
    rc = 1

# lang/*.txt are keyed by lang.def's English string, not by the LANG_ name.
for path in sorted(glob.glob(os.path.join(srcdir, "lang", "*.txt"))):
    have = pairs(path)
    missing = sorted(k for k in used - set(unknown) if langdef[k] not in have)
    if missing:
        print("FAIL: %s lacks %s" % (os.path.basename(path), " ".join(missing)))
        rc = 1

print("ok: %d keys x %d languages" %
      (len(used), len(glob.glob(os.path.join(srcdir, "lang", "*.txt")))))
sys.exit(rc)
PY

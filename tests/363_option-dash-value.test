#!/bin/bash
#
# An option value beginning with '-' (#1425). The shared "the next word looks
# like an option" guard refused it for 25 options, and the run died during
# option parsing, before any log file exists to say why.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_dashvalue.XXXXXX") || exit 1
cleanup_push rm -rf "$tmp"

# absolute: the probes cd into an empty directory, and make check puts the
# build's src/ on PATH relatively
bin=$(httrack_path)
mkdir -p "$tmp/cwd"

url='http://127.0.0.1:1/'
out=$tmp/mirror

# Parse the command line and stop; --testscan opens no socket, so the dead URL
# is never dialled. The streams are kept apart: the run dies before any log
# file exists, so stderr is the only channel the diagnosis has.
parse() {
    rc=0
    rm -rf "$out"
    stdout=$(cd "$tmp/cwd" && "$bin" -O "$out" --quiet --testscan "$url" "$@" 2>"$tmp/err") || rc=$?
    stderr=$(cat "$tmp/err")
}

# Same, minus the -O the -O probes cannot pass, from a directory kept empty so
# an accidental mirror shows up as a stray file.
noparam() { # noparam LABEL ARG...
    rc=0
    shift
    rm -rf "$out"
    stdout=$(cd "$tmp/cwd" && "$bin" --quiet --testscan "$url" "$@" 2>"$tmp/err") || rc=$?
    stderr=$(cat "$tmp/err")
    test -z "$(ls -A "$tmp/cwd")" || fail "$*: mirrored into $(ls -A "$tmp/cwd")"
}

accepted() { # accepted LABEL
    test "$rc" -eq 0 || fail "$1: exited $rc: $stderr"
    ! grep -q 'Syntax error' <<<"$stderr" || fail "$1: $stderr"
}

# A refusal says why on stderr and nowhere else, and leaves no mirror behind.
refused() { # refused LABEL RE...
    local label=$1
    shift
    test "$rc" -ne 0 || fail "$label: the option took the token after it"
    test -z "$stdout" || fail "$label: diagnosis split onto stdout: $stdout"
    test ! -e "$out" || fail "$label: created $out"
    while test $# -gt 0; do
        assert_match "$1" "$stderr" "$label"
        shift
    done
}

# The complaint: --assume with a dash-leading extension, which is what the
# WebHTTrack type page emits, and the same for the other free-text options.
printf '[a dash-leading value is taken, in every spelling] ..\t'
parse --assume '-foo=text/html'
accepted "--assume -foo=text/html"
parse --assume=-foo=text/html
accepted "--assume=-foo=text/html"
parse -%A '-foo=text/html'
accepted "-%A -foo=text/html"
parse --mimetype '-foo=text/html'
accepted "--mimetype -foo=text/html"
parse --user-agent '-mybot/1.0'
accepted "--user-agent -mybot/1.0"
parse -F '-mybot/1.0'
accepted "-F -mybot/1.0"
parse --footer '-<!-- mirrored -->'
accepted "--footer -<!-- mirrored -->"
parse --cookies-file '-cookies.txt' --assume '-foo=text/html'
accepted "a dash value beside another"
echo OK

# The bytes, not just the verdict: the alias layer hands the engine the value
# it was given, dash included, in each spelling the wizard and the man page use.
printf '[the value reaches the engine byte for byte] ..\t'
expand() { # expand OPTION [VALUE]
    "$bin" -O /dev/null '-#test=optalias' "$@"
}
assert_eq '-%A -foo=text/html' "$(expand --assume -foo=text/html)" "--assume"
assert_eq '-%A -foo=text/html' "$(expand --assume=-foo=text/html)" "--assume="
assert_eq '-%A -foo=text/html' "$(expand -%A -foo=text/html)" "-%A"
assert_eq '-F -mybot/1.0' "$(expand --user-agent -mybot/1.0)" "--user-agent"
echo OK

# And it reaches a syscall unmangled: --filterlist opens its file while parsing,
# so a trimmed or rewritten name reads back as the open failure the second half
# of this probe shows.
printf '[a dash-leading file name is opened, not mangled] ..\t'
printf -- '-*.gif\n' >"$tmp/cwd/-rules.txt"
parse --filterlist -rules.txt
accepted "--filterlist -rules.txt"
parse --filterlist=-rules.txt
accepted "--filterlist=-rules.txt"
parse -%S -rules.txt
accepted "-%S -rules.txt"
parse --filterlist -nosuch.txt
refused "--filterlist -nosuch.txt" 'File url list could not be opened'
rm -f "$tmp/cwd/-rules.txt"
echo OK

# What the option refuses, it now explains: the option as the user spelled it,
# the word it choked on, and the spelling that hands it over anyway. The old
# message claimed the parameter was missing and named the internal -%A.
printf '[a refusal names the option, the value and the way out] ..\t'
parse --proxy '-proxy:8080'
refused "--proxy -proxy:8080" 'Option --proxy takes a value' '"-proxy:8080"' \
    'Write --proxy=-proxy:8080'
parse -P '-proxy:8080'
refused "-P -proxy:8080" 'Option -P takes a value' 'Write --proxy=-proxy:8080'
parse --user-structure '-%h/%p/%n.%t'
refused "--user-structure" 'Option --user-structure takes a value' \
    'Write --user-structure=-'
noparam "-O -q" -O -q
refused "-O -q" 'Option -O takes a value' 'Write --path=-q'
# An allowlisted option still refuses a real option name (#1179), with the same
# wording, since that too is a value it declined to take.
parse --assume -q
refused "--assume -q" 'Option --assume takes a value' '"-q"' \
    'Write --assume=-q'
echo OK

# The way out the message names has to work, or it is worse than no advice.
printf '[the spelling the message suggests is taken] ..\t'
parse --proxy=-proxy:8080
accepted "--proxy=-proxy:8080"
parse --path=-mirror
accepted "--path=-mirror"
rm -rf "$tmp/cwd/-mirror"
echo OK

# Nothing at all after the option is still that, and keeps the old wording:
# there is no value to quote and no '=' form to suggest.
printf '[an option with nothing after it still says so] ..\t'
parse --proxy
refused "--proxy alone" 'needs to be followed by a parameter'
parse --assume
refused "--assume alone" 'needs to be followed by a parameter'
noparam "-O alone" -O
refused "-O alone" 'needs to be followed by a parameter'
echo OK

# Two more aborts on this path set no message at all, so stderr carried a bare
# "* " and WebHTTrack an empty string.
printf '[a startup abort that had no message says why] ..\t'
rc=0
stdout=$(cd "$tmp/cwd" && "$bin" --quiet 2>"$tmp/err") || rc=$?
stderr=$(cat "$tmp/err")
test "$rc" -ne 0 || fail "no URL at all: exited 0"
assert_match 'No URL to mirror' "$stderr" "no URL at all"
# Inert where the v6 resolver was not compiled in, and then it says so.
parse -@i9
if ! grep -q 'v6 routines not compiled' <<<"$stdout"; then
    refused "-@i9" 'Unknown value for -@i: 9'
fi
echo OK

# Control: an ordinary value on the very same options is untouched.
printf '[an ordinary value on the same options is unaffected] ..\t'
parse --assume 'php3=text/html'
accepted "--assume php3=text/html"
parse --proxy 'proxy.example.com:8080'
accepted "--proxy proxy.example.com:8080"
parse --user-agent 'mybot/1.0'
accepted "--user-agent mybot/1.0"
parse --footer '<!-- mirrored -->'
accepted "--footer <!-- mirrored -->"
printf -- '-*.gif\n' >"$tmp/cwd/rules.txt"
parse --filterlist rules.txt
accepted "--filterlist rules.txt"
assert_eq '-%A php3=text/html' "$(expand --assume php3=text/html)" "plain --assume"
echo OK

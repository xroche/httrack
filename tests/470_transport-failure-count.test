#!/bin/bash
#
# stat_errors counts log lines, so a front end cannot tell a page the server
# refused from one that never answered at all. Only the second means the mirror
# has holes and an update is owed, which is what an Android crawl firewalled by
# Doze hits: every link times out and the run still reports success.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

python=$(find_python) || skip "python3 missing" # hold_port reads it from here

# macOS drops the SYN on a held port where Linux resets it, so the crawl would
# spend its whole timeout budget per link instead of failing to connect.
test "$HTS_OS" != Darwin || skip "a held port times out rather than refusing here"

# Held for the whole crawl: a freeport number a neighbour then binds would answer
# and retire the premise silently (#1218).
hold_port
dead=$HELD_PORT
"$python" -c 'import socket, sys
s = socket.socket()
s.settimeout(5)
try:
    s.connect(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(0)
sys.exit("port %s answered" % sys.argv[1])' "$dead" || skip "the held port answered"

# One link the server answers and two it cannot answer at all, so a count that
# conflates an answered error with an unanswered link cannot produce 2. The image
# proves the count is not restricted to links that could carry links themselves.
bash "$top_srcdir/tests/local-crawl.sh" \
    --log-found '\(2 links got no answer at all' \
    httrack "BASEURL/simple/basic.html" "http://127.0.0.1:${dead}/dead.html" \
    "http://127.0.0.1:${dead}/dead.png" --timeout=3 --retries=0

# robots.txt carries no content, so a host that never answered its robots.txt
# has lost nothing and the count must not move. The harness disables robots, so
# this leg is the only one that fetches one.
bash "$top_srcdir/tests/local-crawl.sh" \
    --log-found '\(2 links got no answer at all' \
    httrack "BASEURL/simple/basic.html" "http://127.0.0.1:${dead}/dead.html" \
    "http://127.0.0.1:${dead}/dead.png" --timeout=3 --retries=0 --robots=1

# The control in the narrowing direction: with nothing unreachable the line must
# not appear, or it would fire on any ordinary crawl.
bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --log-not-found 'got no answer at all' \
    httrack "BASEURL/simple/basic.html"

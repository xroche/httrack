#!/bin/bash
#
# A ctype call on a plain char is UB for a negative value, so src/ must cast.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

src="${testdir}/../src"
test -d "$src" || skip "no src/ (dist tarball)"
test -r "$src/htslib.c" || fail "src/ exists but src/htslib.c is missing"

names='isalnum|isalpha|isblank|isascii|isdigit|isspace|isxdigit|isupper|islower|ispunct|isprint|iscntrl|isgraph|tolower|toupper'

# Each ctype call whose argument is not cast to unsigned char, one per line.
bad_calls() {
    command grep -vE '^[[:space:]]*(/\*|\*|//)' |
        { command grep -oE "(^|[^[:alnum:]_])($names)[[:space:]]*\\([[:space:]]*(\\((const )?unsigned char\\))?" || true; } |
        { command grep -vE "unsigned char\\)$" || true; }
}

n=$(cat "$src"/*.c "$src"/proxy/*.c | { command grep -oE "($names)[[:space:]]*\\(" || true; } | wc -l)
test "$n" -gt 0 || fail "the scan saw no ctype call at all"

bad=$(cat "$src"/*.c "$src"/proxy/*.c | bad_calls)
test -z "$bad" || fail "ctype call without an unsigned char cast:
$bad"

# control: each planted line must be flagged, and the cast one must not
check() {
    got=$(printf '%s\n' "$2" | bad_calls)
    if [ "$1" = bad ]; then
        test -n "$got" || fail "the scan missed: $2"
    else
        test -z "$got" || fail "the scan flagged: $2"
    fi
}
check bad 'return isspace(s[0]);'
check bad 'return isspace((unsigned char) c) && isalpha(s[0]);'
check bad 'return isspace(c) || isspace(s[0]);'
check bad 'x = tolower(*p);'
check bad 'return isblank(*p) || isascii(*p);'
check good 'return isspace((unsigned char) s[0]);'

#!/bin/bash
#
# -%I1 folds UTF-8 accents and case, counts each word once per page, and
# leaves no stale bytes at the end of index.txt.

set -euo pipefail

: "${top_srcdir:=..}"

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

require_httrack

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_kwindex.XXXXXX")
cleanup_push rm -rf "$tmp"

# 1000 distinct words keep qwx (3 hits) under the "too common" threshold and
# make "the" (30 hits) exceed it. uber has 2 hits, one of them in UTF-8.
mkdir "$tmp/a"
{
    printf '<html><body>Uber \xc3\xbcber Caf\xc3\xa9 NA\xc3\x8fVE stra\xc3\x9fe qwx qwx qwx'
    for i in $(seq 1 1000); do printf ' w%dx' "$i"; done
    for _ in $(seq 1 30); do printf ' the'; done
    printf ' \xc3</body></html>'
} >"$tmp/a/index.html"

bash "$top_srcdir/tests/local-crawl.sh" --root "$(nativepath "$tmp/a")" \
    --file-matches ../index.txt '^uber' \
    --file-matches ../index.txt '^cafe' \
    --file-matches ../index.txt '^naive' \
    --file-not-matches ../index.txt '^(aber|ber|cafae|naave|stra)' \
    --file-matches ../index.txt '^.=2' \
    --file-matches ../index.txt '^.=3' \
    --file-not-matches ../index.txt '^.=(4|6)' \
    --file-matches ../index.txt '^.ignored' \
    httrack BASEURL/index.html -q -%I1

# Every word is too common, so each block is rewound over, and the longest
# block is followed by a shorter one. No entry or total may remain, the last
# word included.
mkdir "$tmp/b"
echo '<a href="b.html">b</a> <a href="c.html">c</a> the the the zzz' \
    >"$tmp/b/index.html"
echo 'the the the' >"$tmp/b/b.html"
echo 'the the the' >"$tmp/b/c.html"

bash "$top_srcdir/tests/local-crawl.sh" --root "$(nativepath "$tmp/b")" \
    --file-matches ../index.txt '^.ignored' \
    --file-not-matches ../index.txt '^.(=|[0-9]+ )' \
    httrack BASEURL/index.html -q -%I1

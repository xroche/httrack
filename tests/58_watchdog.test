#!/bin/bash
#
# Unit-tests the suite watchdog (run_with_timeout and kill_tree in testlib.sh).
# A hung child must be killed with its whole tree and reported as 124. On CI an
# orphaned httrack.exe shows as "the hosted runner lost communication".

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

skip_on_hurd "a killed orphan answers kill -0 for minutes with no /proc entry, so its reap cannot be seen (wontfix)"

# Every timeout here is on purpose, and the hang dump would run inside the timed window.
export OVERRUN_DUMP=0

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_wd.XXXXXX")
# A colon-free root for the PATH shim below: MSYS hands out a drive-letter TMPDIR
# and a PATH entry carrying a colon is read as two, which leaves it unreachable.
shim=$(mktemp -d /tmp/httrack_wdshim.XXXXXX 2>/dev/null) || shim="$tmp/starve"
cleanup_push rm -rf "$tmp" "$shim"

# Exit status passes through when the command finishes in time.
rc=0 && run_with_timeout 30 sh -c 'exit 0' || rc=$?
test "$rc" -eq 0 || fail "clean exit reported $rc"
rc=0 && run_with_timeout 30 sh -c 'exit 7' || rc=$?
test "$rc" -eq 7 || fail "exit 7 reported $rc"

# An overrunning command is reported 124, near the deadline not the child's end.
start=$SECONDS
rc=0
if target_is_windows; then
    run_with_timeout 2 ping -n 30 127.0.0.1 || rc=$?
else
    run_with_timeout 2 sleep 30 || rc=$?
fi
test "$rc" -eq 124 || fail "hang reported $rc, want 124"
test "$((SECONDS - start))" -lt 15 || fail "watchdog fired late"

# The native descendant tree must be dead. On MSYS the check reads
# /proc/<pid>/winpid, so it asks about that shell rather than the binary. On
# POSIX it asks whether the grandchild's own pid still runs.
rc=0
if shell_is_msys; then
    # Match the exact Windows PID, because a ping.exe count would race the
    # still-dying ping the timing sub-test above leaves.
    alive() { win_pid_runs "$1" ping.exe; }
    # An alive() that never matches would call every survivor reaped. Prove it
    # fires on a live ping, reached the same way.
    ping -n 20 127.0.0.1 >/dev/null 2>&1 &
    cpid=$!
    cw=$(cat "/proc/$cpid/winpid" 2>/dev/null)
    test -n "$cw" || fail "could not read a live ping's Windows PID"
    alive "$cw" || fail "alive() cannot see a running ping.exe (pid $cw)"
    # What kill_tree checks before firing (#1228), on a live process: /proc must
    # name the image tasklist answers with, or the check passes nothing on.
    win_capture "$cpid"
    test "$WIN_PID" = "$cw" || fail "win_capture read winpid '$WIN_PID', /proc says $cw"
    win_pid_runs "$cw" "$WIN_IMAGE" || fail "tasklist does not call pid $cw a '$WIN_IMAGE'"
    ! win_pid_runs "$cw" no-such-image.exe || fail "win_pid_runs accepts any image at all"
    kill_tree "$cpid" "$cw"
    wait "$cpid" 2>/dev/null || true
    # The grandchild ping records its Windows PID. A non-empty file proves it
    # ran, so the reap check cannot pass on nothing. Then the pid must go.
    gw="$tmp/gcwinpid"
    # `wait` keeps the bash alive on the ping past the deadline; without it the
    # bash exits at once and run_with_timeout returns 0 instead of timing out.
    # shellcheck disable=SC2016 # $1 expands in the bash -c child, by design
    run_with_timeout 2 bash -c 'ping -n 30 127.0.0.1 >/dev/null 2>&1 & cat /proc/$!/winpid >"$1"; wait' _ "$gw" || rc=$?
    test "$rc" -eq 124 || fail "grandchild hang reported $rc"
    w=$(cat "$gw" 2>/dev/null)
    test -n "$w" || fail "positive control: grandchild ping never started"
    # Poll, because taskkill returns before the teardown finishes. An orphan
    # pings for ~29s, past REAP_GRACE, so waiting cannot hide a survivor.
    start=$SECONDS
    while alive "$w" && test "$((SECONDS - start))" -lt "$REAP_GRACE"; do sleep 1; done
    ! alive "$w" || fail "native ping grandchild (pid $w) survived the watchdog"
else
    started="$tmp/started" pidfile="$tmp/gcpid"
    grandchild_lives() { kill -0 "$gcpid" 2>/dev/null && ! pid_is_zombie "$gcpid"; }
    reap_grandchild() { test -z "${gcpid:-}" || kill -9 "$gcpid" 2>/dev/null || true; }
    # The grandchild marks that it ran, hands back its pid, then execs a sleep
    # that outlasts every deadline, so killing only the direct child leaves it.
    # shellcheck disable=SC2016 # $1, $2 and $! expand in the sh -c child, by design
    run_with_timeout 2 sh -c '{ : >"$1"; exec sleep 300; } & echo $! >"$2"; wait' _ "$started" "$pidfile" || rc=$?
    test "$rc" -eq 124 || fail "grandchild hang reported $rc"
    test -e "$started" || fail "positive control: grandchild never ran"
    gcpid=$(cat "$pidfile" 2>/dev/null) || gcpid=
    test -n "$gcpid" || fail "positive control: the grandchild named no pid"
    cleanup_push reap_grandchild
    # A probe that answers "gone" for everything would call any survivor reaped.
    kill -0 "$$" || fail "kill -0 cannot see this shell, so it can see nothing"
    # A zombie counts as dead, because orphans are reaped fast on a
    # workstation but not on a buildd. reap_bounded splits them that way.
    start=$SECONDS
    while grandchild_lives; do
        test "$((SECONDS - start))" -lt "$REAP_GRACE" || fail "watchdog left a grandchild running (pid $gcpid)"
        poll_wait 1
    done
    gcpid= # disarm: the number is free to be recycled from here on
fi

# Use the wall clock. Under starvation a poll takes longer than it asks, so a
# counted deadline would fire after the CI step it must beat.
(
    # Only the forked tick goes through a shimmed sleep. With the fd tick only
    # the payload would starve, and the case would test nothing.
    export HTTRACK_POLL_SLEEP=1
    starve_sleep "$shim" 4 || fail "could not install the slow sleep"
    # Starvation must not make the watchdog kill a command inside its budget.
    # The command outlives several polls, so the watchdog sees it running.
    rc=0 && run_with_timeout 30 sleep 2 || rc=$?
    test "$rc" -eq 0 || fail "starved watchdog killed a healthy command ($rc)"

    start=$SECONDS
    rc=0 WATCHDOG_FIRED_AT=
    if target_is_windows; then
        run_with_timeout 3 ping -n 60 127.0.0.1 || rc=$?
    else
        run_with_timeout 3 sleep 60 || rc=$?
    fi
    elapsed=$((SECONDS - start))
    test "$rc" -eq 124 || fail "starved watchdog reported $rc, want 124"
    # It must not fire under budget, or a guard killing on sight would pass.
    test "$elapsed" -ge 3 || fail "the watchdog fired early (${elapsed}s of 3s)"
    # The first 4s poll is past 3s, so it fires at 4-5s, while counting three polls takes 12s.
    test -n "$WATCHDOG_FIRED_AT" || fail "the watchdog never recorded when it fired"
    test "$WATCHDOG_FIRED_AT" -lt 12 ||
        fail "deadline counted polls, not seconds: fired after ${WATCHDOG_FIRED_AT}s for a 3s budget"
)
subshell_ok $?

echo "watchdog OK"

#!/bin/bash
#
# The -%X header tokens the log learns, and how the log shows those headers.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# hex keeps the CRs, which Windows text-mode stdin folds
selftest_queue '[Basic   ZPWAB12345][ZPWAB12345] shown=Authorization: <redacted, 20 bytes> log=> Authorization: <redacted, 20 bytes>\r\n' \
    secretheaders hex:417574686f72697a6174696f6e3a2042617369632020205a50574142313233343520200d0a
# a blank line does not end the block, and a bare CR ends a line
selftest_queue $'[Bearer\tZPWTAB12345][ZPWTAB12345][Basic ZPWCR123456][ZPWCR123456] shown=X-K: a log=> X-K: a\\r\\n\\r\\n> Proxy-Authorization\t<redacted, 18 bytes>Authorization: <redacted, 17 bytes>' \
    secretheaders hex:582d4b3a20610d0a0d0a50726f78792d417574686f72697a6174696f6e09426561726572095a505754414231323334350d417574686f72697a6174696f6e3a204261736963205a50574352313233343536
# a fold is no field, and the log hides a cookie without learning it
selftest_queue ' shown= Authorization ZPWFOLD12345 log=>  Authorization ZPWFOLD12345\r\n> Cookie: <redacted, 15 bytes>\r\n> Set-Cookie <redacted, 11 bytes>' \
    secretheaders hex:20417574686f72697a6174696f6e205a5057464f4c4431323334350a436f6f6b69653a207369643d5a505753494431323334350a5365742d436f6f6b6965205a50575345543132333435
# blanks before the colon, a colon in the value, and a name with no colon
selftest_queue '[ZPWa:b12345][Basic ZPWNC123456][ZPWNC123456] shown=Authorization :<redacted, 11 bytes> log=> Authorization :<redacted, 11 bytes>\r\n> Location: http://u:***@h/\r\n> Proxy-Authorization <redacted, 19 bytes>' \
    secretheaders hex:417574686f72697a6174696f6e203a5a5057613a6231323334350d0a4c6f636174696f6e3a20687474703a2f2f753a5a505750415353393940682f0d0a50726f78792d417574686f72697a6174696f6e204261736963205a50574e433132333435362009

selftest_run_queued

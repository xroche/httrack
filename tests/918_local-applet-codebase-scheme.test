#!/bin/bash
# An external applet codebase keeps its own scheme instead of gaining "http://".
set -e

: "${top_srcdir:=..}"

page=appletscheme/index.html

# Without https support the parser leaves an https codebase as written.
https_dir='codebase="https://example\.invalid/sdir/" code="s\.Foo\.class"'
login_dir='codebase="https://user:pw@example\.invalid/ldir/" code="l\.Foo\.class"'
nologin_dir="$login_dir"
if test "$HTTPS_SUPPORT" != "no"; then
    nologin_dir='codebase="https://example\.invalid/ldir/" code="l\.Foo\.class"'
fi

# -%x drops the login from the external codebase.
for opts in "" -%x; do
    expect_login="$login_dir"
    if test -n "$opts"; then
        expect_login="$nologin_dir"
    fi
    # shellcheck disable=SC2086 # $opts is one option or none
    bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
        --file-matches "$page" "$https_dir" \
        --file-matches "$page" "$expect_login" \
        --file-matches "$page" 'codebase="http://example\.invalid/hdir/" code="h\.Foo\.class"' \
        --file-not-matches "$page" 'http://https' \
        httrack "BASEURL/$page" -r2 $opts
done

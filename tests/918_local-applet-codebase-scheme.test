#!/bin/bash
# An external applet codebase keeps its own scheme instead of gaining "http://".
set -e

: "${top_srcdir:=..}"

page=appletscheme/index.html

https_codebase='codebase="https://example\.invalid/sdir/" code="s\.Foo\.class"'
login_codebase='codebase="https://user:pw@example\.invalid/ldir/" code="l\.Foo\.class"'
nologin_codebase='codebase="https://example\.invalid/ldir/" code="l\.Foo\.class"'
http_codebase='codebase="http://example\.invalid/hdir/" code="h\.Foo\.class"'
amp_codebase='codebase="http://example\.invalid/q&amp;x/" code="a\.Foo\.class"'

bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --file-matches "$page" "$https_codebase" \
    --file-matches "$page" "$login_codebase" \
    --file-matches "$page" "$http_codebase" \
    --file-matches "$page" "$amp_codebase" \
    --file-not-matches "$page" 'http://https' \
    httrack "BASEURL/$page" -r2

# -%x drops the login, but without https support the parser leaves an https
# codebase as written.
privacy_codebase="$login_codebase"
if test "$HTTPS_SUPPORT" != "no"; then
    privacy_codebase="$nologin_codebase"
fi
bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --file-matches "$page" "$https_codebase" \
    --file-matches "$page" "$privacy_codebase" \
    --file-matches "$page" "$http_codebase" \
    --file-matches "$page" "$amp_codebase" \
    --file-not-matches "$page" 'http://https' \
    httrack "BASEURL/$page" -r2 -%x

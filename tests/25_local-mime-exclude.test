#!/bin/bash
#
# A -mime: exclusion must abort the transfer on the response Content-Type
# instead of fetching the whole 1 MB body (#58). The file is absent either way,
# so the guard is the bytes-received count, which stays tiny only with the fix.
# Match a count of at most 4 digits, so a missing summary line fails.

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --found 'mimex/real.html' \
    --not-found 'mimex/blob.pdf' \
    --log-found 'excluded by MIME type filter' \
    --log-found '\[[0-9]{1,4} bytes received' \
    httrack 'BASEURL/mimex/index.html' '-mime:application/pdf'

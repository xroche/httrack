#!/bin/bash
#
# A -mime: exclusion must abort on the response Content-Type instead of
# fetching the 1 MB body (#58). The file is absent either way, so match a
# bytes-received count of at most 4 digits.

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 0 \
    --found 'mimex/real.html' \
    --not-found 'mimex/blob.pdf' \
    --log-found 'excluded by MIME type filter' \
    --log-found '\[[0-9]{1,4} bytes received' \
    httrack 'BASEURL/mimex/index.html' '-mime:application/pdf'

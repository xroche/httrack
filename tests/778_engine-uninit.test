#!/bin/bash
#
# hts_uninit() releases what hts_init() set up, and hts_init() rebuilds it.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

require_httrack

# worker: hts_uninit() from a worker returns and keeps the lock it still needs.
# uninit twice: the PSL and the lock are freed, and a repeat is harmless.
# rejoin: hts_init() and a new worker bring both back.
assert_selftest 'worker:kept uninit:psl-off,lock-off uninit:psl-off,lock-off rejoin:psl-on,lock-on' uninit

#!/bin/bash
# Windows has no cross-process SIGTERM, so a running engine takes a stop request
# as a file: hts-abort.lock in the output directory, beside the hts-stop.lock
# that asks for a pause. It acts on one only when it could also delete it.
set -eu

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_abortlock.XXXXXX") || exit 1
crawlpid=
cleanup() {
    if test -n "$crawlpid"; then kill -9 "$crawlpid" 2>/dev/null || true; fi
    # The rule self-test leaves a directory it made read-only on purpose.
    chmod -R u+w "$tmpdir" 2>/dev/null || true
    rm -rf "$tmpdir"
}
cleanup_push cleanup

wait_until() { # wait_until <shell condition> <message>
    for _ in $(seq 1 300); do
        if eval "$1"; then return 0; fi
        sleep 0.1
    done
    fail "$2"
}

stop_crawl() {
    if test -n "$crawlpid"; then
        kill -9 "$crawlpid" 2>/dev/null || true
        wait "$crawlpid" 2>/dev/null || true
        crawlpid=
    fi
}

require_httrack

# A request that deletes is acted on once; one in a read-only directory never is.
expect_ok "abortlock self-test" httrack -O "${tmpdir}/st" \
    -#test=abortlock "$(nativepath "${tmpdir}/rule")"

local_server_start
common=(--quiet --disable-security-limits --robots=0 --timeout=30 --retries=0 -c1)

# /trickle/ hands out eight .bin pages, two bytes a second for a minute each, so
# the single socket is busy and only the reading inside that wait can see this.
printf '[a running engine takes the request] ..\t'
out="${tmpdir}/running"
httrack -O "$out" "${common[@]}" "${BASEURL}/trickle/index.html" \
    >"${tmpdir}/log-running" 2>&1 &
crawlpid=$!
wait_until "test -s '${out}/hts-cache/new.zip'" "the crawl never got going"
sleep 1
: >"${out}/hts-abort.lock"
wait_until "test ! -e '${out}/hts-abort.lock'" \
    "30s on, a running engine had not read the request"
command grep -q "Exit requested by shell or user" "${out}/hts-log.txt" ||
    fail "the request was taken but the engine did not record a stop"
stop_crawl
echo "OK"

# The pause wait watches for it too, or a paused engine is unreachable.
printf '[a paused engine takes the request] ..\t'
out="${tmpdir}/paused"
httrack -O "$out" "${common[@]}" --max-rate=200000 \
    "${BASEURL}/bigfiles/index.html" >"${tmpdir}/log-paused" 2>&1 &
crawlpid=$!
wait_until "test -s '${out}/hts-cache/new.zip'" "the crawl never got going"
sleep 1
: >"${out}/hts-stop.lock"
wait_until "test -e '${out}/hts-paused.lock'" "the engine never paused"
: >"${out}/hts-abort.lock"
wait_until "test ! -e '${out}/hts-abort.lock'" \
    "30s on, a paused engine had not read the request"
stop_crawl
echo "OK"

# A request nobody cleared is not one this run was asked to honour: without the
# start-up clearing it stops the mirror with nothing saved and an exit status of 0.
printf '[a request left behind does not stop the next mirror] ..\t'
out="${tmpdir}/stale"
mkdir -p "$out"
: >"${out}/hts-abort.lock"
local_crawl --log "${tmpdir}/log-stale" -O "$out" "${common[@]}" \
    "${BASEURL}/simple/basic.html" || fail "the mirror failed outright"
test -n "$(find "$out" -name 'basic.html' 2>/dev/null)" ||
    fail "the mirror saved nothing, so the request it inherited stopped it"
test ! -e "${out}/hts-abort.lock" ||
    fail "the request was left in place for the next mirror to find"
echo "OK"

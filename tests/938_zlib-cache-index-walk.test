#!/bin/bash
#
# The shared ZIP cache index walk: keys, case-insensitive matching, and a NUL
# ending the header scan (-#test=cache-walk).

set -eu
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

dir=$(mktemp -d)
cleanup_push rm -rf "$dir"
mkdir "$dir/hts-cache"

httrack -#test=cache-walk "$dir" >"$dir/out" 2>"$dir/err" ||
    fail_dump "the engine self-test failed" "$dir/out" "$dir/err"
out=$(tail -n1 "$dir/out")
test "$out" = "cache-walk: OK" ||
    fail_dump "expected 'cache-walk: OK', got: $out" "$dir/out" "$dir/err"

# ProxyTrack walks the same zip: every entry reaches the ARC
proxytrack --convert "$dir/out.arc" "$dir/hts-cache/new.zip" >"$dir/log" 2>&1 ||
    fail_dump "proxytrack died reading the cache" "$dir/log"
arc=$(<"$dir/out.arc")
for url in http://example.com/upper.html http://example.com/lower.html \
    http://example.com/zero.html http://example.com/nul.html \
    http://example.com/third.html https://example.com/s.html; do
    grep -qF "$url " <<<"$arc" || fail "$url is missing from the ARC"
done

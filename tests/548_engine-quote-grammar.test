#!/bin/bash
#
# The argument quoting grammar: its sites against frozen copies of the old code
# (-#test=quotediff), the split(quote(argv)) round trip, and each split flag.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# The counts are exact, so a shrinking corpus shows.
selftest_queue_lines "quotediff: 100184 cases, 0 failures
quotediff: OK" quotediff
selftest_queue_lines "quoteprop: 40000 cases, 0 failures
quoteprop: OK" quoteprop

# The WebHTTrack command line: every separator splits, quotes stay for argv.
selftest_queue "4:[a][][\"b c\"][d]" splitargs f $'a  "b c"\td'
# The escape goes, the outer quotes stay for the engine to strip.
selftest_queue '3:[a]["x" y"][z]' splitargs f 'a "x\" y" z'
selftest_queue "2:[a][\"b c\"]" splitargs f $'a "b\nc"'
# The doit.log line: only a space splits, quotes go, a "" stays.
selftest_queue "3:[a][b c][]" splitargs sd 'a  "b c" ""'
selftest_queue "1:[ab cd]" splitargs sd 'a"b c"d'
selftest_queue "1:[a\\tb]" splitargs sd $'a\tb'
selftest_queue "2:[a\"b\\c][x]" splitargs sd '"a\"b\\c" x'
selftest_queue "0:" splitargs sd '  '
# Outside quotes a backslash is data, inside it escapes only \ and ".
selftest_queue "1:[a\\\\b]" splitargs - 'a\\b'
selftest_queue "1:[\"a\\nb\"]" splitargs - '"a\nb"'
selftest_queue "1:[a\\]" splitargs s "\"a\\"

selftest_queue '[a "b c" "" "x\"y" "p\\q" -]' quotearg a "b c" "" 'x"y' 'p\q' -
selftest_queue "[x]" unquotearg '"x"'
selftest_queue "[]" unquotearg '""'
selftest_queue "[a\"b]" unquotearg 'a"b'
selftest_queue "missing quote" unquotearg '"x'
selftest_queue "missing quote" unquotearg '"'

selftest_run_queued

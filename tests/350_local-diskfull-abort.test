#!/bin/bash
#
# A full disk must abort the mirror, not pass for a dropped connection that the
# engine retries and then purges against. /dev/full stands in, under the save
# name each crawl is about to write: once for a body that reaches the disk as
# it streams, once for a page and once for a file small enough that stdio holds
# them until the close.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

require_httrack

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_diskfull.XXXXXX")
cleanup() { rm -rf "$tmpdir"; }
cleanup_push cleanup

# The engine here is a native binary and the shell is MSYS, so a symlink the
# shell writes through as /dev/full is a plain file to the crawl: the probe
# below cannot see that difference and would let the test run.
skip_on_windows "a native binary does not follow an MSYS symlink to /dev/full"
# Probe the mechanism, not the node: macOS has no /dev/full and links to it
# happily, so a write through the probe fails with ENOENT rather than ENOSPC.
test -c /dev/full || skip "no /dev/full device"
probe="${tmpdir}/probe"
ln -s /dev/full "$probe" 2>/dev/null || skip "cannot symlink /dev/full"
if printf x >"$probe" 2>/dev/null; then
    skip "a write through /dev/full succeeds here, so it stands in for nothing"
fi
rm -f "$probe"

common=(--quiet --disable-security-limits --robots=0 --retries=2 -c1 --timeout=20)
counter="${tmpdir}/stallhits" # a byte per stall.bin request, so we know when to interrupt
local_server_start --log "${tmpdir}/server.log" --env DISKFULL_COUNTER="$counter"

# What an aborted mirror exits with; HTS_EXIT_MIRROR_ABORTED in the engine.
ABORTED_STATUS=2

# Mirror $1 with $2 pointed at /dev/full, and leave its log in $log. Anything
# past $3 is extra httrack options. Every arm below is a fatal write, so the
# status the engine reports for one is asserted here rather than per arm.
crawl_onto_full() {
    local name="$1" doomed="$2" entry="$3" rc=0
    local dir="${tmpdir}/${name}"
    local site="${dir}/127.0.0.1_${SRV_PORT}/diskfull"

    shift 3
    mkdir -p "$site"
    ln -s /dev/full "${site}/${doomed}"
    # Captured on the line itself: the log read below would clobber $? first.
    local_crawl --log "${tmpdir}/log-${name}" "${common[@]}" "$@" -O "$dir" \
        "${BASEURL}/diskfull/${entry}" || rc=$?
    log=$(<"${dir}/hts-log.txt")
    test "$rc" -eq "$ABORTED_STATUS" ||
        fail "the ${name} arm exited ${rc}, wanted ${ABORTED_STATUS}: ${log}"
}

# --- a body that streams: the write itself fails ----------------------------
crawl_onto_full stream big.bin index.html
grep -q 'disk full or filesystem problems' <<<"$log" ||
    fail "a failed disk write was not reported as fatal: ${log}"
ok "the write failure is reported as a disk problem"

if grep -qE 'Retry after error.*diskfull/big\.bin' <<<"$log"; then
    fail "the full disk was retried as if the network had dropped: ${log}"
fi
# What master reports here instead of the disk.
if grep -q 'Incorrect length' <<<"$log"; then
    fail "the full disk is still reported as a truncated download: ${log}"
fi
ok "it is not retried, nor relabelled a truncated download"

grep -q 'Mirror aborted: keeping all previously mirrored files' <<<"$log" ||
    fail "the mirror carried on past the full disk, purge armed: ${log}"
ok "the mirror gives up and keeps every mirrored file"

# Keeping the mirror is the point of the abort, so read the tree, not the log:
# what preceded the full disk survives and the doomed name is still the symlink.
site="${tmpdir}/stream/127.0.0.1_${SRV_PORT}/diskfull"
test -s "${site}/index.html" || fail "the page mirrored before the abort was lost"
grep -q DISKFULL-TINY "${site}/tiny.bin" ||
    fail "the file mirrored before the abort was lost or truncated"
test -L "${site}/big.bin" ||
    fail "a truncated big.bin replaced the name the crawl wrote through"
ok "the files mirrored before the abort survive it"

# --- a page that fits in stdio's buffer: only the close fails ---------------
crawl_onto_full page small.html smallindex.html
grep -q 'Unable to write HTML file' <<<"$log" ||
    fail "a page whose close failed was saved as a success: ${log}"
grep -q 'Fatal write error, giving up' <<<"$log" ||
    fail "the full disk did not stop the mirror on the page path: ${log}"
ok "a page that only fails on close is fatal too"

# --- and a file that fits: its close is the engine's only warning -----------
crawl_onto_full tiny tiny.bin index.html
grep -q 'disk full or filesystem problems' <<<"$log" ||
    fail "a file whose close failed was counted as written: ${log}"
grep -q 'Mirror aborted: keeping all previously mirrored files' <<<"$log" ||
    fail "the mirror carried on past the full disk, purge armed: ${log}"
ok "a small file that only fails on close is fatal too"

# --- the body that one read completes: its write fails on that same read ------
# Under 4 KB the fclose net catches this; past it only the read's own return
# says anything, and r.size had already reached totalsize when the write failed.
crawl_onto_full mid mid.bin midindex.html
grep -q 'disk full or filesystem problems' <<<"$log" ||
    fail "a body completed by the read whose write failed passed for an EOF: ${log}"
grep -q 'Mirror aborted: keeping all previously mirrored files' <<<"$log" ||
    fail "the mirror carried on past the full disk, purge armed: ${log}"
ok "a body whose last read is the failing write is fatal too"

# Chunked, same shape: the chunk-end test next door erased the error outright.
crawl_onto_full chunked chunked.bin chunkedindex.html
grep -q 'disk full or filesystem problems' <<<"$log" ||
    fail "a chunk completed by the read whose write failed passed for clean: ${log}"
ok "the chunked path is fatal too"

# --- and it is not re-reported as a truncated download -----------------------
# --tolerant downgrades a length mismatch to a warning instead of rewriting the
# status, which is where a disk-cut body would be blamed on the server instead.
crawl_onto_full tolerant big.bin index.html --tolerant
grep -q 'disk full or filesystem problems' <<<"$log" ||
    fail "the tolerant crawl did not report the full disk: ${log}"
if grep -q 'Incorrect length' <<<"$log"; then
    fail "a body the disk cut short was also blamed on the server: ${log}"
fi
ok "a length mismatch the full disk caused is not reported as one"

# --- a write error outside the fatal class must stay retryable ---------------
# A pipe whose reader has gone gives EPIPE, which is about this file, not the
# filesystem: the mirror must finish the rest rather than give up.
epipe="${tmpdir}/epipe"
epipesite="${epipe}/127.0.0.1_${SRV_PORT}/diskfull"
mkdir -p "$epipesite"
mkfifo "${epipesite}/big.bin"
# Take one byte and close, so the next block the engine writes gets EPIPE.
(head -c 1 <"${epipesite}/big.bin" >/dev/null 2>&1 || true) &
reader=$!
# --retries=0: a retry would re-open the fifo and block on a reader that is gone.
epipe_rc=0
local_crawl --log "${tmpdir}/log-epipe" "${common[@]}" --retries=0 -O "$epipe" \
    "${BASEURL}/diskfull/index.html" || epipe_rc=$?
kill "$reader" 2>/dev/null || true
log=$(<"${epipe}/hts-log.txt")
if grep -q 'disk full or filesystem problems' <<<"$log"; then
    fail "a broken pipe was treated as a full disk: ${log}"
fi
if grep -q 'Mirror aborted' <<<"$log"; then
    fail "a write error outside the fatal class gave up the whole mirror: ${log}"
fi
grep -q DISKFULL-TINY "${epipesite}/tiny.bin" ||
    fail "the rest of the mirror did not survive a non-fatal write error"
# The other half of the status the arms above assert: without this, that status
# could mean "a write failed" rather than "the mirror was given up on".
test "$epipe_rc" -eq 0 ||
    fail "a mirror that finished exited ${epipe_rc}: ${log}"
ok "a non-fatal write error leaves the mirror running, and exits 0"

# --- an interrupted transfer: the slot's flush is the only close there is ----
# 100 buffered bytes never reach the disk, so nothing fails until the stopped
# slot is flushed on the way out.
stall="${tmpdir}/stall"
stallsite="${stall}/127.0.0.1_${SRV_PORT}/diskfull"
mkdir -p "$stallsite"
ln -s /dev/full "${stallsite}/stall.bin"
crawlpid=
kill_crawl() { test -z "$crawlpid" || kill -9 "$crawlpid" 2>/dev/null || true; }
cleanup_push kill_crawl
httrack "${common[@]}" --retries=0 -O "$stall" \
    "${BASEURL}/diskfull/stallindex.html" >"${tmpdir}/log-stall" 2>&1 &
crawlpid=$!
for _ in $(seq 1 300); do
    test -s "$counter" && break
    kill -0 "$crawlpid" 2>/dev/null || break
    sleep 0.1
done
test -s "$counter" || fail "the crawl never reached stall.bin; nothing was interrupted"
sleep 0.5
kill -TERM "$crawlpid" 2>/dev/null || true
stall_rc=0
wait "$crawlpid" 2>/dev/null || stall_rc=$?
crawlpid=
log=$(<"${stall}/hts-log.txt")
grep -q 'Unable to write file .*stall\.bin' <<<"$log" ||
    fail "the stopped slot's buffered bytes were dropped without a word: ${log}"
ok "a slot flushed on the way out still reports the full disk"

# An exit the user asked for is not an abort, whatever the flush then finds:
# WebHTTrack renders its cancel button through this status (htsserver.c
# branches on commandReturn), so an abort here would put an error page on it.
test "$stall_rc" -eq 0 ||
    fail "a mirror stopped by SIGTERM exited ${stall_rc}, wanted 0: ${log}"
ok "and the signalled exit is still 0, not an abort"

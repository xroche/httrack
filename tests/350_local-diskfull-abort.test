#!/bin/bash
#
# A body write that fails on a full disk was reported as a connection error and
# retried, leaving exit_xh clear: the mirror carried on and its end-of-update
# purge then measured the site against a truncated copy. /dev/full stands in
# for the full disk, under the save name the crawl is about to write.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

require_httrack
test -w /dev/full || skip "no writable /dev/full"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_diskfull.XXXXXX")
cleanup() { rm -rf "$tmpdir"; }
cleanup_push cleanup

out="${tmpdir}/crawl"
local_server_start --log "${tmpdir}/server.log"
site="${out}/127.0.0.1_${SRV_PORT}/diskfull"
mkdir -p "$site"
ln -s /dev/full "${site}/big.bin"

local_crawl --log "${tmpdir}/log" --quiet --disable-security-limits \
    --robots=0 --retries=2 -c1 --timeout=20 -O "$out" \
    "${BASEURL}/diskfull/index.html"

log=$(<"${out}/hts-log.txt")
grep -q 'disk full or filesystem problems' <<<"$log" ||
    fail "a failed disk write was not reported as fatal: ${log}"
ok "the write failure is reported as a disk problem"

if grep -qE 'Retry after error.*diskfull/big\.bin' <<<"$log"; then
    fail "the full disk was retried as if the network had dropped: ${log}"
fi
ok "it is not retried as a network error"

grep -q 'Mirror aborted: keeping all previously mirrored files' <<<"$log" ||
    fail "the mirror carried on past the full disk, purge armed: ${log}"
ok "the mirror gives up and keeps every mirrored file"

# --- a page small enough to sit in stdio's buffer fails only at fclose -------
out2="${tmpdir}/crawl2"
site2="${out2}/127.0.0.1_${SRV_PORT}/diskfull"
mkdir -p "$site2"
ln -s /dev/full "${site2}/small.html"

local_crawl --log "${tmpdir}/log2" --quiet --disable-security-limits \
    --robots=0 --retries=2 -c1 --timeout=20 -O "$out2" \
    "${BASEURL}/diskfull/smallindex.html"

log2=$(<"${out2}/hts-log.txt")
grep -q 'Unable to write HTML file' <<<"$log2" ||
    fail "a page whose close failed was saved as a success: ${log2}"
grep -q 'Fatal write error, giving up' <<<"$log2" ||
    fail "the full disk did not stop the mirror on the page path: ${log2}"
ok "a page that only fails on close is fatal too"

#!/bin/bash
#
# The header-field reader splits lines as the readers it replaced did, and the
# custom header walks match frozen copies of the old ones.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# The count and corpus checksum are exact, so a shrinking corpus shows.
selftest_queue_lines "custom-header-diff: 79956 cases, 0 failures, corpus f516a94a
custom-header-diff: OK" custom-header-diff

selftest_queue '[HTTP/1.1 200 OK||][A : b |A|b][ folded||][C:d|C|d] rest=E: f' \
    span header $'HTTP/1.1 200 OK\r\nA : b \r\n folded\r\nC:d\r\n\r\nE: f'
# only one CR goes before the LF, in hex because Windows stdin folds CRLF
selftest_queue '[x\r||][y||] rest=' span header hex:780d0d0a79
selftest_queue '[a:|a|][b||] rest=' span header $'a:\nb'
selftest_queue ' rest=X: y' span header $'\r\nX: y'
# 257 bytes into a 256-byte buffer keep 255, the NUL included
a250=$(printf 'A%.0s' {1..250})
selftest_queue "[XXX0:$a250|XXX0|$a250] rest=" span header \
    "hex:585858003a$(printf '41%.0s' {1..252})"

selftest_queue '[A|b]' span headersplit 'A : b '
selftest_queue '[a|]' span headersplit $'a\t:\t'
selftest_queue '[a|b:c]' span headersplit 'a: b:c'
selftest_queue '[|x]' span headersplit ':x'

selftest_run_queued

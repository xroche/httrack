#!/bin/bash
#
# The log masks a secret at the very start and end of a text or a line, and
# never one cut a byte short.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

auth='Authorization: Bearer ZPWTOKEN123'
selftest_queue '[0,12=x***][1,12=***] log=> x***' secretslices x "$auth" xZPWTOKEN123
selftest_queue ' log=> ZPWTOKEN12' secretslices x "$auth" ZPWTOKEN12
selftest_queue '[0,7=***@] log=> ***@' secretslices http://u:PASSWD@h/ x 'PASSWD@'
selftest_queue ' log=> PASSWD' secretslices http://u:PASSWD@h/ x PASSWD
# "X: ZPWTOKEN12\nZPWTOKEN123": a line ends one byte short of the token
selftest_queue '[0,25=X: ZPWTOKEN12\n***][1,25=: ZPWTOKEN12\n***][2,25= ZPWTOKEN12\n***][3,25=ZPWTOKEN12\n***][4,25=PWTOKEN12\n***][5,25=WTOKEN12\n***][6,25=TOKEN12\n***][7,25=OKEN12\n***][8,25=KEN12\n***][9,25=EN12\n***][10,25=N12\n***][11,25=12\n***][12,25=2\n***][13,25=\n***][14,25=***] log=> X: ZPWTOKEN12\r\n> ***' \
    secretslices x "$auth" hex:583a205a5057544f4b454e31320a5a5057544f4b454e313233
# a request line and a Location field, each masked up to its end
selftest_queue_tail ' log=> GET ftp://u:***@h/ HTTP/1.1\r\n> Location: http://u:***@h/x' \
    secretslices http://u:PASSWD@h/ x hex:474554206674703a2f2f753a50415353574440682f20485454502f312e310d0a4c6f636174696f6e3a20687474703a2f2f753a50415353574440682f78

# a front end's buffer clips the name, the redaction marker, or a plain value
selftest_queue_tail ' shown=Authorization' secretslices x "$auth" "$auth" 14
selftest_queue_tail ' shown=Authorization: <red' secretslices x "$auth" "$auth" 20
selftest_queue_tail ' shown=Authorization: <redacted>' secretslices x "$auth" "$auth" 30
selftest_queue_tail ' shown=Authorization: <redacted, 18 bytes>' secretslices x "$auth" "$auth" 60
selftest_queue_tail ' shown=Authorization:' secretslices x "$auth" Authorization: 60
selftest_queue ' log=> X-K: plain value shown=X-K: pl' secretslices x x 'X-K: plain value' 8

selftest_run_queued

#!/bin/bash
#
# lang/*.txt are line pairs: an English msgid, then its translation. A stray
# blank or a drifted msgid silently unhooks every translation that follows,
# rather than failing, so assert the pairing and the join against English.txt.
# Pairs are physical lines here; a msgid ending in \ continues onto the next one
# for the engine (linput_cpp) but not for us. None do today.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

langdir="$top_srcdir/lang"
def="$top_srcdir/lang.def"
eng="$langdir/English.txt"
for f in "$eng" "$def"; do
    [ -f "$f" ] || fail "cannot find $f"
done

tmp=$(mktemp -d)
cleanup_push rm -rf "$tmp"
keys="$tmp/english.keys"

# Byte-wise: each file is in its own declared legacy charset, lang.def is CRLF.
LC_ALL=C awk 'NR%2==1 { sub(/\r$/, ""); print }' "$eng" >"$keys"

# An empty parse would make every check below pass vacuously.
nkeys=$(wc -l <"$keys")
if [ "$nkeys" -lt 400 ]; then
    echo "only $nkeys msgids parsed from $eng; the parse is broken"
    exit 1
fi

nfiles=0
fail=0
for f in "$langdir"/*.txt; do
    nfiles=$((nfiles + 1))
    LC_ALL=C awk -v keys="$keys" -v name="${f##*/}" '
        BEGIN { while ((getline k < keys) > 0) known[k] = 1 }
        { sub(/\r$/, "") }
        NR % 2 == 1 {
            if ($0 == "")
                printf "%s:%d: blank line where an English msgid belongs\n", name, NR
            else if (!($0 in known))
                printf "%s:%d: msgid absent from English.txt: %s\n", name, NR, $0
            else
                next
            bad++
        }
        END {
            if (NR % 2) {
                printf "%s: odd line count (%d): msgid/translation pairing is broken\n", name, NR
                bad++
            }
            exit(bad > 0)
        }
    ' "$f" || fail=1
done

if [ "$nfiles" -lt 25 ]; then
    echo "only $nfiles language files found in $langdir"
    exit 1
fi

# html/server/*.html copies LANGUAGE_CHARSET straight into its <meta>, and
# htsserver.c decodes the POST body with it, so bytes that are not what it says
# render and convert wrong (#963).
c1=$(printf '\302[\200-\237]')
# A single-byte charset maps all 256 byte values, so the iconv decode above
# can never fail on it and cannot see a value left as raw UTF-8; a whole line
# that itself decodes as valid multi-byte UTF-8 is that leak.
# Under 8 bytes a line can be valid UTF-8 by chance (Ukrainian.txt:686 is a
# 2-byte word that is), so short mixed-encoding lines go undetected.
# Raw bytes in an awk ERE, not grep -P: BSD grep has no -P. NUL is left out of
# the ASCII range because an awk record cannot hold one, and no lang file has any.
utf8_full_line=$(printf '^([\001-\177]|[\302-\337][\200-\277]|\340[\240-\277][\200-\277]|[\341-\354][\200-\277][\200-\277]|\355[\200-\237][\200-\277]|[\356-\357][\200-\277][\200-\277]|\360[\220-\277][\200-\277][\200-\277]|[\361-\363][\200-\277][\200-\277][\200-\277]|\364[\200-\217][\200-\277][\200-\277])*$')
high_byte=$(printf '[\200-\377]')
# The value line following a metadata key. Most catalogs are CRLF, Uzbek.txt is not.
field() {
    LC_ALL=C awk -v key="$2" '
        { sub(/\r$/, "") }
        $0 == key { getline v; sub(/\r$/, "", v); print v; exit }' "$1"
}

charset_declared_matches_bytes() {
    f=$1
    cs=$(field "$f" LANGUAGE_CHARSET)
    if [ -z "$cs" ]; then
        echo "${f##*/}: no LANGUAGE_CHARSET declared"
        return 1
    fi
    if ! LC_ALL=C iconv -f "$cs" -t UTF-8 "$f" >"$tmp/utf8" 2>"$tmp/err"; then
        echo "${f##*/}: bytes do not decode as the declared $cs: $(<"$tmp/err")"
        return 1
    fi
    # No legacy 8-bit charset puts text at U+0080..U+009F, so a C1 there means
    # the bytes are really the matching Windows codepage.
    n=$(LC_ALL=C count_matching_lines "$c1" "$tmp/utf8")
    # An empty n means grep failed, not that it found nothing.
    if [ "${n:-1}" -ne 0 ]; then
        echo "${f##*/}: $n lines decode to C1 controls under $cs; the bytes are a Windows codepage"
        return 1
    fi
    # BIG5, gb2312 and shift-jis reach here too: iconv passes a raw UTF-8 leak of
    # accented Latin letters, whose bytes are valid singles in all three. Their own
    # text tops out at 4 non-ASCII bytes per UTF-8-shaped line, so gate on that
    # count rather than on the charset family, and ask for more than 4.
    case "$(printf '%s' "$cs" | LC_ALL=C tr '[:upper:]' '[:lower:]')" in
    # Nothing to tell apart once UTF-8 is what the file claims to be.
    utf-8 | utf8) return 0 ;;
    iso-8859-* | windows-125*) minhigh=1 ;;
    *) minhigh=8 ;;
    esac
    ln=$(LC_ALL=C awk -v u="$utf8_full_line" -v h="$high_byte" -v m="$minhigh" \
        '{ s = $0; nhigh = gsub(h, "", s) }
         length($0) >= 8 && nhigh >= m && $0 ~ u { print NR; exit }' "$f")
    if [ -n "$ln" ]; then
        echo "${f##*/}:$ln: line fully decodes as UTF-8 despite declared $cs; mixed encoding"
        return 1
    fi
    return 0
}

if ! command -v iconv >/dev/null 2>&1; then
    echo "iconv not found; charset check skipped" >&2
else
    # Positive controls, one per branch: a file cannot pass while mislabelled.
    # No CR: BSD sed writes a literal r, and the extractor strips CR anyway.
    LC_ALL=C sed '10s/.*/UTF-8/' "$langdir/Francais.txt" >"$tmp/undecodable.txt"
    LC_ALL=C sed '10s/.*/ISO-8859-2/' "$langdir/Croatian.txt" >"$tmp/c1.txt"
    # A value line left as raw UTF-8, under a declared single-byte charset and then
    # under gb2312, the multi-byte one whose own text comes closest to that shape.
    # Its 8 non-ASCII bytes are what pin minhigh from above; the tree pins it from
    # below, so widening either past the other is caught here.
    leak=$(printf 'Une fuite UTF-8 : caf\xc3\xa9, na\xc3\xafve, t\xc3\xa9l\xc3\xa9phone')
    LC_ALL=C awk -v repl="$leak" \
        'NR == 20 { print repl; next } { print }' "$langdir/Francais.txt" >"$tmp/utf8mix.txt"
    LC_ALL=C awk -v repl="$leak" \
        'NR == 20 { print repl; next } { print }' "$langdir/Chinese-Simplified.txt" >"$tmp/utf8mixmb.txt"
    for probe in undecodable c1 utf8mix utf8mixmb; do
        if charset_declared_matches_bytes "$tmp/$probe.txt" >/dev/null; then
            echo "the charset check passed a deliberately mislabelled file ($probe)"
            exit 1
        fi
    done

    nchecked=0
    for f in "$langdir"/*.txt; do
        nchecked=$((nchecked + 1))
        charset_declared_matches_bytes "$f" || fail=1
    done
    if [ "$nchecked" -ne "$nfiles" ]; then
        echo "charset check saw $nchecked of $nfiles language files"
        exit 1
    fi
fi

# LANGUAGE_FILE is the catalog basename and reaches the network as the update
# link's Language= (#1353), so it must exist, be ASCII, and match the filename.
# The loader backfills an absent key from English, which would silently report
# the wrong language rather than nothing.
for f in "$langdir"/*.txt; do
    base=${f##*/}
    base=${base%.txt}
    lf=$(field "$f" LANGUAGE_FILE)
    if [ -z "$lf" ]; then
        echo "$base.txt: no LANGUAGE_FILE; the loader would report English instead"
        fail=1
    elif [ "$lf" != "$base" ]; then
        echo "$base.txt: LANGUAGE_FILE is \"$lf\", not the basename"
        fail=1
    elif printf '%s' "$lf" | LC_ALL=C grep -q '[^ -~]'; then
        echo "$base.txt: LANGUAGE_FILE \"$lf\" is not ASCII; the update endpoint cannot decode it"
        fail=1
    fi
done

# LANGUAGE_NAME must be the endonym, not English: the menu shows every catalog
# together (#116). Two oracles rather than a copy of the current values, so the
# name may repeat neither a word of the catalog's own English LANGUAGE_WINDOWSID
# nor a common English language name. A language whose endonym really is the
# English word joins own_name_is_english below.
own_name_is_english="en"
exonyms="afrikaans albanian arabic basque belarusian bulgarian catalan chinese croatian czech
danish dutch english estonian farsi filipino finnish flemish french galician georgian
german greek hebrew hindi hungarian icelandic indonesian irish italian japanese kazakh
korean latvian lithuanian macedonian malay norwegian persian polish portuguese
romanian russian serbian simplified slovak slovene slovenian spanish swedish thai
traditional turkish ukrainian urdu uzbek vietnamese welsh"
# BSD awk rejects a newline inside a -v value, so the list travels on one line.
exonyms=$(printf '%s' "$exonyms" | tr '\n' ' ')

name_is_endonym() {
    f=$1
    cs=$(field "$f" LANGUAGE_CHARSET)
    if ! LC_ALL=C iconv -f "$cs" -t UTF-8 "$f" >"$tmp/u8"; then
        echo "${f##*/}: iconv cannot read $cs"
        return 1
    fi
    LC_ALL=C awk -v name="$(field "$tmp/u8" LANGUAGE_NAME)" -v iso="$(field "$f" LANGUAGE_ISO)" \
        -v wid="$(field "$tmp/u8" LANGUAGE_WINDOWSID)" -v exonyms="$exonyms" -v n="${f##*/}" \
        -v exempt="$own_name_is_english" '
        BEGIN {
            split(exempt, x, /[ \t\n]+/)
            for (i in x)
                if (x[i] == iso)
                    exit 0
            split(exonyms, e, /[ \t\n]+/)
            for (i in e)
                bad_word[e[i]] = 1
            split(tolower(wid), w, /[^0-9A-Za-z]+/)
            for (i in w)
                if (w[i] != "")
                    bad_word[w[i]] = 1
            split(tolower(name), t, /[ ()\/,.-]+/)
            for (i in t) {
                if (t[i] != "" && t[i] in bad_word) {
                    printf "%s: LANGUAGE_NAME \"%s\" is the English name, not the endonym (#116)\n", n, name
                    exit 1
                }
            }
        }'
}

if ! command -v iconv >/dev/null 2>&1; then
    echo "iconv not found; endonym check skipped" >&2
else
    # One control per oracle: an English name its own catalog does not name, then
    # a word its LANGUAGE_WINDOWSID does but the list above does not. Match the
    # complaint, not the status: an unreadable fixture also returns non-zero.
    LC_ALL=C sed '2s/.*/Swedish/' "$langdir/Dansk.txt" >"$tmp/exonym.txt"
    LC_ALL=C sed '2s/.*/Nynorsk/' "$langdir/Norsk.txt" >"$tmp/wid.txt"
    for probe in exonym wid; do
        said=$(name_is_endonym "$tmp/$probe.txt" || true)
        case $said in
        *"is the English name"*) ;;
        *)
            echo "the endonym check passed a deliberately English name ($probe): [$said]"
            exit 1
            ;;
        esac
    done
    for f in "$langdir"/*.txt; do
        name_is_endonym "$f" || fail=1
    done
fi

# lang.def maps each LANG_* macro to the English string the GUI compiles in,
# which is the lookup key into every lang/*.txt: no msgid, no translations.
LC_ALL=C awk -v keys="$keys" '
    BEGIN { while ((getline k < keys) > 0) known[k] = 1 }
    { sub(/\r$/, "") }
    NR % 2 == 1 { macro = $0; next }
    macro ~ /^(LANG_|LISTDEF_)/ {
        n++
        if (!($0 in known)) {
            printf "lang.def:%d: %s maps to \"%s\", which is not a msgid in English.txt\n", NR, macro, $0
            bad++
        }
    }
    END {
        if (n < 400) {
            printf "lang.def: only %d LANG_ entries parsed; the parse is broken\n", n
            bad++
        }
        exit(bad > 0)
    }
' "$def" || fail=1

# The CLI prints the wizard's scope answers itself while the GUI reads them from
# lang.def, so a reword on one side alone silently drifts the two apart (#1117).
for scope in "Mirror %s and every host below it" "Ignore %s and every host below it"; do
    for f in "$eng" "$def" "$top_srcdir/src/httrack.c"; do
        if ! LC_ALL=C grep -qF "$scope" "$f"; then
            echo "${f##*/}: missing the wizard scope answer \"$scope\""
            fail=1
        fi
    done
done

# A msgid absent from a language file silently falls back to English (#862).
# Multisets, not sets: a catalog repeating a msgid more often than English.txt
# does keeps the set equal while one of the values it pairs goes unreachable.
# English.txt repeats 27 msgids of its own, and those cancel out on both sides.
LC_ALL=C sort <"$keys" >"$tmp/english.sorted"
for f in "$langdir"/*.txt; do
    LC_ALL=C awk 'NR%2==1 { sub(/\r$/, ""); print }' "$f" | LC_ALL=C sort >"$tmp/have"
    untranslated=$(LC_ALL=C comm -23 "$tmp/english.sorted" "$tmp/have")
    if [ -n "$untranslated" ]; then
        printf '%s\n' "$untranslated" | awk -v n="${f##*/}" '{print n ": untranslated msgid: " $0}'
        fail=1
    fi
    repeated=$(LC_ALL=C comm -13 "$tmp/english.sorted" "$tmp/have")
    if [ -n "$repeated" ]; then
        printf '%s\n' "$repeated" | awk -v n="${f##*/}" '{print n ": msgid occurs more often than in English.txt: " $0}'
        fail=1
    fi
done

# WinHTTrack sprintf()s these strings, and %n/%N/%t/%p/%h/%M/%Q/%q double as
# HTTrack's own build-string letters, so a lost or invented one breaks either.
# No positional specifiers, so a %s that swaps with a %d takes its argument.
placeholder_drift() {
    LC_ALL=C awk '
        # Two characters from each %, so a printf conversion and a build-string
        # letter read alike; %% pairs off on both sides and cancels.
        function toks(s,   n, i, out) {
            n = length(s)
            for (i = 1; i <= n; i++)
                if (substr(s, i, 1) == "%") {
                    out = out substr(s, i, 2) " "
                    i++
                }
            return out
        }
        FNR == 1 { name = FILENAME; sub(/.*\//, "", name) }
        { sub(/\r$/, "") }
        FNR % 2 == 1 { key = $0; next }
        # An empty value falls back to English; the untranslated pin owns it.
        $0 == "" { next }
        {
            pairs++
            want = toks(key)
            got = toks($0)
            if (want != got) {
                printf "%s:%d: placeholders [%s] became [%s]\n", name, FNR, want, got
                bad++
            }
        }
        END { printf "pairs=%d\n", pairs; exit(bad > 0) }
    ' "$@"
}

# One control per direction: a dropped placeholder, then an invented one. A file
# carrying no % at all would satisfy the check with the scanner doing nothing.
printf 'Delete %%s?\nSupprimer ?\n' >"$tmp/dropped.txt"
printf 'Delete?\nSupprimer %%s ?\n' >"$tmp/invented.txt"
printf 'Delete %%s?\nSupprimer %%d ?\n' >"$tmp/swapped.txt"
printf 'Copy %%s to %%d\nCopie %%d vers %%s\n' >"$tmp/reordered.txt"
for probe in dropped invented swapped reordered; do
    if placeholder_drift "$tmp/$probe.txt" >/dev/null; then
        echo "the placeholder check passed a deliberately damaged value ($probe)"
        exit 1
    fi
done

placeholder_drift "$langdir"/*.txt >"$tmp/ph" || fail=1
LC_ALL=C sed '/^pairs=/d' "$tmp/ph"
# Every catalog carries English.txt's msgid count, minus the few empty values
# skipped above; far fewer means the scan read something other than the catalogs.
npairs=$(LC_ALL=C sed -n 's/^pairs=//p' "$tmp/ph")
if [ "${npairs:-0}" -lt $((nfiles * nkeys * 9 / 10)) ]; then
    echo "placeholder check saw only ${npairs:-0} value lines across $nfiles catalogs"
    exit 1
fi

# conv_printf() copies the letter after an unknown escape and drops the backslash,
# so a "\n" that lost its n merges two combo-box rows and mislabels every row after.
unknown_escapes() {
    LC_ALL=C awk -v name="$2" -v showok="${3:-}" '
        # Built here from character codes: a quote or a backslash spelled inside
        # an -v assignment is eaten before awk sees it.
        BEGIN {
            ok = "abfnrtv?" sprintf("%c%c%c", 39, 34, 92)
            if (showok) { print ok; exit }
        }
        { sub(/\r$/, "") }
        NR % 2 == 1 { next }
        {
            values++
            n = length($0)
            for (i = 1; i <= n; i++)
                if (substr($0, i, 1) == "\\") {
                    c = substr($0, i + 1, 1)
                    if (c == "" || index(ok, c) == 0)
                        printf "%s:%d: \\%s is not an escape; conv_printf drops the backslash\n",
                            name, NR, (c == "" ? "<end of line>" : c)
                    i++
                }
        }
        END { printf "values=%d\n", values + 0 }
    ' "$1"
}

if ! command -v iconv >/dev/null 2>&1; then
    echo "iconv not found; escape check skipped" >&2
else
    # Controls: a lost n, then a dangling backslash. Match the complaint rather
    # than the status, since an empty report also reads as success.
    printf 'Two lines\nDeux lignes\\mTrois lignes\n' >"$tmp/lostn.txt"
    printf 'Ends badly\nFinit mal\\\n' >"$tmp/dangling.txt"
    escape_wanted() { [ "$1" = lostn ] && printf '\\m' || printf '\\<end of line>'; }
    # An escaped backslash is legal and common (Windows paths in English.txt:812),
    # so prove the check does not fire on one.
    printf 'A path\nC:\\\\Temp\n' >"$tmp/legal.txt"
    for probe in lostn dangling; do
        case $(unknown_escapes "$tmp/$probe.txt" "$probe.txt" | LC_ALL=C sed '/^values=/d') in
        *"$(escape_wanted "$probe") is not an escape"*) ;;
        *)
            echo "the escape check passed a deliberately broken value ($probe)"
            exit 1
            ;;
        esac
    done
    if [ -n "$(unknown_escapes "$tmp/legal.txt" legal.txt | LC_ALL=C sed '/^values=/d')" ]; then
        echo "the escape check rejects a legally escaped backslash"
        exit 1
    fi
    # The set is the spec, mirroring conv_printf's switch: a probe can only ever
    # name the letters it happens to use, so widening by any other one is invisible.
    want_ok="abfnrtv?$(printf '\047\042\134')"
    got_ok=$(printf 'x\ny\n' >"$tmp/ok.txt" && unknown_escapes "$tmp/ok.txt" ok.txt 1 | head -1)
    if [ "$got_ok" != "$want_ok" ]; then
        echo "the escape valid set is [$got_ok], expected [$want_ok]"
        exit 1
    fi

    # One probe per letter the catalogs actually got wrong, so a widened set
    # also fails loudly rather than only through the pin above.
    printf 'Five bad\na\\Pb\\Dc\\Kd\\he\\sf\n' >"$tmp/letters.txt"
    nbad=$(unknown_escapes "$tmp/letters.txt" letters.txt | LC_ALL=C grep -c 'is not an escape') || true
    if [ "${nbad:-0}" -ne 5 ]; then
        echo "the escape check named ${nbad:-0} of 5 bad escape letters"
        exit 1
    fi

    # Shift-JIS maps 0x5C to the yen sign, hiding every escape in Japanese.txt
    # from the scan below. The engine reads the byte, so put the backslashes back.
    yen=$(printf '\302\245')
    nesc=0
    for f in "$langdir"/*.txt; do
        nesc=$((nesc + 1))
        cs=$(field "$f" LANGUAGE_CHARSET)
        # Decoded, not raw: 0x5C is a legal trail byte in BIG5 and Shift-JIS.
        LC_ALL=C iconv -f "$cs" -t UTF-8 "$f" >"$tmp/esc" || fail "${f##*/}: iconv cannot read $cs"
        case $(printf '%s' "$cs" | LC_ALL=C tr '[:upper:]' '[:lower:]') in
        shift-jis | shift_jis | sjis | cp932)
            LC_ALL=C sed "s|$yen|\\\\|g" "$tmp/esc" >"$tmp/esc.bs" && mv "$tmp/esc.bs" "$tmp/esc"
            ;;
        esac
        out=$(unknown_escapes "$tmp/esc" "${f##*/}")
        nval=$(printf '%s\n' "$out" | LC_ALL=C sed -n 's/^values=//p')
        # A scan that stopped after the first pair would satisfy every control.
        if [ "${nval:-0}" -lt $((nkeys * 9 / 10)) ]; then
            echo "${f##*/}: escape scan read only ${nval:-0} of $nkeys values"
            exit 1
        fi
        found=$(printf '%s\n' "$out" | LC_ALL=C sed '/^values=/d')
        if [ -n "$found" ]; then
            printf '%s\n' "$found"
            fail=1
        fi
    done
    if [ "$nesc" -ne "$nfiles" ]; then
        echo "escape check saw $nesc of $nfiles language files"
        exit 1
    fi
fi

# A value copied verbatim from its msgid, or left empty, passes every check above
# while the string is still English on screen (#1260). A handful are legitimate,
# so the per-catalog counts are pinned and have to match exactly.
pin="$testdir/62_lang-untranslated.counts"
[ -f "$pin" ] || fail "cannot find $pin"

# Surrounding blanks are stripped before comparing: a value of one space, or a
# msgid copied with a trailing one, is as untranslated as the bare shapes.
count_untranslated() {
    # Two anchored sub()s, not one alternation gsub: BSD awk restarts gsub after
    # each match, where the leading-blank anchor can fire again mid-line.
    LC_ALL=C awk -v name="$2" '
        function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        { sub(/\r$/, "") }
        NR % 2 == 1 { key = trim($0); next }
        { value = trim($0) }
        value == "" { empty++ }
        value != "" && value == key { same++ }
        END { printf "%-25s %-9d %d\n", name, same + 0, empty + 0 }
    ' "$1"
}

# Catalogs pinned at zero would also match a counter that never leaves it, so
# count a fixture carrying one of each shape before trusting the real ones.
printf 'Cancel\nCancel\nClose\nClose \nOK\n \nSave\nEnregistrer\n' >"$tmp/probe.txt"
got=$(count_untranslated "$tmp/probe.txt" probe.txt)
want=$(printf '%-25s %-9d %d\n' probe.txt 2 1)
if [ "$got" != "$want" ]; then
    echo "the untranslated counter miscounts a known fixture: got [$got] want [$want]"
    exit 1
fi

: >"$tmp/counts"
for f in "$langdir"/*.txt; do
    # English.txt is the msgid side of every pair, identical by construction.
    [ "$f" != "$eng" ] || continue
    count_untranslated "$f" "${f##*/}" >>"$tmp/counts"
done
LC_ALL=C sort -o "$tmp/counts" "$tmp/counts"

rc=0
LC_ALL=C awk -v pin="$pin" '
    function report(name, got, want, kind,   what) {
        what = "lower the pin here"
        if (got > want)
            what = "translate it rather than raise the pin"
        printf "%s: %d %s, pinned at %d: %s\n", name, got, kind, want, what
        bad++
    }
    BEGIN {
        while ((getline line < pin) > 0) {
            sub(/\r$/, "", line)
            if (line ~ /^[ \t]*(#|$)/)
                continue
            # A second row for the same catalog would otherwise just win, so the
            # numbers a bad merge left behind have to be rejected, not applied.
            if (split(line, a, /[ \t]+/) != 3 || a[2] !~ /^[0-9]+$/ ||
                a[3] !~ /^[0-9]+$/ || a[1] in pinned) {
                printf "%s: malformed pin line: %s\n", pin, line
                bad++
                continue
            }
            same[a[1]] = a[2]
            empty[a[1]] = a[3]
            pinned[a[1]] = 1
        }
    }
    {
        seen[$1] = 1
        if (!($1 in pinned)) {
            printf "%s: no pinned untranslated counts; add them\n", $1
            bad++
            next
        }
        if ($2 != same[$1])
            report($1, $2, same[$1], "values identical to their English msgid")
        if ($3 != empty[$1])
            report($1, $3, empty[$1], "empty values")
    }
    END {
        for (f in pinned)
            if (!(f in seen)) {
                printf "%s: pinned but no such catalog\n", f
                bad++
            }
        exit(bad > 0 ? 3 : 0)
    }
' "$tmp/counts" || rc=$?
# A mismatch says so with 3, because awk's own error status varies by
# implementation; reading any of them as a mismatch would hide a broken check.
if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
    echo "the untranslated-count comparison itself failed"
    exit 1
elif [ "$rc" -ne 0 ]; then
    new=$PWD/62_lang-untranslated.counts.new
    LC_ALL=C awk '/^[ \t]*#/ || /^[ \t]*$/' "$pin" >"$new"
    cat "$tmp/counts" >>"$new"
    echo "once the counts are right for the right reason: cp $new $pin"
    fail=1
fi

# These name real paths on disk and on the wire, so a translated one sends the
# user nowhere: "htscache/new.*" and "robot.txt" both shipped. Case is the
# translator's, spelling is not, and example hostnames stay their call. Counted
# rather than matched: keeping one web/ of eleven still misroutes ten rows.
# Counts must match: one too few loses a path, one too many duplicates a row.
literal_tokens="hts-cache robots.txt cgi-bin web/images web/html"
translated_literals() {
    LC_ALL=C awk -v name="$2" -v toks="$literal_tokens" '
        function count(hay, needle,   n, i) {
            n = 0
            i = index(hay, needle)
            while (i > 0) {
                n++
                hay = substr(hay, i + length(needle))
                i = index(hay, needle)
            }
            return n
        }
        BEGIN { split(toks, t, " ") }
        { sub(/\r$/, "") }
        NR % 2 == 1 { key = $0; next }
        $0 == "" { next }
        {
            for (i in t) {
                want = count(tolower(key), t[i])
                got = count(tolower($0), t[i])
                if (got != want)
                    printf "%s:%d: msgid names %s %d times, the translation %d\n",
                        name, NR, t[i], want, got
            }
        }
    ' "$1"
}

# A fixture carrying one kept and one lost literal, so a checker that never
# fires cannot pass for one that has nothing to report.
printf 'Erase hts-cache/new.*\nEfface htscache/new.*\nFollow robots.txt\nSuivre robot.txt\nrobots.txt, robots.txt and robots.txt\nrobots.txt et robots.txt\nHtml in web/images and web/images\nHtml dans web/images\nHtml in web/html\nHtml dans web/html et web/html\nSee cgi-bin\nVoir cgi-poubelle\n' >"$tmp/literals.txt"
case $(translated_literals "$tmp/literals.txt" literals.txt) in
*"msgid names robots.txt 1 times, the translation 0"*) ;;
*)
    echo "the literal-token check missed a translated robots.txt"
    exit 1
    ;;
esac
# Two findings, not one: the second pair drops one robots.txt of three, which a
# checker looking only for presence would pass.
# The list is the spec, so pin it: a fixture can only ever exercise the tokens
# it happens to name, and dropping any other one would go unnoticed.
want_tokens="hts-cache robots.txt cgi-bin web/images web/html"
if [ "$literal_tokens" != "$want_tokens" ]; then
    echo "literal_tokens is [$literal_tokens], expected [$want_tokens]"
    exit 1
fi

# One damaged pair per token, so narrowing the list cannot pass, plus the other
# direction: a token named twice where the msgid names it once duplicates a
# dropdown row, so a one-sided comparison has to fail here too.
if [ "$(translated_literals "$tmp/literals.txt" literals.txt | wc -l)" -ne 6 ]; then
    echo "the literal-token check did not report all six damaged fixtures"
    exit 1
fi

for f in "$langdir"/*.txt; do
    found=$(translated_literals "$f" "${f##*/}")
    if [ -n "$found" ]; then
        printf '%s\n' "$found"
        fail=1
    fi
done

# A combo-box "\n" starts a row, so a value whose break count differs from its
# msgid shifts every row after it. Most drift here is prose reflowed to another
# width, so counts are pinned per catalog; a new one has to be looked at.
count_linebreaks() {
    LC_ALL=C awk -v name="$2" '
        # Escaped backslashes go first: in "\\n" the break belongs to neither
        # the pair nor the n, and counting it hides a row that never breaks.
        function breaks(s,   n) {
            gsub(/\\\\/, "", s)
            n = gsub(/\\r\\n/, "", s)
            return n + gsub(/\\n/, "", s)
        }
        { sub(/\r$/, "") }
        NR % 2 == 1 { key = $0; next }
        # An empty value renders as English, breaks included.
        $0 == "" { next }
        breaks(key) != breaks($0) { drift++ }
        END { printf "%-25s %d\n", name, drift + 0 }
    ' "$1"
}

# A catalog pinned at zero would also match a counter stuck there, so count a
# fixture holding one drifting pair and one matching pair first.
printf 'a\\nb\nx\\ny\nc\\nd\nz\ne\\nf\ng\\\\nh\n' >"$tmp/breaks.txt"
got=$(count_linebreaks "$tmp/breaks.txt" breaks.txt)
want=$(printf '%-25s %d\n' breaks.txt 2)
if [ "$got" != "$want" ]; then
    echo "the line-break counter miscounts a known fixture: got [$got] want [$want]"
    exit 1
fi

lbpin="$testdir/62_lang-linebreaks.counts"
[ -f "$lbpin" ] || fail "cannot find $lbpin"
: >"$tmp/lb"
for f in "$langdir"/*.txt; do
    [ "$f" != "$eng" ] || continue
    count_linebreaks "$f" "${f##*/}" >>"$tmp/lb"
done
LC_ALL=C sort -o "$tmp/lb" "$tmp/lb"
LC_ALL=C awk -v pin="$lbpin" '
    BEGIN {
        while ((getline line < pin) > 0) {
            sub(/\r$/, "", line)
            if (line ~ /^[ \t]*(#|$)/)
                continue
            if (split(line, a, /[ \t]+/) != 2 || a[2] !~ /^[0-9]+$/ || a[1] in pinned) {
                printf "%s: malformed pin line: %s\n", pin, line
                bad++
                continue
            }
            want[a[1]] = a[2]
            pinned[a[1]] = 1
        }
    }
    {
        seen[$1] = 1
        if (!($1 in pinned)) {
            printf "%s: no pinned line-break count; add it\n", $1
            bad++
            next
        }
        if ($2 > want[$1])
            printf "%s: %d values whose line breaks differ from their msgid, pinned at %d: read the new one before raising it\n", $1, $2, want[$1], bad++
        else if ($2 < want[$1])
            printf "%s: %d line-break mismatches, pinned at %d: lower the pin\n", $1, $2, want[$1], bad++
    }
    END {
        for (f in pinned)
            if (!(f in seen)) {
                printf "%s: pinned but no such catalog\n", f
                bad++
            }
        exit(bad > 0)
    }
' "$tmp/lb" || fail=1

# A single-byte charset maps all 256 values, so a catalog can declare the wrong
# one and still decode: Romanian said ISO-8859-1 with ISO-8859-2 bytes for years,
# and every a-breve reached the browser as a-tilde. Catch it by naming letters
# the language never writes. These are not merely absent from the language, they
# are what reading its own bytes as Latin-1 produces, which is the mistake being
# caught; the loop below proves each row still fires. A language absent from the
# table is unchecked, so a pass here says nothing about one.
never_used="ro:ãºþ pl:¹³ê¿ cs:øìèù sk:è¾ï hu:õû hr:èæð sl:è"

foreign_letters() {
    LC_ALL=C awk -v name="$2" -v iso="$3" -v only="${4:-}" -v table="$never_used" '
        BEGIN {
            n = split(table, rows, " ")
            for (i = 1; i <= n; i++) {
                split(rows[i], kv, ":")
                if (kv[1] == iso)
                    bad = kv[2]
            }
            if (only != "")
                bad = only
            if (bad == "")
                exit 0
        }
        { sub(/\r$/, "") }
        NR % 2 == 1 { next }
        {
            # Byte-wise under LC_ALL=C, so walk the UTF-8 two-byte sequences.
            for (i = 1; i <= length(bad); i += 2) {
                ch = substr(bad, i, 2)
                if (index($0, ch) > 0) {
                    # One line per catalog: a wrong charset hits nearly every
                    # value, and the count is the evidence, not the list.
                    if (hits++ == 0)
                        printf "%s:%d: %s is not used in %s; the declared charset is wrong\n",
                            name, NR, ch, iso
                    break
                }
            }
        }
        END {
            if (hits > 1)
                printf "%s: %d more values carry letters %s does not use\n",
                    name, hits - 1, iso
        }
    ' "$1"
}

if ! command -v iconv >/dev/null 2>&1; then
    echo "iconv not found; charset repertoire check skipped" >&2
else
    # Every row must fire when its own catalog is read as Latin-1, the mislabel
    # this exists to catch. A row naming letters that mistake never produces is
    # inert, and an inert row reads exactly like a clean catalog.
    for row in $never_used; do
        riso=${row%%:*}
        rfile=""
        for f in "$langdir"/*.txt; do
            [ "$(field "$f" LANGUAGE_ISO)" = "$riso" ] || continue
            rfile=$f
            break
        done
        if [ -z "$rfile" ]; then
            echo "never_used names $riso, which no catalog declares"
            exit 1
        fi
        LC_ALL=C iconv -f ISO-8859-1 -t UTF-8 "$rfile" >"$tmp/mis"
        # Per letter, not per row: a row keeping one live letter of three would
        # otherwise pass while the rest of it sat dead.
        # Process substitution, not a pipe: a piped loop runs in a subshell and
        # its exit would not end the test.
        while read -r letter; do
            if [ -z "$(foreign_letters "$tmp/mis" "${rfile##*/}" "$riso" "$letter")" ]; then
                echo "never_used $riso lists $letter, which a Latin-1 misread never makes"
                exit 1
            fi
        done < <(LC_ALL=C awk -v l="${row#*:}" '
            BEGIN { for (i = 1; i <= length(l); i += 2) print substr(l, i, 2) }')
    done

    # Control: Romanian read as the Latin-1 it used to claim must be rejected,
    # and read as the Latin-2 it is must pass.
    LC_ALL=C iconv -f ISO-8859-1 -t UTF-8 "$langdir/Romanian.txt" >"$tmp/ro-wrong"
    if [ -z "$(foreign_letters "$tmp/ro-wrong" Romanian.txt ro)" ]; then
        echo "the charset check passed Romanian decoded as ISO-8859-1"
        exit 1
    fi
    LC_ALL=C iconv -f ISO-8859-2 -t UTF-8 "$langdir/Romanian.txt" >"$tmp/ro-right"
    if [ -n "$(foreign_letters "$tmp/ro-right" Romanian.txt ro)" ]; then
        echo "the charset check rejected Romanian decoded as ISO-8859-2"
        exit 1
    fi

    for f in "$langdir"/*.txt; do
        cs=$(field "$f" LANGUAGE_CHARSET)
        LC_ALL=C iconv -f "$cs" -t UTF-8 "$f" >"$tmp/rep" || fail "${f##*/}: iconv cannot read $cs"
        found=$(foreign_letters "$tmp/rep" "${f##*/}" "$(field "$f" LANGUAGE_ISO)")
        if [ -n "$found" ]; then
            printf '%s\n' "$found"
            fail=1
        fi
    done
fi

# Each combo box is filled from a LISTDEF_* list and read back as a bare row
# index that selects an engine option, so a list whose item count differs from
# its msgid hands the engine the neighbour of what the user clicked: wrong robots
# policy, wrong travel mode, wrong structure, silently and per locale. WinHTTrack
# cannot catch it (its own selftest checks the English list) and it never shows
# in English, so this is the only place it is caught. Exact, not pinned like the
# line-break counts: these are the strings where a compensating change hides.
listdef_keys="$tmp/listdef.keys"
LC_ALL=C awk '
    { sub(/\r$/, "") }
    NR % 2 == 1 { macro = $0; next }
    macro ~ /^LISTDEF_/ { print }
' "$def" | LC_ALL=C sort -u >"$listdef_keys"
nlist=$(wc -l <"$listdef_keys")
# Pinned: a new list is a new combo box whose indices want looking at, not a
# number to bump. A parse that returned nothing would otherwise pass everything.
if [ "$nlist" -ne 11 ]; then
    echo "$def: parsed $nlist LISTDEF_ lists, expected 11"
    exit 1
fi

listdef_items() {
    LC_ALL=C awk -v name="$2" -v keyfile="$3" '
        # Items, not breaks: an escaped backslash is not a separator.
        # An escaped backslash is not a separator, so it goes first; the count
        # that follows sees a \n inside a \r\n exactly once either way.
        function items(s) {
            gsub(/\\\\/, "", s)
            return gsub(/\\n/, "", s) + 1
        }
        BEGIN { while ((getline k < keyfile) > 0) want[k] = items(k) }
        { sub(/\r$/, "") }
        NR % 2 == 1 { key = $0; next }
        !(key in want) { next }
        # An empty value renders as English, so English sets its row count.
        $0 == "" { next }
        {
            cmp++
            if (items($0) != want[key])
                printf "%s:%d: list has %d items, its msgid %d: a combo row selects the wrong option\n",
                    name, NR, items($0), want[key]
        }
        END { printf "cmp=%d\n", cmp + 0 }
    ' "$1"
}

# One control per direction: a value that lost an item and one that invented
# another, against a real msgid. Built as a pair rather than by editing a
# catalog, since English.txt repeats each msgid as its own value and resizing
# both sides at once keeps them equal.
LC_ALL=C awk -v kf="$listdef_keys" -v dir="$tmp" '
    BEGIN {
        getline k < kf
        short = k
        sub(/\\n[^\\]*$/, "", short)
        print k > (dir "/short.txt")
        print short > (dir "/short.txt")
        print k > (dir "/long.txt")
        print k "\\nextra" > (dir "/long.txt")
        # An escaped backslash before an n is not a separator. No catalog holds
        # one today, so without this the guard that strips them is unreachable.
        esc = k
        sub(/\\n/, "\\\\n", esc)
        print k > (dir "/escbs.txt")
        print esc > (dir "/escbs.txt")
    }' </dev/null
for probe in short long escbs; do
    case $(listdef_items "$tmp/$probe.txt" "$probe.txt" "$listdef_keys") in
    *"selects the wrong option"*) ;;
    *)
        echo "the LISTDEF check passed a deliberately resized list ($probe)"
        exit 1
        ;;
    esac
done

ncmp=0
for f in "$langdir"/*.txt; do
    out=$(listdef_items "$f" "${f##*/}" "$listdef_keys")
    ncmp=$((ncmp + $(printf '%s\n' "$out" | LC_ALL=C sed -n 's/^cmp=//p')))
    found=$(printf '%s\n' "$out" | LC_ALL=C sed '/^cmp=/d')
    if [ -n "$found" ]; then
        printf '%s\n' "$found"
        fail=1
    fi
done
# Every catalog owns every list, bar a couple of empty values. A scan narrowed
# to one list, one catalog or none would otherwise report nothing and pass.
if [ "$ncmp" -lt $((nfiles * nlist * 9 / 10)) ]; then
    echo "LISTDEF check compared $ncmp values, expected about $((nfiles * nlist))"
    exit 1
fi
# An unknown ${LANG_*} renders as nothing rather than erroring, so check that
# every macro the templates interpolate, in any wrapper form, resolves.
LC_ALL=C grep -oh '[$]{[^}]*LANG_[A-Za-z0-9_]*}' "$top_srcdir"/html/server/*.html |
    LC_ALL=C sed 's|.*\(LANG_[A-Za-z0-9_]*\)}|\1|' | LC_ALL=C sort -u >"$tmp/used"
nused=$(wc -l <"$tmp/used")
if [ "$nused" -lt 100 ]; then
    echo "only $nused LANG_ macros scanned from html/server; the scan is broken"
    exit 1
fi
LC_ALL=C awk 'NR%2==1 { sub(/\r$/, ""); print }' "$def" | LC_ALL=C sort -u >"$tmp/defined"
undef=$(LC_ALL=C comm -23 "$tmp/used" "$tmp/defined")
if [ -n "$undef" ]; then
    printf '%s\n' "$undef" | awk '{print "html/server uses a macro absent from lang.def: " $0}'
    fail=1
fi

[ "$fail" -eq 0 ] || exit 1

echo "$nfiles language files consistent with $nkeys English msgids"

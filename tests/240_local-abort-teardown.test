#!/bin/bash
# An aborted mirror (-#L limit, then a dead server) must still commit its WARC
# and rewrite the .cdx, and must leave the previous change report alone: it
# never ran the index pass, so any report it wrote would be false (#1061).
set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_abort.XXXXXX") || exit 1
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

local_server_start

require_httrack

out="${tmpdir}/crawl"
mkdir "$out"
report="${out}/hts-changes.json"
poison="stale-archive-an-abort-must-still-replace"
common=(--quiet --disable-security-limits --robots=0 --timeout=30 --changes
    --purge-old=0 --warc-file warc-out --warc-cdx)

expect() {
    local what="$1"
    printf '[%s] ..\t' "$what"
    shift
    "$@" || fail "$what"
    echo "OK"
}
no_tmp() { test -z "$(find "$out" -maxdepth 1 -name '*.tmp' -print -quit)"; }
unpoisoned() { ! grep -qa "$poison" "$1"; }

# --- pass 1: a complete crawl, to have something an abort could destroy ------
local_crawl --log "${tmpdir}/log1" "${common[@]}" -O "$out" "${BASEURL}/changes/index.html"
test -s "$report" || fail "pass 1 wrote no ${report}"
cp "$report" "${tmpdir}/report1.json"
for f in "${out}/warc-out.warc.gz" "${out}/warc-out.cdx"; do
    test -s "$f" || fail "pass 1 produced no $f"
    printf '%s\n' "$poison" >"$f"
done

# --- pass 2: -#L trips the link limit deep in the crawl loop -----------------
# -C0 so the pass re-downloads: a revisit-only pass declines to swap on its own.
rc2=0
local_crawl --log "${tmpdir}/log2" "${common[@]}" -O "$out" -C0 -\#L4 \
    "${BASEURL}/changes/index.html" || rc2=$?
expect "the link limit aborted the crawl" \
    grep -aq "Too many URLs" "${out}/hts-log.txt"
# 3 is HTS_EXIT_MIRROR_ABORTED; hts_is_exiting() owns 2 and means the opposite.
expect "the abort reported itself in the exit status" test "$rc2" -eq 3
expect "the abort still committed the archive" \
    unpoisoned "${out}/warc-out.warc.gz"
expect "the abort still rewrote the .cdx" unpoisoned "${out}/warc-out.cdx"
expect "the abort left no in-progress archive" no_tmp
expect "the abort kept the previous change report" \
    cmp -s "${tmpdir}/report1.json" "$report"

cp "${out}/warc-out.warc.gz" "${tmpdir}/warc2.gz"
cp "${out}/warc-out.cdx" "${tmpdir}/cdx2"

# --- pass 3: server gone, so the no-data rollback restores the last session --
local_server_stop "$SRV_PID"
rc3=0
local_crawl --log "${tmpdir}/log3" "${common[@]}" -O "$out" --retries=1 --update \
    "${BASEURL}/changes/index.html" || rc3=$?
expect "the dead pass rolled the session back" \
    grep -aq "restoring previous one" "${out}/hts-log.txt"
# A rollback restores the last good session rather than leaving a half mirror,
# so it is not the abort pass 2 reports, even though both set exit_xh.
expect "the rollback is not reported as an abort" test "$rc3" -eq 0
expect "the rollback kept the previous change report" \
    cmp -s "${tmpdir}/report1.json" "$report"
expect "the rollback kept the previous archive" \
    cmp -s "${tmpdir}/warc2.gz" "${out}/warc-out.warc.gz"
expect "the rollback kept the previous .cdx" \
    cmp -s "${tmpdir}/cdx2" "${out}/warc-out.cdx"
expect "the rollback left no in-progress archive" no_tmp

#!/bin/bash
#
# A Windows leg on the old WSL2 kernel must red at once and name the kernel,
# rather than after a 25-minute suite that blames an interop outage.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top=${abs_top_srcdir:-$(cd "$testdir/.." && pwd)}
check="$top/tools/wsl-kernel-check.sh"
test -r "$check" || fail "$check is missing"

expect() { # expect <rc> <uname -r> <updated> [text the output must carry]
    local out rc=0
    out=$(bash "$check" "$2" "$3") || rc=$?
    test "$rc" -eq "$1" || fail "'$2' (updated=$3) exited $rc, want $1: $out"
    test -z "${4:-}" || grep -qF -- "$4" <<<"$out" || fail "'$2': no '$4' in: $out"
}

# The kernel the cached package installs, and the one every passing run had.
expect 1 5.10.16.3-microsoft-standard-WSL2 false 'wsl --update failed'
expect 1 5.10.16.3-microsoft-standard-WSL2 true 're-run this leg'
expect 0 6.18.40.1-microsoft-standard-WSL2 true
expect 0 6.18.40.1-microsoft-standard-WSL2 false
# A two-digit major must not compare as text.
expect 0 10.1.0 true
# No distro, or an unreadable version, is left to the suite step.
expect 0 '' false
expect 0 garbage false '::warning::'

# The step must exist, gate, run before the suite, and carry the name the
# re-run grader keys on.
workflow="$top/.github/workflows/windows-build.yml"
if test -r "$workflow"; then
    grep -qF '"Check the WSL2 kernel"' "$top/tools/windows-kill-grade.sh" ||
        fail "the grader does not key on the step name"
    steps=$(grep -n -e '- name: Check the WSL2 kernel$' \
        -e '- name: Run the engine test suite (offline tests, WSL2)$' "$workflow")
    case "$steps" in
    *'Check the WSL2 kernel'*$'\n'*'Run the engine test suite'*) ;;
    *) fail "the kernel check is missing or after the suite: $steps" ;;
    esac
    body=$(sed -n '/- name: Check the WSL2 kernel$/,/- name:/p' "$workflow")
    grep -q 'continue-on-error' <<<"$body" && fail "the kernel check does not gate"
    grep -qF 'tools/wsl-kernel-check.sh' <<<"$body" || fail "the step does not run the check"
else
    echo "no .github here (dist tarball), so the workflow wiring is not checked"
fi

echo "wsl-kernel-check OK"

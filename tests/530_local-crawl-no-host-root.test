#!/bin/bash
#
# A crawl that saves nothing may leave no host root: the engine only creates one
# when it spools a reply that arrives before its parser is done. The late 404
# pins the no-directory side, which 238 met once on a loaded macOS runner.

set -eu

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 1 --host-root-optional \
    --archive-kept-on-rerun --archive-min-files 2 --rerun-args '-C0' \
    httrack 'BASEURL/late404/page.html' --warc-file warc-out --warc-cdx

# A check that reads the host root still requires it.
rc=0
out=$(bash "$top_srcdir/tests/local-crawl.sh" --errors 1 --host-root-optional \
    --not-found late404/page.html \
    httrack 'BASEURL/late404/page.html' 2>&1) || rc=$?
if test "$rc" -eq 0 || ! grep -q "could not find host root" <<<"$out"; then
    echo "$out" >&2
    echo "a host-root check passed with no host root (exit $rc)" >&2
    exit 1
fi

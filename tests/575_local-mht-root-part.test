#!/bin/bash
# Issue #223: nothing named a .mht archive's root. RFC 2387 then picks the first
# part, whichever file the mirror finished first.
set -eu

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_223.XXXXXX") || exit 1
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

mkdir -p "${tmpdir}/root"
printf 'GIF89a\001\000\001\000\200\000\000\377\377\377\000\000\000!\371\004\001\000\000\000\000,\000\000\000\000\001\000\001\000\000\002\002D\001\000;' \
    >"${tmpdir}/root/a.gif"
cp "${tmpdir}/root/a.gif" "${tmpdir}/root/b.gif"
cp "${tmpdir}/root/a.gif" "${tmpdir}/root/c.gif"
cat >"${tmpdir}/root/index.html" <<'HTML'
<html><body><h1>start</h1>
<img src="a.gif"><img src="b.gif"><img src="c.gif">
<a href="sub.html">sub</a>
</body></html>
HTML
cat >"${tmpdir}/root/sub.html" <<'HTML'
<html><body><h1>sub</h1><img src="a.gif"></body></html>
HTML

flags=(--quiet --max-time=120 --timeout=30 --robots=0 '-%M')

require_httrack
local_server_start --root "${tmpdir}/root" --log "${tmpdir}/server.log"

local_crawl --log "${tmpdir}/crawl.log" "http://127.0.0.1:${SRV_PORT}/index.html" \
    -O "${tmpdir}/out" "${flags[@]}" || fail "crawl failed"

mht="${tmpdir}/out/index.mht"
test -s "$mht" || fail "no .mht archive was written"
text=$(tr -d '\r' <"$mht")

start=$(sed -n 's/^[[:space:]]*start="<\(.*\)>"$/\1/p' <<<"$text")
test -n "$start" || fail "the archive names no root part
$(head -12 <<<"$text")"

# The part start= names, with the two header lines above its Content-ID.
root=$(command grep -B3 -xF "Content-ID: <${start}>" <<<"$text") ||
    fail "start=<${start}> names no part of the archive"
command grep -qx 'Content-Type: text/html' <<<"$root" ||
    fail "the root part is not a page
${root}"
command grep -q 'filename="[^"]*/index\.html"' <<<"$root" ||
    fail "the root part is not the page the crawl started from
${root}"

# The page is saved after some of its own images, so the root is not the first
# part. Should that order ever change, the archive needs no start= to open on a
# page and this test is the place that says so.
first=$(command grep -m1 '^Content-disposition: ' <<<"$text")
case $first in
*'/index.html"'*) fail "the page is now the first part written
${first}" ;;
esac

# Every part held back before the root arrived has to survive the move.
for f in a.gif b.gif c.gif index.html sub.html; do
    command grep -qF "filename=\"127.0.0.1_${SRV_PORT}/${f}\"" <<<"$text" ||
        fail "the archive lost the ${f} part
$(command grep '^Content-disposition: ' <<<"$text")"
done

boundary=$(sed -n 's/^[[:space:]]*boundary="\(.*\)";$/\1/p' <<<"$text")
test -n "$boundary" || fail "the archive carries no boundary"
command grep -qxF -- "--${boundary}--" <<<"$text" || fail "the archive is not closed"

test ! -e "${tmpdir}/out/~index.mht.part" ||
    fail "the scratch file holding the early parts was left behind"

# A page the engine cannot read back must not be named as the root, because the
# header is written before the part and start= would then point at nothing.
local_crawl --log "${tmpdir}/crawl3.log" "http://127.0.0.1:${SRV_PORT}/index.html" \
    -O "${tmpdir}/out3" --quiet --max-time=120 --timeout=30 --robots=0 ||
    fail "the plain crawl failed"
page="${tmpdir}/out3/127.0.0.1_${SRV_PORT}/index.html"
chmod 000 "$page"
if test -r "$page"; then
    echo "# this user reads a mode-000 file, so the unreadable page is not checked"
else
    local_crawl --log "${tmpdir}/crawl4.log" --continue -O "${tmpdir}/out3" \
        "${flags[@]}" || fail "the update crawl failed"
    text3=$(tr -d '\r' <"${tmpdir}/out3/index.mht")
    start3=$(sed -n 's/^[[:space:]]*start="<\(.*\)>"$/\1/p' <<<"$text3")
    if test -n "$start3"; then
        command grep -qxF "Content-ID: <${start3}>" <<<"$text3" ||
            fail "start=<${start3}> names no part, so the unreadable page was named
$(command grep '^Content-ID: ' <<<"$text3")"
    fi
fi
chmod 644 "$page"

# A crawl with no page gets no root, but the archive is still whole.
local_crawl --log "${tmpdir}/crawl2.log" "http://127.0.0.1:${SRV_PORT}/a.gif" \
    -O "${tmpdir}/out2" "${flags[@]}" || fail "the image-only crawl failed"

mht2="${tmpdir}/out2/index.mht"
test -s "$mht2" || fail "no .mht archive was written for the image-only crawl"
text2=$(tr -d '\r' <"$mht2")
! command grep -q '^[[:space:]]*start="<' <<<"$text2" ||
    fail "an archive with no page still names a root
$(head -12 <<<"$text2")"
boundary2=$(sed -n 's/^[[:space:]]*boundary="\(.*\)";$/\1/p' <<<"$text2")
test -n "$boundary2" || fail "the image-only archive carries no boundary"
command grep -qxF -- "--${boundary2}--" <<<"$text2" ||
    fail "the image-only archive is not closed"
test ! -e "${tmpdir}/out2/~index.mht.part" ||
    fail "the scratch file was left behind by the image-only crawl"

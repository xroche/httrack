#!/bin/bash
#
# A non-ASCII -O output dir must receive the mirror (#621). argv is UTF-8 on
# Windows, and re-encoding path_html as the ANSI codepage would put every file
# under a mangled directory. Only path_html is non-ASCII, so the harness still
# reads hts-log.txt and hts-cache normally.

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --html-subdir 'café' --errors 0 --files 5 \
    --found 'simple/basic.html' \
    httrack 'BASEURL/simple/basic.html'

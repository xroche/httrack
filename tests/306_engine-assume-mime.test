#!/bin/bash
#

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "$(dirname "$0")/testlib.sh"

# An --assume value longer than the buffer it lands in used to be copied whole
# (#1276). 'httrack -#test=assumemime' overshoots both real destinations, and
# each half is selectable because pre-fix only the first assertion to fire is
# ever seen: "big" is ishtml()'s mime[256], "small" htsblk.contenttype[128].
for half in big small; do
    rc=0
    out=$(httrack -O /dev/null "-#test=assumemime" "$half") || rc=$?
    test "$rc" -eq 0 || fail "-#test=assumemime $half exited $rc: $out"
    grep -q "assumemime ok" <<<"$out" || fail "$half: no ok line: $out"
done

# a 200-byte value fits mime[256] but not contenttype[128], so a single
# one-size-fits-all bound would report the same clip for both
out=$(httrack -O /dev/null "-#test=assumemime")
grep -q "is 200 bytes, clipped to 127" <<<"$out" || fail "no 128-byte clip: $out"
grep -q "is 300 bytes, clipped to 255" <<<"$out" || fail "no 256-byte clip: $out"
if grep -q "is 200 bytes, clipped to 255" <<<"$out"; then
    fail "200 bytes clipped in mime[256], which holds them: $out"
fi

exit 0

#!/bin/bash
#
# A bundle loaded over a full -%K jar warns instead of failing.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

tmpdir=$(mktemp -d)
cleanup_push rm -rf "$tmpdir"
dir=$(nativepath "$tmpdir")
tab=$(printf '\t')

value=$(repeat_chars 100 v)
records() { # records DOMAIN COUNT -- COUNT jar lines of about 130 bytes
    local i
    for i in $(seq 1 "$2"); do
        printf '.%s%sTRUE%s/%sFALSE%s0%sC%d%s%s\n' "$1" "$tab" "$tab" "$tab" \
            "$tab" "$tab" "$i" "$tab" "$value"
    done
}
# 300 records pass the 30000 bytes the jar holds
records other.test 300 >"$tmpdir/cookies.txt"
# a 500-byte cookie does not fit in what the full jar has left
sid=".alpha.test${tab}TRUE${tab}/${tab}FALSE${tab}0${tab}SID${tab}$(repeat_chars 500 s)"
printf '%s\n' '# HTTrack bundle 1' 'ua FullUA' cookies "$sid" >"$tmpdir/full.hts"

rc=0
out=$(httrack -O /dev/null '-#test=bundle' "$dir" \
    'http://www.alpha.test/#httrack-bundle=full' "jar:$dir/cookies.txt" \
    host:http://www.alpha.test 2>"$tmpdir/err") || rc=$?
test "$rc" -eq 0 || fail_dump "exited $rc: $out" "$tmpdir/err"
out=$(tr -d '\r' <<<"$out")
grep -q '^refused' <<<"$out" && fail_dump "bundle refused: $out" "$tmpdir/err"
grep -qx 'http://www.alpha.test ua=FullUA headers=global' <<<"$out" ||
    fail "the bundle UA was not applied: $out"
grep -q '^cookie \.other\.test C1=' <<<"$out" || fail "the jar was not loaded"
grep -q '^cookie \.alpha\.test SID=' <<<"$out" &&
    fail "the full jar stored the bundle cookie, so the test proves nothing"
grep -q 'full.hts, line 4: the cookie jar is full, so a cookie is left out' \
    "$tmpdir/err" || fail_dump "no warning for the cookie left out" "$tmpdir/err"

# with no -%K jar, a bundle too big for the jar on its own is refused
{
    printf '%s\n' '# HTTrack bundle 1' cookies
    records alpha.test 224
    printf '%s\n' "$sid"
} >"$tmpdir/own.hts"
assert_selftest 'refused: /own.hts, line 227: the cookie jar did not store a cookie' \
    bundle "$dir" 'http://www.alpha.test/#httrack-bundle=own'
# a small -%K jar does not excuse it
records other.test 1 >"$tmpdir/small.txt"
assert_selftest 'refused: /own.hts, line 227: the cookie jar did not store a cookie' \
    bundle "$dir" 'http://www.alpha.test/#httrack-bundle=own' "jar:$dir/small.txt"
ok "a full jar warns about a bundle cookie, a bundle that overflows it alone is refused"

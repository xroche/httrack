#!/bin/bash
#
# An engine-forced not-modified (the #176 error-ignore hack here) is not a 304
# the server ever sent: back_wait() must not archive it as a server-not-modified
# revisit, which would claim an exchange that never happened (#839). A genuine
# 304 (mini304) must still come out as a revisit with its exchange intact.

set -eu

: "${top_srcdir:=..}"

export WARC_VALIDATE_UPDATE="warc-forced.warc.gz"
export WARC_VALIDATE_NORESP="mini304/index.html mini304/page.html"
export WARC_VALIDATE_NORECORD="errmask/keep.dat"
export WARC_VALIDATE_EXCHANGE=1

bash "$top_srcdir/tests/local-crawl.sh" --warc-validate \
    --rerun-args '--warc-file warc-forced' \
    --found 'mini304/index.html' --found 'mini304/page.html' --found 'errmask/keep.dat' \
    --file-matches 'errmask/keep.dat' '^KEEP' \
    --file-not-matches 'errmask/keep.dat' 'error 403' \
    httrack 'BASEURL/mini304/index.html' 'BASEURL/errmask/index.html' --warc-file warc-out

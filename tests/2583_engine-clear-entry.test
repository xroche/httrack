#!/bin/bash
#

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# Clearing a backlog slot closes its socket, removes its temporary file and frees it.
tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_clearentry.XXXXXX") || exit 1
trap 'set +e; rm -rf "$tmpdir"' EXIT

out=$(httrack -O /dev/null -#test=clearentry "$tmpdir")
grep -q "^clearentry: OK$" <<<"$out" || fail "clearentry: $out"

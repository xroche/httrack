#!/bin/bash
#
# A cert fixture that fails must say why: discarding openssl's output left tests
# 13 and 52 exiting 1 with an empty log (#1094).

set -euo pipefail

: "${top_srcdir:=..}"
testdir=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=tests/testlib.sh
. "${testdir}/testlib.sh"

command -v openssl >/dev/null 2>&1 || {
    echo "openssl not found; skipping" >&2
    exit 77
}

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_tlspem.XXXXXX")
trap 'set +e; rm -rf "$tmpdir"' EXIT

fail() {
    echo "FAIL: $*" >&2
    exit 1
}
ok() { echo "OK: $*"; }

# The working case first: without it, a helper that never produces anything
# would still satisfy the failure case below.
good="$tmpdir/good"
mkdir -p "$good"
make_tls_pem "$good"
grep -q 'BEGIN .*PRIVATE KEY' "$good/both.pem" || fail "both.pem has no private key"
grep -q 'BEGIN CERTIFICATE' "$good/both.pem" || fail "both.pem has no certificate"
ok "make_tls_pem writes a key and a certificate"

# Shim in an openssl that refuses, and require its reason to reach the output.
marker="openssl-stub-declined-to-issue"
stub="$tmpdir/bin"
mkdir -p "$stub" "$tmpdir/broken"
cat >"$stub/openssl" <<EOF
#!/bin/sh
echo "${marker}" >&2
exit 3
EOF
chmod +x "$stub/openssl"

rc=0
out=$(
    PATH="$stub:$PATH"
    hash -r # bash caches the real openssl from the call above
    make_tls_pem "$tmpdir/broken" 2>&1
) || rc=$?

# Non-zero also proves the shim was reached; a real openssl here would succeed.
test "$rc" -ne 0 || fail "make_tls_pem succeeded with an openssl that exits 3"
case "$out" in
*"$marker"*) ;;
*) fail "openssl's reason never reached the log, got: '${out}'" ;;
esac
ok "a failing openssl is reported (rc ${rc})"

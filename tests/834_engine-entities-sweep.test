#!/bin/bash
#
# Every generated entity name decodes to its code point, and none of its
# one-byte misses does unless it is itself a name.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_entsweep.XXXXXX") || exit 1
trap 'set +e; rm -rf "$tmp"' EXIT

# The oracle is the name comment and code point of each generated row.
sed -n 's|^    {0x[0-9a-f]*ULL, \([0-9]*\), [0-9]*}, */\* \([A-Za-z0-9]*\) \*/$|\2 \1|p' \
    "${top_srcdir:-..}/src/htsentities.h" >"$tmp/names"
rows=$(wc -l <"$tmp/names")
test "$rows" -eq 2032 || fail "parsed $rows entity rows, want 2032"

# Multi-codepoint names are not generated, so they stay verbatim.
for name in fjlig acE bne NotEqualTilde ThickSpace; do
    echo "$name -1" >>"$tmp/names"
done

out=$(httrack -O /dev/null -#test=entities-sweep "$tmp/names" 2>&1) ||
    fail "entities-sweep failed: $out"
grep -q '^entities-sweep: 2037 names, [0-9]* inputs, 0 failures' <<<"$out" ||
    fail "unexpected sweep summary: $out"

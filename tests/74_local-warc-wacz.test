#!/bin/bash
#
# A --wacz crawl packages the WARC, its CDXJ index and a pages.jsonl into one
# WACZ file at crawl end. The stdlib validator checks STORE-mode entries, the
# layout, the sha256 digests and the datapackage-digest chain (plus py-wacz and
# pywb when importable). A build without OpenSSL skips.
#
# The cacheless (-C0) second pass repackages over the first .wacz, which fails
# where a platform refuses to rename onto an existing file (#726). A
# cache-served pass keeps the old package, see 97_local-warc-update-keep.

set -eu

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 0 --wacz-validate \
    --rerun-args '-C0' --log-not-found 'could not finalize' \
    --found 'mini304/index.html' --found 'mini304/page.html' \
    httrack 'BASEURL/mini304/index.html' --warc-file warc-out --wacz

#!/bin/bash
# Issue #1251: the wizard joins a link's host and path into one string to match
# filters on, and the 2 KB buffer it used aborted the whole crawl on a link the
# parser accepts.
set -eu

# shellcheck source=tests/crawllib.sh
. "$(dirname "$0")/crawllib.sh"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_1251.XXXXXX") || exit 1
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

doc="${tmpdir}/doc"
mkdir -p "$doc"
printf 'placeholder\n' >"${doc}/index.html"
local_server_start --root "$doc"

which httrack >/dev/null || fail "could not find httrack"

# A scheme-relative href, so the engine prepends "http://" to the pair and the
# join outgrows what the URL itself was allowed to be. 2047 escaped bytes is the
# most the parser takes; control bytes triple, keeping the raw href under its
# separate 1 KB gate. Written after the server is up: the port sizes the host.
awk -v host="127.0.0.1:${SRV_PORT}" 'BEGIN {
    esc = 2047 - 3 - length(host)  # "//" + host + "/" + path, escaped and raw
    raw = 1023 - 3 - length(host)
    nc = (esc - raw) / 2           # each control byte grows by two
    np = raw - nc
    s = "<html><body><a href=\"//" host "/"
    for (i = 0; i < int(np / 2); i++) s = s "p"
    for (i = 0; i < nc; i++) s = s sprintf("%c", 11)
    for (i = int(np / 2); i < np; i++) s = s "p"
    print s "\">x</a></body></html>"
}' >"${doc}/index.html"

out="${tmpdir}/crawl"
mkdir "$out"
rc=0
local_crawl --log "${tmpdir}/log" -O "$out" --quiet --disable-security-limits \
    --robots=0 --timeout=30 --retries=0 --debug-log "${BASEURL}/index.html" || rc=$?
test "$rc" -eq 0 || fail "the crawl died (exit $rc) on a link the wizard joined"

# 2041 is where "http://" plus the pair passes 2047, so anything this matches
# would have aborted; a shorter link means the fixture stopped proving anything.
printf '[the whole link reached the wizard] ..\t'
grep -aqE 'wizard test begins: [^[:space:]]{2041,}' "${out}/hts-log.txt" ||
    fail "no over-long link reached the wizard"
echo OK

#!/bin/bash
#

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "$(dirname "$0")/testlib.sh"

# url_savename_addstr() appends a crawled link to afs->save; it used to take no
# destination size, so a link past the naming cap wrote past the buffer (#1269).
assert_selftest "savename-addstr self-test OK" savename-addstr

httrack_bin=$(httrack_path)

# -#test=savename poisons the bytes behind save[] and exits non-zero if the
# naming path touched them. 'filpad=N' expands the '*' into N bytes, which argv
# cannot carry itself (HTS_CDLMAXSIZE caps it at 1024).
probe() { # probe LABEL PAD MINLEN FIL [ARGS...]
    local label=$1 pad=$2 minlen=$3 fil=$4 out name
    shift 4
    out=$("$httrack_bin" -O /dev/null -#test=savename "$fil" text/html \
        "filpad=$pad" "$@" 2>&1) ||
        fail "$label: pad $pad exited non-zero: $out"
    name=${out#savename: }
    test "${#name}" -ge "$minlen" ||
        fail "$label: pad $pad named ${#name} bytes, want $minlen or more"
    test "${#name}" -lt 2048 || fail "$label: pad $pad named ${#name} bytes"
}

# Both appenders, at the two sizes the fault takes: a link that just crosses the
# end of save[], and one that runs a long way past it behind a near-cap host.
long_host=$(printf '%01000d' 0 | tr '0' h)
for spec in '/*/x.html:path' '/dir/*.html:name'; do
    fil=${spec%%:*} label=${spec#*:}
    probe "$label" 2030 1 "$fil"
    probe "$label" 1500 1 "$fil" "adr=$long_host"
    # a link that fits must keep every byte: the clip must not fire early
    probe "$label" 200 220 "$fil"
done

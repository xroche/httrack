#!/bin/bash
#
# A URL added through WebHTTrack's add-url keeps a typed login whose password
# holds a raw '?', '#' and '\', and sends it to the host after the last '@'.

set -euo pipefail

# shellcheck source=tests/webhttracklib.sh
. "${0%"${0##*/}"}./webhttracklib.sh"

htsserver_require

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_addurl_login.XXXXXX") || fail "no tmpdir"
csrv=
cleanup_push htsserver_cleanup_dir "${work}"
cleanup_push htsserver_reap_vars csrv

export HOME="${work}" # no ~/.httrack.ini of the developer's in the store

mkdir -p "${work}/docroot"
clog="${work}/content.log"
"${HTS_PYTHON}" "${testdir}/local-server.py" --root "${work}/docroot" \
    >"${clog}" 2>&1 &
csrv=$!
cport=$(discover_server_port "${clog}" "${csrv}") || fail "no content server"

htsserver_start
sid=$(htsserver_sid)
test "${#sid}" -eq 32 || fail "no session id in the panel (got '${sid}')"

# p0.bin trickles for a minute, so the crawl still runs when the URL is added.
out="${work}/crawl"
htsserver_client --path /step4.html --field "sid=${sid}" --field "path=${work}" \
    --field projname=crawl --field winprofile=x --field command_do=start \
    --field "command=httrack --robots=0 http://127.0.0.1:${cport}/trickle/p0.bin +* -O ${out}" \
    >/dev/null

log="${out}/hts-log.txt"
start=$SECONDS
while test ! -f "${log}"; do
    test "$((SECONDS - start))" -lt 60 || fail "the crawl never started"
    poll_wait 0.2
done

cred='u:Hd7k?Zq9x#Wv3m\Pp2r'
htsserver_client --path /step4.html --field "sid=${sid}" \
    --field "command=add-url=http://${cred}@127.0.0.1:${cport}/reqheaders/echo.txt" \
    >/dev/null

echo_txt="${out}/127.0.0.1_${cport}/reqheaders/echo.txt"
start=$SECONDS
while test ! -f "${echo_txt}"; do
    htsserver_alive || fail "htsserver died: $(tail -n 20 "${log}" 2>/dev/null)"
    test "$((SECONDS - start))" -lt 90 ||
        fail "the added URL was not fetched: $(tail -n 20 "${log}")"
    poll_wait 0.2
done
want="Authorization: Basic $("${HTS_PYTHON}" -c 'import base64, sys
print(base64.b64encode(sys.argv[1].encode()).decode())' "${cred}")"
headers=$(<"${echo_txt}")
grep -qF "${want}" <<<"${headers}" || fail "wrong login sent: ${headers}"

start=$SECONDS
while ! grep -q "HTTrack Website Copier/" "${log}"; do
    test "$((SECONDS - start))" -lt 90 || fail "the crawl did not end"
    poll_wait 0.2
done
! grep -q -e Hd7k -e Zq9x -e Wv3m -e Pp2r "${log}" || fail "password logged"

echo "PASS"

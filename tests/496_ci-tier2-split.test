#!/bin/bash
#
# Enforces the tier-2 rule in AGENTS.md: a job moved out of the pull-request
# path stops reporting there, and a required one then leaves every open PR
# waiting forever on a context that never arrives.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top=${abs_top_srcdir:-$(cd "$testdir/.." && pwd)}
wfdir="$top/.github/workflows"

if ! test -d "$wfdir"; then
    test -d "$top/.github" && fail "$wfdir is gone but $top/.github is not"
    skip "no .github under $top (dist tarball), so the audit has nothing to read"
fi

# Every context the "Protect master" ruleset requires by name, with the
# workflow and job that emits it. Pinned rather than read back from the
# tree, because one file compared against itself proves nothing. Tab-separated.
required='ci.yml	dco	DCO sign-off
ci.yml	gate	ci gate
windows-build.yml	gate	windows gate'

# Does this workflow run on every pull request? A filter under the key (paths:,
# branches:, types:) would skip the PRs it does not match, and those PRs then
# wait on a context nobody will report.
on_pull_request() { # on_pull_request <workflow>
    awk '
        /^on:/ { on = 1; next }
        on && /^[^ #]/ { exit }
        on && /^  pull_request:?[ \t]*$/ { seen = 1; pending = 1; next }
        pending && /^[ \t]*(#.*)?$/ { next }
        pending { if ($0 ~ /^    /) filtered = 1; pending = 0 }
        END { exit !(seen && !filtered) }
    ' "$1"
}

# The status contexts one job emits, with its matrix expanded. Empty output
# means the job carries no name:, and GitHub then builds the context from the
# job id.
job_contexts() { # job_contexts <workflow> <job id>
    awk -v want="$2" '
        function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        function unquote(s) {
            if (s ~ /^".*"$/ || s ~ /^'"'"'.*'"'"'$/) s = substr(s, 2, length(s) - 2)
            return s
        }
        function emit(entry,   out, n, i, kv, k, v, pairs) {
            out = tpl
            n = split(entry, pairs, ",")
            for (i = 1; i <= n; i++) {
                kv = trim(pairs[i])
                if (kv == "") continue
                k = trim(substr(kv, 1, index(kv, ":") - 1))
                v = unquote(trim(substr(kv, index(kv, ":") + 1)))
                gsub(/&/, "\\\\&", v)
                gsub("\\$\\{\\{[ ]*matrix\\." k "[ ]*\\}\\}", v, out)
            }
            # An interpolation the entry does not supply expands to nothing.
            gsub(/\$\{\{[^}]*\}\}/, "", out)
            print out
        }
        /^jobs:/ { injobs = 1; next }
        !injobs { next }
        /^  [A-Za-z0-9_-]+:[ \t]*(#.*)?$/ {
            id = $0; sub(/[ \t]*(#.*)?$/, "", id); sub(/:$/, "", id); sub(/^  /, "", id)
            if (injob) exit
            injob = (id == want); found = found || injob; next
        }
        !injob { next }
        /^    name: [>|]/ { print "ERR: a folded name:"; bad = 1; exit }
        /^    name: / { tpl = unquote(trim(substr($0, 11))); next }
        # A required job must run, and must be able to fail. needs: makes it skip
        # with whatever it waits on, and continue-on-error: reports green always.
        # A gate needs every job, and always() keeps it from skipping with them.
        /^    needs:/ && want == "gate" { next }
        /^    needs:/ { print "ERR: a needs:, which can skip the job"; bad = 1; exit }
        /^    continue-on-error:/ {
            print "ERR: continue-on-error:, so the check cannot fail"; bad = 1; exit
        }
        # The two required jobs that carry one are restricted TO pull requests,
        # which is the opposite of a hazard. Any other condition can switch the
        # job off on a PR without changing its name.
        /^    if:/ {
            cond = trim(substr($0, index($0, ":") + 1))
            if (want == "gate" && cond == "always()") { always = 1; next }
            if (cond != "github.event_name == '"'"'pull_request'"'"'") {
                print "ERR: unpinned if: " cond; bad = 1; exit
            }
            next
        }
        /^      matrix:/ { inmatrix = 1; next }
        # sawinclude is never cleared, unlike ininclude, which any 8-space key
        # later in the job resets. The run: key of a step would otherwise hide
        # that the matrix was ever there.
        inmatrix && /^        include:/ { ininclude = 1; sawinclude = 1; next }
        inmatrix && !ininclude && /^        [A-Za-z0-9_-]+:/ { plainaxis = 1; next }
        ininclude && /^          - \{/ {
            buf = $0; sub(/^ *- \{/, "", buf)
            while (buf !~ /\}/) {
                if ((getline line) <= 0) { print "ERR: unterminated matrix entry"; bad = 1; exit }
                buf = buf " " line
            }
            sub(/\}.*$/, "", buf)
            entries[++nentries] = buf
            next
        }
        ininclude && /^        [A-Za-z0-9_-]+:/ { ininclude = 0; inmatrix = 0 }
        END {
            if (bad) exit 1
            if (!found) { print "ERR: no job " want; exit 1 }
            # Without always() the gate skips when a job fails, and a skipped
            # required check counts as passing.
            if (want == "gate" && !always) { print "ERR: a gate without if: always()"; exit 1 }
            if (tpl == "") exit 0
            if (plainaxis) { print "ERR: a plain matrix axis under a name:"; exit 1 }
            # An include: nothing matched expands to zero jobs, and the template
            # would otherwise print as though the job still ran.
            if (sawinclude && nentries == 0) { print "ERR: an include: with no entries"; exit 1 }
            if (nentries == 0) {
                if (tpl ~ /\$\{\{/) { print "ERR: an interpolated name with no matrix"; exit 1 }
                print tpl
                exit 0
            }
            for (i = 1; i <= nentries; i++) emit(entries[i])
        }
    ' "$1"
}

bad=
while IFS=$'\t' read -r wf id ctx; do
    path="$wfdir/$wf"
    if ! test -r "$path"; then
        bad="$bad
  $ctx: $wf is gone"
        continue
    fi
    if ! on_pull_request "$path"; then
        bad="$bad
  $ctx: $wf no longer runs on every pull request"
        continue
    fi
    # Not piped into grep, because a failing parse would hand its status away.
    got=$(job_contexts "$path" "$id") || {
        bad="$bad
  $ctx: $wf job $id: $got"
        continue
    }
    if test -n "$got"; then
        command grep -qxF "$ctx" <<<"$got" || bad="$bad
  $ctx: $wf job $id emits $(tr '\n' '|' <<<"$got")"
    else
        # No name:, so GitHub prefixes the context with the job id.
        case $ctx in
        "$id "*) ;;
        *) bad="$bad
  $ctx: $wf job $id has no name: and the context does not start with it" ;;
        esac
    fi
done <<<"$required"

test -z "$bad" || fail "required contexts nothing emits on a pull request:$bad
A required check that never reports blocks every open PR, not only this one.
Keep the job where it is, or drop the context from the ruleset first."

# Second invariant: tier2.yml owns the schedule for the legs it absorbed, so a
# workflow reachable only by workflow_call has to be named there.
orphans=
for wf in "$wfdir"/*.yml "$wfdir"/*.yaml; do
    test -r "$wf" || continue # the .yaml glob matches nothing today
    base=${wf##*/}
    test "$base" != tier2.yml || continue
    # Callable, and with no trigger of its own that would ever fire.
    command grep -q '^  workflow_call:' "$wf" || continue
    command grep -Eq '^  (schedule|push|pull_request|release|workflow_run):' "$wf" && continue
    # A uses: line, not any mention: a commented-out call runs nothing.
    command grep -Eq "^ *uses: \./\.github/workflows/$base\$" "$wfdir/tier2.yml" ||
        orphans="$orphans $base"
done

test -z "$orphans" || fail "callable workflows nothing schedules and tier2.yml does not call:$orphans
A workflow with neither a trigger nor a caller never runs again, and says nothing about it."

# Third invariant: each gate has to need every other job in its workflow. A job
# it does not name can red while the gate reports green, which is worse than
# having no gate, and nothing in the workflow itself notices.
gate_gaps() { # gate_gaps <workflow>: prints the gap, or the job count
    local wf=$1 legs_raw legs needed_raw needed
    # A key this cannot read would drop the job from BOTH lists, and they would
    # still agree while that job reds unwatched.
    legs_raw=$(awk '/^jobs:/ { injobs = 1; next }
                    !injobs || /^[ \t]*(#.*)?$/ { next }
                    /^  [^ ]/ {
                        if ($0 !~ /^  [A-Za-z0-9_-]+:[ \t]*(#.*)?$/) {
                            print "ERR: unreadable job key: " $0; exit 1
                        }
                        sub(/[ \t]*(#.*)?$/, ""); sub(/:$/, ""); sub(/^  /, ""); print
                    }' "$wf") || true
    case $legs_raw in *ERR:*) echo "$legs_raw" && return 1 ;; esac
    command grep -qx gate <<<"$legs_raw" || { echo "no gate job" && return 1; }
    legs=$(command grep -vx gate <<<"$legs_raw" | sort)
    needed_raw=$(awk '/^  gate:[ \t]*(#.*)?$/ { ingate = 1; next }
                      ingate && /^  [A-Za-z0-9_-]+:/ { exit }
                      ingate && /^    needs:[ \t]*\[/ { print "ERR: a flow-style needs:"; exit 1 }
                      ingate && /^    needs:$/ { inneeds = 1; next }
                      inneeds && /^      - / { sub(/^      - /, ""); print; next }
                      inneeds && /^    [A-Za-z0-9_-]+:/ { inneeds = 0 }' "$wf") || true
    case $needed_raw in *ERR:*) echo "$needed_raw" && return 1 ;; esac
    needed=$(sort <<<"$needed_raw")
    test -n "$legs" || { echo "no jobs parsed" && return 1; }
    test "$legs" = "$needed" || {
        echo "the gate does not need every job.
jobs:   $(tr '\n' ' ' <<<"$legs")
needs:  $(tr '\n' ' ' <<<"$needed")
A job missing from needs: reds while the gate still reports success."
        return 1
    }
    printf '%s' "$legs" | count_matching_lines .
}

gates=
for wf in tier2.yml ci.yml windows-build.yml; do
    n=$(gate_gaps "$wfdir/$wf") || fail "$wf: $n"
    gates="$gates $wf:$n"
done

# The mutant this exists to catch: a job dropped from a gate's needs:.
mut=$(mktemp "${TMPDIR:-/tmp}/httrack_gate.XXXXXX")
cleanup_push rm -f "$mut"
sed '/^  gate:/,$ { /^      - lint$/d; }' "$wfdir/ci.yml" >"$mut"
cmp -s "$wfdir/ci.yml" "$mut" && fail "the dropped-need mutant changed nothing, so it proves nothing"
gate_gaps "$mut" >/dev/null && fail "a job dropped from the ci gate's needs: went unreported"

echo "tier-2 split OK ($(printf '%s' "$required" | count_matching_lines .) required contexts still on the PR path, no orphaned callable workflow, gates need every job:$gates)"

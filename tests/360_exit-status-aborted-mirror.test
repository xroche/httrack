#!/bin/bash
#
# hts_main2() returned 0 whatever the mirror did, so a wrapper script could not
# tell a finished mirror from one the engine gave up on. Both directions here,
# plus a refused command line, so the aborted status means that and not "any
# failure". /dev/full stands in for the full disk, as in 350.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

require_httrack

# What an aborted mirror must exit with; keep in step with HTS_EXIT_MIRROR_ABORTED.
ABORTED=2

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/httrack_exitstatus.XXXXXX")
cleanup() { rm -rf "$tmpdir"; }
cleanup_push cleanup

# A native binary does not follow an MSYS symlink, so /dev/full stands in for
# nothing there and the probe below cannot see the difference.
skip_on_windows "a native binary does not follow an MSYS symlink to /dev/full"
test -c /dev/full || skip "no /dev/full device"
probe="${tmpdir}/probe"
ln -s /dev/full "$probe" 2>/dev/null || skip "cannot symlink /dev/full"
if printf x >"$probe" 2>/dev/null; then
    skip "a write through /dev/full succeeds here, so it stands in for nothing"
fi
rm -f "$probe"

common=(--quiet --disable-security-limits --robots=0 --retries=2 -c1 --timeout=20)
local_server_start --log "${tmpdir}/server.log"

# Crawl $2 into $tmpdir/$1, leaving httrack's status in $rc, its combined
# output in $rc_log and the mirror's own log in $log. Not a subshell: the
# status is the point, and local_crawl's watchdog must fail the test.
crawl_status() {
    local name="$1" entry="$2" dir="${tmpdir}/$1"

    shift 2
    rc=0
    rc_log="${tmpdir}/out-${name}"
    local_crawl --log "$rc_log" "${common[@]}" "$@" -O "$dir" \
        "${BASEURL}/diskfull/${entry}" || rc=$?
    log=$(<"${dir}/hts-log.txt")
}

# --- a mirror that runs to the end -------------------------------------------
crawl_status clean index.html
test "$rc" -eq 0 || fail "a completed mirror exited $rc: $(<"$rc_log")"
test -s "${tmpdir}/clean/127.0.0.1_${SRV_PORT}/diskfull/index.html" ||
    fail "the control crawl mirrored nothing, so its exit 0 proves nothing"
ok "a mirror that completes still exits 0"

# --- the engine gives up on a body it cannot write ---------------------------
site="${tmpdir}/stream/127.0.0.1_${SRV_PORT}/diskfull"
mkdir -p "$site"
ln -s /dev/full "${site}/big.bin"
crawl_status stream index.html
grep -q 'Mirror aborted: keeping all previously mirrored files' <<<"$log" ||
    fail "the fixture did not abort the mirror, so the status proves nothing: ${log}"
test "$rc" -eq "$ABORTED" || fail "an aborted mirror exited $rc, wanted $ABORTED"
ok "a mirror the engine aborts exits $ABORTED"

# stderr is the only place httrack.c says why, and it used to be empty here.
grep -q 'mirror aborted' <"$rc_log" ||
    fail "the non-zero exit came with no reason: $(<"$rc_log")"
ok "and says so on stderr rather than printing an empty error"

# --- a page whose close fails: a different producer of the same abort ---------
site="${tmpdir}/page/127.0.0.1_${SRV_PORT}/diskfull"
mkdir -p "$site"
ln -s /dev/full "${site}/small.html"
crawl_status page smallindex.html
grep -q 'Fatal write error, giving up' <<<"$log" ||
    fail "the page arm did not reach the fatal write path: ${log}"
test "$rc" -eq "$ABORTED" || fail "the page arm exited $rc, wanted $ABORTED"
ok "the page path aborts with the same status"

# --- and the cache, which fails nowhere near the mirrored tree ----------------
mkdir -p "${tmpdir}/cache/hts-cache"
ln -s /dev/full "${tmpdir}/cache/hts-cache/new.zip"
crawl_status cache index.html
grep -q 'Mirror aborted' <<<"$log" ||
    fail "the cache arm did not abort the mirror: ${log}"
test "$rc" -eq "$ABORTED" || fail "the cache arm exited $rc, wanted $ABORTED"
ok "a cache write failure aborts with the same status"

# --- a command line httrack refuses is a different failure -------------------
# Without this, $ABORTED could mean "anything went wrong" and still pass above.
rc=0
local_crawl --log "${tmpdir}/out-badopt" "${common[@]}" --no-such-option-here \
    -O "${tmpdir}/badopt" "${BASEURL}/diskfull/index.html" || rc=$?
test "$rc" -ne 0 || fail "a refused command line exited 0"
test "$rc" -ne "$ABORTED" ||
    fail "a refused command line exits $ABORTED too, so the status says nothing"
ok "a refused command line keeps its own status ($rc)"

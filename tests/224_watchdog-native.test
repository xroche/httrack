#!/bin/bash
#
# The native suite watchdog (#795). Its decision logic through the script's own
# -SelfTest, proved non-vacuous by four mutants, plus the wiring no .ps1 can
# check for itself: the launch arguments, the permission the status post needs,
# and that the kill lands inside the step's own timeout. The audits run
# everywhere; only the -SelfTest legs need PowerShell.

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
top=${abs_top_srcdir:-$(cd "$testdir/.." && pwd)}
wdscript="$testdir/ci-windows-watchdog.ps1"
driver="$testdir/ci-windows-suite.sh"
workflow="$top/.github/workflows/windows-build.yml"
tmpbase=${TMPDIR:-/tmp}

tmp=$(mktemp -d "$tmpbase/httrack_wdnat.XXXXXX")
# TMPDIR is a Windows path on the runner, and its drive-letter colon would split
# the PATH entry the stubs below are found through, silently running the real
# PowerShell against the real watchdog instead.
if command -v cygpath >/dev/null 2>&1; then
    tmp=$(cygpath -u "$tmp")
fi
trap 'set +e; rm -rf "$tmp"' EXIT
fail() {
    echo "FAIL: $*" >&2
    exit 1
}

test -r "$wdscript" || fail "no $wdscript"

# The prose in the script names the very calls the audits forbid.
uncommented() { sed 's/[[:space:]]*#.*$//' "$1"; }

# A box that has stopped creating processes is the failure this watchdog exists
# to catch, so anything spawning one puts it back in the class it replaces.
spawns_a_process() {
    uncommented "$1" | grep -nEi \
        'Start-Process|Start-Job|Start-ThreadJob|Invoke-Expression|taskkill|cmd\.exe|wmic|schtasks|System\.Diagnostics\.Process[^a-zA-Z]'
}
if hits=$(spawns_a_process "$wdscript"); then
    fail "the watchdog spawns a process: $hits"
fi
{
    cat "$wdscript"
    echo 'Start-Process notepad.exe'
} >"$tmp/spawn.ps1"
if ! spawns_a_process "$tmp/spawn.ps1" >/dev/null; then
    fail "the spawn audit cannot see a spawned process"
fi

# Killing Runner.Worker.exe reproduces this exact failure, so every kill must
# name a pid the descendant walk produced, never an image name or a wildcard.
unscoped_kills() {
    # shellcheck disable=SC2016 # the PowerShell variables are the literal to match
    uncommented "$1" | grep -n 'Stop-Process' |
        grep -vE 'Stop-Process -Id \$(k|DriverPid) -Force' || true
}
bad=$(unscoped_kills "$wdscript")
test -z "$bad" || fail "a kill is not scoped to the driver's tree: $bad"
{
    cat "$wdscript"
    echo 'Stop-Process -Name httrack -Force'
} >"$tmp/kill.ps1"
test -n "$(unscoped_kills "$tmp/kill.ps1")" ||
    fail "the kill-scope audit does not see a kill by image name"

# shellcheck disable=SC2016 # $env: is PowerShell's, not this shell's
grep -q '\$env:WATCHDOG_TOKEN' "$wdscript" ||
    fail "the watchdog does not read its token from the environment"
if grep -q 'WATCHDOG_TOKEN' "$driver"; then
    fail "the token reaches the watchdog through argv, where the process list exposes it"
fi
# A background holder of the step's stdout keeps the step open past the suite (#949).
grep -q '>watchdog.log 2>&1' "$driver" ||
    fail "the watchdog's output is not redirected off the step's stdout"

if test -r "$workflow"; then
    # The watchdog has to beat the step timeout, which takes the log, the
    # annotations and the artifacts with it -- the whole reason it exists.
    n=$(grep -c 'timeout-minutes:' "$workflow")
    test "$n" -eq 1 || fail "$n timeout-minutes in the workflow, cannot tell which bounds the suite"
    cap=$(($(awk '/timeout-minutes:/ { print $2; exit }' "$workflow") * 60))
    stuck=$(sed -n 's/^stuck=\([0-9]*\)$/\1/p' "$driver")
    deadline=$(sed -n 's/^suite_deadline=\([0-9]*\)$/\1/p' "$driver")
    test -n "$stuck" || fail "cannot read the driver's static window"
    test -n "$deadline" || fail "cannot read the driver's suite deadline"
    # A test may start one second under the deadline and never report again.
    test $((deadline + stuck + 240)) -le "$cap" ||
        fail "a kill at ${deadline}+${stuck}s leaves under 240s before the ${cap}s step timeout"

    grep -q '^  statuses: write$' "$workflow" || fail "the workflow token cannot post a commit status"
    grep -q '^  contents: read$' "$workflow" || fail "contents: read was dropped from the workflow"
    for v in WATCHDOG_TOKEN WATCHDOG_REPO WATCHDOG_SHA WATCHDOG_CONTEXT; do
        grep -q "$v:" "$workflow" || fail "$v is not passed to the suite step"
    done
fi

# The launch is Windows-only in production, so drive it against stubs that
# shadow whatever real interpreter is on PATH. pwsh is what the driver looks for
# first, so shadowing it keeps the stub off the .exe path entirely.
bin="$tmp/bin"
mkdir -p "$bin"
# Renamed into place, so the poll below cannot read a half-written file.
printf '#!/bin/sh\nprintf "%%s\\n" "$@" >%s/argv.part\nmv %s/argv.part %s/argv\n' \
    "$tmp" "$tmp" "$tmp" >"$bin/pwsh"
cp "$bin/pwsh" "$bin/powershell.exe"
# shellcheck disable=SC2016 # $2 is the stub's own argument
printf '#!/bin/sh\necho "$2"\n' >"$bin/cygpath"
chmod +x "$bin/pwsh" "$bin/powershell.exe" "$bin/cygpath"
if test -x "$bin/pwsh"; then
    (
        cd "$tmp"
        PATH="$bin:$PATH"
        export PATH
        # An unshadowed pwsh would run the real watchdog against the real token,
        # and every assertion below would still read as a launch failure.
        test "$(command -v pwsh)" = "$bin/pwsh" ||
            fail "the stub does not shadow PowerShell: $(command -v pwsh)"
        # shellcheck source=tests/ci-windows-suite.sh
        . "$driver"
        ci_watchdog_pid=''
        ci_start_native_watchdog "$tmp/progress.log" 4242 900 ||
            fail "the launch reported no watchdog with a PowerShell on PATH"
        test -n "$ci_watchdog_pid" || fail "the launch set no pid"
        # wait only reaps a child: a pid echoed out of a subshell is not one, and
        # the driver's teardown could not signal it.
        wait "$ci_watchdog_pid" || fail "the watchdog is not a child of the driver"
    )
    # The launch returns as soon as the child is backgrounded.
    for _ in $(seq 1 100); do
        test -r "$tmp/argv" && break
        sleep 0.1
    done
    test -r "$tmp/argv" || fail "the watchdog was never launched"
    grep -qx -- '-SelfTest' "$tmp/argv" && fail "the production launch runs the self-test"
    grep -qx -- "$wdscript" "$tmp/argv" ||
        fail "the launch did not name the script: $(tr '\n' ' ' <"$tmp/argv")"
    grep -qx -- "$tmp/progress.log" "$tmp/argv" || fail "the launch did not pass the progress log"
    grep -qx -- '900' "$tmp/argv" || fail "the launch did not pass the static window"
    # 4242 has no /proc/<pid>/winpid here, so the fallback is what is seen.
    grep -qx -- '4242' "$tmp/argv" || fail "the launch did not pass a pid to kill"
    test -s "$tmp/watchdog.log" && fail "the watchdog wrote to a log the stub should have left empty"
else
    echo "note: $tmpbase is noexec, the stub launch was not driven"
fi

# Both, where both exist: the driver prefers pwsh and falls back to Windows
# PowerShell, and the two differ enough for one to accept what the other rejects.
psruns=()
for c in pwsh powershell.exe powershell; do
    if command -v "$c" >/dev/null 2>&1; then
        psruns+=("$c")
    fi
done
if test "${#psruns[@]}" -eq 0; then
    echo "SKIP: no PowerShell here, the watchdog's own self-test cannot run"
    exit 77
fi

winpath() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -w "$1"
    else
        echo "$1"
    fi
}

selftest() {
    "$psrun" "${psargs[@]}" -File "$(winpath "$1")" -SelfTest 2>&1
}

# Each mutant breaks one property the self-test claims to hold; one the script
# survives is a property nothing is checking.
mutate() {
    local name=$1 expr=$2 m="$tmp/$1.ps1" rc=0 said
    sed "$expr" "$wdscript" >"$m"
    cmp -s "$wdscript" "$m" && fail "mutant $name changed nothing, so it proves nothing"
    said=$(selftest "$m") || rc=$?
    test "$rc" -ne 0 || fail "mutant $name passed the self-test under $psrun: $said"
}

for psrun in "${psruns[@]}"; do
    psargs=(-NoProfile -NonInteractive)
    case $psrun in
    powershell*) psargs+=(-ExecutionPolicy Bypass) ;;
    esac

    out=$(selftest "$wdscript") || fail "the $psrun self-test failed: $out"
    grep -q 'watchdog self-test OK' <<<"$out" || fail "the $psrun self-test said: $out"

    # A process older than its claimed parent is a recycled pid; unchecked, the
    # walk adopts whatever inherited the number, a runner process included.
    mutate recycled '/CreationDate -lt/d'
    # shellcheck disable=SC2016 # PowerShell variables, quoted for sed
    mutate self-kill '/-ne \$Self/d'
    # shellcheck disable=SC2016
    mutate off-by-one 's/-ge \$Stuck/-gt \$Stuck/'
    # shellcheck disable=SC2016
    mutate shallow-first 's/\$out\.Insert(0, \$cpid)/$out.Add($cpid)/'

    # The loop itself, against a log that never moves. Pid 0 has no descendants
    # and the dry run kills nothing, so the only process at risk is the
    # watchdog's own. The token is cleared because the suite step exports a real
    # one, and a smoke run must not post a verdict on the commit under test.
    printf 'RUN 36_local-bigcrawl.test at 41s\n' >"$tmp/progress.log"
    out=$(WATCHDOG_TOKEN='' "$psrun" "${psargs[@]}" -File "$(winpath "$wdscript")" \
        -ProgressLog "$(winpath "$tmp/progress.log")" -DriverPid 0 \
        -StuckSeconds 2 -IntervalSeconds 1 -PollSeconds 1 -DryRun 2>&1) ||
        fail "the $psrun watchdog loop exited nonzero: $out"
    grep -q 'killing the step: t=' <<<"$out" || fail "a static log was not killed: $out"
    grep -q '36_local-bigcrawl.test' <<<"$out" || fail "the kill does not name the test in flight: $out"
    grep -q 'dry run, would kill:' <<<"$out" || fail "the dry run was not honoured: $out"
    grep -q 'q=[0-9]*s' <<<"$out" || fail "no staticness in the status line: $out"
done

echo "native watchdog OK (${psruns[*]})"

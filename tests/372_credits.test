#!/bin/bash
#
# One hardcoded name used to stand for every translator in the About box. The
# credit now comes from each catalog's LANGUAGE_AUTHOR, so AUTHORS, greetings.txt
# and html/contact.html have to keep naming whoever those catalogs name.

set -euo pipefail

# shellcheck source=tests/webhttracklib.sh
. "${0%"${0##*/}"}./webhttracklib.sh"

htsserver_require
distdir=${HTS_DISTDIR}

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_credits.XXXXXX") || fail "no tmpdir"
cleanup_push htsserver_cleanup_dir "${work}"

printf '[the credit files name every translator the catalogs do] ..\t'
"${HTS_PYTHON}" - "${distdir}" <<'PY' || fail "the credit files are out of step (see above)"
import glob, os, re, sys

top = sys.argv[1]
read = lambda p: open(os.path.join(top, p), encoding="utf-8").read()
authors, greetings, contact = read("AUTHORS"), read("greetings.txt"), read("html/contact.html")
bad = []

# The roster starts at the first section and runs to the end of greetings.txt;
# the other two embed it verbatim, so drift is a diff rather than a re-audit.
roster = greetings[greetings.index("Development\n"):]
if len(roster) < 1000:
    sys.exit("the roster parsed out of greetings.txt is only %d bytes" % len(roster))
for name, text in (("AUTHORS", authors), ("html/contact.html", contact)):
    if roster not in text:
        bad.append("%s does not carry greetings.txt's roster verbatim" % name)

# Contact groups and addresses out, what is left is the person.
GROUP = re.compile(r"\([^()]*\)|\[[^\[\]]*\]|<[^<>]*>")
DROP = re.compile(r"[@:./\\0-9]")

def names(value):
    out = []
    for entry in GROUP.sub(" ", value).split("\\r\\n"):
        for tok in re.split(r"[\s,;\"]+", entry):
            tok = tok.strip("'.,;:")
            if len(tok) >= 2 and not DROP.search(tok):
                out.append(tok)
    return out

def field(path, key):
    lines = open(path, encoding="utf-8").read().replace("\r\n", "\n").split("\n")
    for i in range(0, len(lines) - 1, 2):
        if lines[i] == key:
            return lines[i + 1]
    return None

# A fixture first: a checker that never fires would pass every catalog below.
probe = names("Zzzyx Qwertson (nobody@example.com)\\r\\n[ x@example.com ]")
if probe != ["Zzzyx", "Qwertson"]:
    sys.exit("the name parser reads %r out of the fixture" % (probe,))
if "Zzzyx" in authors:
    sys.exit("the fixture name is in AUTHORS, so the check below cannot fail")

catalogs = sorted(glob.glob(os.path.join(top, "lang", "*.txt")))
if len(catalogs) < 25:
    sys.exit("only %d catalogs found" % len(catalogs))
checked = 0
for path in catalogs:
    base = os.path.basename(path)
    author = field(path, "LANGUAGE_AUTHOR")
    if author is None:
        bad.append("%s: no LANGUAGE_AUTHOR" % base)
        continue
    # about.html interpolates it into a <pre> with no escaper, so markup would
    # reach the browser as markup: Turkish shipped an <address> for years.
    for c in "<>&":
        if c in author or c in (field(path, "LANGUAGE_NAME") or ""):
            bad.append("%s: LANGUAGE_NAME/AUTHOR holds %r, which the About page emits raw" % (base, c))
    got = names(author)
    if not got:
        bad.append("%s: no name parsed out of LANGUAGE_AUTHOR %r" % (base, author))
    for tok in got:
        checked += 1
        if tok not in authors:
            bad.append("%s: LANGUAGE_AUTHOR names %r, absent from AUTHORS" % (base, tok))
if checked < 40:
    sys.exit("only %d translator names checked across %d catalogs" % (checked, len(catalogs)))

# The About blurb carries the copyright line every catalog copied; a translation
# left on its own stale year is what put 1998-2003 on screen in 2026.
msgid = None
for line in read("lang.def").replace("\r\n", "\n").split("\n"):
    if line.startswith("\\r\\n(Please notify us"):
        msgid = line
if msgid is None:
    sys.exit("the About blurb is not in lang.def any more; retarget this check")
year = re.search(r"\(C\)\s*(1998-\d{4})", msgid)
if year is None:
    sys.exit("no copyright stamp in the About blurb msgid: %r" % msgid)
stamped = 0
for path in catalogs:
    value = field(path, msgid)
    if not value:
        continue
    for stamp in re.findall(r"\(C\)\s*(1998-\d{4})", value):
        stamped += 1
        if stamp != year.group(1):
            bad.append("%s: the About blurb is stamped %s, the msgid says %s"
                       % (os.path.basename(path), stamp, year.group(1)))
# A msgid that drifted would leave every value above unread, and say nothing.
if stamped < len(catalogs) - 2:
    sys.exit("only %d of %d catalogs carry a stamped About blurb" % (stamped, len(catalogs)))

for line in bad:
    print(line)
sys.exit(1 if bad else 0)
PY

# A private root, so the server reads the catalogs this checkout ships.
root="${work}/root"
mkdir -p "${root}"
cp -R "${distdir}/html" "${distdir}/lang" "${distdir}/lang.def" "${root}/"
chmod -R u+w "${root}"

# Names unique to one catalog, so the page must follow the language rather than
# echo a single string: German got Robert Lagadec's name for twenty years.
check() { # $1 = lang index, $2 = LANGUAGE_NAME, $3 = name shown, $4 = name not shown
    mkdir -p "${work}/h$1"
    htsserver_start --root "${root}" --home "${work}/h$1" lang "$1"
    local reply
    reply=$(htsserver_get /server/about.html)
    grep -q '^HTTP/1.[01] 200' <<<"${reply}" || fail "about.html for language $1: ${reply}"
    grep -q "$2: " <<<"${reply}" || fail "about.html for language $1 has no '$2:' credit line"
    grep -q "$3" <<<"${reply}" || fail "about.html for language $1 does not name $3"
    if grep -q "$4" <<<"${reply}"; then
        fail "about.html for language $1 still names $4"
    fi
    # shellcheck disable=SC2016 # the raw token is what must not survive
    case ${reply} in
    *'${'*) fail "about.html for language $1 serves a raw token: ${reply}" ;;
    esac
    htsserver_stop
}

check 1 English Lagadec Klueting
check 4 Deutsch Klueting Lagadec
check 10 Türkçe Aksoy Lagadec

# A leaked server wedges the parallel harness behind a green log.
htsserver_assert_reaped

echo OK

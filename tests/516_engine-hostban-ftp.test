#!/bin/bash
#
# A banned host's FTP slot belongs to its worker thread, so host_ban() must not
# end it. The http slot beside it is ended, which is what proves the check works.

set -eu

out=$(httrack -#test=hostban)

test "$out" = "hostban self-test: OK" || {
    echo "expected 'hostban self-test: OK', got: $out" >&2
    exit 1
}

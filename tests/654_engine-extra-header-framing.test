#!/bin/bash
#
# A -%X framing or hop-by-hop field is refused: on a bodyless GET, a server
# would wait for a body that never comes.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

CRLF=$'\r\n'
TAB=$'\t'

tohex() { printf '%s' "$1" | od -An -v -t x1 | tr -d '[:space:]'; }

hd() { # hd WANT BLOCK
    selftest_queue "$1" headerdedup "hex:$(tohex "$req")" "hex:$(tohex "$2")"
}

req="GET /plain.html HTTP/1.1${CRLF}Host: h${CRLF}"

for field in Content-Length Transfer-Encoding Connection Keep-Alive TE \
    Upgrade Expect content-length TRANSFER-ENCODING; do
    hd 'X-A: 1\r\n' "$field: 5${CRLF}X-A: 1$CRLF"
done
# a space before the colon, and the folded continuation of a refused line
hd 'X-A: 1\r\n' "Transfer-Encoding : chunked${CRLF}X-A: 1$CRLF"
hd 'X-A: 1\r\n' "Transfer-Encoding: gzip,$CRLF${TAB}chunked${CRLF}X-A: 1$CRLF"
# neighbours of a refused name, and the fields a user may replace, go out
hd 'TEX: 1\r\n' "TEX: 1$CRLF"
hd 'X-Expect: 1\r\n' "X-Expect: 1$CRLF"
hd 'Authorization: Basic eA==\r\n' "Authorization: Basic eA==$CRLF"
hd 'Cookie: a=b\r\n' "Cookie: a=b$CRLF"

selftest_run_queued

python=$(find_python) || skip "python3 missing"

server=$(nativepath "$top_srcdir/tests/header-injection-server.py")
tmpdir=$(mktemp -d)
serverpid=
wire=$tmpdir/wire
nreq=0
cleanup() {
    stop_server "$serverpid"
    rm -rf "$tmpdir"
}
cleanup_push cleanup

"$python" "$server" "$(nativepath "$wire")" >"$tmpdir/server.out" 2>"$tmpdir/server.err" &
serverpid=$!
port=$(discover_server_port "$tmpdir/server.out" "$serverpid") || exit 1

# One crawl of a leaf page: the request bytes land in $tmpdir/TAG.req and
# stderr in $tmpdir/TAG.err.
probe() { # probe TAG [extra httrack args...]
    local tag=$1 rc=0
    shift
    run_with_timeout 90 httrack "http://127.0.0.1:$port/plain.html" \
        -O "$tmpdir/$tag.mirror" -c1 --robots=0 --retries=0 --quiet -%v0 \
        "$@" >"$tmpdir/$tag.err" 2>&1 || rc=$?
    test "$rc" -eq 0 || fail "$tag: the crawl exited $rc"
    nreq=$((nreq + 1))
    cp "$wire.$nreq" "$tmpdir/$tag.req"
}

lines() { # lines ERE TAG
    count_matching_lines_regexp "$1" "$tmpdir/$2.req"
}

# The command line warns about it.
warned() { # warned TAG TEXT
    grep -qF "warning: -%X $2" "$tmpdir/$1.err" ||
        fail "$1: no warning '$2': $(cat "$tmpdir/$1.err")"
}

probe framing -%X 'Content-Length: 5' -%X 'Transfer-Encoding : chunked' \
    -%X 'X-Kept: 1'
assert_eq 0 "$(lines '^(Content-Length|Transfer-Encoding)' framing)" \
    'framing: the refused lines'
assert_eq 1 "$(lines '^X-Kept: 1' framing)" 'framing: the kept line'
warned framing 'framing header ignored: Content-Length: 5'
warned framing 'framing header ignored: Transfer-Encoding : chunked'
if grep -q 'X-Kept' "$tmpdir/framing.err"; then
    fail "an ordinary -%X header drew a warning"
fi

# a conditional line goes out as typed on a first crawl, and draws no warning
probe conditional -%X 'If-None-Match: "x"'
assert_eq 1 "$(lines '^If-None-Match: "x"' conditional)" 'conditional: the line'
if grep -qF 'warning: -%X' "$tmpdir/conditional.err"; then
    fail "a conditional -%X header drew a warning"
fi

# a header name may begin with '-'
probe dash -%X '-X-Foo: 1'
assert_eq 1 "$(lines '^-X-Foo: 1' dash)" 'dash: the line'

probe host -%X 'Host : x'
assert_eq 1 "$(lines '^Host' host)" 'host: Host lines'
assert_eq 1 "$(lines '^Host: x' host)" 'host: the box Host, without the blank'

probe twohosts -%X 'Host: a' -%X 'Host: b'
assert_eq 1 "$(lines '^Host' twohosts)" 'twohosts: Host lines'
assert_eq 1 "$(lines '^Host: b' twohosts)" 'twohosts: the last Host'
warned twohosts 'header replaces an earlier one: Host: b'

probe orphan -%X ' orphan' -%X 'X-Kept: 1'
# a launcher that strips the blank leaves a bare "orphan", dropped as malformed
assert_eq 0 "$(lines 'orphan' orphan)" 'orphan: the folded line'
assert_eq 1 "$(lines '^X-Kept: 1' orphan)" 'orphan: the kept line'
grep -qE 'warning: -%X (folded line with no header to continue|malformed header) ignored: +orphan' \
    "$tmpdir/orphan.err" || fail "orphan: no warning: $(cat "$tmpdir/orphan.err")"

probe malformed -%X ':' -%X ': v' -%X 'X A: 1' -%X 'nocolon' \
    -%X 'Content-Length' -%X 'X-Kept: 1'
assert_eq 0 "$(lines '^(:|X A|nocolon|Content-Length)' malformed)" \
    'malformed: the malformed lines'
assert_eq 1 "$(lines '^X-Kept: 1' malformed)" 'malformed: the kept line'
warned malformed 'malformed header ignored: X A: 1'
warned malformed 'malformed header ignored: nocolon'

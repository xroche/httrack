#!/bin/bash
#
# The internal duration, date, query-digest, ref-name, SNI, Origin,
# mime-extension and path-split writers take their output size, and never
# write past it.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

dir=$(mktemp -d)
cleanup_push rm -rf "$dir"

assert_selftest 'lib-sized: OK' lib-sized "$dir"
assert_selftest 'name-sized: OK' name-sized
assert_selftest 'leaf-sized: OK' leaf-sized
echo "PASS"

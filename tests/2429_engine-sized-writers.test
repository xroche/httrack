#!/bin/bash
#
# The internal duration, date, query-digest and ref-name writers take their
# output size, and never write past it.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

dir=$(mktemp -d)
cleanup_push rm -rf "$dir"

assert_selftest 'lib-sized: OK' lib-sized "$dir"
assert_selftest 'name-sized: OK' name-sized
echo "PASS"

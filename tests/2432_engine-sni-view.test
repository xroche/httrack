#!/bin/bash
#

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# hts_sni_hostname() takes the host from hts_url_view_parse(), so an unknown
# scheme sends its host and never the scheme name.

sni() { selftest_queue "$2" sniname "$1"; }

sni 'gopher://u@h.example:70/x' 'sni=h.example'
sni 'file://' 'sni=none'
sni 'https://u:p@H.example:8/x?a@b' 'sni=H.example'
sni 'h.example.:443' 'sni=h.example.'
sni 'https://[::1]:8/x' 'sni=none'
sni 'https://1.2.3.4/x' 'sni=none'
sni 'https://:8/x' 'sni=none'
selftest_run_queued

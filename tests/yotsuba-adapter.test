#!/bin/sh
set -eu

test_binary="${CATALOG_TOP_BUILDDIR}/tests/yotsuba-adapter-test-bin"

"${CATALOG_CC}" ${CATALOG_CPPFLAGS} ${CATALOG_CFLAGS} \
  -std=c99 -Wall -Wextra -Werror -Wformat=2 -Wformat-nonliteral \
  -I"${CATALOG_TOP_BUILDDIR}" \
  -I"${CATALOG_TOP_SRCDIR}/src" \
  "${CATALOG_TOP_SRCDIR}/tests/yotsuba-adapter-test.c" \
  "${CATALOG_TOP_SRCDIR}/src/htsyotsuba.c" \
  "${CATALOG_TOP_SRCDIR}/src/htsmetadata.c" \
  "${CATALOG_TOP_SRCDIR}/src/htscatalog.c" \
  ${CATALOG_SQLITE_LIBS} -o "${test_binary}"

HTTRACK_YOTSUBA_FIXTURE_ROOT="${CATALOG_TOP_SRCDIR}/tests/fixtures/yotsuba" \
  "${test_binary}"

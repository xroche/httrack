#!/bin/bash
#
# A "param" option takes a number, and used to have any other value glued onto
# its short form regardless: --long-names=yes wrote DOS 8.3 names and
# --sockets=8I0 mirrored with no top index, both exit 0 (#1426).

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=tests/testlib.sh
. "${testdir}/testlib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_paramval.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${tmp}"

assert_selftest "optalias self-test OK" optalias

echo '<html><body>hello</body></html>' >"${tmp}/page.html"
out=${tmp}/out

crawl() {
    rm -rf "${out}"
    mkdir -p "${out}"
    RC=0
    httrack "file://${tmp}/page.html" -O "${out}" --quiet -n "$@" \
        >"${tmp}/log" 2>&1 || RC=$?
}

has_name() { mirror_has_name "${out}" "$1"; }
has_cache() { test -n "$(find "${out}/hts-cache" -type f 2>/dev/null)"; }

# The discriminator, proven on the two spellings that ask for each layout:
# long names keep page.html, DOS 8.3 truncates it to PAGE.HTM.
crawl --long-names=1
assert_eq 0 "${RC}" "--long-names=1 exited"
has_name page.html || fail_dump "--long-names=1 wrote no long name" "${tmp}/log"
crawl --long-names=0
assert_eq 0 "${RC}" "--long-names=0 exited"
has_name PAGE.HTM || fail_dump "--long-names=0 wrote no 8.3 name" "${tmp}/log"

refused() { # refused ARG...
    crawl "$@"
    # 134 is an abort, which would read as a refusal without being one
    { test "${RC}" -ne 0 && test "${RC}" -ne 134; } ||
        fail_dump "$* not refused (exit ${RC})" "${tmp}/log"
    grep -q 'does not take the value' "${tmp}/log" ||
        fail_dump "$* refused without saying why" "${tmp}/log"
    # the mirror must not be there at all, in either layout
    ! has_name page.html || fail_dump "$* still mirrored" "${tmp}/log"
    ! has_name PAGE.HTM || fail_dump "$* still mirrored, in 8.3" "${tmp}/log"
}

accepted() { # accepted ARG...
    crawl "$@"
    assert_eq 0 "${RC}" "$* exited"
    # either layout: bare -L is 8.3, so --long-names=on lands there too
    has_name page.html || has_name PAGE.HTM ||
        fail_dump "$* mirrored nothing" "${tmp}/log"
    ! grep -q 'does not take the value' "${tmp}/log" ||
        fail_dump "$* drew a refusal" "${tmp}/log"
}

# The headline: junk on -L wrote 8.3 names, which is what --long-names=0 means.
for value in yes none OFF true "8I0"; do
    refused "--long-names=${value}"
done

# ...and the same on rows reaching four other short options. --sockets=8I0 is
# the second visible one: the I0 tail reached -I0 and dropped the top index.
refused --sockets=8I0
refused --depth=none
refused --cache=OFF
refused --robots=yes
refused --max-files=none
# a detached value is the same value: --depth ate the URL and mirrored nothing
refused --depth "file://${tmp}/page.html"
# the separator -m and -%c read is one occurrence with a digit after it, or the
# value converts short: 1.2.3 reached maxconn as 1.2, and 100, died downstream
refused --connection-per-second=1.2.3
refused --max-files=100,
refused --max-files=,,,5

# The message names the option that was typed. --cache=OFF used to report
# "Option O needs [...] a path", -O being reached out of the middle of OFF.
crawl --cache=OFF
grep -q 'Option --cache does not take the value OFF' "${tmp}/log" ||
    fail_dump "--cache=OFF blamed another option" "${tmp}/log"

# Negative control: the values these rows do take still run, and say nothing.
accepted --long-names=1
has_name page.html || fail_dump "--long-names=1 lost its long names" "${tmp}/log"
accepted --sockets=8
# ...and it keeps the top index that --sockets=8I0 lost
has_name index.html || fail_dump "--sockets=8 wrote no top index" "${tmp}/log"
accepted --depth=2
accepted --robots=1
accepted --max-files=100
accepted --sockets 8
accepted --long-names=on
accepted --long-names=off
# what the short forms read beyond a digit run: -m takes N,N2, -%c a rate
accepted --max-files=,5000
accepted --max-files=100,5000
accepted --connection-per-second=0.5

# on/off is a mapping, not merely an accepted spelling: off is -C0, which writes
# no cache, and on is the bare -C, which does.
accepted --cache=off
! has_cache || fail_dump "--cache=off still wrote a cache" "${tmp}/log"
accepted --cache=on
has_cache || fail_dump "--cache=on wrote no cache" "${tmp}/log"
accepted --cache=0
! has_cache || fail_dump "--cache=0 still wrote a cache" "${tmp}/log"

# The rule above is scoped to the "param" class, and --structure is "paramn"
# since #1418. -N1L0 is the boundary: a preset trailed by more short options,
# which the param rule would refuse, and whose -L0 tail is visible on disk.
crawl --structure=1L0
assert_eq 0 "${RC}" "--structure=1L0 exited"
has_name PAGE.HTM ||
    fail_dump "--structure=1L0 lost its clustered -L0" "${tmp}/log"
accepted --structure=1
crawl --structure=%h%p/%n%q.%t
! grep -q 'does not take the value' "${tmp}/log" ||
    fail_dump "--structure template refused" "${tmp}/log"

exit 0

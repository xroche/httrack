#!/bin/bash
#
# WSL2 drops its interop channel on the Windows runner and the exe never launches,
# so whichever tests called it then fail on the empty output they read (#1672). One
# of their logs catches WSL's own error line; the rest look like ordinary reds. The
# driver must retry them all once and judge each retry on its own log.
#
# Four staged suite runs of 121 stubs each are real work, not a wedge. They outlast
# the 600s guard on a loaded macOS runner, so the arms pace themselves. Split from
# 337 so the two run side by side under "make check -j".
# TEST_TIMEOUT_AT_LEAST: 1200

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# Before the driver is sourced: with these set, anything it starts posts a commit
# status on whatever the surrounding shell was last looking at.
unset WATCHDOG_TOKEN WATCHDOG_REPO WATCHDOG_SHA WATCHDOG_URL
# shellcheck source=tests/ci-windows-suite.sh
. "$testdir/ci-windows-suite.sh"
# shellcheck source=tests/ci-suite-stage.sh
. "$testdir/ci-suite-stage.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_interopretry.XXXXXX")
cleanup_push rm -rf "$tmp"

GITHUB_STEP_SUMMARY=$tmp/summary
export GITHUB_STEP_SUMMARY
: >"$GITHUB_STEP_SUMMARY"

ci_stage_init

cases=4
n=0

# A failure whose log carries WSL2's interop error is not a red: the exe never
# launched (#1672). Here rather than in 469, which calls the verdict directly and
# so leaves the driver's own gate untested.
stage "$tmp/interop" ':'
stub "$tmp/interop/900_zlib-pass.test" 3 \
    'echo "<3>init: (2409) ERROR: UtilAcceptVsock:235: accept4 failed 110" >&2'
run_suite "$tmp/interop"
grep -q '::error::re-run this leg: WSL2 lost its interop channel under: 900_zlib-pass.test' \
    "$tmp/out" || fail "the outage was not named: $(<"$tmp/out")"
test "$rc" -eq 3 || fail "an interop outage exited $rc, want 3: $(<"$tmp/out")"
ok "an interop outage ends the leg on a status that says re-run"
n=$((n + 1))
pace "$((cases - n))" "$arm_took" "the retry, and the failure it must not excuse"

# Fails once then behaves. $POOLSHARE/$1 counts its runs, so a retry that never
# happened is caught. With $2 it also writes WSL2's error line into its log.
fail_once() { # fail_once <counter name> [outage]
    # shellcheck disable=SC2016 # the stub's own expansions, not this shell's
    printf 'n=$(cat "$POOLSHARE/%s" 2>/dev/null || echo 0)\n' "$1"
    # shellcheck disable=SC2016
    printf 'n=$((n + 1))\necho "$n" >"$POOLSHARE/%s"\n' "$1"
    # shellcheck disable=SC2016
    printf 'test "$n" -gt 1 || {\n'
    test -z "${2:-}" ||
        printf '    echo "<3>init: (2409) ERROR: UtilAcceptVsock:235: accept4 failed 110" >&2\n'
    printf '    exit 3\n}\n'
}

# A test the outage hit is retried alone, at the cost of one test rather than the
# whole leg. Three runs: the first, the trace the driver gives any failure, and
# the retry.
stage "$tmp/retried" ':'
stub "$tmp/retried/900_zlib-pass.test" 0 "$(fail_once retried outage)"
run_suite "$tmp/retried"
test "$(<"$share/retried")" = 3 ||
    fail "the stub ran $(<"$share/retried") time(s), so nothing was retried"
test "$rc" -eq 0 || fail "a retried outage exited $rc, want 0: $(<"$tmp/out")"
grep -q "^ran=$ran pass=92 fail=0 skip=$nskip lost=0$" "$tmp/out" ||
    fail "the recovered test was not counted as a pass: $(grep '^ran=' "$tmp/out" || true)"
grep -q '^retry: PASS 900_zlib-pass.test$' "$tmp/out" ||
    fail "the retry did not report its own verdict: $(<"$tmp/out")"
grep -q '^interop-retried: 900_zlib-pass.test$' "$tmp/out" ||
    fail "a green leg does not say it hit an outage: $(<"$tmp/out")"
# A green leg raises no error, so the annotation is all a reader gets.
grep -q '::warning title=WSL2 lost its interop channel::caught by: 900_zlib-pass.test%0Aretried once: 900_zlib-pass.test' "$tmp/out" || fail "the rescued leg raised no annotation: $(<"$tmp/out")"
# Or the run that recovers throws away the only evidence the outage happened.
grep -q 'UtilAcceptVsock' "$tmp/retried/900_zlib-pass.test.first.log" ||
    fail "the outage log was not kept beside the retry"
# The first failure's tail would else be printed under a green tally.
! grep -q 'UtilAcceptVsock' "$tmp/out" ||
    fail "a recovered test still printed its failure tail: $(<"$tmp/out")"
ok "a test the outage hit is retried, and a green leg still names it"
n=$((n + 1))
pace "$((cases - n))" "$arm_took" "the failure a retry must not excuse"

# The control: the retry is read on its own log, or the outage before it excuses a
# red and nobody investigates it. It runs four times, the second failure traced too.
stage "$tmp/retriedred" ':'
stub "$tmp/retriedred/900_zlib-pass.test" 3 "$(fail_once retriedred outage)"
run_suite "$tmp/retriedred"
test "$(<"$share/retriedred")" = 4 ||
    fail "the stub ran $(<"$share/retriedred") time(s), so nothing was retried"
grep -q '^interop-retried: 900_zlib-pass.test$' "$tmp/out" ||
    fail "the outage went unnamed, so this arm proves nothing: $(<"$tmp/out")"
grep -q '::error::failing: 900_zlib-pass.test' "$tmp/out" ||
    fail "the failure after the outage was not named: $(<"$tmp/out")"
! grep -q '::error::re-run this leg' "$tmp/out" ||
    fail "the outage excused the failure that followed it: $(<"$tmp/out")"
test "$rc" -eq 1 || fail "a real failure after an outage exited $rc, want 1: $(<"$tmp/out")"
ok "a failure on the retry is a red, not the outage before it"
n=$((n + 1))
pace "$((cases - n))" "$arm_took" "the collateral failure, which carries no error line"

# The real case (#1672): one outage failed three tests and only one log caught
# WSL2's error line, so every failure of a run that saw one is retried. The
# collateral test runs FIRST here, or a retry starting at the test that caught the
# line would pass this too.
stage "$tmp/collateral" ':'
stub "$tmp/collateral/900_zlib-pass.test" 0 "$(fail_once collateral)"
stub "$tmp/collateral/901_watchdog-pass.test" 0 "$(fail_once collateral2 outage)"
run_suite "$tmp/collateral"
test -f "$tmp/collateral/900_zlib-pass.test.first.log" ||
    fail "the collateral test kept no first log, so it was never retried"
! grep -q 'UtilAcceptVsock' "$tmp/collateral/900_zlib-pass.test.first.log" ||
    fail "the collateral stub wrote the error line, so this arm proves nothing"
test "$(<"$share/collateral")" = 3 ||
    fail "the collateral test ran $(<"$share/collateral") time(s), so it was not retried"
test "$rc" -eq 0 || fail "an outage hitting two tests exited $rc, want 0: $(<"$tmp/out")"
grep -q "^ran=$ran pass=92 fail=0 skip=$nskip lost=0$" "$tmp/out" ||
    fail "both recovered tests were not counted: $(grep '^ran=' "$tmp/out" || true)"
grep -q '^interop-retried: 900_zlib-pass.test 901_watchdog-pass.test$' "$tmp/out" ||
    fail "the retried tests were not both named: $(<"$tmp/out")"
grep -q '::warning title=WSL2 lost its interop channel::caught by: 901_watchdog-pass.test%0Aretried once: 900_zlib-pass.test 901_watchdog-pass.test' "$tmp/out" ||
    fail "the annotation does not separate the catcher from the collateral: $(<"$tmp/out")"
ok "an outage that only one log caught still retries the tests beside it"
n=$((n + 1))
# Nothing left to pace. It catches an arm counted out of step, not one never counted.
assert_steps_ran "$cases" "$n"

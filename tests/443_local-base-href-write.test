#!/bin/bash
#
# A consumed <base href> must be written back, or the mirror keeps "<base >".
# An element with no href means "no base", and a framework requiring one refuses
# to start (Angular throws "No base href set").
#
# The written value is empty, because "./" makes href="#f" resolve to the
# directory rather than the page, and in-page anchors then lead away from it.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

work=$(mktemp -d)
cleanup_push rm -rf "$work"
root="$work/root"
mkdir -p "$root/sub/j"

cat >"$root/index.html" <<'EOF'
<!DOCTYPE html><html><body><a href="sub/page.html">p</a>
<a href="sub/dot.html">d</a><a href="sub/eofb.html">b</a>
<a href="sub/eofa.html">a</a></body></html>
EOF

# The page with the base sits below the document root, so a base of "./" and
# one of "" pick different directories. <base href="/"> already resolves
# correctly, so the test asserts what is written out. The applet's codebase
# shares the write site and must keep its own value.
cat >"$root/sub/page.html" <<'EOF'
<!DOCTYPE html><html><head><base href="/"><title>t</title></head>
<body><a href="#f">f</a> <a href="target.html">r</a> <a name="f">A</a>
<applet codebase="j/" code="A.class" width="1" height="1"></applet>
</body></html>
EOF
# A second page carries a "./" base, the other consumed relative form and the
# one frameworks ship. A fix that writes the attribute for a root base alone
# leaves it hrefless. Its links are all fragments.
cat >"$root/sub/dot.html" <<'EOF'
<!DOCTYPE html><html><head><base href="./"><title>d</title></head>
<body><a href="#f">f</a><a name="f">A</a></body></html>
EOF

cat >"$root/target.html" <<'EOF'
<!DOCTYPE html><html><body>reached</body></html>
EOF
echo stub >"$root/sub/j/A.class"
# A base or codebase value cut by the end of the file broke the parse.
printf '<base href="http://x/' >"$root/sub/eofb.html"
printf '<applet codebase="cb/' >"$root/sub/eofa.html"

bash "$top_srcdir/tests/local-crawl.sh" --root "$root" \
    --errors 0 \
    --found target.html \
    --file-matches sub/page.html '<base href="">' \
    --file-matches sub/dot.html '<base href="">' \
    --file-not-matches sub/dot.html '<base >' \
    --file-not-matches sub/page.html '<base >' \
    --file-not-matches sub/page.html '<base href="\./">' \
    --file-matches sub/page.html 'href="#f"' \
    --file-matches sub/page.html 'codebase="j/"' \
    --file-not-matches sub/page.html 'applet href' \
    --file-bytes sub/eofb.html 13 --file-bytes sub/eofa.html 8 \
    httrack BASEURL/index.html -q -%v0 -r4

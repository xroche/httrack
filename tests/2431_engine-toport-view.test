#!/bin/bash
#

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# jump_toport_const() takes the port from hts_url_view_parse(), so a malformed
# bracket gets the port that matches the host the engine reads.

tp() { selftest_queue "$2" toport "$1"; }

tp '[::1' '(none)'
tp '[::1]x:8' '(none)'
tp '[::1]:8]:9' ':8]:9'
tp 'a:b]' ':b]'
tp 'u@[::1]:8/x' ':8/x'
tp 'h:80?x:9' ':80?x:9'
# an unknown scheme is kept whole, as by jump_identification_const()
tp 'gopher://h:8/' '://h:8/'
selftest_run_queued

#!/bin/bash
#

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# hts_buildtopindex takes a system-charset path but verif_backblue below it
# expects utf-8, mangling a non-ASCII project dir on Windows (#216, #217).
dir=$(mktemp -d)
cleanup_push rm -rf "$dir"

# Not assert_selftest: the #1329 leg that fails the move logs a warning, so the
# output is more than the marker.
got=$(httrack -O /dev/null -#test=topindex "$dir" run) || fail "topindex: exited $?"
assert_match "topindex self-test OK" "$got"
target_is_windows || assert_match "could not rebuild the top index" "$got"

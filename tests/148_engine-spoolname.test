#!/bin/bash
#
# A frozen backlog slot must spool into the mirror root's ~hts-tmp. Beside its
# save name, it clobbered a site's <path>.tmp (#859) and left empty dirs.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

work=$(mktemp -d "${TMPDIR:-/tmp}/spoolname.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${work}"

httrack -#test=spoolname "${work}"

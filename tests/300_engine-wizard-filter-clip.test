#!/bin/bash
#

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "$(dirname "$0")/testlib.sh"

# #1264: the pattern is cut from the link the question is about, so a long
# enough one outgrows the filter slot it is built into. It must clip; aborting
# would kill the crawl over one URL.

slot=2048 # HTS_FILTER_SLOT_SIZE: HTS_URLMAXSIZE * 2

# each argument stays under HTS_CDLMAXSIZE, so the length comes from both
adr=$(printf 'a%.0s' $(seq 1 1016)).com
fil=/$(printf 'b%.0s' $(seq 1 1018))/

# answer 7 carries the longest suffix: "+" host path "*[file]"
full="+$adr$fil*[file]"
test ${#full} -gt $((slot - 1)) || fail "answer 7 fits the slot: ${#full} bytes"
assert_selftest "${full:0:$((slot - 1))}" wizardfilter 7 "$adr" "$fil"

# one byte shorter and nothing is clipped, or the case above proves nothing
short=${fil:0:$((${#fil} - 2))}/
assert_selftest "+$adr$short*[file]" wizardfilter 7 "$adr" "$short"

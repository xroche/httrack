#!/bin/bash
#
# Cookie chain against the local test server. entrance.php sets cat/cake,
# second.php checks them and sets badger, third.php checks all three. A wrong
# cookie returns 500, so a clean 3-files/0-errors run proves the jar works.

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 0 --files 3 \
    --found 'cookies/entrance.html' \
    --found 'cookies/second.html' \
    --found 'cookies/third.html' \
    httrack 'BASEURL/cookies/entrance.php'

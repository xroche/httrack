#!/bin/bash
#
# Cache header lines read back from disk keep to the reader's line cap, and a
# longer one is dropped whole (httrack -#test=cache-fields).

set -euo pipefail

out=$(httrack -O /dev/null -#test=cache-fields 2>&1) || {
    echo "$out" >&2
    exit 1
}
grep -q "cache-fields: OK" <<<"$out"

#!/bin/bash
#
# On a compiler with the access attribute, HTS_ARG_ACCESS_* and the annotated
# concat() must make an undersized buffer warn, and a right-sized one must not.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top=$(cd "$top_srcdir" && pwd)
# htsfeatures.h is generated, so a hand run outside make check has none.
[ -n "${abs_top_builddir:-}" ] || skip "abs_top_builddir unset, no automake environment"
tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"
read -r -a cc <<<"${CC:-cc}"
cc+=(-O2 -Wall -I"$abs_top_builddir" -I"$top/src" -c)

# Each call passes 64 bytes, then 16, for a 16-byte buffer.
cat >"$tmp/probe.c" <<'PROBE'
#include "httrack-library.h"
#ifdef RAW
__attribute__((access(write_only, 1, 2))) void raw(char *, size_t);
#endif
HTS_ARG_ACCESS_RO(1, 2) void ro(const char *, size_t);
HTS_ARG_ACCESS_WO(1, 2) void wo(char *, size_t);
HTS_ARG_ACCESS_RW(1, 2) void rw(char *, size_t);
void probe(void);
void probe(void) {
  char buf[16] = "123456789012345";
  CALL;
}
PROBE

# Without -Werror a compiler lacking the attribute only warns about it.
probe() {
    "${cc[@]}" "$@" -o "$tmp/probe.o" "$tmp/probe.c" 2>"$tmp/err" ||
        fail_dump "the probe does not compile: $*" "$tmp/err"
}

probe -DRAW "-DCALL=raw(buf, 64)"
grep -q '\[-Wstringop-overflow' "$tmp/err" || skip "${cc[0]} has no access attribute"
probe -DRAW "-DCALL=raw(buf, 16)"
[ ! -s "$tmp/err" ] || fail_dump "the control warns on a buffer that fits" "$tmp/err"

for call in 'ro(buf, 64)' 'wo(buf, 64)' 'rw(buf, 64)' '(void) concat(buf, 64, "a", "b")'; do
    probe "-DCALL=$call"
    grep -qE '\[-Wstringop-over(flow|read)' "$tmp/err" || fail_dump "$call does not warn" "$tmp/err"
    probe "-DCALL=${call/64/16}"
    [ ! -s "$tmp/err" ] || fail_dump "${call/64/16} warns" "$tmp/err"
done
echo "OK: ${cc[0]} checks every access mode and concat()"

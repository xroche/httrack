#!/bin/bash
#
# A top-level "make install" relinks the libtest plugins inside the build tree the
# suite shares, so two staged installs at once lose a .so. Assert the lock that
# serialises them excludes, hands a dead holder's lock to exactly one waiter,
# refuses to take a live one's, and is taken by every install in the suite.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

srcdir="${abs_top_srcdir:?not run under make check}"
# Resolved before any cd: $0 is relative under the test driver.
TESTLIB=$(cd "$(dirname "$0")" && pwd)/testlib.sh
export TESTLIB

work=$(mktemp -d "${TMPDIR:-/tmp}/installlock.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${work}"

# Every make install in the suite goes through the helper. Candidates are judged
# on the whole logical line, quotes included, so a command wrapped in a string
# cannot hide; only the vouching name is looked for outside the quotes, or a
# helper named in a failure message would speak for the line it sits on.
lint=${work}/lint.awk
cat >"${lint}" <<'AWK'
BEGIN {
    TARGET = "(^|[^[:alnum:]_./-])([i]nstall(-[A-Za-z0-9]+)*|[D]ESTDIR)([^[:alnum:]_.-]|$)"
    MAKEISH = "(^|[^[:alnum:]_])(make|MAKE|gmake)([^[:alnum:]_]|$)|-C[[:space:]]"
    HELPER = "run_with_install_lock|stage_install_target|stage_install_exec"
}
function scrub(s) {
    gsub(/"[^"]*"/, "", s)
    gsub(/'[^']*'/, "", s)
    return s
}
# A line whose only commands report is about an install, not one. What such a
# message runs in a substitution of its own is not looked at.
function is_message(t,   n, i, a) {
    gsub(/[0-9]*[<>]+&?[0-9]*/, " ", t)
    gsub(/[|&;(){}]/, " ", t)
    n = split(t, a, /[[:space:]]+/)
    for (i = 1; i <= n; i++) {
        if (a[i] == "")
            continue
        if (a[i] !~ /^(fail|fail_dump|skip|ok|echo|printf|dump_file)$/)
            return 0
    }
    return 1
}
function check(s,   t) {
    if (s ~ /^[[:space:]]*#/ || s !~ TARGET)
        return
    # An install target alone is someone else's package manager.
    if (s !~ MAKEISH && s !~ HELPER)
        return
    t = scrub(s)
    if (is_message(t))
        return
    calls++
    if (t ~ HELPER)
        return
    bad++
    print FILENAME ":" FNR ": " s
}
{ line = line $0 }
/\\$/ { sub(/\\[[:space:]]*$/, "", line); next }
{ check(line); line = "" }
END { print "TOTALS " calls+0 " " bad+0 }
AWK

lint_files() { awk -f "${lint}" "$@"; }
totals_of() { sed -n 's/^TOTALS //p' <<<"$1"; }
offenders_of() { grep -v '^TOTALS ' <<<"$1" || true; }

cd "${srcdir}/tests"
files=(*.sh *.py)
# shfmt reads a leading [0-9] glob as an array index, so add it after.
for f in [0-9]*_*.test; do files+=("${f}"); done
test "${#files[@]}" -ge 9 || fail "the lint found only ${#files[@]} files to scan"
for must in testlib.sh local-server.py; do
    case " ${files[*]} " in
    *" ${must} "*) ;;
    *) fail "the lint no longer reaches ${must}, where an install can hide" ;;
    esac
done

report=$(lint_files "${files[@]}")
read -r calls bad <<<"$(totals_of "${report}")"
test "${bad}" -eq 0 || {
    offenders_of "${report}" >&2
    fail "the lines above run a build-tree make outside the lock"
}
# An empty candidate list would satisfy the line above without reading anything.
test "${calls}" -ge 10 || fail "the lint saw only ${calls} such lines, the suite has more"
ok "${calls} staged-install lines, all through the lock"

# Ways to skip the lock, all but the first invisible to a file-level grep.
dirty=${work}/dirty
mkdir -p "${dirty}"
printf '%s\n' 'env make -C build install DESTDIR=/tmp/s >log 2>&1' >"${dirty}/raw.test"
printf '%s\n' 'stage_install_target install /tmp/s /tmp/l .' \
    'make -C build install DESTDIR=/tmp/s' >"${dirty}/second.test"
printf '%s\n' 'make -C build install prefix=/tmp/p' >"${dirty}/noDESTDIR.test"
printf '%s\n' 'do_install() { make -C build install-exec DESTDIR=/tmp/s; }' >"${dirty}/helper.sh"
printf '%s\n' 'make -C build install DESTDIR=/tmp/s || fail "use run_with_install_lock"' \
    >"${dirty}/named-in-a-message.test"
printf '%s\n' 'make -C build install-exec-am DESTDIR=/tmp/s' >"${dirty}/two-hyphens.test"
printf '%s\n' 'sh -c "make -C build install DESTDIR=/tmp/s"' >"${dirty}/in-quotes.test"
printf '%s\n' '"make" -C build "install" prefix=/tmp/p' >"${dirty}/quoted-target.test"
printf '%s\n' 'subprocess.run(["make", "-C", "build", "install"], check=True)' >"${dirty}/from.py"
for f in "${dirty}"/*; do
    read -r _ bad <<<"$(totals_of "$(lint_files "${f}")")"
    test "${bad}" -ge 1 || fail "the lint cannot see the install in $(basename "${f}")"
done
ok "the lint sees $(find "${dirty}" -type f | lines_of /dev/stdin) ways to skip it"

# And leaves alone what only talks about one: a lint that reds on apt-get would
# be turned off the day it is pointed at tools/.
clean=${work}/clean
mkdir -p "${clean}"
printf '%s\n' 'sudo apt-get install -y shellcheck shfmt' >"${clean}/package.sh"
printf '%s\n' 'fail "make install DESTDIR=/tmp/s"' >"${clean}/message.sh"
for f in "${clean}"/*; do
    read -r _ bad <<<"$(totals_of "$(lint_files "${f}")")"
    test "${bad}" -eq 0 || fail "the lint reds on $(basename "${f}"), which runs no install"
done
ok "the lint leaves a package install and a failure message alone"

cd "${work}"
export INSTALL_LOCK="${work}/lock"
export BARRIER="${work}/go"
export SECTIONS="${work}/sections"
export SECTION_SECS=0.25
workers=8
rounds=3
export BARRIER_POLL=0.05
stale_budget=10

# One process per worker, not a subshell: the lock is owned by a pid, and a
# subshell inherits $$.
worker="${work}/worker.sh"
cat >"${worker}" <<'EOF'
set -u
. "${TESTLIB}"
section() {
    printf 'IN %s\n' "$$" >>"${SECTIONS}"
    test -z "${HOLD:-}" || while :; do poll_wait 1; done
    sleep "${SECTION_SECS}"
    printf 'OUT %s\n' "$$" >>"${SECTIONS}"
}
until test -e "${BARRIER}"; do sleep "${BARRIER_POLL}"; done
if test "${USE_LOCK}" = 1; then
    run_with_install_lock section || exit 1
else
    section
fi
EOF

# Started together so their sections must overlap, then read back as a sequence:
# with the lock every OUT follows its own IN, without it they interleave.
run_workers() { # run_workers 0|1
    local i p pids=()
    rm -f "${BARRIER}"
    : >"${SECTIONS}"
    for ((i = 0; i < workers; i++)); do
        USE_LOCK=$1 bash "${worker}" &
        pids+=($!)
    done
    touch "${BARRIER}"
    for p in "${pids[@]}"; do wait "${p}" || fail "a worker failed to take the lock"; done
    test "$(lines_of "${SECTIONS}")" -eq $((workers * 2)) ||
        fail "wanted $((workers * 2)) section lines, got $(lines_of "${SECTIONS}")"
}

# Every section must close before the next one opens.
serialised() {
    awk '{ if (NR % 2) { want = ($1 == "IN"); pid = $2 }
           else { want = ($1 == "OUT" && $2 == pid) }
           if (!want) exit 1 }' "${SECTIONS}"
}

# The control first, and never gated behind the lint above: a probe blind to the
# unlocked interleaving would pass on a lock that does not lock.
run_workers 0
serialised &&
    skip "${workers} unlocked sections did not overlap, so this box cannot show the race"
ok "unlocked, ${workers} critical sections interleave"

for ((round = 1; round <= rounds; round++)); do
    run_workers 1
    serialised || fail "round ${round}: the lock let two sections overlap: $(tr '\n' ' ' <"${SECTIONS}")"
done
ok "the lock serialises ${workers} holders, ${rounds} rounds"

# A holder killed outright leaves a lock nobody is allowed to remove, since only
# the process named inside one removes it. Every waiter must refuse and name the
# file, none may enter, and the lock must still be there afterwards: each of the
# three reclaim designs tried here handed that lock to two waiters at once.
for ((round = 1; round <= rounds; round++)); do
    rm -f "${BARRIER}" "${work}/stale.log"
    : >"${SECTIONS}"
    touch "${BARRIER}"
    USE_LOCK=1 HOLD=1 bash "${worker}" &
    corpse=$!
    start=${SECONDS}
    until test "$(lines_of "${SECTIONS}")" -ge 1; do
        test $((SECONDS - start)) -lt "${stale_budget}" || fail "the corpse never took the lock"
        sleep "${BARRIER_POLL}"
    done
    kill -9 "${corpse}" 2>/dev/null || true
    wait "${corpse}" 2>/dev/null || true
    pids=()
    for ((i = 0; i < workers; i++)); do
        USE_LOCK=1 INSTALL_LOCK_STALE=1 bash "${worker}" 2>>"${work}/stale.log" &
        pids+=($!)
    done
    for p in "${pids[@]}"; do
        wait "${p}" && fail "round ${round}: a waiter took the lock a killed holder left"
    done
    test "$(lines_of "${SECTIONS}")" -eq 1 ||
        fail "round ${round}: a waiter ran its section anyway: $(tr '\n' ' ' <"${SECTIONS}")"
    install_lock_read_pid "${INSTALL_LOCK}"
    test "${INSTALL_LOCK_PID}" = "${corpse}" ||
        fail "round ${round}: the stale lock was removed, pid is now [${INSTALL_LOCK_PID}]"
    grep -q "${INSTALL_LOCK}" "${work}/stale.log" ||
        fail "round ${round}: the refusal does not name the file to remove"
    rm -f "${INSTALL_LOCK}"
done
ok "a lock left by a killed holder is refused and named, never taken, ${rounds} rounds"

# A live holder is never evicted: past the deadline the waiter fails the run rather
# than install alongside it.
rm -f "${BARRIER}"
: >"${SECTIONS}"
touch "${BARRIER}"
USE_LOCK=1 SECTION_SECS=4 bash "${worker}" &
holder=$!
start=${SECONDS}
until test "$(lines_of "${SECTIONS}")" -ge 1; do
    test $((SECONDS - start)) -lt "${stale_budget}" || fail "the holder never took the lock"
    sleep "${BARRIER_POLL}"
done
start=${SECONDS}
INSTALL_LOCK_TIMEOUT=1 run_with_install_lock touch "${work}/ran" 2>"${work}/backstop.log" &&
    fail "a waiter walked in on a live holder"
test $((SECONDS - start)) -lt "${stale_budget}" || fail "the deadline never fired"
# The command must not run either: an acquire failure the wrapper drops is an
# install with no lock at all.
test ! -e "${work}/ran" || fail "the command ran without the lock"
install_lock_read_pid "${INSTALL_LOCK}"
test "${INSTALL_LOCK_PID}" = "${holder}" ||
    fail "the live holder's lock was taken: pid is now [${INSTALL_LOCK_PID}]"
wait "${holder}" || fail "the live holder did not finish"
serialised || fail "the live holder's section was not clean"
ok "past the deadline a waiter fails instead of evicting a live holder"

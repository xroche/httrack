#!/bin/bash
#
# Reloading a saved project must run the winprofile.ini reader: nothing else in
# the suite reaches it, so unescapeini() and the "0" coercion were unguarded.

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
distdir=${top_srcdir:-$(cd "${testdir}/.." && pwd)}
distdir=$(cd "${distdir}" && pwd)
# shellcheck source=tests/webhttracklib.sh
. "${testdir}/webhttracklib.sh"

# Ahead of htsserver_require, which skips where python3 is absent: this block
# is pure text and must still run there.
printf '[the checkbox table matches step4.html] ..\t'
# Nothing else ties ini_checkbox_keys[] to the ${ztest:} keys step4.html
# writes. ProxyType is the one entry step4.html does not spell that way.
written=$({
    sed -n 's/^\([^=]*\)=[$]{ztest:.*/\1/p' "${distdir}/html/server/step4.html"
    echo ProxyType
} | sort -u)
listed=$(awk '/ini_checkbox_keys\[\] = /,/^\};/' "${distdir}/src/htsserver.c" |
    grep -o '"[^"]*"' | tr -d '"' | sort -u)
# Floor: two gutted lists compare equal.
test "$(printf '%s\n' "${written}" | wc -l)" -ge 30 ||
    fail "only $(printf '%s\n' "${written}" | wc -l) ztest keys in step4.html"
test "${written}" = "${listed}" ||
    fail "$(diff <(echo "${written}") <(echo "${listed}"))"
! command grep -q '^ProxyType=[$]{ztest:' "${distdir}/html/server/step4.html" ||
    fail "ProxyType is a ztest key now, so the exception hides drift"
echo OK

htsserver_require

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_profile.XXXXXX") || fail "no tmpdir"
cleanup_push htsserver_cleanup_dir "${work}"

mkdir -p "${work}/proj/hts-cache"
# What the wizard itself writes: checkboxes as 0/1, values verbatim, and every
# separator of a rules box percent-encoded one byte at a time.
cat >"${work}/proj/hts-cache/winprofile.ini" <<'EOF'
CurrentUrl=http://example.com/
Category=c%
MaxRate=0
MaxTime=0
Depth=3
UserID=
KeepAlive=0
Cookies=0
Index=0
Cache=0
URLHack=0
Warc=0
WarcFile=keepme
Wacz=1
NoExternalPages=0
HostAlias=a=b%0D%0A%09c=d
Footer=x%%y
Sitemap=1
SitemapUrl=http://example.com/s.xml%
ProxyType=0
EOF

printf '[reloading a project reads its winprofile.ini] ..\t'
htsserver_start --home "${work}"

htsserver_python - "${HTS_URL}" "${work}" <<'PY' || fail "see above"
import re
import sys

from webtestlib import Session, field, textarea

s, work = Session(sys.argv[1]), sys.argv[2]
sid = s.sid

# Control, before anything is loaded: a fresh session ticks the cache box, so
# the assertions below measure the profile rather than an absent default.
tag = re.findall(r'<input[^>]*type="checkbox"[^>]*name="cache"[^>]*>',
                 s.get("option3.html?sid=" + sid))
if len(tag) != 1 or "checked" not in tag[0]:
    sys.exit("a new project does not default to caching: %r" % tag)

# The only request that opens the file: a GET of an option page renders the
# session the server already holds and never touches the disk.
loaded = s.post("step2.html", [("path", work), ("loadprojname", "proj")])
if "http://example.com/" not in loaded:
    sys.exit("step2.html did not load the project\n%s" % loaded[:400])
# The category dropdown comes from a second, independent reader in htstools.c
# that decodes the same escapes out of the same file.
if '<option value="c%">' not in loaded:
    sys.exit("the category list lost the trailing escape\n%s"
             % re.findall(r"<option[^>]*>[^<]*</option>", loaded))


step4 = s.get("step4.html?sid=" + sid)
flags = [line.strip() for line in textarea(step4, "command").split("\n")]
ini = dict(line.split("=", 1) for line in textarea(step4, "winprofile")
           .replace("\r\n", "\n").split("\n") if "=" in line)


def want(flag):
    if flag not in flags:
        sys.exit("%s missing from the reloaded command line\n%s"
                 % (flag, "\n".join(flags)))


def reject(flag):
    if flag in flags:
        sys.exit("%s came back from the reloaded profile\n%s"
                 % (flag, "\n".join(flags)))


# A value field: zero is the user's answer, and dropping it hands the engine a
# default two orders of magnitude away (#1177).
want("--max-rate=0")
want("--max-time=0")
want("--depth=3")
if ini.get("MaxRate") != "0" or ini.get("MaxTime") != "0":
    sys.exit("saving the reloaded project loses the zeros: %r" % ini)
maxrate = re.search(r'name="maxrate" value="([^"]*)"',
                    s.get("option5.html?sid=" + sid))
if maxrate is None or maxrate.group(1) != "0":
    sys.exit("option5.html shows %r in the rate box"
             % (maxrate and maxrate.group(1)))

# A checkbox field: the writer spells "cleared" as 0, so it must not come back
# as a flag. Wacz is the control, on the same page and the same shape, and it
# is ungated: --wacz names its own archive.
reject("--warc")
reject("--replace-external")
want("--wacz")
# A cleared box gates its value out of the command line and keeps it on disk.
reject('--warc-file "keepme"')
if ini.get("WarcFile") != "keepme":
    sys.exit("the cleared box lost WarcFile: %r" % ini.get("WarcFile"))
option9 = s.get("option9.html?sid=" + sid)
for box, ticked in [("warc", False), ("wacz", True)]:
    tag = re.findall(r'<input[^>]*type="checkbox"[^>]*name="%s"[^>]*>' % box,
                     option9)
    if len(tag) != 1:
        sys.exit("option9.html renders %d %s boxes" % (len(tag), box))
    if ("checked" in tag[0]) != ticked:
        sys.exit("the %s box came back %r" % (box, tag[0]))
for key, value in [("Warc", "0"), ("Wacz", "1"), ("NoExternalPages", "0")]:
    if ini.get(key) != value:
        sys.exit("%s saved back as %r, wanted %r" % (key, ini.get(key), value))

# A key in the file wins over the startup default even when it holds nothing
# (#1186); the box is the observable, since an empty -F now emits nothing (#1386).
box = field(s.get("option6.html?sid=" + sid), "user")
if box != "":
    sys.exit("the emptied browser id came back as %r" % box)
sent = [f for f in flags if f.startswith("--user-agent")]
if sent:
    sys.exit("an emptied browser id still reached the engine: %r" % sent)
reject("--keep-alive")
if ini.get("UserID") != "" or ini.get("KeepAlive") != "0":
    sys.exit("the cleared fields came back as %r / %r"
             % (ini.get("UserID"), ini.get("KeepAlive")))
# A cleared box has to reach the engine, not just untick: the file spells all
# four 0, the reader empties them, and each one still emits its disabling flag.
want("--cookies=0")
want("--index=0")
want("--cache=0")
want("--urlhack=0")
option4 = s.get("option4.html?sid=" + sid)
tag = re.findall(r'<input[^>]*type="checkbox"[^>]*name="ka"[^>]*>', option4)
if len(tag) != 1 or "checked" in tag[0]:
    sys.exit("the keep-alive box came back %r" % tag)
# Control: an absent key still takes the default, or the two are the same test.
want("--sockets=4")
if "Sockets" not in ini or ini["Sockets"] != "4":
    sys.exit("an absent Sockets did not default: %r" % ini.get("Sockets"))

# Re-rendering step2.html must not re-apply a startup default over the loaded
# value; only a fresh session may take it.
for page in ["step2.html?sid=" + sid, "option3.html?sid=" + sid]:
    tag = re.findall(r'<input[^>]*type="checkbox"[^>]*name="cache"[^>]*>',
                     s.get(page))
    if tag and "checked" in tag[0]:
        sys.exit("the cache box came back ticked after %s" % page)

# One separator, whatever the run: unescapeini() folds an encoded CR LF TAB
# into a single break, and the rules box must show exactly that.
alias = textarea(s.get("option8.html?sid=" + sid), "hostalias")
if alias != "a=b\rc=d":
    sys.exit("the rules box holds %r, wanted one separator" % alias)
want('--host-alias "a=b"')
want('--host-alias "c=d"')

# %% is the escape for a literal percent, and the writer puts it back.
want('--footer "x%y"')
if ini.get("Footer") != "x%%y":
    sys.exit("Footer round-tripped as %r" % ini.get("Footer"))

# The form body decodes through unescapehttp() rather than unescapeini(), and
# only a raw % reaches it: urlencoding one would defeat the probe.
want('--sitemap-url "http://example.com/s.xml%"')
posted = s.post_raw("step4.html", "sid=%s&cookiesfile=z%%&x=1" % s.sid)
if '--cookies-file "z%"' not in textarea(posted, "command"):
    sys.exit("a posted trailing %% did not come back verbatim\n%s"
             % textarea(posted, "command"))


# ProxyType 0 is the HTTP entry, so it prefixes no scheme. The proxy box itself
# is session state, so fill it before reading the flag.
def proxy_flag(fields):
    page = s.post("step4.html", fields)
    got = [line.strip() for line in textarea(page, "command").split("\n")
           if line.strip().startswith("--proxy ")]
    if len(got) != 1:
        sys.exit("step4.html emitted %d proxy flags" % len(got))
    return got[0]


box = [("prox", "p.example.com"), ("portprox", "8080")]
for fields, wanted in [(box, '--proxy "p.example.com:8080"'),
                       (box + [("proxytype", "1")],
                        '--proxy "socks5://p.example.com:8080"')]:
    got = proxy_flag(fields)
    if got != wanted:
        sys.exit("proxy flag is %r, wanted %r" % (got, wanted))
PY
echo OK

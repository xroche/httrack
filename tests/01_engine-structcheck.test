#!/bin/bash
#
# structcheck(): the path-length guard, the <name>.txt rename that once
# built its target with an unbounded sprintf (#745), and a bare file name.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

dir=$(mktemp -d)
cleanup_push rm -rf "$dir"

# The bare-name case resolves against the current directory.
PATH="$(dirname "$(httrack_path)"):$PATH"
(
    cd "$dir"
    assert_selftest "structcheck self-test OK" structcheck "$dir"
)
subshell_ok $?

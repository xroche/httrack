#!/bin/bash
#
# A placeholder moved to its final name in another directory must keep the
# file (#2249). The type is in the path, so the .delayed placeholder sits in
# delayed/ and the page in html/. Setup as in test 39.

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --log-found 'moved placeholder' \
    --log-not-found 'Write error on disk' \
    --found 'dcap/html/p0.bin.html' \
    httrack 'BASEURL/dcap/index.html' -M50000 -c1 -Z -N '%h%p/%t/%n.%t'

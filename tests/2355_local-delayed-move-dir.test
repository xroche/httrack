#!/bin/bash
#
# A placeholder moved into another directory must keep its file (#2249).

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --log-found 'moved placeholder' \
    --log-not-found 'Write error on disk' \
    --found 'dcap/html/p0.bin.html' \
    httrack 'BASEURL/dcap/index.html' -M50000 -c1 -Z -N '%h%p/%t/%n.%t'

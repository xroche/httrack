#!/bin/bash
#
# Every object in libhttrack.so's writable .data is listed in
# 2569_writable-data.txt, so a lookup table missing a const fails here.
set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

list="${0%"${0##*/}"}./2569_writable-data.txt"
[ -r "$list" ] || fail "no $list"
lib=${HTTRACK_SHLIB:-}
[ -f "${lib:-/nonexistent}" ] || skip "no shared libhttrack at '${lib:-unset}'"
readelf=${READELF:-readelf}
command -v "$readelf" >/dev/null 2>&1 || skip "no readelf ($readelf)"
"$readelf" -hW "$lib" >/dev/null 2>&1 || skip "$(basename "$lib") is not an ELF object"

tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"

LC_ALL=C "$readelf" -SW "$lib" >"$tmp/sections"
grep -q ' \.symtab ' "$tmp/sections" || skip "$(basename "$lib") is stripped"
idx=$(sed -n 's/^ *\[ *\([0-9][0-9]*\)\] \.data .*/\1/p' "$tmp/sections")
[ -n "$idx" ] || fail "no .data section in $lib"

# gcc writes a static local as "x.8" or "x.lto_priv.0", clang as "func.x".
LC_ALL=C "$readelf" -sW "$lib" >"$tmp/symbols"
awk -v n="$idx" '$4 == "OBJECT" && $7 == n && $8 !~ /^_/ {
    sub(/@.*/, "", $8)
    k = split($8, part, ".")
    while (k > 1 && part[k] ~ /^([0-9]+|lto_priv|isra|constprop)$/)
        k--
    print part[k]
}' "$tmp/symbols" | LC_ALL=C sort -u >"$tmp/actual"
grep -qx V6_is_available "$tmp/actual" || fail "V6_is_available not seen in .data: the listing is broken"

grep -v '^#' "$list" | LC_ALL=C sort -u >"$tmp/allowed"
extra=$(LC_ALL=C comm -23 "$tmp/actual" "$tmp/allowed" | tr "\n" " ")
[ -z "$extra" ] ||
    fail "writable objects not in $list: ${extra}(make a table that is never written const (both levels for an array of pointers), or list it)"
echo "writable .data objects: $(lines_of "$tmp/actual")"

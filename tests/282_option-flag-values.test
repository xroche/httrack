#!/bin/bash
#
# A long option must honour the value its short form takes: --index=0 dropped
# its value and read back as the enabling bare --index (#1195).

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=tests/webhttracklib.sh
. "${testdir}/webhttracklib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_flagvalue.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${tmp}"

assert_selftest "optalias self-test OK" optalias

# The engine end of it: the top index is <out>/index.html, next to the mirrored
# tree, which lands under out/file/.
echo '<html><body>hello</body></html>' >"${tmp}/page.html"
crawl() {
    rm -rf "${tmp}/out"
    mkdir -p "${tmp}/out"
    RC=0
    httrack "file://${tmp}/page.html" -O "${tmp}/out" --quiet -n "$@" \
        >"${tmp}/out/.log" 2>&1 || RC=$?
    INDEX=no
    test ! -f "${tmp}/out/index.html" || INDEX=yes
}

indexed() { # indexed WANT ARG...
    local want=$1
    shift
    crawl "$@"
    assert_eq 0 "${RC}" "$* exited"
    assert_eq "${want}" "${INDEX}" "$* wrote a top index"
}

indexed no -I0
indexed no --index=0
indexed no --index=off
indexed no --noindex
indexed no --index off
indexed yes --index
indexed yes --index=1
indexed yes -I

# A value the option cannot take stops the run instead of being dropped. The
# message has to name the reason, or a mangled flag the engine happens to reject
# would read as a refusal; 134 would be an abort rather than either.
refused() { # refused WANTED-MESSAGE ARG...
    local want=$1
    shift
    crawl "$@"
    { test "${RC}" -ne 0 && test "${RC}" -ne 134; } || fail "$* not refused (exit ${RC})"
    grep -q "${want}" "${tmp}/out/.log" ||
        fail "$* refused without saying why: $(cat "${tmp}/out/.log")"
}

refused 'does not take the value' --index=2
refused 'does not take the value' --mirror=0
refused 'Unknown option: nomirror' --nomirror

# Every option that now carries a value must emit a short form the engine parses
# whole: a digit left over reaches "invalid option" and kills the run (#1200).
# Only =0 is swept, since =1 is the bare flag for onoff and blocks for
# --advanced-wait, and it is the suffix that is new to all of them.
rows=$(httrack -O /dev/null "-#test=optalias" -list)
test "$(grep -c . <<<"${rows}")" -ge 30 || fail "short value-option list: ${rows}"
while read -r class name; do
    crawl "--${name}=0"
    ! grep -q 'invalid option' "${tmp}/out/.log" ||
        fail "--${name}=0 (${class}) emits a short form the engine rejects"
done <<<"${rows}"

# The wizard end: a cleared box, and a project reload carrying Index=0, must
# both emit the disabling form.
htsserver_require
work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_flagvalue.XXXXXX") || fail "no tmpdir"
cleanup() {
    htsserver_cleanup
    rm -rf "${work}"
}
cleanup_push cleanup

htsserver_start --home "${work}"

"${HTS_PYTHON}" - "${HTS_URL}" <<'PY' || fail "the index boxes do not disable the index (see above)"
import re, sys, urllib.parse, urllib.request

url = sys.argv[1].rstrip("/")
form = urllib.request.urlopen(url + "/server/index.html", timeout=20).read()
m = re.search(rb'name="sid" value="([0-9a-f]+)"', form)
if not m:
    sys.exit("no session id in server/index.html")
sid = m.group(1).decode()
rc = 0


def command(fields):
    body = "&".join("%s=%s" % (k, urllib.parse.quote(v)) for k, v in
                    [("sid", sid)] + fields)
    req = urllib.request.Request(url + "/server/step4.html",
                                 data=body.encode("latin-1"), method="POST")
    page = urllib.request.urlopen(req, timeout=20).read().decode("latin-1")
    m = re.search(r'<textarea name="command".*?>(.*?)</textarea>', page, re.S)
    if m is None:
        sys.exit("no command textarea in the rendered step4.html")
    return m.group(1).split()


def flags(cmd, name):
    return [w for w in cmd if w == name or w.startswith(name + "=")]


def check(field, value, want, name):
    global rc
    got = flags(command([(field, value)]), name)
    if got != want:
        print("FAIL: %s=%r emits %s, want %s" % (field, value, got, want))
        rc = 1


# A cleared checkbox posts nothing, and "0" is what a reloaded profile seeds.
# The whole emitted set is asserted: a wrong value would pass a bare "in cmd".
for field, name, ticked in (("index", "--index", []),
                            ("index2", "--search-index", ["--search-index"])):
    for value in ("", "0"):
        check(field, value, [name + "=0"], name)
    check(field, "on", ticked, name)

sys.exit(rc)
PY

htsserver_cleanup
htsserver_assert_reaped

echo "PASS"

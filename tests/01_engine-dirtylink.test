#!/bin/bash
#
# The engine checks hts_dirty_link_is_url on all strings up to 4 bytes (#1612).

set -euo pipefail

out=$(httrack -#test=dirtylink) || {
    echo "httrack -#test=dirtylink exited non-zero: $out" >&2
    exit 1
}

case "$out" in
"dirtylink self-test OK"*) ;;
*)
    echo "expected 'dirtylink self-test OK', got: $out" >&2
    exit 1
    ;;
esac

# A sweep whose corpus collapses still prints OK, so floor it at the real count.
swept=${out#*OK (}
swept=${swept%% *}
test "$swept" -ge 311651 || {
    echo "expected at least 311651 cases swept, got: $out" >&2
    exit 1
}

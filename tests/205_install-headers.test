#!/bin/bash
#
# Every header in DevIncludes_DATA lands in $(includedir)/httrack with nothing
# else beside it, so each must compile on its own from there, in both
# HTS_INTERNAL_BYTECODE states: four of them gate declarations on it (#943).

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}testlib.sh"

# Unset means no automake run (the Windows job runs the scripts directly), so
# there is no install rule to drive.
if [ -z "${abs_top_builddir:-}" ]; then
    echo "abs_top_builddir unset, no automake environment, skipping" >&2
    exit 77
fi
[ -f "$abs_top_builddir/src/Makefile" ] || fail "$abs_top_builddir/src is not configured"

# CC carries flags on some legs ("gcc -m32" on linux-i386, "ccache gcc"), so
# split it: looking the whole string up as one program skips the i386 job, the
# only leg with a different data model.
read -r -a cc_argv <<<"${CC:-cc}"
command -v "${cc_argv[0]}" >/dev/null 2>&1 || skip "no C compiler (${cc_argv[0]})"
make=${MAKE:-make}
command -v "$make" >/dev/null 2>&1 || skip "no make ($make)"

tmp=$(mktemp -d) || exit 1
cleanup_push rm -rf "$tmp"

# A consumer compiles against our headers with the dependency include paths too.
# Seeding the array with -I keeps it non-empty, which bash 3.2 needs under set -u.
cpp_argv=(-I"$tmp/include")
if [ -n "${TEST_CPPFLAGS:-}" ]; then
    read -r -a extra_argv <<<"$TEST_CPPFLAGS"
    cpp_argv+=("${extra_argv[@]}")
fi

# Positive control: without it, a compiler whose libc headers are missing (a box
# with no gcc-multilib and CC="gcc -m32") blames every installed header instead.
printf '#include <stdio.h>\n' >"$tmp/tu.c"
if ! "${cc_argv[@]}" "${cpp_argv[@]}" -fsyntax-only "$tmp/tu.c" 2>"$tmp/cc.log"; then
    head -5 "$tmp/cc.log" >&2
    echo "${cc_argv[*]} cannot compile a bare <stdio.h>, skipping" >&2
    exit 77
fi

# Override the install dir rather than use DESTDIR: same rule and file list, no
# guessing at the prefix. Empty MAKEFLAGS, or the sub-make reaches for a
# jobserver the test driver did not hand it.
env MAKEFLAGS= MFLAGS= "$make" -C "$abs_top_builddir/src" install-DevIncludesDATA \
    DevIncludesdir="$tmp/include/httrack" >"$tmp/install.log" 2>&1 ||
    {
        cat "$tmp/install.log" >&2
        fail "install-DevIncludesDATA failed"
    }

headers=("$tmp/include/httrack"/*.h)
[ "${#headers[@]}" -ge 10 ] || fail "only ${#headers[@]} headers installed, the list cannot be right"
for expected in htswrap.h htsdefines.h htsmodules.h httrack-library.h; do
    [ -f "$tmp/include/httrack/$expected" ] || fail "$expected was not installed"
done

bad=0
for h in "${headers[@]}"; do
    b=$(basename "$h")
    printf '#include <httrack/%s>\n' "$b" >"$tmp/tu.c"
    for mode in -UHTS_INTERNAL_BYTECODE -DHTS_INTERNAL_BYTECODE; do
        if ! "${cc_argv[@]}" "${cpp_argv[@]}" "$mode" -fsyntax-only "$tmp/tu.c" 2>"$tmp/cc.log"; then
            echo "$b does not compile standalone ($mode):" >&2
            head -5 "$tmp/cc.log" >&2
            bad=1
        fi
    done
done
[ "$bad" -eq 0 ] || fail "installed headers are not self-contained"

# The loop above is only meaningful if this compiler rejects a missing include.
printf '#include "no-such-header-943.h"\n' >"$tmp/tu.c"
if "${cc_argv[@]}" "${cpp_argv[@]}" -fsyntax-only "$tmp/tu.c" 2>/dev/null; then
    fail "${cc_argv[*]} accepted a missing include, the checks above proved nothing"
fi

exit 0

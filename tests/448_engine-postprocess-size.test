#!/bin/bash
#
# A postprocess-html callback returns its byte count as an int, which the
# engine checks before using it as the buffer's size.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

selftest_queue "postprocess reply self-test OK" postprocsize
selftest_run_queued

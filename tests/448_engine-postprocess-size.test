#!/bin/bash
#
# A postprocess-html callback returns its byte count as an int, and the engine
# checks it before using it as the buffer's size. 440 keeps the unchecked route
# out, and this pins what the check accepts.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

selftest_queue "postprocess reply self-test OK" postprocsize
selftest_run_queued

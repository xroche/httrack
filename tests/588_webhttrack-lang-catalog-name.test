#!/bin/bash
# lang.def names the catalog file for each language and the server joins that
# name to lang/, so the name has to be a bare basename. One carrying a
# separator read a catalog from outside lang/, and a long one overflowed the
# 1024-byte buffer the name was formatted into. The sanitizer CI build turns
# that overflow into a hard stack-buffer-overflow.

set -euo pipefail

# shellcheck source=tests/webhttracklib.sh
. "${0%"${0##*/}"}./webhttracklib.sh"

htsserver_require

work=$(mktemp -d "${TMPDIR:-/tmp}/webhttrack_langname.XXXXXX") || fail "no tmpdir"
cleanup_push htsserver_cleanup_dir "${work}"

long=$(printf 'X%.0s' $(seq 1 1100))

# A root of symlinks into the dist tree, with lang.def a real file so the
# rewrite cannot reach the source tree through it. $2 replaces the value paired
# with LANGUAGE_1, which is the catalog the default language loads and is
# lang.def's very first line; empty keeps the stock file.
make_root() { # $1 = root, $2 = catalog name
    local root=$1 name=$2 entry
    mkdir -p "${root}/html" "${root}/lang"
    for entry in "${HTS_DISTDIR}"/*; do
        case "${entry##*/}" in
        html | lang | lang.def) ;;
        *) ln -s "${entry}" "${root}/${entry##*/}" ;;
        esac
    done
    for entry in "${HTS_DISTDIR}"/html/*; do
        ln -s "${entry}" "${root}/html/${entry##*/}"
    done
    ln -s "${HTS_DISTDIR}" "${root}/html/doc"
    for entry in "${HTS_DISTDIR}"/lang/*; do
        ln -s "${entry}" "${root}/lang/${entry##*/}"
    done
    if test -z "${name}"; then
        cp "${HTS_DISTDIR}/lang.def" "${root}/lang.def"
        return 0
    fi
    {
        printf '%s\n' "${name}"
        tail -n +2 "${HTS_DISTDIR}/lang.def"
    } >"${root}/lang.def"
    # A real catalog where the name resolves, so a refusal cannot be mistaken
    # for the file being absent. The over-long name is past NAME_MAX, and there
    # the overflow rather than the open is the point.
    if test "${#name}" -lt 240; then
        mkdir -p "$(dirname "${root}/lang/${name}")"
        cp "${HTS_DISTDIR}/lang/English.txt" "${root}/lang/${name}.txt"
    fi
}

# Start htsserver on $1 with its own $HOME, leaving the pid in ${srvpid} and
# the output in ${srvlog}. The announcement comes before the catalog load, so
# reaching it says nothing about whether the catalog was accepted.
start_server() { # $1 = root tag
    local port
    port=$(htsserver_freeport) || fail "no free loopback port"
    srvlog="${work}/$1.log"
    mkdir -p "${work}/$1.home"
    : >"${srvlog}"
    (
        trap '' TERM TTOU XFSZ
        HOME="${work}/$1.home" exec htsserver "${work}/$1/" --port "${port}" \
            >"${srvlog}" 2>&1
    ) &
    srvpid=$!
    HTS_BG_PIDS+=("${srvpid}")
}

# True once ${srvlog} matches $1, or the server died; false on the deadline.
wait_for() { # $1 = grep -E pattern
    local deadline=$((SECONDS + 30))
    while test "${SECONDS}" -lt "${deadline}"; do
        if grep -qE "$1" "${srvlog}"; then return 0; fi
        if ! kill -0 "${srvpid}" 2>/dev/null; then
            grep -qE "$1" "${srvlog}"
            return $?
        fi
        sleep 0.1
    done
    return 1
}

# The control first: a stock lang.def must get past the catalog load and stay
# up, or every refusal below would pass on a root that simply cannot serve.
make_root "${work}/stock" ""
start_server stock
wait_for '^URL=' || fail "the stock lang.def never announced: $(cat "${srvlog}")"
kill -0 "${srvpid}" 2>/dev/null ||
    fail "the stock lang.def killed the server: $(cat "${srvlog}")"
htsserver_stop

for label in dotdot subdir overlong; do
    case "${label}" in
    dotdot) name=../planted ;;
    subdir) name=lang2/planted ;;
    overlong) name=${long} ;;
    esac
    make_root "${work}/${label}" "${name}"
    start_server "${label}"
    wait_for 'unable to find lang.def' ||
        fail "a ${label} catalog name was accepted: $(cat "${srvlog}")"
    htsserver_stop
done

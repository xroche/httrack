#!/bin/bash
#

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# hts_mirror_completed() reads HTS_DEFAULT before any mirror has run, so a GUI
# whose hts_main2() bailed out early does not show abort text for a mirror that
# never started. 'run' is an ignored placeholder argument.
assert_selftest "mirror-completed: OK" mirrorcompleted run

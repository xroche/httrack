#!/bin/bash
# A socket numbered FD_SETSIZE or more must fail its slot, not overflow an fd_set.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

: "${top_srcdir:=..}"

skip_on_windows "windows: a Winsock fd_set has no descriptor ceiling to test"

# The helper's boundary, before any crawl.
out=$(httrack -O /dev/null '-#test=selectable' 2>&1) ||
    fail "-#test=selectable failed: $out"
assert_eq "selectable OK" "$out" "the selectable self-test verdict"

python=$(find_python) || skip "python3 missing"

crawl() { bash "$top_srcdir/tests/local-crawl.sh" "$@"; }

# Control: with no descriptors burnt the same crawl succeeds and never warns.
crawl --found 'sitemapdir/start.html' --log-not-found 'beyond FD_SETSIZE' \
    httrack 'BASEURL/sitemapdir/start.html' -r2

# Fill every descriptor below 1103 so the crawl's sockets land above FD_SETSIZE.
# A locked limit skips the test, and so does a host where the exec'd shell cannot
# open one more file (GNU/Hurd, where bash failed to open local-crawl.sh).
# shellcheck disable=SC2016 # the bash -c script expands its own arguments
"$python" -c '
import os, resource, sys
soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
want = min(hard, 4096) if hard != resource.RLIM_INFINITY else 4096
if want < 1300:
    sys.exit(77)
resource.setrlimit(resource.RLIMIT_NOFILE, (want, hard))
for _ in range(1100):
    os.set_inheritable(os.open("/dev/null", os.O_RDONLY), True)
os.execvp(sys.argv[1], sys.argv[1:])
' bash -c '
n=$(ulimit -n)
[ "$n" = unlimited ] || [ "$n" -ge 1300 ] || exit 77
{ : <"$0"; } 2>/dev/null || exit 77
exec bash "$0" "$@"
' "$top_srcdir/tests/local-crawl.sh" --no-host-root \
    --log-found 'Socket (10[2-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[0-9]{5,}) is beyond FD_SETSIZE' \
    httrack 'BASEURL/sitemapdir/start.html' -r2 ||
    {
        rc=$?
        test "$rc" -ne 77 || skip "cannot hold 1100 open descriptors here"
        exit "$rc"
    }

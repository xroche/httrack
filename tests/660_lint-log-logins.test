#!/bin/bash
#
# Check that no log call prints an engine address with its password.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

python=$(find_python) || skip "no python3 to run the lint"
checker="${testdir}/check-log-logins.py"
src="${top_srcdir}/src"

work=$(mktemp -d "${TMPDIR:-/tmp}/log_logins.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "$work"

lint() { "$python" "$checker" "$@" 2>"$work/lint.err"; }

files=()
for f in "$src"/*.c; do
    case "$f" in
    *_selftest.c) ;;
    *) files+=("$f") ;;
    esac
done
test "${#files[@]}" -ge 40 || fail "the lint found only ${#files[@]} files to scan"
out=$(lint "${files[@]}") || fail_dump "a log call prints an address raw:
$out" "$work/lint.err"
grep -qx "${#files[@]} files, 0 hits" "$work/lint.err" ||
    fail_dump "the lint did not scan every file" "$work/lint.err"

# Mutant: one wrapped address put back raw.
sed 's/? adr_nologin(opt, urladr()) :/? (urladr()) :/' "$src/htscore.c" >"$work/htscore.c"
cmp -s "$src/htscore.c" "$work/htscore.c" && fail "the htscore.c mutant changed nothing"
lint "$work/htscore.c" >"$work/mut.out" && fail "the lint passed a raw urladr()"
grep -q 'is ready, skipping' "$work/mut.out" ||
    fail "the mutant was not reported: $(<"$work/mut.out")"

# Each form must be reported, and the safe ones not.
cat >"$work/forms.c" <<'CEOF'
f() {
  hts_log_print(opt, LOG_INFO, "a %s", adr); /* hit */
  hts_log_print(opt, LOG_INFO, "b %s%s", back[i].url_adr, fil); /* hit */
  hts_log_vprint(opt, LOG_INFO, "c %s", urladr()); /* hit */
  fprintf(opt->log, "d %s", r->adr); /* hit */
  hts_log_print(opt, LOG_INFO, "e %s", adr_nologin(opt, adr));
  hts_log_print(opt, LOG_INFO, "f %s", url_nologin(opt, url_adr));
  hts_log_print(opt, LOG_INFO, "g %s", urladr() != NULL ? "x" : "y");
  fprintf(fp, "h %s", adr);
  hts_log_print(opt, LOG_INFO, "i adr %s", "adr");
}
CEOF
lint "$work/forms.c" >"$work/forms.out" && fail "the lint passed the raw forms"
want=$(grep -n '/\* hit \*/' "$work/forms.c" | cut -d: -f1)
assert_eq "$want" "$(cut -d: -f2 "$work/forms.out")" "lines reported"

echo "log login lint OK"

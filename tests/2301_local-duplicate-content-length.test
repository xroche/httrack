#!/bin/bash
#
# RFC 9112 6.3: Content-Length values that disagree leave the body's end
# unknown, so the response is dropped. Repeated equal values are accepted.

set -euo pipefail

: "${top_srcdir:=..}"

bash "$top_srcdir/tests/local-crawl.sh" --errors 2 \
    --file-bytes 'dupcl/same.bin' 16 \
    --file-bytes 'dupcl/list.bin' 16 \
    --not-found 'dupcl/differ.bin' --not-found 'dupcl/differ-list.bin' \
    --log-found 'Conflicting Content-Length, response dropped: .*/dupcl/differ\.bin' \
    --log-found 'Conflicting Content-Length, response dropped: .*/dupcl/differ-list\.bin' \
    httrack 'BASEURL/dupcl/index.html' --retries=0

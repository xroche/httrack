#!/bin/bash
#
# shellcheck disable=SC2016 # the templates are for the engine to expand, not us

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

# -V expands "$0" to the crawled page's save name. The name comes from a URL, so
# it can hold ; ` $ & ' ( ) and spaces. usercommand_expand() must quote it so
# the shell reads it as one word and runs nothing else. -#test=usercmd prints
# the verdict and the expansion without spawning a shell.

# The round-trip below replays each expansion through a POSIX shell, and a
# native Windows engine emits the cmd.exe form instead: there a backtick inside
# "..." is inert, while the bash doing the replay runs it. Checking that form
# needs a cmd.exe round-trip, which this harness is not.
skip_on_windows "the expansion is quoted for cmd.exe, which bash cannot replay"

work=$(mktemp -d) || fail "mktemp failed"
canary="$work/pwned"
trap 'set +e; rm -rf "$work"' EXIT

# Verdict line for one template/filename pair, trailing EOL stripped.
expand() { # expand TEMPLATE FILENAME
    local got rc=0
    got=$(httrack -O /dev/null -#test=usercmd "$1" "$2") || rc=$?
    test "$rc" -eq 0 || fail "usercmd '$1' '$2': exited $rc"
    strip_trailing_eol "$got"
    printf '%s' "$STRIPPED"
}

# Round-trip: expand, run the expansion in a real bash, and the shell must read
# back exactly the filename with nothing else run. The payloads each carry a
# "touch $canary" gadget, so a quoting hole fires the canary checked at the end.
roundtrip() { # roundtrip TEMPLATE FILENAME [EXPECTED]
    local out exp want=${3-$2}
    out=$(expand "$1" "$2")
    case $out in
    OK\ *) exp=${out#OK } ;;
    *) fail "expected OK for '$1' '$2', got: $out" ;;
    esac
    # dash as well as bash: the two differ on what a stray quote does, and the
    # engine has no idea which /bin/sh system() will hand the command to.
    for sh in ${ROUNDTRIP_SHELLS:-bash dash}; do
        command -v "$sh" >/dev/null 2>&1 || continue
        got=$("$sh" -c "$exp") || fail "$sh eval of [$exp] failed"
        test "$got" = "$want" || fail "roundtrip '$1' '$2' under $sh: read [$got]"
    done
}

# Every template prints its one argument verbatim, in each context a shell word
# can sit: unquoted, "...", '...', and inside a command substitution.
templates=(
    'printf %s $0'
    'printf %s "$0"'
    'printf %s '\''$0'\'''
    'printf %s "$(printf %s '\''$0'\'')"'
    'printf %s "$( (printf %s '\''$0'\'') )"'
    'printf %s "$( (printf %s $0) )"'
    # the man page and fcguide print -V "rm \$0"; nothing strips that backslash
    # when the value comes from a profile, a Makefile or an argument list.
    'printf %s \$0'
    'printf %s "\$0"'
)

# Save names a crawled URL can produce, each with a live shell gadget.
names=(
    "a;touch $canary;.html"
    "a\`touch $canary\`.html"
    "a\$(touch $canary).html"
    "x'; touch $canary; echo 'y"
    "a b|touch $canary"
    "a&touch $canary"
    "a>$canary"
    "a b c.html"
    "a'b\"c\$d.html"
)

for t in "${templates[@]}"; do
    for n in "${names[@]}"; do
        roundtrip "$t" "$n"
    done
done

# Two substitutions in one template, the first one backslash-escaped. A
# backslash applies to the $0 it precedes and is spent there; if the scanner
# carries it past the substitution it suppresses the NEXT character's quote
# transition, so the second $0 is quoted for a context the shell is not in.
# The second $0 sits in each context in turn, and adjacent to the first, which
# is where a carried flag instead deletes the closing quote just emitted.
pair_templates=(
    'printf %s \$0$0'
    'printf %s \$0"$0"'
    'printf %s \$0'\''$0'\'''
    'printf %s \$0"$(printf %s '\''$0'\'')"'
    'printf %s $0\$0'
    'printf %s "$0"\$0'
    # no backslash at all: the control, so a fix that broke pairs outright fails
    'printf %s $0$0'
    'printf %s "$0"'\''$0'\'''
)

for t in "${pair_templates[@]}"; do
    for n in "${names[@]}"; do
        roundtrip "$t" "$n" "$n$n"
    done
done

# Each refusal must name its own cause, or a user cannot tell what to change.
refused_for() { # refused_for TEMPLATE WORD
    local out
    out=$(expand "$1" 'x.html')
    case $out in
    REFUSED*) ;;
    *) fail "expected REFUSED for '$1', got: $out" ;;
    esac
    case $out in
    *"$2"*) ;;
    *) fail "refusal for '$1' does not name $2: $out" ;;
    esac
}

# $0 inside `...`: the enclosing shell strips a backslash layer before the inner
# one reads the text, so no single escaping survives both.
refused_for 'echo `cat $0`' '`...`'

# $0 inside $(( )): POSIX evaluates arithmetic as if in double quotes, so the
# quotes put around the value are inert and a $( ) in the filename still runs.
# Bare, spaced, and with an operand, since each reaches the branch differently.
refused_for 'echo $(($0))' 'arithmetic'
refused_for 'echo $(( $0 ))' 'arithmetic'
refused_for 'echo $((1+$0))' 'arithmetic'
refused_for 'echo $(( ($0) ))' 'arithmetic'

# $(( )) is one spelling of several. bash reaches the same evaluator through
# $[ ], through (( )) as a command, through the for (( )) header, and through a
# [ ] array subscript, and the quoting is inert in all of them. $( (( is the
# sharp one: the lookahead that keeps a separated $( ( expandable reads only
# one paren, and (( at command position is arithmetic wherever it appears.
refused_for 'echo $[$0]' 'arithmetic'
refused_for '((n=$0))' 'arithmetic'
refused_for 'for ((i=0;i<$0;i++)); do :; done' 'arithmetic'
refused_for 'echo ${a[$0]}' 'arithmetic'
refused_for 'echo $( ((printf %s $0)) )' 'arithmetic'

# ${a[$0]} only reads an element. Writing one evaluates the subscript just the
# same, so the assignment forms are refused too. The last row is why the test
# cannot be name-blind: a template may declare one associative array and assign
# into a different, indexed one, and that one does evaluate.
refused_for 'a[$0]=1' 'arithmetic'
refused_for 'a[$0]+=1' 'arithmetic'
refused_for 'a=([$0]=x)' 'arithmetic'
refused_for 'declare -A m; a[$0]=1' 'arithmetic'

# Controls: a subscript with no assignment after it evaluates nothing, so
# neither shape may be refused. Arrays are bash-only, and dash rejects the word.
roundtrip_bash() { ROUNDTRIP_SHELLS=bash roundtrip "$@"; }
roundtrip_bash 'unset a[$0]; printf %s $0' "a;touch $canary;.html"
roundtrip_bash 'printf %s a[$0]' "a;touch $canary;.html" "a[a;touch $canary;.html]"

# Controls for those five, so a fix cannot pass by refusing the shapes around
# them: [ is the test command outside ${ }, and ${ } without a subscript is an
# ordinary parameter expansion.
roundtrip '[ -n $0 ] && printf %s $0' "a;touch $canary;.html"
roundtrip 'printf %s ${HOME:+}$0' "a;touch $canary;.html"
roundtrip 'printf %s ${x:-$0}' "a;touch $canary;.html"

# The control for the refusal above: a separated $( ( is an ordinary subshell,
# where quoting does hold, so it must still expand. Without this a fix that
# refuses both shapes would pass.
roundtrip 'printf %s "$( (printf %s $0) )"' "a;touch $canary;.html"

# Arithmetic carrying no $0 is copied through, and a $0 after it still expands,
# which is what proves the arithmetic frame closed where it should.
case $(expand 'echo $((1+2)) $0' 'a b.html') in
"OK echo \$((1+2)) 'a b.html'") ;;
*) fail "arithmetic without \$0 did not close: $(expand 'echo $((1+2)) $0' 'a b.html')" ;;
esac

# A backslash before $0 is the documented spelling, not a refusal: httrack
# substitutes $0 escaped or not, so the backslash was meant for an outer shell
# that never stripped it. Both forms must give the same quoted expansion.
test "$(expand 'rm \$0' '/out/a b.html')" = "$(expand 'rm $0' '/out/a b.html')" ||
    fail "rm \\\$0 and rm \$0 disagree"

# An escaped backslash is a literal one, and the $0 after it still gets quoted.
case $(expand 'echo \\$0' 'a;id;.html') in
"OK echo \\\\'a;id;.html'") ;;
*) fail "escaped backslash mishandled: $(expand 'echo \\$0' 'a;id;.html')" ;;
esac

# An expansion that does not fit temp[8192] is refused, never truncated
# mid-quote (a cut "rm '\$0'" would run as "rm"). Repeat $0 against a name near
# HTS_CDLMAXSIZE, since a single arg cannot itself exceed that limit.
big=$(printf '$0 %.0s' $(seq 1 12))
test "$(expand "$big" "$(repeat_chars 1000 A)")" = TOOLONG ||
    fail "over-long expansion not reported"

# The documented html/scripting.html templates keep expanding $0 to one word.
roundtrip 'printf %s $0' 'hello world.html'
roundtrip 'printf %s "$0"' 'hello world.html'

# No gadget in any payload ever ran.
test ! -e "$canary" || fail "a payload executed: canary $canary exists"

echo "usercommand -V quoting self-test OK"

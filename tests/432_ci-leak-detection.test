#!/bin/bash
#
# The sanitize leg is the only thing in CI that sees a dropped free, and it saw
# nothing for as long as its ASAN_OPTIONS carried detect_leaks=0. A leg told not
# to look goes green either way, so nothing but this test notices the flip back.

set -euo pipefail

# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

top=${abs_top_srcdir:-$(cd "$testdir/.." && pwd)}
workflow="$top/.github/workflows/ci.yml"
leg="$top/.github/workflows/sanitizer.yml"

if ! test -r "$workflow"; then
    test -d "$top/.github" && fail "$workflow is gone but $top/.github is not"
    skip "no .github under $top (dist tarball), so the audit has nothing to read"
fi

py=$(find_python || true)
if test -z "$py" || ! "$py" -c 'import yaml' 2>/dev/null; then
    skip "no python3 with PyYAML here, so the workflow cannot be parsed"
fi

# Read out of the parsed workflow, so reformatting it moves no verdict.
audit=$(mktemp "${TMPDIR:-/tmp}/httrack_leakaudit.XXXXXX")
cleanup_push rm -f "$audit"
cat >"$audit" <<'PY'
import sys

import yaml

with open(sys.argv[1], encoding="utf-8") as fp:
    jobs = yaml.safe_load(fp)["jobs"]

job = jobs.get("sanitize")
if job is None:
    sys.exit("no sanitize job in the workflow")

# Two shapes, because the leg has been both: its own steps, and a call into
# sanitizer.yml that takes the options as NAME=value lines.
found = []
for step in job.get("steps") or []:
    opts = (step.get("env") or {}).get("ASAN_OPTIONS")
    if opts is not None:
        found.append(("step %r" % step.get("name"), opts))
for line in ((job.get("with") or {}).get("options") or "").splitlines():
    name, sep, value = line.partition("=")
    if sep and name.strip() == "ASAN_OPTIONS":
        found.append(("the options input", value))

for name, opts in found:
    # Last value wins in the sanitizer flag parser.
    flags = [f for f in opts.split(":") if f.startswith("detect_leaks=")]
    if not flags:
        sys.exit("%s sets ASAN_OPTIONS without detect_leaks" % name)
    if flags[-1].split("=", 1)[1] == "0":
        sys.exit("%s runs with detect_leaks=0" % name)

if not found:
    sys.exit("nothing sets ASAN_OPTIONS for the sanitize job")
PY

"$py" "$audit" "$workflow" || fail "the sanitize leg no longer looks for leaks"

# A parser reading the wrong shape finds no ASAN_OPTIONS at all, and the check
# above would then pass on an empty set. The mutant is what rules that out.
# Only the sanitize leg spells it with '=', so the fuzz job's own
# "ASAN_OPTIONS: detect_leaks=1" cannot stand in for it.
mut=$(mktemp "${TMPDIR:-/tmp}/httrack_leakmut.XXXXXX")
cleanup_push rm -f "$mut"
sed 's/ASAN_OPTIONS=detect_leaks=1/ASAN_OPTIONS=detect_leaks=0/' "$workflow" >"$mut"
cmp -s "$workflow" "$mut" && fail "the detect_leaks=0 mutant changed nothing, so it proves nothing"
"$py" "$audit" "$mut" >/dev/null 2>&1 && fail "detect_leaks=0 went unreported"

# Asking for leak detection is half of it: a leg whose options never reach the
# environment runs with the runtime's own defaults, and the audit above cannot
# see that, because the write lives in the workflow ci.yml calls.
if test -r "$leg"; then
    command grep -q 'GITHUB_ENV' "$leg" ||
        fail "$leg no longer writes the runtime options to GITHUB_ENV"
elif command grep -q 'uses: \./\.github/workflows/' "$workflow"; then
    fail "ci.yml calls a workflow for its legs but $leg is gone"
fi

echo "leak detection OK (the sanitize leg asks for it, and detect_leaks=0 reds this test)"

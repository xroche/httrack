#!/bin/bash
#
# A rewritten URL written into a script string must not end the string or
# start an escape in it, so a backslash there is percent-encoded like a quote.
# Every link points off-site, so the page is rewritten and nothing is fetched.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_jsbackslash.XXXXXX") || exit 1
cleanup_push rm -rf "$tmp"
root=$tmp/root
mkdir -p "$root"

cat >"$root/index.html" <<'EOF'
<html><body>
<script>var s="//ext.invalid/b1.php?x=&#92;";</script>
<script>document.write("<img src=//ext.invalid/b2.php?x=&#92;");var ok=1;</script>
<script>var t="//ext.invalid/b3.php?x=&#92;n";</script>
<script>document.write('<a href="//ext.invalid/b4.php?x=&#92;">c</a>');</script>
<a onclick="document.write('<img src=//ext.invalid/b5.php?x=&#92; alt=a')">a</a>
<a href="//ext.invalid/b6.php?x=&#92;">m</a>
<script>var u="//ext.invalid/b7.php?x=1";</script>
</body></html>
EOF

# 1 to 5 hold the backslash in a script string, so it is encoded. 6 is an
# attribute, where a backslash is plain text, and 7 has none.
cat >"$tmp/expect-default" <<'EOF'
<html><body>
<script>var s="http://ext.invalid/b1.php?x=%5c";</script>
<script>document.write("<img src=http://ext.invalid/b2.php?x=%5c");var ok=1;</script>
<script>var t="http://ext.invalid/b3.php?x=%5cn";</script>
<script>document.write('<a href="http://ext.invalid/b4.php?x=%5c">c</a>');</script>
<a onclick="document.write('<img src=http://ext.invalid/b5.php?x=%5c alt=a')">a</a>
<a href="http://ext.invalid/b6.php?x=\">m</a>
<script>var u="http://ext.invalid/b7.php?x=1";</script>
</body></html>
EOF

# -%P0 leaves the plain script strings 1, 3 and 7 as they are.
awk 'NR==FNR { src[FNR] = $0; next }
     FNR == 2 || FNR == 4 || FNR == 8 { print src[FNR]; next } { print }' \
    "$root/index.html" "$tmp/expect-default" >"$tmp/expect-P0"

local_server_start --root "$root" --log "$tmp/server.log"

# check MODE [httrack args]: crawl, then compare the page byte for byte
check() {
    local mode=$1 out site
    shift
    out=$tmp/out-$mode
    local_crawl --log "$tmp/$mode.log" "$BASEURL/index.html" -O "$out" \
        -r2 --robots=0 --quiet -%F '' "$@" || true
    site=$out/127.0.0.1_$SRV_PORT
    test -f "$site/index.html" || fail_dump "$mode: no index.html" "$tmp/$mode.log"
    cmp -s "$tmp/expect-$mode" "$site/index.html" || {
        diff "$tmp/expect-$mode" "$site/index.html" | cut -c1-200 >&2 || true
        fail "$mode: index.html differs"
    }
}

check P0 -%P0
check default

#!/bin/bash
#
# Response headers arriving whole or one byte per write, over HTTP and HTTPS:
# the header reader must stop at the blank line, so each body lands intact,
# and must refuse a header block larger than its 8 KB line buffer.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

tmpdir=$(mktemp -d)
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

# FRAG_BODY in local-server.py
{
    printf '\r\n\r\nstart\r\nline\n\nlone\rCR\r\n'
    python3 -c 'import sys; sys.stdout.buffer.write(bytes(range(256)))'
    printf '\r\n\r\n'
} >"$tmpdir/expected"
test "$(wc -c <"$tmpdir/expected")" -eq 286 || fail "expected body is not 286 bytes"

# check SCHEME [local_server_start args]
check() {
    local scheme=$1 dir shape mode
    shift
    local_server_start "$@" --log "$tmpdir/$scheme-srv.out"
    local_crawl --log "$tmpdir/$scheme.out" \
        "$scheme://127.0.0.1:$SRV_PORT/frag/index.html" -O "$tmpdir/$scheme" \
        -r2 -c4 --robots=0 --retries=0 --quiet || true
    dir="$tmpdir/$scheme/127.0.0.1_$SRV_PORT/frag"
    for shape in crlf lf big continue chunked; do
        for mode in whole bytes; do
            test -f "$dir/$shape-$mode.bin" ||
                fail_dump "$scheme $shape-$mode.bin not saved" "$tmpdir/$scheme.out"
            cmp "$tmpdir/expected" "$dir/$shape-$mode.bin" ||
                fail "$scheme $shape-$mode.bin differs from the served body"
        done
    done
    for mode in whole bytes; do
        test ! -e "$dir/huge-$mode.bin" || fail "$scheme huge-$mode.bin saved"
    done
}

check http
if test "${HTTPS_SUPPORT:-}" == "no"; then
    echo "no https support compiled, skipping the https half"
else
    check https --tls
fi

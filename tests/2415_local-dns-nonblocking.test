#!/bin/bash
#
# A host whose DNS never answers must not hold up the other slots: pages of a
# fast host finish while its resolve is still pending.

set -euo pipefail

# shellcheck source=tests/crawllib.sh
. "${0%"${0##*/}"}./crawllib.sh"

if ! target_is_linux; then
    skip "dns-nonblocking: LD_PRELOAD interposition is Linux-only here"
fi
if [ ! -r "${GAISTALL_LA:-}" ]; then
    echo "dns-nonblocking: ${GAISTALL_LA:-\$GAISTALL_LA} was not built" >&2
    exit 1
fi
if grep -q "^dlname=''" "$GAISTALL_LA"; then
    skip "dns-nonblocking: static-only build, nothing to preload"
fi
if [ ! -r "${GAISTALL_LIB:-}" ]; then
    echo "dns-nonblocking: ${GAISTALL_LIB:-\$GAISTALL_LIB} was not built" >&2
    exit 1
fi

tmpdir=$(mktemp -d)
cleanup() {
    rm -rf "$tmpdir"
}
cleanup_push cleanup

root="$tmpdir/root"
mkdir -p "$root"
local_server_start --root "$root" --log "$tmpdir/srv.out" --bind 127.0.0.1
base="http://127.0.0.1:${SRV_PORT}"
links=""
for n in 1 2 3 4 5 6; do
    echo "page $n" >"$root/p$n.html"
    links="$links<a href=\"p$n.html\">$n</a>"
done
# the stalled link comes last, so the crawl never has to wait for it in order
echo "$links<a href=\"http://stall.invalid:${SRV_PORT}/s.html\">s</a>" >"$root/index.html"

export ASAN_OPTIONS="${ASAN_OPTIONS:+$ASAN_OPTIONS:}verify_asan_link_order=0"
export GAISTALL_HOST=stall.invalid

# The resolve stalls 60s and --timeout allows 30, so only a crawl that goes on
# around it can fetch the pages before --max-time. -%N1 lets links start ahead
# of their turn, so several wait on DNS at once.
out="$tmpdir/o1"
rc=0
TIMEFORMAT='%U %S'
{ time GAISTALL=60 LD_PRELOAD="$GAISTALL_LIB" \
    local_crawl --log "$tmpdir/log1" "$base/index.html" "+stall.invalid*" -O "$out" -c8 -%N1 --timeout=30 --max-time=8 --robots=0 --quiet 2>&3 || rc=$?; } 3>&2 2>"$tmpdir/cpu1"
for n in 1 2 3 4 5 6; do
    test -f "$out/127.0.0.1_${SRV_PORT}/p$n.html" ||
        fail_dump "p$n.html waited on the stalled resolve (rc=$rc)" "$out/hts-log.txt"
done
# waiting for the resolve must not spin: the crawl idles most of its 8s
cpu=$(tail -n 1 "$tmpdir/cpu1")
cpu=${cpu//,/.} # a decimal comma under some locales
[[ $cpu =~ ^[0-9.]+\ [0-9.]+$ ]] || fail "crawl 1: no CPU times in '$cpu'"
read -r cpu_user cpu_sys <<<"$cpu"
awk -v u="$cpu_user" -v s="$cpu_sys" 'BEGIN { exit !(u + s < 4) }' ||
    fail_dump "crawl 1 burnt ${cpu_user}s user ${cpu_sys}s sys" "$out/hts-log.txt"

# A resolve past --timeout fails its own link, and the others still land.
out="$tmpdir/o2"
GAISTALL=6 LD_PRELOAD="$GAISTALL_LIB" \
    local_crawl --log "$tmpdir/log2" "$base/index.html" "+stall.invalid*" -O "$out" -c8 --timeout=2 --retries=0 --robots=0 --quiet
grep -q "host name resolution timed out" "$out/hts-log.txt" ||
    fail_dump "no resolve timeout reported" "$out/hts-log.txt"
test -f "$out/127.0.0.1_${SRV_PORT}/p6.html" || fail_dump "p6.html missing" "$out/hts-log.txt"

# Two links to one host share a single resolve, and the cache keeps its answer.
# A 400ms resolve fits --timeout=1 however the second boundaries fall.
echo "<a href=\"http://localhost:${SRV_PORT}/p1.html\">1</a><a href=\"http://localhost:${SRV_PORT}/p2.html\">2</a>" >"$root/two.html"
for run in 1 2 3 4 5; do
    out="$tmpdir/o3-$run"
    GAISTALL_HOST=localhost GAISTALL_MS=400 GAISTALL_LOG="$tmpdir/gai3-$run" LD_PRELOAD="$GAISTALL_LIB" \
        local_crawl --log "$tmpdir/log3-$run" "$base/two.html" "+localhost*" -O "$out" -c8 -%N1 --timeout=1 --retries=0 --robots=0 --quiet
    for n in 1 2; do
        test -f "$out/localhost_${SRV_PORT}/p$n.html" ||
            fail_dump "run $run: localhost p$n.html missing" "$out/hts-log.txt"
    done
    calls=$(wc -l <"$tmpdir/gai3-$run")
    test "$calls" -eq 1 ||
        fail_dump "run $run: $calls resolves of localhost, expected 1" "$out/hts-log.txt"
done

# A resolved slot waits for --pause like a direct connect, so three links
# parked on one resolve do not all connect when it answers: about 3.2s, or
# 2.2s unpaced.
links=""
for n in 1 2 3; do
    links="$links<a href=\"http://localhost:${SRV_PORT}/p$n.html\">$n</a>"
done
echo "$links" >"$root/three.html"
out="$tmpdir/o4"
start=$(date +%s%N)
GAISTALL_HOST=localhost GAISTALL=1 LD_PRELOAD="$GAISTALL_LIB" \
    local_crawl --log "$tmpdir/log4" "$base/three.html" "+localhost*" -O "$out" -c8 -%N1 --pause 1 --robots=0 --quiet
elapsed=$((($(date +%s%N) - start) / 1000000))
for n in 1 2 3; do
    test -f "$out/localhost_${SRV_PORT}/p$n.html" ||
        fail_dump "paced localhost p$n.html missing" "$out/hts-log.txt"
done
test "$elapsed" -ge 2700 ||
    fail_dump "three paced connects took ${elapsed}ms, under 2.7s" "$out/hts-log.txt"

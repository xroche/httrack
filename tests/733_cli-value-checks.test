#!/bin/bash
#
# --warc-max-size and --connection-per-second refuse a bad value with a
# non-zero exit before any crawl.

set -euo pipefail

testdir=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=tests/testlib.sh
. "${testdir}/testlib.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/httrack_clival.XXXXXX") || fail "no tmpdir"
cleanup_push rm -rf "${tmp}"

echo '<html><body>hello</body></html>' >"${tmp}/page.html"
out=${tmp}/out

crawl() {
    rm -rf "${out}"
    mkdir -p "${out}"
    RC=0
    httrack "file://${tmp}/page.html" -O "${out}" --quiet -n "$@" \
        >"${tmp}/log" 2>&1 || RC=$?
}

refused() {
    crawl "$@"
    { test "${RC}" -ne 0 && test "${RC}" -ne 134; } ||
        fail_dump "$* not refused (exit ${RC})" "${tmp}/log"
    test -z "$(find "${out}" -name 'page.html' 2>/dev/null)" ||
        fail_dump "$* still mirrored" "${tmp}/log"
}

accepted() {
    crawl "$@"
    assert_eq 0 "${RC}" "$* exited"
}

accepted --warc-max-size 1048576
accepted --connection-per-second=0.5
for v in abc -5 10X 99999999999999999999 ""; do
    refused --warc-max-size "$v"
done
for v in 0.0000001 nan inf 1e99; do
    refused "-%c${v}"
done

#!/bin/bash
#
# A field appended to the tail of httrackp must not lock out an older binary:
# the guard rejects only a caller compiled bigger than the library.

set -euo pipefail
# shellcheck source=tests/testlib.sh
. "${0%"${0##*/}"}./testlib.sh"

raw=$(httrack -O /dev/null "-#test=optsize")
strip_trailing_eol "$raw"
case $STRIPPED in
"optsize: library "*) lib=${STRIPPED#optsize: library } ;;
*) fail "expected the library size, got [$STRIPPED]" ;;
esac
test "$lib" -gt 0 || fail "library reported sizeof(httrackp) = $lib"

assert_selftest "optsize: compatible" optsize "$((lib - 1))"
assert_selftest "optsize: compatible" optsize "$lib"
assert_selftest "optsize: incompatible" optsize "$((lib + 1))"
